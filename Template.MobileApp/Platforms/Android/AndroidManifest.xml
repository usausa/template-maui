<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:label="Template" android:usesCleartextTraffic="true"></application>
	<!-- Network state: diagnostics, telemetry, SignalR -->
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<!-- Internet: network pages, samples, telemetry, notifications -->
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Wi-Fi: connection info and scanning -->
	<uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
	<uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
	<uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
	<!-- Notifications and exact alarms -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
	<!-- Camera: capture, QR, OCR, CV, and flashlight -->
	<uses-permission android:name="android.permission.CAMERA" />
	<!-- Flashlight -->
	<uses-permission android:name="android.permission.FLASHLIGHT" />
	<!-- Microphone: speech input and noise level -->
	<uses-permission android:name="android.permission.RECORD_AUDIO" />
	<!-- Vibration: QR and haptic feedback -->
	<uses-permission android:name="android.permission.VIBRATE" />
	<!-- Location: location, Wi-Fi SSID, and legacy Bluetooth scanning -->
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<!-- Device > NFC -->
	<uses-permission android:name="android.permission.NFC" />
	<!-- Activity recognition -->
	<uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
	<!-- Biometric authentication -->
	<uses-permission android:name="android.permission.USE_BIOMETRIC" />
	<!-- Legacy Bluetooth permissions (Android 11 and earlier) -->
	<uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
	<uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
	<!-- BLE advertising -->
	<uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
	<!-- Bluetooth connections and device names -->
	<uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
	<!-- Bluetooth scanning without location inference -->
	<uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
	<!-- Optional hardware features -->
	<!-- Location -->
	<uses-feature android:name="android.hardware.location" android:required="false" />
	<uses-feature android:name="android.hardware.location.gps" android:required="false" />
	<uses-feature android:name="android.hardware.location.network" android:required="false" />
	<!-- NFC -->
	<uses-feature android:name="android.hardware.nfc" android:required="false" />
	<!-- Camera -->
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<!-- Bluetooth -->
	<uses-feature android:name="android.hardware.bluetooth" android:required="false" />
	<!-- Microphone -->
	<uses-feature android:name="android.hardware.microphone" android:required="false" />

	<!-- Package visibility: dialer -->
	<queries>
		<intent>
			<action android:name="android.intent.action.DIAL" />
			<data android:scheme="tel"/>
		</intent>
	</queries>
	<!-- Package visibility: SMS -->
	<queries>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="smsto"/>
		</intent>
	</queries>
	<!-- Package visibility: email -->
	<queries>
		<intent>
			<action android:name="android.intent.action.SENDTO" />
			<data android:scheme="mailto" />
		</intent>
	</queries>

</manifest>
