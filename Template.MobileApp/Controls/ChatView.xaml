<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             x:Class="Template.MobileApp.Controls.ChatView"
             x:Name="Root">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="ChatRootGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
            </Style>

            <!-- Message -->

            <Style x:Key="MessageCardBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="12,6" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Offset="0,2"
                                Brush="Black"
                                Opacity="0.08"
                                Radius="6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="UserCardBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource MessageCardBorder}">
                <Setter Property="Margin" Value="48,6,12,6" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
            </Style>

            <Style x:Key="RoleHeaderStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="RoleIconBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="28" />
                <Setter Property="HeightRequest" Value="28" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>

            <Style x:Key="RoleIconLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="RoleNameLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="MessageTextLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
            </Style>

            <Style x:Key="TypingDot"
                   TargetType="Ellipse">
                <Setter Property="WidthRequest" Value="8" />
                <Setter Property="HeightRequest" Value="8" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Fill" Value="{StaticResource GrayLighten1}" />
            </Style>

            <Style x:Key="TypingStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>

            <!-- Input -->

            <Style x:Key="InputBarGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="ColumnSpacing" Value="8" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="InputBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            </Style>

            <Style x:Key="InputBarButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <!-- Send -->

            <Style x:Key="SendButton"
                   TargetType="Button"
                   BasedOn="{StaticResource InputBarButton}">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten2}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Cancel -->

            <Style x:Key="CancelButton"
                   TargetType="Button"
                   BasedOn="{StaticResource InputBarButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource RedDefault}" />
            </Style>

            <Style x:Key="VoiceButton"
                   TargetType="Button"
                   BasedOn="{StaticResource InputBarButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken2}" />
                <Setter Property="behaviors:ButtonOption.HapticFeedback" Value="True" />
            </Style>

            <Style x:Key="VoiceRing"
                   TargetType="Ellipse">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Stroke" Value="{StaticResource RedDefault}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="InputTransparent" Value="True" />
            </Style>

            <!-- Assistant -->

            <DataTemplate x:Key="AssistantTemplate"
                          x:DataType="{x:Type sample:AiChatMessage}">
                <Border Style="{StaticResource MessageCardBorder}">
                    <VerticalStackLayout>
                        <HorizontalStackLayout Style="{StaticResource RoleHeaderStack}">
                            <Border Style="{StaticResource RoleIconBorder}">
                                <Label Style="{StaticResource RoleIconLabel}"
                                       Text="{x:Static fonts:MaterialIcons.Smart_toy}" />
                            </Border>
                            <Label Style="{StaticResource RoleNameLabel}"
                                   Text="Assistant" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Style="{StaticResource TypingStack}"
                                               IsVisible="{Binding IsTyping}">
                            <Ellipse Style="{StaticResource TypingDot}"
                                     behaviors:AnimationOption.Wave="True" />
                            <Ellipse Style="{StaticResource TypingDot}"
                                     behaviors:AnimationOption.Wave="True"
                                     behaviors:AnimationOption.WaveDelay="180" />
                            <Ellipse Style="{StaticResource TypingDot}"
                                     behaviors:AnimationOption.Wave="True"
                                     behaviors:AnimationOption.WaveDelay="360" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource MessageTextLabel}"
                               IsVisible="{Binding IsTyping, Converter={StaticResource ReverseConverter}}"
                               Text="{Binding Text}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>

            <!-- User -->

            <DataTemplate x:Key="UserTemplate"
                          x:DataType="{x:Type sample:AiChatMessage}">
                <Border Style="{StaticResource UserCardBorder}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource RoleNameLabel}"
                               Text="You" />
                        <Label Style="{StaticResource MessageTextLabel}"
                               Text="{Binding Text}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>

            <controls:AiChatTemplateSelector x:Key="MessageTemplateSelector"
                                             AssistantTemplate="{StaticResource AssistantTemplate}"
                                             UserTemplate="{StaticResource UserTemplate}" />

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
    <!-- Content -->
    <Grid Style="{StaticResource ChatRootGrid}"
          RowDefinitions="*,Auto">

        <!-- Message list -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Source={x:Reference Root}, Path=Messages, x:DataType={x:Type controls:ChatView}}"
                        ItemTemplate="{StaticResource MessageTemplateSelector}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        VerticalScrollBarVisibility="Default" />

        <!-- Input bar -->
        <Grid Grid.Row="1"
              Style="{StaticResource InputBarGrid}"
              ColumnDefinitions="*,Auto,Auto">
            <Border Grid.Column="0"
                    Style="{StaticResource InputBorder}">
                <Entry Style="{StaticResource BasicFieldEntry}"
                       Text="{Binding Source={x:Reference Root}, Path=InputText, Mode=TwoWay, x:DataType={x:Type controls:ChatView}}"
                       Placeholder="メッセージを入力">
                    <Entry.Triggers>
                        <DataTrigger TargetType="Entry"
                                     Binding="{Binding Source={x:Reference Root}, Path=IsListening, x:DataType={x:Type controls:ChatView}}"
                                     Value="True">
                            <Setter Property="Placeholder" Value="話しかけてください" />
                        </DataTrigger>
                    </Entry.Triggers>
                </Entry>
            </Border>

            <Grid Grid.Column="1"
                  IsVisible="{Binding Source={x:Reference Root}, Path=VoiceCommand, Converter={StaticResource NotEmptyConverter}, x:DataType={x:Type controls:ChatView}}">
                <Ellipse Style="{StaticResource VoiceRing}"
                         behaviors:AnimationOption.Ripple="{Binding Source={x:Reference Root}, Path=IsListening, x:DataType={x:Type controls:ChatView}}" />
                <Ellipse Style="{StaticResource VoiceRing}"
                         behaviors:AnimationOption.Ripple="{Binding Source={x:Reference Root}, Path=IsListening, x:DataType={x:Type controls:ChatView}}"
                         behaviors:AnimationOption.RippleDelay="900" />
                <Button Style="{StaticResource VoiceButton}"
                        Command="{Binding Source={x:Reference Root}, Path=VoiceCommand, x:DataType={x:Type controls:ChatView}}"
                        Text="{x:Static fonts:MaterialIcons.Mic}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Source={x:Reference Root}, Path=IsListening, x:DataType={x:Type controls:ChatView}}"
                                     Value="True">
                            <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Stop}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource RedDefault}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <Button Grid.Column="2"
                    Style="{StaticResource SendButton}"
                    Command="{Binding Source={x:Reference Root}, Path=SendCommand, x:DataType={x:Type controls:ChatView}}"
                    IsVisible="{Binding Source={x:Reference Root}, Path=IsResponding, Converter={StaticResource ReverseConverter}, x:DataType={x:Type controls:ChatView}}"
                    Text="{x:Static fonts:MaterialIcons.Send}" />
            <Button Grid.Column="2"
                    Style="{StaticResource CancelButton}"
                    Command="{Binding Source={x:Reference Root}, Path=CancelCommand, x:DataType={x:Type controls:ChatView}}"
                    IsVisible="{Binding Source={x:Reference Root}, Path=IsResponding, x:DataType={x:Type controls:ChatView}}"
                    Text="{x:Static fonts:MaterialIcons.Stop}" />
        </Grid>

    </Grid>
    <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->

</ContentView>
