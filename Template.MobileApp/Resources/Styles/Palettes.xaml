<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Series -->

    <x:Array x:Key="ChartPalette"
             Type="{x:Type Color}">
        <Color>#42A5F5</Color>
        <Color>#66BB6A</Color>
        <Color>#FFCA28</Color>
        <Color>#EC407A</Color>
        <Color>#26C6DA</Color>
        <Color>#7E57C2</Color>
        <Color>#FF7043</Color>
        <Color>#26A69A</Color>
        <Color>#5C6BC0</Color>
        <Color>#9CCC65</Color>
        <Color>#EF5350</Color>
        <Color>#78909C</Color>
    </x:Array>

    <!-- Scale -->

    <x:Array x:Key="ChartGreenScale"
             Type="{x:Type Color}">
        <Color>#1A66BB6A</Color>
        <Color>#66BB6A</Color>
        <Color>#2E7D32</Color>
    </x:Array>

    <x:Array x:Key="ChartBlueScale"
             Type="{x:Type Color}">
        <Color>#1A42A5F5</Color>
        <Color>#42A5F5</Color>
        <Color>#1565C0</Color>
    </x:Array>

</ResourceDictionary>
