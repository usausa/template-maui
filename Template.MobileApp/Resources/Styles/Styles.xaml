<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:s="http://smart/maui"
                    xmlns:shell="clr-namespace:Template.MobileApp.Shell"
                    xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
                    xmlns:controls="clr-namespace:Template.MobileApp.Controls"
                    xmlns:converters="clr-namespace:Template.MobileApp.Converters"
                    xmlns:fonts="clr-namespace:Fonts">

    <!-- ================================================================================ -->
    <!-- Value -->
    <!-- ================================================================================ -->

    <!-- Color -->

    <Color x:Key="PrimaryTextColor">#DE000000</Color>
    <Color x:Key="SecondaryTextColor">#99000000</Color>
    <Color x:Key="DisabledColor">#61000000</Color>
    <Color x:Key="BorderColor">#1F000000</Color>

    <Color x:Key="SelectFocusColor">#FFF9C4</Color>

    <Color x:Key="NoErrorColor">Transparent</Color>

    <!-- ================================================================================ -->
    <!-- Converter -->
    <!-- ================================================================================ -->

    <!-- Basic -->

    <s:ReverseConverter x:Key="ReverseConverter" />

    <s:NullToBoolConverter x:Key="NotEmptyConverter"
                           HandleEmptyString="True"
                           NullValue="False"
                           NonNullValue="True" />

    <s:CompareToBoolConverter x:Key="EqualsConverter"
                              Expression="{x:Static s:CompareExpressions.Equal}" />

    <s:CompareToBoolConverter x:Key="GreaterThanToBoolConverter"
                              Expression="{x:Static s:CompareExpressions.GreaterThan}" />

    <s:ColorToBrushConverter x:Key="ColorToBrushConverter" />

    <s:NullToBoolConverter x:Key="EmptyConverter"
                           HandleEmptyString="True"
                           NullValue="True"
                           NonNullValue="False" />

    <s:AllConverter x:Key="AllConverter" />

    <s:AnyConverter x:Key="AnyConverter" />

    <s:ToUpperConverter x:Key="ToUpperConverter" />

    <s:ToLowerConverter x:Key="ToLowerConverter" />

    <!-- Application -->

    <converters:MaskTextConverter x:Key="MaskTextConverter" />

    <converters:QrImageSourceConverter x:Key="QrImageSourceConverter" />

    <converters:DivideConverter x:Key="DivideConverter" />

    <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />

    <converters:BatteryIconConverter x:Key="BatteryIconConverter">
        <converters:BatteryIconConverter.Alert>
            <x:Static Member="fonts:MaterialIcons.Battery_alert" />
        </converters:BatteryIconConverter.Alert>
        <converters:BatteryIconConverter.Unknown>
            <x:Static Member="fonts:MaterialIcons.Battery_unknown" />
        </converters:BatteryIconConverter.Unknown>
        <converters:BatteryIconConverter.Charging>
            <x:Static Member="fonts:MaterialIcons.Battery_charging_full" />
        </converters:BatteryIconConverter.Charging>
        <converters:BatteryIconConverter.Full>
            <x:Static Member="fonts:MaterialIcons.Battery_full" />
        </converters:BatteryIconConverter.Full>
        <converters:BatteryIconConverter.Level6>
            <x:Static Member="fonts:MaterialIcons.Battery_6_bar" />
        </converters:BatteryIconConverter.Level6>
        <converters:BatteryIconConverter.Level5>
            <x:Static Member="fonts:MaterialIcons.Battery_5_bar" />
        </converters:BatteryIconConverter.Level5>
        <converters:BatteryIconConverter.Level4>
            <x:Static Member="fonts:MaterialIcons.Battery_4_bar" />
        </converters:BatteryIconConverter.Level4>
        <converters:BatteryIconConverter.Level3>
            <x:Static Member="fonts:MaterialIcons.Battery_3_bar" />
        </converters:BatteryIconConverter.Level3>
        <converters:BatteryIconConverter.Level2>
            <x:Static Member="fonts:MaterialIcons.Battery_2_bar" />
        </converters:BatteryIconConverter.Level2>
        <converters:BatteryIconConverter.Level1>
            <x:Static Member="fonts:MaterialIcons.Battery_1_bar" />
        </converters:BatteryIconConverter.Level1>
        <converters:BatteryIconConverter.Level0>
            <x:Static Member="fonts:MaterialIcons.Battery_0_bar" />
        </converters:BatteryIconConverter.Level0>
    </converters:BatteryIconConverter>

    <converters:BadgeCountConverter x:Key="BadgeCountConverter" />

    <s:BoolToTextConverter x:Key="ExpandGlyphConverter"
                           TrueValue="{x:Static fonts:MaterialIcons.Expand_less}"
                           FalseValue="{x:Static fonts:MaterialIcons.Expand_more}" />

    <s:BoolToTextConverter x:Key="ExpandAllGlyphConverter"
                           TrueValue="{x:Static fonts:MaterialIcons.Unfold_less}"
                           FalseValue="{x:Static fonts:MaterialIcons.Unfold_more}" />

    <!-- ================================================================================ -->
    <!-- Main -->
    <!-- ================================================================================ -->

    <Style x:Key="MainGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style x:Key="ContainerLayout"
           TargetType="AbsoluteLayout">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Header -->
    <!-- ================================================================================ -->

    <Style x:Key="HeaderGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken4}" />
    </Style>

    <Style x:Key="HeaderTitleLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeaderIconButton"
           TargetType="Button">
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Footer -->
    <!-- ================================================================================ -->

    <Style x:Key="FooterFlexLayout"
           TargetType="FlexLayout">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="JustifyContent" Value="SpaceBetween" />
    </Style>

    <Style x:Key="FooterInfoLabel"
           TargetType="Label">
        <Setter Property="Padding" Value="6,0,6,0" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Diagnostic -->
    <!-- ================================================================================ -->

    <Style x:Key="DiagnosticPanel"
           TargetType="shell:DiagnosticPanel">
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="SafeColor" Value="{StaticResource GreenDarken3}" />
        <Setter Property="WarningColor" Value="{StaticResource OrangeDarken3}" />
        <Setter Property="CriticalColor" Value="{StaticResource RedDarken3}" />
        <Setter Property="ZIndex" Value="999" />
    </Style>

    <Style x:Key="DiagnosticBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="Stroke" Value="LightGray" />
        <Setter Property="Shadow">
            <Shadow Offset="4,4"
                    Brush="Black"
                    Opacity="0.25"
                    Radius="4" />
        </Setter>
    </Style>

    <Style x:Key="DiagnosticValueLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="Black" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="DiagnosticSeparatorBoxView"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Color" Value="Gray" />
    </Style>

