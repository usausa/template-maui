<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <RootNamespace>Template.MobileApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>

    <!-- XA4301: BarcodeScanning.Native.Maui re-bundles libbarhopper_v3.so already provided by its MLKit dependency. Harmless duplicate, not fixable on the app side -->
    <NoWarn>$(NoWarn);XA4301</NoWarn>

    <!-- Display name -->
    <ApplicationTitle>Template</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>template.mobileapp</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <UseMonoRuntime>false</UseMonoRuntime>
  </PropertyGroup>
  -->

  <!--
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  -->

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
    <AndroidKeyStore>True</AndroidKeyStore>
    <AndroidSigningKeyStore>example.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>example</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>example</AndroidSigningKeyPass>
    <AndroidSigningStorePass>example</AndroidSigningStorePass>
  </PropertyGroup>

  <PropertyGroup>
    <EmbeddedFlavor>Development</EmbeddedFlavor>
    <EmbeddedApiEndPoint></EmbeddedApiEndPoint>
    <EmbeddedMonitorEndPoint></EmbeddedMonitorEndPoint>
    <EmbeddedGoogleMapsApiKey></EmbeddedGoogleMapsApiKey>
  </PropertyGroup>

  <Import Project="..\.EmbeddedProperty.props" Condition="Exists('..\.EmbeddedProperty.props')" />

  <PropertyGroup>
    <EmbeddedPropertyValues>
      Flavor=string:$(EmbeddedFlavor),
      ApiEndPoint=string:$(EmbeddedApiEndPoint),
      MonitorEndPoint=string:$(EmbeddedMonitorEndPoint),
      GoogleMapsApiKey=string:$(EmbeddedGoogleMapsApiKey)
    </EmbeddedPropertyValues>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.5" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="128,128" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\**" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- String resources -->
    <Compile Update="Resources\Strings\*.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>$([System.String]::Copy('%(FileName)').Replace('.Designer','.resx'))</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Resources\Strings\*.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>%(Filename).Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android')) == 'true'">
    <Compile Update="**\*.android.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.android',''))</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android')) == 'false'">
    <Compile Remove="**\*.android.cs" />
    <None Include="**\*.android.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.android',''))</DependentUpon>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-ios')) == 'true'">
    <Compile Update="**\*.ios.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.ios',''))</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-ios')) == 'false'">
    <Compile Remove="**\*.ios.cs" />
    <None Include="**\*.ios.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.ios',''))</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.Vision.Face" Version="1.0.0-beta.2" />
    <PackageReference Include="Azure.AI.Vision.ImageAnalysis" Version="1.0.0" />
    <PackageReference Include="BarcodeScanning.Native.Maui" Version="3.1.0" />
    <PackageReference Include="BunnyTail.DependencyInjection" Version="0.6.0" />
    <PackageReference Include="BunnyTail.EmbeddedBuildProperty" Version="1.19.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BunnyTail.MemberAccessor" Version="1.16.0" />
    <PackageReference Include="BunnyTail.XamlProperty.Maui" Version="1.2.0" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageReference Include="CommunityToolkit.Maui.Camera" Version="6.1.0" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Components.Maui" Version="1.42.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Indiko.Maui.Controls.Markdown" Version="1.10.0" />
    <PackageReference Include="Mapsui.Maui" Version="5.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="10.0.100" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.100" />
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
    <PackageReference Include="SkiaSharp" Version="4.151.2" />
    <PackageReference Include="SkiaSharp.Extended" Version="3.0.0" />
    <PackageReference Include="SkiaSharp.Extended.UI.Maui" Version="3.0.0" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.151.2" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
    <PackageReference Include="Plugin.Maui.DebugRainbows" Version="1.2.2">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Rester" Version="2.16.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Shiny.BluetoothLE" version="5.5.0" />
    <PackageReference Include="Shiny.BluetoothLE.Hosting" Version="5.5.0" />
    <PackageReference Include="Shiny.Hosting.Maui" Version="5.5.0" />
    <PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.11" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Usa.Smart.Converter" Version="2.16.0" />
    <PackageReference Include="Usa.Smart.Core" Version="2.19.0" />
    <PackageReference Include="Usa.Smart.Data" Version="2.11.0" />
    <PackageReference Include="Usa.Smart.Data.Accessor" Version="3.0.0-beta8" />
    <PackageReference Include="Usa.Smart.Data.Mapper" Version="2.16.0" />
    <PackageReference Include="Usa.Smart.Data.Mapper.Builders" Version="2.16.0" />
    <PackageReference Include="Usa.Smart.Mapper" Version="1.0.0-beta8" />
    <PackageReference Include="Usa.Smart.Maui" Version="2.25.0" />
    <PackageReference Include="Usa.Smart.Maui.Extensions" Version="2.25.0" />
    <PackageReference Include="Usa.Smart.Mvvm" Version="2.12.0" />
    <PackageReference Include="Usa.Smart.Navigation" Version="3.9.0" />
    <PackageReference Include="Usa.Smart.Navigation.Extensions.DependencyInjection" Version="3.9.0" />
    <PackageReference Include="Usa.Smart.Navigation.Maui" Version="3.9.0" />
    <PackageReference Include="Usa.Smart.Reactive" Version="2.15.0" />
    <PackageReference Include="Usa.Smart.Results" Version="2.2.0" />
    <PackageReference Include="Vitvov.Maui.PDFView" Version="1.8.4" />
    <!-- Xamarin.AndroidX.Fragment.Ktx: Shiny.Hosting.Maui and BarcodeScanning.Native.Maui still reference the old ktx package, so pin it to match Xamarin.AndroidX.Fragment 1.9.0 which merged those classes in -->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition.Japanese" Version="116.0.1.9" />
  </ItemGroup>

  <!-- Trimmer -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Template.MobileApp" />
    <TrimmerRootAssembly Include="Smart" />
    <TrimmerRootAssembly Include="Smart.Converter" />
    <TrimmerRootAssembly Include="Smart.Data" />
    <TrimmerRootAssembly Include="Smart.Data.Mapper" />
    <TrimmerRootAssembly Include="Smart.Data.Mapper.Builders" />
    <TrimmerRootAssembly Include="Smart.Mapper" />
    <TrimmerRootAssembly Include="Smart.Mvvm" />
    <TrimmerRootAssembly Include="Smart.Navigation" />
    <TrimmerRootAssembly Include="Smart.Navigation.Extensions.DependencyInjection" />
    <TrimmerRootAssembly Include="Smart.Navigation.Maui" />
    <TrimmerRootAssembly Include="Smart.Reactive" />
    <TrimmerRootAssembly Include="Smart.Maui" />
    <TrimmerRootAssembly Include="Smart.Maui.Extensions" />
    <TrimmerRootAssembly Include="MauiComponents" />
    <TrimmerRootAssembly Include="Renci.SshNet" />
    <TrimmerRootAssembly Include="BouncyCastle.Cryptography" />
  </ItemGroup>

</Project>
