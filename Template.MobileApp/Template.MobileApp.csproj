<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <RootNamespace>Template.MobileApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <!-- XA4301: BarcodeScanning.Native.Maui re-bundles libbarhopper_v3.so already provided by its MLKit dependency. Harmless duplicate, not fixable on the app side -->
    <NoWarn>$(NoWarn);XA4301</NoWarn>

    <!-- Display name -->
    <ApplicationTitle>Template</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>template.mobileapp</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>

    <!--
    <UseMaterial3>true</UseMaterial3>
    -->
  </PropertyGroup>

  <PropertyGroup>
    <MetricsSupport>true</MetricsSupport>
    <EventSourceSupport>true</EventSourceSupport>
  </PropertyGroup>

  <!--
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  -->

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-android|AnyCPU'">
    <AndroidKeyStore>True</AndroidKeyStore>
    <AndroidSigningKeyStore>example.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>example</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>example</AndroidSigningKeyPass>
    <AndroidSigningStorePass>example</AndroidSigningStorePass>
  </PropertyGroup>

  <PropertyGroup>
    <TextResourceLanguages>en;ja</TextResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <EmbeddedFlavor>Development</EmbeddedFlavor>
    <EmbeddedApiEndPoint></EmbeddedApiEndPoint>
    <EmbeddedMonitorEndPoint></EmbeddedMonitorEndPoint>
    <EmbeddedGoogleMapsApiKey></EmbeddedGoogleMapsApiKey>
  </PropertyGroup>

  <Import Project="..\.EmbeddedProperty.props" Condition="Exists('..\.EmbeddedProperty.props')" />

  <PropertyGroup>
    <EmbeddedPropertyValues>
      Flavor=string:$(EmbeddedFlavor),
      ApiEndPoint=string:$(EmbeddedApiEndPoint),
      MonitorEndPoint=string:$(EmbeddedMonitorEndPoint),
      GoogleMapsApiKey=string:$(EmbeddedGoogleMapsApiKey)
    </EmbeddedPropertyValues>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.5" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0D47A1" BaseSize="128,128" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\**" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android')) == 'true'">
    <Compile Update="**\*.android.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.android',''))</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android')) == 'false'">
    <Compile Remove="**\*.android.cs" />
    <None Include="**\*.android.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.android',''))</DependentUpon>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-ios')) == 'true'">
    <Compile Update="**\*.ios.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.ios',''))</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-ios')) == 'false'">
    <Compile Remove="**\*.ios.cs" />
    <None Include="**\*.ios.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.ios',''))</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.Vision.ImageAnalysis" Version="1.0.0" />
    <PackageReference Include="BarcodeScanning.Native.Maui" Version="3.1.0" />
    <PackageReference Include="BunnyTail.DependencyInjection" Version="2.0.0" />
    <PackageReference Include="BunnyTail.EmbeddedBuildProperty" Version="2.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BunnyTail.MemberAccessor" Version="2.0.0" />
    <PackageReference Include="BunnyTail.TextResource" Version="2.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BunnyTail.XamlProperty.Maui" Version="2.0.0" />
    <PackageReference Include="ClamCalendar" Version="4.0.0" />
    <PackageReference Include="ClamChart" Version="4.1.0" />
    <PackageReference Include="ClamGauge" Version="4.0.0" />
    <PackageReference Include="ClamGrid" Version="4.0.0" />
    <PackageReference Include="CommunityToolkit.Maui" Version="17.0.0" />
    <PackageReference Include="CommunityToolkit.Maui.Camera" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="12.0.0" />
    <PackageReference Include="GonFox.GameBoy.Core" Version="1.1.0" />
    <PackageReference Include="GonFox.GameBoy.Platform.Android" Version="1.1.0" />
    <PackageReference Include="GonFox.GameBoy.Platform.Shared" Version="1.1.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Components.Maui" Version="2.0.0" />
    <PackageReference Include="Components.Maui.Controls" Version="2.0.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Indiko.Maui.Controls.Markdown" Version="1.10.0" />
    <PackageReference Include="Mapsui.Maui" Version="5.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="11.0.10" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="11.0.10" />
    <PackageReference Include="Microsoft.ML" Version="6.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Mofucat.ReactiveHub" Version="2.0.0" />
    <PackageReference Include="OllamaSharp" Version="5.5.2" />
    <PackageReference Include="OpenTelemetry" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="SkiaExtension" Version="2.1.0" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.Extended" Version="3.0.0" />
    <PackageReference Include="SkiaSharp.Extended.UI.Maui" Version="3.0.0" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.157.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
    <PackageReference Include="Plugin.Maui.DebugRainbows" Version="1.2.2">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <PackageReference Include="Rester" Version="3.1.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
    <PackageReference Include="Shiny.BluetoothLE" version="6.6.0" />
    <PackageReference Include="Shiny.BluetoothLE.Hosting" Version="6.6.0" />
    <PackageReference Include="Shiny.Hosting.Maui" Version="6.6.0" />
    <PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.12" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Usa.Smart.ComponentModel.DataAnnotations" Version="2.0.0" />
    <PackageReference Include="Usa.Smart.Converter" Version="3.1.0" />
    <PackageReference Include="Usa.Smart.Core" Version="3.2.0" />
    <PackageReference Include="Usa.Smart.Data" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.Data.Accessor" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.Mapper" Version="1.1.0" />
    <PackageReference Include="Usa.Smart.Maui" Version="3.1.0" />
    <PackageReference Include="Usa.Smart.Maui.Extensions" Version="3.1.0" />
    <PackageReference Include="Usa.Smart.Mvvm" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.Navigation" Version="3.21.0" />
    <PackageReference Include="Usa.Smart.Navigation.Extensions.DependencyInjection" Version="3.21.0" />
    <PackageReference Include="Usa.Smart.Navigation.Maui" Version="3.21.0" />
    <PackageReference Include="Usa.Smart.Reactive" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.Results" Version="3.0.0" />
    <PackageReference Include="Vitvov.Maui.PDFView" Version="1.8.4" />
    <!-- Xamarin.AndroidX.Fragment.Ktx: Shiny.Hosting.Maui and BarcodeScanning.Native.Maui still reference the old ktx package, so pin it to match Xamarin.AndroidX.Fragment 1.9.0 which merged those classes in -->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.1" />
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition.Japanese" Version="116.0.1.9" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Services\Protos\*.proto" GrpcServices="Client" />
  </ItemGroup>

  <!-- Trimmer -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Template.MobileApp" />
    <TrimmerRootAssembly Include="Smart" />
    <TrimmerRootAssembly Include="Smart.Converter" />
    <TrimmerRootAssembly Include="Smart.Data" />
    <TrimmerRootAssembly Include="Smart.Data.Accessor" />
    <TrimmerRootAssembly Include="Smart.Mapper" />
    <TrimmerRootAssembly Include="Smart.Maui" />
    <TrimmerRootAssembly Include="Smart.Maui.Extensions" />
    <TrimmerRootAssembly Include="Smart.Mvvm" />
    <TrimmerRootAssembly Include="Smart.Navigation" />
    <TrimmerRootAssembly Include="Smart.Navigation.Extensions.DependencyInjection" />
    <TrimmerRootAssembly Include="Smart.Navigation.Maui" />
    <TrimmerRootAssembly Include="Smart.Reactive" />
    <TrimmerRootAssembly Include="Smart.Results" />
    <TrimmerRootAssembly Include="MauiComponents" />
    <TrimmerRootAssembly Include="MauiComponents.Controls" />
    <TrimmerRootAssembly Include="Renci.SshNet" />
    <TrimmerRootAssembly Include="BouncyCastle.Cryptography" />
  </ItemGroup>

</Project>
