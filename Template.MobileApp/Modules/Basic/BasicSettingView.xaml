<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Basic"
             x:Class="Template.MobileApp.Modules.Basic.BasicSettingView"
             x:DataType="{x:Type module:BasicSettingViewModel}"
             s:BindingContextResolver.Type="{x:Type module:BasicSettingViewModel}"
             shell:ShellProperty.Title="Setting"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="StepperValueLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource CardRowValueLabel}">
                <Setter Property="WidthRequest" Value="40" />
            </Style>

            <Style x:Key="FieldSearchBar"
                   TargetType="SearchBar">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="SearchIconColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="behaviors:EntryOption.NoBorder" Value="True" />
                <Setter Property="behaviors:Focus.FocusedStroke" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="FieldDatePicker"
                   TargetType="DatePicker">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="behaviors:EntryOption.NoBorder" Value="True" />
                <Setter Property="behaviors:Focus.FocusedStroke" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="FieldTimePicker"
                   TargetType="TimePicker">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="behaviors:EntryOption.NoBorder" Value="True" />
                <Setter Property="behaviors:Focus.FocusedStroke" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="OutlinedStepper"
                   TargetType="Stepper">
                <Setter Property="behaviors:StepperOption.Outlined" Value="True" />
            </Style>

            <Style x:Key="SummaryGrid"
                   TargetType="Grid"
                   BasedOn="{StaticResource CardInfoGrid}">
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>

            <Style x:Key="SummaryValueLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicBodyLabel}">
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="RowButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="BorderColor" Value="{StaticResource GrayLighten1}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
                                    <Setter Property="BorderColor" Value="{StaticResource GrayLighten3}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Account"
                               Icon="{x:Static fonts:MaterialIcons.Person}">
                <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="User name (Entry)" />
                    <Border Style="{StaticResource CardFieldBorder}">
                        <Entry Style="{StaticResource BasicFieldEntry}"
                               Text="{Binding UserName}" />
                    </Border>

                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="Search (SearchBar)" />
                    <Border Style="{StaticResource CardFieldBorder}">
                        <SearchBar Style="{StaticResource FieldSearchBar}"
                                   Text="{Binding SearchText}"
                                   Placeholder="Search settings"
                                   ReturnType="Search"
                                   SearchCommand="{Binding SearchCommand}" />
                    </Border>
                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           behaviors:AnimationOption.FadeInTrigger="{Binding LastSearch}"
                           IsVisible="{Binding LastSearch, Converter={StaticResource NotEmptyConverter}}"
                           Text="{Binding LastSearch, StringFormat='Searched: {0}'}" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="60"
                               Title="Display &amp; Sound"
                               Icon="{x:Static fonts:MaterialIcons.Tune}">
                <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="*,Auto,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource CardRowLabel}"
                               Text="Cache limit (Stepper)" />
                        <Label Grid.Column="1"
                               Style="{StaticResource CardRowValueLabel}"
                               Text="{Binding CacheSize, StringFormat='{0:F0} GB'}" />
                        <Stepper Grid.Column="2"
                                 Style="{StaticResource OutlinedStepper}"
                                 Value="{Binding CacheSize}"
                                 Minimum="1" Maximum="8"
                                 Increment="1" />
                    </Grid>

                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource CardRowLabel}"
                               Text="Volume (Slider)" />
                        <Slider Grid.Column="1"
                                Value="{Binding Volume}"
                                Minimum="0" Maximum="100" />
                        <Label Grid.Column="2"
                               Style="{StaticResource StepperValueLabel}"
                               Text="{Binding Volume, StringFormat='{0:F0}'}" />
                    </Grid>

                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource CardRowLabel}"
                               Text="Notification (Switch)" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding NotificationEnabled}"
                                OffColor="{StaticResource GrayLighten1}" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="120"
                               Title="Backup Schedule"
                               Icon="{x:Static fonts:MaterialIcons.Event}">
                <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="Date (DatePicker)" />
                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="*,Auto,Auto">
                        <Border Grid.Column="0"
                                Style="{StaticResource CardFieldBorder}">
                            <DatePicker Style="{StaticResource FieldDatePicker}"
                                        IsOpen="{Binding BackupDateOpen}"
                                        Date="{Binding BackupDate}" />
                        </Border>
                        <Button Grid.Column="1"
                                Style="{StaticResource RowButton}"
                                Command="{Binding OpenBackupDateCommand}"
                                Text="Open" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RowButton}"
                                Command="{Binding ClearBackupDateCommand}"
                                Text="Clear" />
                    </Grid>
                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="Time (TimePicker)" />
                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="*,Auto,Auto">
                        <Border Grid.Column="0"
                                Style="{StaticResource CardFieldBorder}">
                            <TimePicker Style="{StaticResource FieldTimePicker}"
                                        IsOpen="{Binding BackupTimeOpen}"
                                        Time="{Binding BackupTime}" />
                        </Border>
                        <Button Grid.Column="1"
                                Style="{StaticResource RowButton}"
                                Command="{Binding OpenBackupTimeCommand}"
                                Text="Open" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RowButton}"
                                Command="{Binding ClearBackupTimeCommand}"
                                Text="Clear" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="180"
                               Title="Quality &amp; Language"
                               Icon="{x:Static fonts:MaterialIcons.Language}">
                <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="Quality (RadioButton)" />
                    <HorizontalStackLayout Style="{StaticResource CardRowStack}"
                                           RadioButtonGroup.GroupName="Quality"
                                           RadioButtonGroup.SelectedValue="{Binding Quality, Mode=TwoWay}">
                        <RadioButton Value="low"
                                     Content="Low" />
                        <RadioButton Value="middle"
                                     Content="Medium" />
                        <RadioButton Value="high"
                                     Content="High" />
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="Language (Picker)" />
                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="*,Auto">
                        <Border Grid.Column="0"
                                Style="{StaticResource CardFieldBorder}">
                            <Picker Style="{StaticResource CardFieldPicker}"
                                    ItemsSource="{Binding Languages}"
                                    SelectedItem="{Binding Language}"
                                    IsOpen="{Binding LanguageOpen}" />
                        </Border>
                        <Button Grid.Column="1"
                                Style="{StaticResource RowButton}"
                                Command="{Binding OpenLanguageCommand}"
                                Text="Open" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="Summary"
                               Icon="{x:Static fonts:MaterialIcons.Fact_check}">
                <Grid Style="{StaticResource SummaryGrid}"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*">
                    <Label Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource BasicBodyLabel}"
                           Text="User" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource SummaryValueLabel}"
                           Text="{Binding UserName}" />
                    <Label Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource BasicBodyLabel}"
                           Text="Cache" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource SummaryValueLabel}"
                           Text="{Binding CacheSize, StringFormat='{0:F0} GB'}" />
                    <Label Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource BasicBodyLabel}"
                           Text="Volume" />
                    <Label Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource SummaryValueLabel}"
                           Text="{Binding Volume, StringFormat='{0:F0}'}" />
                    <Label Grid.Row="3" Grid.Column="0"
                           Style="{StaticResource BasicBodyLabel}"
                           Text="Backup" />
                    <Label Grid.Row="3" Grid.Column="1"
                           Style="{StaticResource SummaryValueLabel}"
                           Text="{Binding BackupDate, StringFormat='{0:yyyy/MM/dd}', TargetNullValue='-'}" />
                    <Label Grid.Row="4" Grid.Column="0"
                           Style="{StaticResource BasicBodyLabel}"
                           Text="Time" />
                    <Label Grid.Row="4" Grid.Column="1"
                           Style="{StaticResource SummaryValueLabel}"
                           Text="{Binding BackupTime, StringFormat='{0:hh\\:mm}', TargetNullValue='-'}" />
                    <Label Grid.Row="5" Grid.Column="0"
                           Style="{StaticResource BasicBodyLabel}"
                           Text="Quality" />
                    <Label Grid.Row="5" Grid.Column="1"
                           Style="{StaticResource SummaryValueLabel}"
                           Text="{Binding Quality}" />
                    <Label Grid.Row="6" Grid.Column="0"
                           Style="{StaticResource BasicBodyLabel}"
                           Text="Language" />
                    <Label Grid.Row="6" Grid.Column="1"
                           Style="{StaticResource SummaryValueLabel}"
                           Text="{Binding Language}" />
                </Grid>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
