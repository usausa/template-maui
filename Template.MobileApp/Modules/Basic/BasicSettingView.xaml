<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Basic"
             x:Class="Template.MobileApp.Modules.Basic.BasicSettingView"
             x:DataType="{x:Type module:BasicSettingViewModel}"
             s:BindingContextResolver.Type="{x:Type module:BasicSettingViewModel}"
             shell:ShellProperty.Title="Setting"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="StepperValueLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource CardRowValueLabel}">
                <Setter Property="WidthRequest" Value="40" />
            </Style>

            <Style x:Key="RowButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="BorderColor" Value="{StaticResource GrayLighten1}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
                                    <Setter Property="BorderColor" Value="{StaticResource GrayLighten3}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Account"
                               Icon="{x:Static fonts:MaterialIcons.Person}">
                <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="User name (Entry)" />
                    <Border Style="{StaticResource CardFieldBorder}">
                        <Entry Style="{StaticResource BasicFieldEntry}"
                               Text="{Binding UserName}"
                               ToolTipProperties.Text="表示に使う名前を入力します" />
                    </Border>

                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="Search (SearchBar)" />
                    <SearchBar Text="{Binding SearchText}"
                               Placeholder="設定を検索"
                               ToolTipProperties.Text="検索ボタンで確定します"
                               ReturnType="Search"
                               SearchCommand="{Binding SearchCommand}"
                               SearchIconColor="{StaticResource BlueDefault}" />
                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           behaviors:AnimationOption.FadeInTrigger="{Binding LastSearch}"
                           IsVisible="{Binding LastSearch, Converter={StaticResource NotEmptyConverter}}"
                           Text="{Binding LastSearch, StringFormat='検索実行: {0}'}" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="60"
                               Title="Display &amp; Sound"
                               Icon="{x:Static fonts:MaterialIcons.Tune}">
                <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="*,Auto,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource CardRowLabel}"
                               Text="キャッシュ上限 (Stepper)" />
                        <Label Grid.Column="1"
                               Style="{StaticResource CardRowValueLabel}"
                               Text="{Binding CacheSize, StringFormat='{0:F0} GB'}" />
                        <Stepper Grid.Column="2"
                                 Value="{Binding CacheSize}"
                                 Minimum="1" Maximum="8"
                                 ToolTipProperties.Text="ローカルキャッシュの上限サイズ"
                                 Increment="1" />
                    </Grid>

                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource CardRowLabel}"
                               Text="音量 (Slider)" />
                        <Slider Grid.Column="1"
                                Value="{Binding Volume}"
                                Minimum="0" Maximum="100"
                                ToolTipProperties.Text="通知音の音量" />
                        <Label Grid.Column="2"
                               Style="{StaticResource StepperValueLabel}"
                               Text="{Binding Volume, StringFormat='{0:F0}'}" />
                    </Grid>

                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource CardRowLabel}"
                               Text="通知 (Switch)" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding NotificationEnabled}"
                                ToolTipProperties.Text="プッシュ通知の有効/無効"
                                OffColor="{StaticResource GrayLighten1}" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="120"
                               Title="Backup Schedule"
                               Icon="{x:Static fonts:MaterialIcons.Event}">
                <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="*,Auto,Auto,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource CardRowLabel}"
                               Text="日付 (DatePicker)" />
                        <DatePicker Grid.Column="1"
                                    IsOpen="{Binding BackupDateOpen}"
                                    ToolTipProperties.Text="次回バックアップ日"
                                    Date="{Binding BackupDate}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RowButton}"
                                Command="{Binding OpenBackupDateCommand}"
                                Text="開く" />
                        <Button Grid.Column="3"
                                Style="{StaticResource RowButton}"
                                Command="{Binding ClearBackupDateCommand}"
                                Text="クリア" />
                    </Grid>
                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="*,Auto,Auto,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource CardRowLabel}"
                               Text="時刻 (TimePicker)" />
                        <TimePicker Grid.Column="1"
                                    IsOpen="{Binding BackupTimeOpen}"
                                    ToolTipProperties.Text="次回バックアップ時刻"
                                    Time="{Binding BackupTime}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RowButton}"
                                Command="{Binding OpenBackupTimeCommand}"
                                Text="開く" />
                        <Button Grid.Column="3"
                                Style="{StaticResource RowButton}"
                                Command="{Binding ClearBackupTimeCommand}"
                                Text="クリア" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="180"
                               Title="Quality &amp; Language"
                               Icon="{x:Static fonts:MaterialIcons.Language}">
                <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="画質 (RadioButton)" />
                    <HorizontalStackLayout Style="{StaticResource CardRowStack}"
                                           RadioButtonGroup.GroupName="Quality"
                                           RadioButtonGroup.SelectedValue="{Binding Quality, Mode=TwoWay}">
                        <RadioButton Value="low"
                                     Content="低" />
                        <RadioButton Value="middle"
                                     Content="中" />
                        <RadioButton Value="high"
                                     Content="高" />
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="言語 (Picker)" />
                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="*,Auto">
                        <Border Grid.Column="0"
                                Style="{StaticResource CardFieldBorder}">
                            <Picker Style="{StaticResource CardFieldPicker}"
                                    ItemsSource="{Binding Languages}"
                                    SelectedItem="{Binding Language}"
                                    IsOpen="{Binding LanguageOpen}"
                                    ToolTipProperties.Text="表示言語を選択します" />
                        </Border>
                        <Button Grid.Column="1"
                                Style="{StaticResource RowButton}"
                                Command="{Binding OpenLanguageCommand}"
                                Text="開く" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="Summary"
                               Icon="{x:Static fonts:MaterialIcons.Fact_check}">
                <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                    <Label Style="{StaticResource BasicBodyLabel}"
                           Text="{Binding UserName, StringFormat='ユーザー: {0}'}" />
                    <Label Style="{StaticResource BasicBodyLabel}"
                           Text="{Binding CacheSize, StringFormat='キャッシュ: {0:F0} GB'}" />
                    <Label Style="{StaticResource BasicBodyLabel}"
                           Text="{Binding Volume, StringFormat='音量: {0:F0}'}" />
                    <Label Style="{StaticResource BasicBodyLabel}"
                           Text="{Binding BackupDate, StringFormat='バックアップ: {0:yyyy/MM/dd}', TargetNullValue='バックアップ: 未設定'}" />
                    <Label Style="{StaticResource BasicBodyLabel}"
                           Text="{Binding BackupTime, StringFormat='時刻: {0:hh\\:mm}', TargetNullValue='時刻: 未設定'}" />
                    <Label Style="{StaticResource BasicBodyLabel}"
                           Text="{Binding Quality, StringFormat='画質: {0}'}" />
                    <Label Style="{StaticResource BasicBodyLabel}"
                           Text="{Binding Language, StringFormat='言語: {0}'}" />
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
