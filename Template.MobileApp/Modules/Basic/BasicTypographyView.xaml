<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Basic"
             x:Class="Template.MobileApp.Modules.Basic.BasicTypographyView"
             x:DataType="{x:Type module:BasicTypographyViewModel}"
             s:BindingContextResolver.Type="{x:Type module:BasicTypographyViewModel}"
             shell:ShellProperty.Title="Typography"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="SampleStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="4" />
            </Style>

            <Style x:Key="BandLabel"
                   TargetType="Label">
                <Setter Property="Padding" Value="8,0" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Semantic"
                               Icon="{x:Static fonts:MaterialIcons.Format_size}">
                <VerticalStackLayout Style="{StaticResource SampleStack}">
                    <Label Style="{StaticResource TitleLabel}"
                           Text="Title" />
                    <Label Style="{StaticResource HeaderLabel}"
                           Text="Header" />
                    <Label Style="{StaticResource GroupLabel}"
                           Text="Group" />
                    <Label Style="{StaticResource NameLabel}"
                           Text="Name" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="80"
                               Title="Left / Size / Color"
                               Icon="{x:Static fonts:MaterialIcons.Text_format}">
                <VerticalStackLayout Style="{StaticResource SampleStack}">
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelLeft, LabelMicro, LabelPrimary"
                           Text="Micro Primary" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelLeft, LabelSmall, LabelSecondary"
                           Text="Small Secondary" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelLeft, LabelMedium, LabelTertiary"
                           Text="Medium Tertiary" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelLeft, LabelLarge, LabelInformation"
                           Text="Large Information" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelLeft, LabelExtraLarge, LabelSuccess"
                           Text="ExtraLarge Success" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelLeft, LabelHuge, LabelWarning"
                           Text="Huge Warning" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="160"
                               Title="Center / Size / Color"
                               Icon="{x:Static fonts:MaterialIcons.Text_format}">
                <VerticalStackLayout Style="{StaticResource SampleStack}">
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelCenter, LabelMicro, LabelError"
                           Text="Micro Error" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelCenter, LabelSmall, LabelPrimary"
                           Text="Small Primary" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelCenter, LabelMedium, LabelSecondary"
                           Text="Medium Secondary" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelCenter, LabelLarge, LabelTertiary"
                           Text="Large Tertiary" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelCenter, LabelExtraLarge, LabelInformation"
                           Text="ExtraLarge Information" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelCenter, LabelHuge, LabelSuccess"
                           Text="Huge Success" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="Right / Size / Color"
                               Icon="{x:Static fonts:MaterialIcons.Text_format}">
                <VerticalStackLayout Style="{StaticResource SampleStack}">
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelRight, LabelMicro, LabelWarning"
                           Text="Micro Warning" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelRight, LabelSmall, LabelError"
                           Text="Small Error" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelRight, LabelMedium, LabelPrimary"
                           Text="Medium Primary" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelRight, LabelLarge, LabelSecondary"
                           Text="Large Secondary" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelRight, LabelExtraLarge, LabelTertiary"
                           Text="ExtraLarge Tertiary" />
                    <Label Style="{StaticResource BandLabel}"
                           StyleClass="LabelRight, LabelHuge, LabelInformation"
                           Text="Huge Information" />
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
