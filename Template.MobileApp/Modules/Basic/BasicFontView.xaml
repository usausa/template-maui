<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Basic"
             x:Class="Template.MobileApp.Modules.Basic.BasicFontView"
             x:DataType="{x:Type module:BasicFontViewModel}"
             s:BindingContextResolver.Type="{x:Type module:BasicFontViewModel}"
             shell:ShellProperty.Title="Font"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="MaterialIconSampleLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="FluentIconSampleLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="FluentUI" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextColor" Value="{StaticResource CyanDefault}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <!-- ReSharper disable MarkupAttributeTypo -->

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Default"
                               Icon="{x:Static fonts:MaterialIcons.Text_format}">
                <VerticalStackLayout Style="{StaticResource CardSmallContentStack}">
                    <Label Text="+(1234567890.) ABCDEF 金額履歴"
                           FontSize="12" />
                    <Label Text="+(1234567890.) ABCDEF 金額履歴"
                           FontSize="18" />
                    <Label Text="+(1234567890.) ABCDEF 金額履歴"
                           FontSize="24" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="60"
                               Title="OpenSansRegular"
                               Icon="{x:Static fonts:MaterialIcons.Font_download}">
                <VerticalStackLayout Style="{StaticResource CardSmallContentStack}">
                    <Label Text="+(1234567890.) ABCDEF"
                           FontFamily="OpenSansRegular" FontSize="12" />
                    <Label Text="+(1234567890.) ABCDEF"
                           FontFamily="OpenSansRegular" FontSize="18" />
                    <Label Text="+(1234567890.) ABCDEF"
                           FontFamily="OpenSansRegular" FontSize="24" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="120"
                               Title="OxaniumRegular"
                               Icon="{x:Static fonts:MaterialIcons.Font_download}">
                <VerticalStackLayout Style="{StaticResource CardSmallContentStack}">
                    <Label Text="+(1234567890.) ABCDEF"
                           FontFamily="OxaniumRegular" FontSize="12" />
                    <Label Text="+(1234567890.) ABCDEF"
                           FontFamily="OxaniumRegular" FontSize="18" />
                    <Label Text="+(1234567890.) ABCDEF"
                           FontFamily="OxaniumRegular" FontSize="24" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="180"
                               Title="Gkktt"
                               Icon="{x:Static fonts:MaterialIcons.Font_download}">
                <VerticalStackLayout Style="{StaticResource CardSmallContentStack}">
                    <Label Text="+(1234567890.) ABCDEF"
                           FontFamily="Gkktt" FontSize="12" />
                    <Label Text="+(1234567890.) ABCDEF"
                           FontFamily="Gkktt" FontSize="18" />
                    <Label Text="+(1234567890.) ABCDEF"
                           FontFamily="Gkktt" FontSize="24" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="DSEG7"
                               Icon="{x:Static fonts:MaterialIcons.Font_download}">
                <VerticalStackLayout Style="{StaticResource CardSmallContentStack}">
                    <Label Text="1234567890."
                           FontFamily="DSEG7" FontSize="12" />
                    <Label Text="1234567890."
                           FontFamily="DSEG7" FontSize="18" />
                    <Label Text="1234567890."
                           FontFamily="DSEG7" FontSize="24" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="JetBrainsMono"
                               Icon="{x:Static fonts:MaterialIcons.Font_download}">
                <VerticalStackLayout Style="{StaticResource CardSmallContentStack}">
                    <Label Text="+(1234567890.) ABCDEF =&gt; {}"
                           FontFamily="JetBrainsMono" FontSize="12" />
                    <Label Text="+(1234567890.) ABCDEF =&gt; {}"
                           FontFamily="JetBrainsMono" FontSize="18" />
                    <Label Text="+(1234567890.) ABCDEF =&gt; {}"
                           FontFamily="JetBrainsMono" FontSize="24" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="NotoSerifJP"
                               Icon="{x:Static fonts:MaterialIcons.Font_download}">
                <VerticalStackLayout Style="{StaticResource CardSmallContentStack}">
                    <Label Text="金額履歴 あいうえお 1234567890"
                           FontFamily="NotoSerifJP" FontSize="12" />
                    <Label Text="金額履歴 あいうえお 1234567890"
                           FontFamily="NotoSerifJP" FontSize="18" />
                    <Label Text="金額履歴 あいうえお 1234567890"
                           FontFamily="NotoSerifJP" FontSize="24" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="MaterialIcons"
                               Icon="{x:Static fonts:MaterialIcons.Palette}">
                <HorizontalStackLayout Style="{StaticResource CardRowStack}">
                    <Label Style="{StaticResource MaterialIconSampleLabel}"
                           Text="{x:Static fonts:MaterialIcons.Stay_current_portrait}" />
                    <Label Style="{StaticResource MaterialIconSampleLabel}"
                           Text="{x:Static fonts:MaterialIcons.Create}" />
                    <Label Style="{StaticResource MaterialIconSampleLabel}"
                           Text="{x:Static fonts:MaterialIcons.Save_alt}" />
                    <Label Style="{StaticResource MaterialIconSampleLabel}"
                           Text="{x:Static fonts:MaterialIcons.Bluetooth}" />
                    <Label Style="{StaticResource MaterialIconSampleLabel}"
                           Text="{x:Static fonts:MaterialIcons.Cloud_download}" />
                    <Label Style="{StaticResource MaterialIconSampleLabel}"
                           Text="{x:Static fonts:MaterialIcons.Cloud_upload}" />
                    <Label Style="{StaticResource MaterialIconSampleLabel}"
                           Text="{x:Static fonts:MaterialIcons.Phone_android}" />
                    <Label Style="{StaticResource MaterialIconSampleLabel}"
                           Text="{x:Static fonts:MaterialIcons.Camera_alt}" />
                    <Label Style="{StaticResource MaterialIconSampleLabel}"
                           Text="{x:Static fonts:MaterialIcons.Favorite}" />
                    <Label Style="{StaticResource MaterialIconSampleLabel}"
                           Text="{x:Static fonts:MaterialIcons.Favorite_outline}" />
                </HorizontalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="FluentUI"
                               Icon="{x:Static fonts:MaterialIcons.Palette}">
                <HorizontalStackLayout Style="{StaticResource CardRowStack}">
                    <Label Style="{StaticResource FluentIconSampleLabel}"
                           Text="{x:Static fonts:FluentUI.add_circle_28_regular}" />
                    <Label Style="{StaticResource FluentIconSampleLabel}"
                           Text="{x:Static fonts:FluentUI.save_28_regular}" />
                    <Label Style="{StaticResource FluentIconSampleLabel}"
                           Text="{x:Static fonts:FluentUI.bluetooth_28_regular}" />
                    <Label Style="{StaticResource FluentIconSampleLabel}"
                           Text="{x:Static fonts:FluentUI.phone_28_regular}" />
                    <Label Style="{StaticResource FluentIconSampleLabel}"
                           Text="{x:Static fonts:FluentUI.camera_28_regular}" />
                    <Label Style="{StaticResource FluentIconSampleLabel}"
                           Text="{x:Static fonts:FluentUI.heart_28_regular}" />
                    <Label Style="{StaticResource FluentIconSampleLabel}"
                           Text="{x:Static fonts:FluentUI.star_28_regular}" />
                </HorizontalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="ImageSource"
                               Icon="{x:Static fonts:MaterialIcons.Palette}">
                <HorizontalStackLayout Style="{StaticResource CardRowStack}">
                    <Image>
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Error}"
                                             FontFamily="MaterialIcons"
                                             Color="{StaticResource RedDefault}"
                                             Size="28" />
                        </Image.Source>
                    </Image>
                    <Image>
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Warning}"
                                             FontFamily="MaterialIcons"
                                             Color="{StaticResource OrangeDefault}"
                                             Size="28" />
                        </Image.Source>
                    </Image>
                </HorizontalStackLayout>
            </controls:InfoCard>

            <!-- ReSharper restore MarkupAttributeTypo -->

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
