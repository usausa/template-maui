<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Basic"
             xmlns:strings="clr-namespace:Template.MobileApp.Resources.Strings"
             x:Class="Template.MobileApp.Modules.Basic.BasicLocaleView"
             x:DataType="{x:Type module:BasicLocaleViewModel}"
             s:BindingContextResolver.Type="{x:Type module:BasicLocaleViewModel}"
             shell:ShellProperty.Title="Locale"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="CurrentValueLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource CardStrongValueLabel}">
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="ResourceTagLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="CultureNameStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="CurrentChipBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 9" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="CurrentChipLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="White" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Current culture"
                               Icon="{x:Static fonts:MaterialIcons.Language}">
                <Grid Style="{StaticResource CardInfoGrid}"
                      RowDefinitions="Auto,Auto"
                      ColumnDefinitions="2*,3*">
                    <Label Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource NameLabel}"
                           Text="Culture" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource ValueLabel}"
                           Text="{Binding CultureName}" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource NameLabel}"
                           Text="UICulture" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource ValueLabel}"
                           Text="{Binding UICultureName}" />
                </Grid>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="100"
                               Title="Localized resources"
                               Icon="{x:Static fonts:MaterialIcons.Translate}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <VerticalStackLayout Style="{StaticResource CardContentStack}"
                                         BindableLayout.ItemsSource="{Binding ResourceEntries}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type module:ResourceEntry}">
                                <VerticalStackLayout Style="{StaticResource BasicTextGroupStack}">
                                    <Label Style="{StaticResource BasicMonoLabel}"
                                           Text="{Binding Key}" />
                                    <Grid Style="{StaticResource CardInfoGrid}"
                                          RowDefinitions="Auto,Auto,Auto"
                                          ColumnDefinitions="72,*">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource ResourceTagLabel}"
                                               Text="neutral" />
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Style="{StaticResource CardPrimaryValueLabel}"
                                               Text="{Binding NeutralValue}" />
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource ResourceTagLabel}"
                                               Text="ja" />
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Style="{StaticResource CardPrimaryValueLabel}"
                                               Text="{Binding JapaneseValue}" />
                                        <Label Grid.Row="2" Grid.Column="0"
                                               Style="{StaticResource ResourceTagLabel}"
                                               Text="current" />
                                        <Label Grid.Row="2" Grid.Column="1"
                                               Style="{StaticResource CurrentValueLabel}"
                                               Text="{Binding CurrentValue}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource CardDivider}" />
                    <VerticalStackLayout Style="{StaticResource BasicTextGroupStack}">
                        <Label Style="{StaticResource BasicMonoLabel}"
                               Text="x:Static reference" />
                        <Label Style="{StaticResource CardPrimaryValueLabel}"
                               Text="{x:Static strings:Messages.Hello_World}" />
                    </VerticalStackLayout>
                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="Values switch with the system language (en / ja resx)" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="200"
                               Title="Culture formats"
                               Icon="{x:Static fonts:MaterialIcons.Public}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <VerticalStackLayout Style="{StaticResource CardLargeContentStack}"
                                         BindableLayout.ItemsSource="{Binding FormatEntries}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type module:CultureFormatEntry}">
                                <VerticalStackLayout Style="{StaticResource BasicTextGroupStack}">
                                    <HorizontalStackLayout Style="{StaticResource CultureNameStack}">
                                        <Label Style="{StaticResource BasicSubtitleLabel}"
                                               Text="{Binding Name}" />
                                        <Border Style="{StaticResource CurrentChipBorder}"
                                                IsVisible="{Binding IsCurrent}">
                                            <Label Style="{StaticResource CurrentChipLabel}"
                                                   Text="current" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Grid Style="{StaticResource CardInfoGrid}"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="72,*">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource ResourceTagLabel}"
                                               Text="Number" />
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Style="{StaticResource CardPrimaryValueLabel}"
                                               Text="{Binding Number}" />
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource ResourceTagLabel}"
                                               Text="Currency" />
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Style="{StaticResource CardPrimaryValueLabel}"
                                               Text="{Binding Currency}" />
                                        <Label Grid.Row="2" Grid.Column="0"
                                               Style="{StaticResource ResourceTagLabel}"
                                               Text="Date" />
                                        <Label Grid.Row="2" Grid.Column="1"
                                               Style="{StaticResource CardPrimaryValueLabel}"
                                               Text="{Binding Date}" />
                                        <Label Grid.Row="3" Grid.Column="0"
                                               Style="{StaticResource ResourceTagLabel}"
                                               Text="Time" />
                                        <Label Grid.Row="3" Grid.Column="1"
                                               Style="{StaticResource CardPrimaryValueLabel}"
                                               Text="{Binding Time}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
