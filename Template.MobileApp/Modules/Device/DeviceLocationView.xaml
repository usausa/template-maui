<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Device"
             x:Class="Template.MobileApp.Modules.Device.DeviceLocationView"
             x:DataType="{x:Type module:DeviceLocationViewModel}"
             s:BindingContextResolver.Type="{x:Type module:DeviceLocationViewModel}"
             shell:ShellProperty.Title="Location"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="CoordGrid"
                   TargetType="Grid">
                <Setter Property="RowSpacing" Value="12" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="ValueUnitStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="4" />
            </Style>

            <Style x:Key="UnitLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
            </Style>

            <Style x:Key="CoordValueLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken3}" />
            </Style>

            <Style x:Key="TimestampIcon"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken1}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="TimestampLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicMonoLabel}">
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid Style="{StaticResource RootGrid}"
          RowDefinitions="240,*">

        <!-- 現在地マップ(タイル表示には Google Maps API キーの設定が必要) -->
        <maps:Map Grid.Row="0"
                  behaviors:MapBind.Controller="{Binding Controller}"
                  IsShowingUser="True" />

        <!-- 測位待ちの空状態 -->
        <VerticalStackLayout Grid.Row="1"
                             Style="{StaticResource BasicEmptyStack}"
                             IsVisible="{Binding Location, Converter={StaticResource EmptyConverter}}">
            <Grid Style="{StaticResource BasicRippleGrid}">
                <Ellipse Style="{StaticResource BasicRippleRing}"
                         behaviors:AnimationOption.Ripple="True" />
                <Ellipse Style="{StaticResource BasicRippleRing}"
                         behaviors:AnimationOption.Ripple="True"
                         behaviors:AnimationOption.RippleDelay="900" />
                <Border Style="{StaticResource BasicIconCircleBorder}">
                    <Label Style="{StaticResource BasicIconCircleLabel}"
                           Text="{x:Static fonts:MaterialIcons.My_location}" />
                </Border>
            </Grid>
            <Label Style="{StaticResource BasicCenterTitleLabel}"
                   Text="Acquiring location..." />
            <Label Style="{StaticResource BasicCenterHintLabel}"
                   Text="Waiting for GPS fix" />
            <Label Style="{StaticResource BasicCenterHintLabel}"
                   IsVisible="{Binding ServiceDisabled}"
                   Text="Location service is disabled" />
        </VerticalStackLayout>

        <!-- 測位結果 -->
        <ScrollView Grid.Row="1"
                    IsVisible="{Binding Location, Converter={StaticResource NotEmptyConverter}}">
            <VerticalStackLayout Style="{StaticResource PageStack}">

                <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                                   Title="Position"
                                   Icon="{x:Static fonts:MaterialIcons.My_location}">
                    <VerticalStackLayout Style="{StaticResource CardContentStack}">
                        <Grid Style="{StaticResource CoordGrid}"
                              ColumnDefinitions="*,*">
                            <VerticalStackLayout Grid.Column="0"
                                                 Style="{StaticResource BasicTextGroupStack}">
                                <Label Style="{StaticResource BasicFieldCaptionLabel}"
                                       Text="Latitude" />
                                <Label Style="{StaticResource CoordValueLabel}"
                                       Text="{Binding Location.Latitude, StringFormat='{0:F6}', FallbackValue='-'}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Style="{StaticResource BasicTextGroupStack}">
                                <Label Style="{StaticResource BasicFieldCaptionLabel}"
                                       Text="Longitude" />
                                <Label Style="{StaticResource CoordValueLabel}"
                                       Text="{Binding Location.Longitude, StringFormat='{0:F6}', FallbackValue='-'}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource CardDivider}" />
                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0"
                                   Style="{StaticResource TimestampIcon}"
                                   Text="{x:Static fonts:MaterialIcons.Schedule}" />
                            <!-- ReSharper disable Xaml.PossibleNullReferenceException -->
                            <Label Grid.Column="1"
                                   Style="{StaticResource TimestampLabel}"
                                   behaviors:AnimationOption.HighlightColor="{StaticResource AmberLighten4}"
                                   behaviors:AnimationOption.HighlightTrigger="{Binding Location.Timestamp}"
                                   Text="{Binding Location.Timestamp.LocalDateTime, StringFormat='{0:yyyy-MM-dd HH:mm:ss}', FallbackValue='-'}" />
                            <!-- ReSharper restore Xaml.PossibleNullReferenceException -->
                        </Grid>
                    </VerticalStackLayout>
                </controls:InfoCard>

                <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                                   behaviors:AnimationOption.EnterDelay="100"
                                   Title="Motion"
                                   Icon="{x:Static fonts:MaterialIcons.Directions_run}">
                    <Grid Style="{StaticResource CoordGrid}"
                          RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0"
                                             Style="{StaticResource BasicTextGroupStack}">
                            <Label Style="{StaticResource BasicFieldCaptionLabel}"
                                   Text="Altitude" />
                            <HorizontalStackLayout Style="{StaticResource ValueUnitStack}">
                                <Label Style="{StaticResource CoordValueLabel}"
                                       Text="{Binding Location.Altitude, StringFormat='{0:F1}', TargetNullValue='-', FallbackValue='-'}" />
                                <Label Style="{StaticResource UnitLabel}"
                                       IsVisible="{Binding Location.Altitude, Converter={StaticResource NotEmptyConverter}, FallbackValue=False}"
                                       Text="m" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource BasicTextGroupStack}">
                            <Label Style="{StaticResource BasicFieldCaptionLabel}"
                                   Text="Course" />
                            <HorizontalStackLayout Style="{StaticResource ValueUnitStack}">
                                <Label Style="{StaticResource CoordValueLabel}"
                                       Text="{Binding Location.Course, StringFormat='{0:F0}', TargetNullValue='-', FallbackValue='-'}" />
                                <Label Style="{StaticResource UnitLabel}"
                                       IsVisible="{Binding Location.Course, Converter={StaticResource NotEmptyConverter}, FallbackValue=False}"
                                       Text="°" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0"
                                             Style="{StaticResource BasicTextGroupStack}">
                            <Label Style="{StaticResource BasicFieldCaptionLabel}"
                                   Text="Speed" />
                            <HorizontalStackLayout Style="{StaticResource ValueUnitStack}">
                                <Label Style="{StaticResource CoordValueLabel}"
                                       Text="{Binding Location.Speed, StringFormat='{0:F1}', TargetNullValue='-', FallbackValue='-'}" />
                                <Label Style="{StaticResource UnitLabel}"
                                       IsVisible="{Binding Location.Speed, Converter={StaticResource NotEmptyConverter}, FallbackValue=False}"
                                       Text="m/s" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                                             Style="{StaticResource BasicTextGroupStack}">
                            <Label Style="{StaticResource BasicFieldCaptionLabel}"
                                   Text="Accuracy" />
                            <HorizontalStackLayout Style="{StaticResource ValueUnitStack}">
                                <Label Style="{StaticResource CoordValueLabel}"
                                       Text="{Binding Location.Accuracy, StringFormat='±{0:F0}', TargetNullValue='-', FallbackValue='-'}" />
                                <Label Style="{StaticResource UnitLabel}"
                                       IsVisible="{Binding Location.Accuracy, Converter={StaticResource NotEmptyConverter}, FallbackValue=False}"
                                       Text="m" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </controls:InfoCard>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentView>
