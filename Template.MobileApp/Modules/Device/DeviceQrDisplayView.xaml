<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Device"
             x:Class="Template.MobileApp.Modules.Device.DeviceQrDisplayView"
             x:DataType="{x:Type module:DeviceQrDisplayViewModel}"
             s:BindingContextResolver.Type="{x:Type module:DeviceQrDisplayViewModel}"
             shell:ShellProperty.Title="QR Display"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="QrPlaceholderIconLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicIconCircleLabel}">
                <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
            </Style>

            <Style x:Key="QrCardBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource CardCenterBorder}">
                <Setter Property="Margin" Value="0" />
            </Style>

            <Style x:Key="QrEmptyStack"
                   TargetType="VerticalStackLayout"
                   BasedOn="{StaticResource BasicEmptyStack}">
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="QrLayoutGrid"
                   TargetType="Grid"
                   BasedOn="{StaticResource RootGrid}">
                <Setter Property="Padding" Value="16" />
                <Setter Property="RowSpacing" Value="16" />
            </Style>

            <Style x:Key="QrFrameBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="QrFrameGrid"
                   TargetType="Grid">
                <Setter Property="WidthRequest" Value="280" />
                <Setter Property="HeightRequest" Value="280" />
            </Style>

            <Style x:Key="EncodedTextLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid Style="{StaticResource QrLayoutGrid}"
          RowDefinitions="*,Auto">

        <Border Grid.Row="0"
                Style="{StaticResource QrCardBorder}"
                behaviors:AnimationOption.EnterAnimation="FadeUp">
            <VerticalStackLayout Style="{StaticResource CardStack}">

                <Border Style="{StaticResource QrFrameBorder}">
                    <Grid Style="{StaticResource QrFrameGrid}">
                        <Image Source="{Binding Text, Converter={StaticResource QrImageSourceConverter}}"
                               IsVisible="{Binding Text, Converter={StaticResource NotEmptyConverter}}" />
                        <VerticalStackLayout Style="{StaticResource QrEmptyStack}"
                                             IsVisible="{Binding Text, Converter={StaticResource EmptyConverter}}">
                            <Label Style="{StaticResource QrPlaceholderIconLabel}"
                                   Text="{x:Static fonts:MaterialIcons.Qr_code_2}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Style="{StaticResource EncodedTextLabel}"
                       Text="{Binding Text}" />

            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource QrCardBorder}"
                behaviors:AnimationOption.EnterAnimation="FadeUp">
            <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                <Label Style="{StaticResource BasicFieldCaptionLabel}"
                       Text="Content" />
                <Border Style="{StaticResource CardFieldBorder}">
                    <Entry Style="{StaticResource BasicFieldEntry}"
                           Text="{Binding Text}"
                           Placeholder="Text to encode" />
                </Border>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentView>
