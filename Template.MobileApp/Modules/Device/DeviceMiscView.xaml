<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Device"
             x:Class="Template.MobileApp.Modules.Device.DeviceMiscView"
             x:DataType="{x:Type module:DeviceMiscViewModel}"
             s:BindingContextResolver.Type="{x:Type module:DeviceMiscViewModel}"
             shell:ShellProperty.Title="Misc"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="SpeechRateLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource ValueLabel}">
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="ListeningIcon"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="{StaticResource RedDefault}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Screen"
                               Icon="{x:Static fonts:MaterialIcons.Smartphone}">
                <VerticalStackLayout Style="{StaticResource CardActionStack}">
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding KeepScreenOnCommand}"
                                Text="Keep on"
                                ImageSource="{x:Static markup:AppIcons.SmallVisibility}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding KeepScreenOffCommand}"
                                Text="Keep off"
                                ImageSource="{x:Static markup:AppIcons.SmallVisibilityOff}" />
                    </Grid>
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding OrientationPortraitCommand}"
                                Text="Portrait"
                                ImageSource="{x:Static markup:AppIcons.SmallStayCurrentPortrait}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding OrientationLandscapeCommand}"
                                Text="Landscape"
                                ImageSource="{x:Static markup:AppIcons.SmallStayCurrentLandscape}" />
                    </Grid>
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding BrightnessCommand}"
                                CommandParameter="{s:Float Value=0.0}"
                                Text="Bright 0"
                                ImageSource="{x:Static markup:AppIcons.SmallBrightnessLow}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding BrightnessCommand}"
                                CommandParameter="{s:Float Value=1.0}"
                                Text="Bright 1"
                                ImageSource="{x:Static markup:AppIcons.SmallBrightnessHigh}" />
                    </Grid>
                    <Button Style="{StaticResource BasicIconOutlinedButton}"
                            Command="{Binding ScreenshotCommand}"
                            Text="Screenshot"
                            ImageSource="{x:Static markup:AppIcons.SmallScreenshot}" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="80"
                               Title="Feedback"
                               Icon="{x:Static fonts:MaterialIcons.Vibration}">
                <VerticalStackLayout Style="{StaticResource CardActionStack}">
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding VibrateCommand}"
                                Text="Vibrate"
                                ImageSource="{x:Static markup:AppIcons.SmallVibration}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding VibrateCancelCommand}"
                                Text="Cancel"
                                ImageSource="{x:Static markup:AppIcons.SmallDoNotDisturb}" />
                    </Grid>
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding FeedbackClickCommand}"
                                Text="Feed click"
                                ImageSource="{x:Static markup:AppIcons.SmallTouchApp}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding FeedbackLongPressCommand}"
                                Text="Feed press"
                                ImageSource="{x:Static markup:AppIcons.SmallTouchApp}" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="160"
                               Title="Light"
                               Icon="{x:Static fonts:MaterialIcons.Flashlight_on}">
                <Grid Style="{StaticResource BasicButtonGrid}"
                      ColumnDefinitions="*,*">
                    <Button Grid.Column="0"
                            Style="{StaticResource BasicIconOutlinedButton}"
                            Command="{Binding LightOnCommand}"
                            Text="Light on"
                            ImageSource="{x:Static markup:AppIcons.SmallFlashlightOn}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource BasicIconOutlinedButton}"
                            Command="{Binding LightOffCommand}"
                            Text="Light off"
                            ImageSource="{x:Static markup:AppIcons.SmallFlashlightOff}" />
                </Grid>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="Speech"
                               Icon="{x:Static fonts:MaterialIcons.Record_voice_over}">
                <VerticalStackLayout Style="{StaticResource CardActionStack}">
                    <!-- SpeechOptions.Rate (0.1〜2.0) -->
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource BasicItemValueLabel}"
                               Text="Rate" />
                        <Slider Grid.Column="1"
                                Value="{Binding SpeechRate}"
                                Minimum="0.5" Maximum="2.0" />
                        <Label Grid.Column="2"
                               Style="{StaticResource SpeechRateLabel}"
                               Text="{Binding SpeechRate, StringFormat='{0:F1}x'}" />
                    </Grid>
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding SpeakCommand}"
                                Text="Speak"
                                ImageSource="{x:Static markup:AppIcons.SmallRecordVoiceOver}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding SpeakCancelCommand}"
                                Text="Cancel"
                                ImageSource="{x:Static markup:AppIcons.SmallVoiceOverOff}" />
                    </Grid>
                    <Button Style="{StaticResource BasicIconOutlinedButton}"
                            Command="{Binding RecognizeCommand}"
                            Text="{Binding IsListening, Converter={s:BoolToText True='Stop', False='Recognize'}}"
                            ImageSource="{x:Static markup:AppIcons.SmallMic}" />

                    <Grid Style="{StaticResource CardRowGrid}"
                          ColumnDefinitions="Auto,*"
                          IsVisible="{Binding IsListening}">
                        <Label Grid.Column="0"
                               Style="{StaticResource ListeningIcon}"
                               behaviors:AnimationOption.Pulse="True"
                               Text="{x:Static fonts:MaterialIcons.Mic}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource BasicItemValueLabel}"
                               Text="Listening..." />
                    </Grid>

                    <Label Style="{StaticResource CardPrimaryValueLabel}"
                           behaviors:AnimationOption.FadeInTrigger="{Binding RecognizeText}"
                           IsVisible="{Binding RecognizeText, Converter={StaticResource NotEmptyConverter}}"
                           Text="{Binding RecognizeText}" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <!-- ローカル通知 (自作 NotificationService)。即時 (アクションボタン付き) / 10 秒後 / 取消 / 正確なアラームの許可設定 -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="400"
                               Title="Notification"
                               Icon="{x:Static fonts:MaterialIcons.Notifications}">
                <VerticalStackLayout Style="{StaticResource CardActionStack}">
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding NotifyCommand}"
                                Text="Notify"
                                ImageSource="{x:Static markup:AppIcons.SmallNotifications}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding NotifyScheduleCommand}"
                                Text="Schedule"
                                ImageSource="{x:Static markup:AppIcons.SmallAlarm}" />
                    </Grid>
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding NotifyCancelCommand}"
                                Text="Cancel"
                                ImageSource="{x:Static markup:AppIcons.SmallNotificationsOff}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding NotifyExactSettingCommand}"
                                Text="Exact alarm"
                                ImageSource="{x:Static markup:AppIcons.SmallAlarmOn}" />
                    </Grid>
                    <Label Style="{StaticResource CardPrimaryValueLabel}"
                           behaviors:AnimationOption.FadeInTrigger="{Binding NotificationText}"
                           IsVisible="{Binding NotificationText, Converter={StaticResource NotEmptyConverter}}"
                           Text="{Binding NotificationText}" />
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
