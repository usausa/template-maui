<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Device"
             x:Class="Template.MobileApp.Modules.Device.DeviceBleHostView"
             x:DataType="{x:Type module:DeviceBleHostViewModel}"
             s:BindingContextResolver.Type="{x:Type module:DeviceBleHostViewModel}"
             shell:ShellProperty.Title="BLE Host"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function4Text="{Binding Running, Converter={s:BoolToText True='OFF', False='ON'}}"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="UserIdValueLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicMonoLabel}">
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="StateChip"
                   TargetType="controls:StatusChip">
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="RadioRingGrid"
                   TargetType="Grid">
                <Setter Property="WidthRequest" Value="150" />
                <Setter Property="HeightRequest" Value="150" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="RadioRing"
                   TargetType="Ellipse">
                <Setter Property="WidthRequest" Value="96" />
                <Setter Property="HeightRequest" Value="96" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Stroke" Value="{StaticResource GreenDefault}" />
                <Setter Property="StrokeThickness" Value="3" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="InputTransparent" Value="True" />
            </Style>

            <Style x:Key="RadioIconBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource BasicIconCircleBorder}">
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <Grid Style="{StaticResource RootGrid}">

        <Border Style="{StaticResource CardCenterBorder}"
                behaviors:AnimationOption.EnterAnimation="FadeUp">
            <VerticalStackLayout Style="{StaticResource CardStack}">

                <Grid Style="{StaticResource RadioRingGrid}">
                    <Ellipse Style="{StaticResource RadioRing}"
                             behaviors:AnimationOption.Ripple="{Binding Running}" />
                    <Ellipse Style="{StaticResource RadioRing}"
                             behaviors:AnimationOption.Ripple="{Binding Running}"
                             behaviors:AnimationOption.RippleDelay="900" />
                    <Border Style="{StaticResource RadioIconBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding Running}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource GreenLighten4}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Style="{StaticResource BasicIconCircleLabel}"
                               Text="{x:Static fonts:MaterialIcons.Podcasts}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding Running}"
                                             Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource GreenDarken2}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>

                <Label Style="{StaticResource BasicCenterTitleLabel}"
                       Text="BLE Peripheral" />

                <controls:StatusChip Style="{StaticResource StateChip}"
                                     Icon="{x:Static fonts:MaterialIcons.Podcasts}"
                                     Text="Stopped">
                    <controls:StatusChip.Triggers>
                        <DataTrigger TargetType="controls:StatusChip"
                                     Binding="{Binding Running}"
                                     Value="True">
                            <Setter Property="Text" Value="Advertising" />
                            <Setter Property="ChipColor" Value="{StaticResource GreenLighten4}" />
                            <Setter Property="IconColor" Value="{StaticResource GreenDarken2}" />
                            <Setter Property="TextColor" Value="{StaticResource GreenDarken2}" />
                        </DataTrigger>
                    </controls:StatusChip.Triggers>
                </controls:StatusChip>

                <BoxView Style="{StaticResource CardDivider}" />

                <VerticalStackLayout Style="{StaticResource BasicTextGroupStack}">
                    <Label Style="{StaticResource BasicCenterFieldCaptionLabel}"
                           Text="UserId" />
                    <Label Style="{StaticResource UserIdValueLabel}"
                           Text="{Binding UserId}" />
                </VerticalStackLayout>

                <Label Style="{StaticResource BasicCenterHintLabel}"
                       Text="Toggle advertising with the ON/OFF key" />

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentView>
