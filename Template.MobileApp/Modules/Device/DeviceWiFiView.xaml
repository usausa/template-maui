<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Device"
             xmlns:components="clr-namespace:MauiComponents;assembly=MauiComponents"
             x:Class="Template.MobileApp.Modules.Device.DeviceWiFiView"
             x:DataType="{x:Type module:DeviceWiFiViewModel}"
             s:BindingContextResolver.Type="{x:Type module:DeviceWiFiViewModel}"
             shell:ShellProperty.Title="WiFi"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function4Text="Settings"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <!--
        接続中の Wi-Fi (上のカード) と検出したアクセスポイントの一覧 (CollectionView)。変化は NetworkCallback / スキャン結果の通知で追従し、表示中は一定間隔で自動スキャン。
        更新で検出されなかった行は薄く表示して猶予の後に消す
    -->
    <!-- ReSharper disable Xaml.RedundantResource -->
    <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="PermissionHintLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicCaptionLabel}">
                <Setter Property="TextColor" Value="{StaticResource RedDarken1}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="ConnectionDivider"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource GrayLighten2}" />
                <Setter Property="Margin" Value="-12,8,-12,-10" />
            </Style>

            <Style x:Key="DetailDivider"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource GrayLighten2}" />
                <Setter Property="Margin" Value="-8,0,0,0" />
            </Style>

            <converters:WiFiSignalIconConverter x:Key="SignalIconConverter"
                                                Level0="{x:Static fonts:MaterialIcons.Signal_wifi_0_bar}"
                                                Level1="{x:Static fonts:MaterialIcons.Network_wifi_1_bar}"
                                                Level2="{x:Static fonts:MaterialIcons.Network_wifi_2_bar}"
                                                Level3="{x:Static fonts:MaterialIcons.Network_wifi_3_bar}"
                                                Level4="{x:Static fonts:MaterialIcons.Signal_wifi_4_bar}"
                                                Off="{x:Static fonts:MaterialIcons.Signal_wifi_off}" />
            <s:MapToColorConverter x:Key="SignalColorConverter"
                                   DefaultValue="{StaticResource GrayDefault}">
                <s:MapToColorConverter.Entries>
                    <s:MapToColorEntry Key="{s:Int32 0}"
                                       Value="{StaticResource RedDefault}" />
                    <s:MapToColorEntry Key="{s:Int32 1}"
                                       Value="{StaticResource OrangeDefault}" />
                    <s:MapToColorEntry Key="{s:Int32 2}"
                                       Value="{StaticResource AmberDefault}" />
                    <s:MapToColorEntry Key="{s:Int32 3}"
                                       Value="{StaticResource LightGreenDefault}" />
                    <s:MapToColorEntry Key="{s:Int32 4}"
                                       Value="{StaticResource GreenDefault}" />
                </s:MapToColorConverter.Entries>
            </s:MapToColorConverter>
            <converters:WiFiBandConverter x:Key="BandConverter" />
            <s:NullToParameterConverter x:Key="SsidConverter"
                                        HandleEmptyString="True" />
            <s:MapToTextConverter x:Key="SecurityTextConverter"
                                  DefaultValue="🔒 Enterprise">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static components:WiFiSecurity.Open}"
                                      Value="🔓 オープン" />
                    <s:MapToTextEntry Key="{x:Static components:WiFiSecurity.Wep}"
                                      Value="🔒 WEP" />
                    <s:MapToTextEntry Key="{x:Static components:WiFiSecurity.Wpa}"
                                      Value="🔒 WPA" />
                    <s:MapToTextEntry Key="{x:Static components:WiFiSecurity.Wpa2}"
                                      Value="🔒 WPA2" />
                    <s:MapToTextEntry Key="{x:Static components:WiFiSecurity.Wpa3}"
                                      Value="🔒 WPA3" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>
            <!-- 接続中 (上部のブロック。角丸にせず区切り線で仕切る) -->
            <Style x:Key="ConnectionBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="Rectangle" />
                <Style.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding IsConnected}"
                                 Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource GreenLighten5}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ConnectionGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="10" />
            </Style>

            <!-- 信号レベルの色は SignalColorConverter (未接続は既定の灰色) -->
            <Style x:Key="SignalIconBase"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="ConnectionSignalIcon"
                   TargetType="Label"
                   BasedOn="{StaticResource SignalIconBase}">
                <Setter Property="FontSize" Value="56" />
                <Setter Property="WidthRequest" Value="64" />
                <Setter Property="TextColor" Value="{Binding Connection.SignalLevel, Converter={StaticResource SignalColorConverter}, FallbackValue={StaticResource GrayDefault}}" />
            </Style>

            <Style x:Key="ConnectionStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="4" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="TitleRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="SsidLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="StateChip"
                   TargetType="Border">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
                <Style.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding IsConnected}"
                                 Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource GreenDefault}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChipLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
            </Style>

            <Style x:Key="StateChipLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource ChipLabel}">
                <Style.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsConnected}"
                                 Value="True">
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 絵文字付きの情報 (📶 -38 dBm など) -->
            <Style x:Key="InfoRow"
                   TargetType="FlexLayout">
                <Setter Property="Wrap" Value="Wrap" />
                <Setter Property="AlignItems" Value="Center" />
            </Style>

            <Style x:Key="InfoLabel"
                   TargetType="Label">
                <Setter Property="FlexLayout.Shrink" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,0,12,2" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="MonoLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource InfoLabel}">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="ExpandButton"
                   TargetType="Button">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken1}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style x:Key="DetailStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="DetailSeparator"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Color" Value="{StaticResource GrayLighten3}" />
            </Style>

            <!-- 一覧ヘッダ -->
            <Style x:Key="ListHeaderGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="ColumnSpacing" Value="8" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten5}" />
            </Style>

            <Style x:Key="ListTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken2}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="CountChip"
                   TargetType="Border">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
            </Style>

            <Style x:Key="CountChipLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource ChipLabel}">
                <Setter Property="TextColor" Value="{StaticResource BlueDarken1}" />
            </Style>

            <Style x:Key="ScanLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <!-- アクセスポイントの行 -->
            <Style x:Key="AccessPointCollection"
                   TargetType="CollectionView">
                <Setter Property="SelectionMode" Value="None" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="AccessPointBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="Rectangle" />
                <Style.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding IsConnected, x:DataType={x:Type module:WiFiAccessPointItem}}"
                                 Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource GreenLighten5}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding IsStale, x:DataType={x:Type module:WiFiAccessPointItem}}"
                                 Value="True">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AccessPointGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="8,8,0,0" />
                <Setter Property="ColumnSpacing" Value="8" />
            </Style>

            <Style x:Key="AccessPointStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Spacing" Value="4" />
            </Style>

            <Style x:Key="AccessPointSignalIcon"
                   TargetType="Label"
                   BasedOn="{StaticResource SignalIconBase}">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="TextColor" Value="{Binding AccessPoint.SignalLevel, x:DataType={x:Type module:WiFiAccessPointItem}, Converter={StaticResource SignalColorConverter}}" />
            </Style>

            <Style x:Key="AccessPointSsidLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource SsidLabel}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="FlexLayout.Shrink" Value="0" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style x:Key="AccessPointChip"
                   TargetType="Border"
                   BasedOn="{StaticResource CountChip}">
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <Style x:Key="ConnectedChip"
                   TargetType="Border"
                   BasedOn="{StaticResource AccessPointChip}">
                <Setter Property="BackgroundColor" Value="{StaticResource GreenDefault}" />
            </Style>

            <Style x:Key="ConnectedChipLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource ChipLabel}">
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="StaleChip"
                   TargetType="Border"
                   BasedOn="{StaticResource AccessPointChip}">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
            </Style>

            <Style x:Key="BandChip"
                   TargetType="Border"
                   BasedOn="{StaticResource AccessPointChip}">
                <Setter Property="BackgroundColor" Value="{StaticResource BlueGrayLighten4}" />
            </Style>

            <Style x:Key="SecurityChip"
                   TargetType="Border"
                   BasedOn="{StaticResource AccessPointChip}">
                <Setter Property="BackgroundColor" Value="{StaticResource AmberLighten4}" />
                <Style.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding AccessPoint.Security, x:DataType={x:Type module:WiFiAccessPointItem}}"
                                 Value="{x:Static components:WiFiSecurity.Open}">
                        <Setter Property="BackgroundColor" Value="{StaticResource RedLighten4}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StandardChip"
                   TargetType="Border"
                   BasedOn="{StaticResource AccessPointChip}">
                <Setter Property="BackgroundColor" Value="{StaticResource PurpleLighten5}" />
            </Style>

            <Style x:Key="StandardChipLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource ChipLabel}">
                <Setter Property="TextColor" Value="{StaticResource PurpleDarken1}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid Style="{StaticResource RootGrid}"
          RowDefinitions="Auto,Auto,*">

        <!-- 接続中 (タップで詳細の開閉) -->
        <Border Grid.Row="0"
                Style="{StaticResource ConnectionBorder}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleDetailCommand}" />
            </Border.GestureRecognizers>
            <Grid Style="{StaticResource ConnectionGrid}"
                  RowDefinitions="*,Auto"
                  ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Row="0" Grid.Column="0"
                       Style="{StaticResource ConnectionSignalIcon}"
                       Text="{Binding Connection.SignalLevel, Converter={StaticResource SignalIconConverter}, FallbackValue={x:Static fonts:MaterialIcons.Signal_wifi_off}}" />
                <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource ConnectionStack}">
                    <HorizontalStackLayout Style="{StaticResource TitleRow}">
                        <Label Style="{StaticResource SsidLabel}"
                               Text="{Binding Connection.Ssid, FallbackValue=''}" />
                        <Border Style="{StaticResource StateChip}">
                            <Label Style="{StaticResource StateChipLabel}"
                                   Text="{Binding StateText}" />
                        </Border>
                    </HorizontalStackLayout>
                    <!-- 未接続 (Connection が null) のときは行ごと隠すか空欄で良い -->
                    <!-- ReSharper disable Xaml.PossibleNullReferenceException -->
                    <FlexLayout Style="{StaticResource InfoRow}"
                                IsVisible="{Binding IsConnected}">
                        <Label Style="{StaticResource InfoLabel}"
                               Text="{Binding Connection.Rssi, StringFormat='📶 {0} dBm'}" />
                        <Label Style="{StaticResource InfoLabel}"
                               Text="{Binding Connection.LinkSpeed, StringFormat='⚡ {0} Mbps'}" />
                        <Label Style="{StaticResource InfoLabel}"
                               Text="{Binding Connection.Frequency, Converter={StaticResource BandConverter}, StringFormat='📡 {0}'}" />
                        <Label Style="{StaticResource InfoLabel}"
                               Text="{Binding Connection.IpAddress, StringFormat='🌐 {0}'}" />
                    </FlexLayout>
                    <VerticalStackLayout Style="{StaticResource DetailStack}"
                                         IsVisible="{Binding IsDetailOpen}">
                        <BoxView Style="{StaticResource DetailSeparator}" />
                        <FlexLayout Style="{StaticResource InfoRow}">
                            <Label Style="{StaticResource MonoLabel}"
                                   Text="{Binding Connection.Bssid, StringFormat='🏷 {0}'}" />
                            <Label Style="{StaticResource InfoLabel}"
                                   Text="{Binding Connection.Frequency, StringFormat='📡 {0} MHz'}" />
                            <Label Style="{StaticResource InfoLabel}"
                                   Text="{Binding Connection.Standard, StringFormat='📘 {0}'}" />
                        </FlexLayout>
                        <FlexLayout Style="{StaticResource InfoRow}">
                            <Label Style="{StaticResource InfoLabel}">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}⬇ {0} / ⬆ {1} Mbps">
                                        <Binding Path="Connection.RxLinkSpeed" />
                                        <Binding Path="Connection.TxLinkSpeed" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label Style="{StaticResource InfoLabel}"
                                   Text="{Binding Connection.Gateway, StringFormat='🚪 {0}'}" />
                            <Label Style="{StaticResource InfoLabel}"
                                   Text="{Binding Connection.Dns, StringFormat='🔎 {0}'}" />
                        </FlexLayout>
                        <!-- ReSharper restore Xaml.PossibleNullReferenceException -->
                        <Label Style="{StaticResource PermissionHintLabel}"
                               IsVisible="{Binding HasPermission, Converter={StaticResource ReverseConverter}}"
                               Text="位置情報 / 付近の Wi-Fi 機器の権限が無いため SSID とスキャン結果は取得できません" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <Button Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource ExpandButton}"
                        Command="{Binding ToggleDetailCommand}"
                        Text="{Binding IsDetailOpen, Converter={StaticResource ExpandGlyphConverter}}" />
                <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                         Style="{StaticResource ConnectionDivider}" />
            </Grid>
        </Border>

        <!-- 一覧ヘッダ: 件数と帯域ごとの内訳、更新時刻 (スキャンは自動のみ) -->
        <Grid Grid.Row="1"
              Style="{StaticResource ListHeaderGrid}"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*">
            <Label Grid.Column="0"
                   Style="{StaticResource ListTitleLabel}"
                   Text="{Binding AccessPoints.Count, StringFormat='アクセスポイント {0}'}" />
            <Border Grid.Column="1"
                    Style="{StaticResource CountChip}">
                <Label Style="{StaticResource CountChipLabel}"
                       Text="{Binding Band24Count, StringFormat='2.4G {0}'}" />
            </Border>
            <Border Grid.Column="2"
                    Style="{StaticResource CountChip}">
                <Label Style="{StaticResource CountChipLabel}"
                       Text="{Binding Band5Count, StringFormat='5G {0}'}" />
            </Border>
            <Border Grid.Column="3"
                    Style="{StaticResource CountChip}"
                    IsVisible="{Binding HasBand6}">
                <Label Style="{StaticResource CountChipLabel}"
                       Text="{Binding Band6Count, StringFormat='6G {0}'}" />
            </Border>
            <Label Grid.Column="4"
                   Style="{StaticResource ScanLabel}"
                   Text="{Binding ScanMessage}" />
        </Grid>

        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
        <CollectionView Grid.Row="2"
                        Style="{StaticResource AccessPointCollection}"
                        ItemsSource="{Binding AccessPoints}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type module:WiFiAccessPointItem}">
                    <Border Style="{StaticResource AccessPointBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:DeviceWiFiViewModel}}, Path=ToggleExpandCommand, x:DataType={x:Type module:DeviceWiFiViewModel}}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid Style="{StaticResource AccessPointGrid}"
                              RowDefinitions="*,Auto"
                              ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource AccessPointSignalIcon}"
                                   Text="{Binding AccessPoint.SignalLevel, Converter={StaticResource SignalIconConverter}}" />
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                                 Style="{StaticResource AccessPointStack}">
                                <FlexLayout Style="{StaticResource InfoRow}">
                                    <Label Style="{StaticResource AccessPointSsidLabel}"
                                           Text="{Binding AccessPoint.Ssid, Converter={StaticResource SsidConverter}, ConverterParameter='(非公開)'}" />
                                    <Border Style="{StaticResource ConnectedChip}"
                                            IsVisible="{Binding IsConnected}">
                                        <Label Style="{StaticResource ConnectedChipLabel}"
                                               Text="接続中" />
                                    </Border>
                                    <Border Style="{StaticResource StaleChip}"
                                            IsVisible="{Binding IsStale}">
                                        <Label Style="{StaticResource ChipLabel}"
                                               Text="未検出" />
                                    </Border>
                                    <Border Style="{StaticResource BandChip}">
                                        <Label Style="{StaticResource ChipLabel}"
                                               Text="{Binding AccessPoint.Frequency, Converter={StaticResource BandConverter}}" />
                                    </Border>
                                    <Border Style="{StaticResource SecurityChip}">
                                        <Label Style="{StaticResource ChipLabel}"
                                               Text="{Binding AccessPoint.Security, Converter={StaticResource SecurityTextConverter}}" />
                                    </Border>
                                    <Border Style="{StaticResource StandardChip}"
                                            IsVisible="{Binding AccessPoint.Standard, Converter={StaticResource NotEmptyConverter}}">
                                        <Label Style="{StaticResource StandardChipLabel}"
                                               Text="{Binding AccessPoint.Standard}" />
                                    </Border>
                                </FlexLayout>
                                <FlexLayout Style="{StaticResource InfoRow}">
                                    <Label Style="{StaticResource InfoLabel}"
                                           Text="{Binding AccessPoint.Rssi, StringFormat='📶 {0} dBm'}" />
                                    <Label Style="{StaticResource InfoLabel}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}📡 ch {0} ({1} MHz)">
                                                <Binding Path="AccessPoint.Channel" />
                                                <Binding Path="AccessPoint.Frequency" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Style="{StaticResource InfoLabel}"
                                           IsVisible="{Binding AccessPoint.ChannelWidth, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter={s:Int32 0}}"
                                           Text="{Binding AccessPoint.ChannelWidth, StringFormat='↔ {0} MHz'}" />
                                </FlexLayout>
                                <VerticalStackLayout Style="{StaticResource DetailStack}"
                                                     IsVisible="{Binding IsExpanded}">
                                    <BoxView Style="{StaticResource DetailSeparator}" />
                                    <FlexLayout Style="{StaticResource InfoRow}">
                                        <Label Style="{StaticResource MonoLabel}"
                                               Text="{Binding AccessPoint.Bssid, StringFormat='🏷 {0}'}" />
                                        <Label Style="{StaticResource InfoLabel}"
                                               Text="{Binding AccessPoint.SeenAt, StringFormat='🕒 {0:HH:mm:ss}'}" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                            <Button Grid.Row="0" Grid.Column="2"
                                    Style="{StaticResource ExpandButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type module:DeviceWiFiViewModel}}, Path=ToggleExpandCommand, x:DataType={x:Type module:DeviceWiFiViewModel}}"
                                    CommandParameter="{Binding .}"
                                    Text="{Binding IsExpanded, Converter={StaticResource ExpandGlyphConverter}}" />
                            <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                     Style="{StaticResource DetailDivider}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
    </Grid>

</ContentView>
