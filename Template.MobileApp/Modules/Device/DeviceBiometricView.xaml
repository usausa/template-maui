<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:components="clr-namespace:Template.MobileApp.Components"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Device"
             x:Class="Template.MobileApp.Modules.Device.DeviceBiometricView"
             x:DataType="{x:Type module:DeviceBiometricViewModel}"
             s:BindingContextResolver.Type="{x:Type module:DeviceBiometricViewModel}"
             shell:ShellProperty.Title="Biometric"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <s:MapToTextConverter x:Key="AvailabilityTextConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static components:BiometricAvailability.Available}"
                                      Value="Available" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricAvailability.NoHardware}"
                                      Value="No sensor" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricAvailability.NoneEnrolled}"
                                      Value="Not enrolled" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricAvailability.Unavailable}"
                                      Value="Unavailable now" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <converters:MapToToneConverter x:Key="AvailabilityToneConverter">
                <converters:MapToToneConverter.Entries>
                    <converters:MapToToneEntry Key="{x:Static components:BiometricAvailability.Available}"
                                               Value="Success" />
                    <converters:MapToToneEntry Key="{x:Static components:BiometricAvailability.NoHardware}"
                                               Value="Error" />
                    <converters:MapToToneEntry Key="{x:Static components:BiometricAvailability.NoneEnrolled}"
                                               Value="Warning" />
                </converters:MapToToneConverter.Entries>
            </converters:MapToToneConverter>

            <s:MapToTextConverter x:Key="ResultTextConverter"
                                  DefaultValue="—">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static components:BiometricResult.Succeeded}"
                                      Value="✅ Success" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricResult.Canceled}"
                                      Value="↩️ Canceled" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricResult.Lockout}"
                                      Value="🔒 Too many attempts" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricResult.Failed}"
                                      Value="❌ Error" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="AuthenticationTypeTextConverter"
                                  DefaultValue="">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static components:BiometricAuthenticationType.Biometric}"
                                      Value="(Biometric)" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricAuthenticationType.DeviceCredential}"
                                      Value="(Screen lock)" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="KeyStateTextConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static components:BiometricKeyState.None}"
                                      Value="— None" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricKeyState.Available}"
                                      Value="🔑 Exists" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricKeyState.Invalidated}"
                                      Value="⚠️ Unusable" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="KeyLocationTextConverter"
                                  DefaultValue="—">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static components:BiometricKeyLocation.StrongBox}"
                                      Value="🛡️ StrongBox" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricKeyLocation.TrustedEnvironment}"
                                      Value="🔒 TEE" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricKeyLocation.Software}"
                                      Value="⚠️ Software" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricKeyLocation.Unknown}"
                                      Value="❓ Unknown" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="SignStatusTextConverter"
                                  DefaultValue="—">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static components:BiometricSignStatus.Succeeded}"
                                      Value="✅ Signed" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricSignStatus.Canceled}"
                                      Value="↩️ Canceled" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricSignStatus.Lockout}"
                                      Value="🔒 Too many attempts" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricSignStatus.Failed}"
                                      Value="❌ Error" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricSignStatus.NoKey}"
                                      Value="— No key" />
                    <s:MapToTextEntry Key="{x:Static components:BiometricSignStatus.KeyInvalidated}"
                                      Value="⚠️ Key unusable" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="AcceptTextConverter"
                                  DefaultValue="—">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{s:Bool Value=True}"
                                      Value="✅ Match" />
                    <s:MapToTextEntry Key="{s:Bool Value=False}"
                                      Value="❌ Mismatch" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="RejectTextConverter"
                                  DefaultValue="—">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{s:Bool Value=False}"
                                      Value="🛡️ Rejected" />
                    <s:MapToTextEntry Key="{s:Bool Value=True}"
                                      Value="⚠️ Accepted" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <converters:HexTextConverter x:Key="HexTextConverter"
                                         Length="6" />

            <converters:DurationConverter x:Key="DurationConverter" />

            <Style x:Key="TileGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
                <Setter Property="RowSpacing" Value="8" />
            </Style>

            <Style x:Key="TileStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="TileChip"
                   TargetType="controls:StatusChip">
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>

            <Style x:Key="HexValueLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicMonoLabel}">
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="ResultValueStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="8" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <!-- Content -->
    <Grid Style="{StaticResource RootGrid}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <!-- Availability -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Availability"
                               Icon="{x:Static fonts:MaterialIcons.Verified_user}">
                <Grid Style="{StaticResource TileGrid}"
                      RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*,*">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0"
                                         Style="{StaticResource TileStack}">
                        <Label Style="{StaticResource BasicCaptionLabel}"
                               Text="Biometric" />
                        <controls:StatusChip Style="{StaticResource TileChip}"
                                             Text="{Binding BiometricStatus, Converter={StaticResource AvailabilityTextConverter}}"
                                             Tone="{Binding BiometricStatus, Converter={StaticResource AvailabilityToneConverter}}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource TileStack}">
                        <Label Style="{StaticResource BasicCaptionLabel}"
                               Text="Weak" />
                        <controls:StatusChip Style="{StaticResource TileChip}"
                                             Text="{Binding WeakStatus, Converter={StaticResource AvailabilityTextConverter}}"
                                             Tone="{Binding WeakStatus, Converter={StaticResource AvailabilityToneConverter}}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="0" Grid.Column="2"
                                         Style="{StaticResource TileStack}">
                        <Label Style="{StaticResource BasicCaptionLabel}"
                               Text="Screen lock" />
                        <controls:StatusChip Style="{StaticResource TileChip}"
                                             Text="{Binding CredentialStatus, Converter={StaticResource AvailabilityTextConverter}}"
                                             Tone="{Binding CredentialStatus, Converter={StaticResource AvailabilityToneConverter}}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0"
                                         Style="{StaticResource TileStack}">
                        <Label Style="{StaticResource BasicCaptionLabel}"
                               Text="Last used" />
                        <Label Style="{StaticResource CardAccentLabel}"
                               Text="{Binding SinceLastAuthentication, Converter={StaticResource DurationConverter}, StringFormat='{0} ago', TargetNullValue='—'}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding SinceLastAuthentication, Converter={StaticResource EmptyConverter}}"
                                             Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                    <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                            Style="{StaticResource BasicIconOutlinedButton}"
                            Command="{Binding EnrollCommand}"
                            Text="Enroll"
                            ImageSource="{x:Static markup:AppIcons.SmallHowToReg}" />
                </Grid>
            </controls:InfoCard>

            <!-- Authenticate -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="80"
                               Title="Authenticate"
                               Icon="{x:Static fonts:MaterialIcons.Fingerprint}">
                <VerticalStackLayout Style="{StaticResource CardActionStack}">
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding AuthenticateCommand}"
                                CommandParameter="{x:Static components:BiometricMethod.Biometric}"
                                Text="Strong"
                                ImageSource="{x:Static markup:AppIcons.SmallFingerprint}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding AuthenticateCommand}"
                                CommandParameter="{x:Static components:BiometricMethod.WeakBiometric}"
                                Text="Weak"
                                ImageSource="{x:Static markup:AppIcons.SmallFace}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding AuthenticateCommand}"
                                CommandParameter="{x:Static components:BiometricMethod.BiometricOrDeviceCredential}"
                                Text="PIN"
                                ImageSource="{x:Static markup:AppIcons.SmallPassword}" />
                    </Grid>
                    <VerticalStackLayout Style="{StaticResource TileStack}">
                        <Label Style="{StaticResource BasicCaptionLabel}"
                               Text="Result" />
                        <HorizontalStackLayout Style="{StaticResource ResultValueStack}">
                            <Label Style="{StaticResource CardAccentLabel}"
                                   Text="{Binding Result, Converter={StaticResource ResultTextConverter}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Result, Converter={StaticResource EmptyConverter}}"
                                                 Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Style="{StaticResource CardAccentLabel}"
                                   Text="{Binding AuthenticationType, Converter={StaticResource AuthenticationTypeTextConverter}}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </controls:InfoCard>

            <!-- Key sign in -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="160"
                               Title="Key sign in"
                               Icon="{x:Static fonts:MaterialIcons.Key}">
                <VerticalStackLayout Style="{StaticResource CardActionStack}">
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding RegisterCommand}"
                                Text="Register"
                                ImageSource="{x:Static markup:AppIcons.SmallKey}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding SignInCommand}"
                                Text="Sign in"
                                ImageSource="{x:Static markup:AppIcons.SmallLogin}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding DeleteKeyCommand}"
                                Text="Delete"
                                ImageSource="{x:Static markup:AppIcons.SmallDelete}" />
                    </Grid>
                    <Grid Style="{StaticResource TileGrid}"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0"
                                             Style="{StaticResource TileStack}">
                            <Label Style="{StaticResource BasicCaptionLabel}"
                                   Text="Key" />
                            <Label Style="{StaticResource CardAccentLabel}"
                                   Text="{Binding KeyState, Converter={StaticResource KeyStateTextConverter}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding KeyState}"
                                                 Value="{x:Static components:BiometricKeyState.None}">
                                        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource TileStack}">
                            <Label Style="{StaticResource BasicCaptionLabel}"
                                   Text="Location" />
                            <Label Style="{StaticResource CardAccentLabel}"
                                   Text="{Binding KeyLocation, Converter={StaticResource KeyLocationTextConverter}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding KeyLocation, Converter={StaticResource EmptyConverter}}"
                                                 Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0"
                                             Style="{StaticResource TileStack}">
                            <Label Style="{StaticResource BasicCaptionLabel}"
                                   Text="Public key" />
                            <Label Style="{StaticResource HexValueLabel}"
                                   Text="{Binding KeyFingerprint, Converter={StaticResource HexTextConverter}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                                             Style="{StaticResource TileStack}">
                            <Label Style="{StaticResource BasicCaptionLabel}"
                                   Text="Challenge" />
                            <Label Style="{StaticResource HexValueLabel}"
                                   Text="{Binding Challenge, Converter={StaticResource HexTextConverter}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="0"
                                             Style="{StaticResource TileStack}">
                            <Label Style="{StaticResource BasicCaptionLabel}"
                                   Text="Signature" />
                            <Label Style="{StaticResource HexValueLabel}"
                                   Text="{Binding Signature, Converter={StaticResource HexTextConverter}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1"
                                             Style="{StaticResource TileStack}">
                            <Label Style="{StaticResource BasicCaptionLabel}"
                                   Text="Result" />
                            <Label Style="{StaticResource CardAccentLabel}"
                                   Text="{Binding SignStatus, Converter={StaticResource SignStatusTextConverter}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SignStatus, Converter={StaticResource EmptyConverter}}"
                                                 Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid Style="{StaticResource TileGrid}"
                          ColumnDefinitions="*,*,*">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0"
                                             Style="{StaticResource TileStack}">
                            <Label Style="{StaticResource BasicCaptionLabel}"
                                   Text="Verify" />
                            <Label Style="{StaticResource CardAccentLabel}"
                                   Text="{Binding Verified, Converter={StaticResource AcceptTextConverter}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Verified, Converter={StaticResource EmptyConverter}}"
                                                 Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource TileStack}">
                            <Label Style="{StaticResource BasicCaptionLabel}"
                                   Text="Tampered" />
                            <Label Style="{StaticResource CardAccentLabel}"
                                   Text="{Binding TamperedVerified, Converter={StaticResource RejectTextConverter}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding TamperedVerified, Converter={StaticResource EmptyConverter}}"
                                                 Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="2"
                                             Style="{StaticResource TileStack}">
                            <Label Style="{StaticResource BasicCaptionLabel}"
                                   Text="Replay" />
                            <Label Style="{StaticResource CardAccentLabel}"
                                   Text="{Binding ReplayVerified, Converter={StaticResource RejectTextConverter}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding ReplayVerified, Converter={StaticResource EmptyConverter}}"
                                                 Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </Grid>

</ContentView>
