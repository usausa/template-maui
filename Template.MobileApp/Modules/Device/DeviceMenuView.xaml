<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Device"
             x:Class="Template.MobileApp.Modules.Device.DeviceMenuView"
             x:DataType="{x:Type module:DeviceMenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:DeviceMenuViewModel}"
             shell:ShellProperty.Title="Device"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="*,*,*,*,*,*,*,*,*"
          ColumnDefinitions="*,*">
        <Button Grid.Row="0" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceInfo}"
                Text="Info"
                ImageSource="{x:Static markup:AppIcons.Info}" />
        <Button Grid.Row="0" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceStatus}"
                Text="Status"
                ImageSource="{x:Static markup:AppIcons.Assessment}" />

        <Button Grid.Row="1" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceSensor}"
                Text="Sensor"
                ImageSource="{x:Static markup:AppIcons.Sensors}" />
        <Button Grid.Row="1" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceLocation}"
                Text="Location"
                ImageSource="{x:Static markup:AppIcons.LocationOn}" />

        <Button Grid.Row="2" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceQrDisplay}"
                Text="QR Display"
                ImageSource="{x:Static markup:AppIcons.QrCode}" />
        <Button Grid.Row="2" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceQrScan}"
                Text="QR Scan"
                ImageSource="{x:Static markup:AppIcons.QrCodeScanner}" />

        <Button Grid.Row="3" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceCamera}"
                Text="Camera"
                ImageSource="{x:Static markup:AppIcons.PhotoCamera}" />
        <Button Grid.Row="3" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceOcr}"
                Text="OCR"
                ImageSource="{x:Static markup:AppIcons.DocumentScanner}" />

        <Button Grid.Row="4" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="WiFi"
                ImageSource="{x:Static markup:AppIcons.Wifi}" />
        <Button Grid.Row="4" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceBluetooth}"
                Text="Bluetooth"
                ImageSource="{x:Static markup:AppIcons.Bluetooth}" />

        <Button Grid.Row="5" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceBleScan}"
                Text="BLE Scan"
                ImageSource="{x:Static markup:AppIcons.BluetoothSearching}" />
        <Button Grid.Row="5" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceBleHost}"
                Text="BLE Host"
                ImageSource="{x:Static markup:AppIcons.BluetoothConnected}" />

        <Button Grid.Row="6" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceNfc}"
                Text="NFC"
                ImageSource="{x:Static markup:AppIcons.Nfc}" />
        <Button Grid.Row="6" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceAudio}"
                Text="Audio"
                ImageSource="{x:Static markup:AppIcons.VolumeUp}" />

        <Button Grid.Row="7" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceActivity}"
                Text="Activity"
                ImageSource="{x:Static markup:AppIcons.DirectionsRun}" />
        <Button Grid.Row="7" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="Biometric"
                ImageSource="{x:Static markup:AppIcons.Fingerprint}" />

        <Button Grid.Row="8" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceCommunication}"
                Text="Communication"
                ImageSource="{x:Static markup:AppIcons.CellTower}" />
        <Button Grid.Row="8" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId DeviceMisc}"
                Text="Misc"
                ImageSource="{x:Static markup:AppIcons.MoreHoriz}" />
    </Grid>

</ContentView>
