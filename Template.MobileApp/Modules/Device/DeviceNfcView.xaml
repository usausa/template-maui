<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Device"
             x:Class="Template.MobileApp.Modules.Device.DeviceNfcView"
             x:DataType="{x:Type module:DeviceNfcViewModel}"
             s:BindingContextResolver.Type="{x:Type module:DeviceNfcViewModel}"
             shell:ShellProperty.Title="NFC"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function4Text="Clear"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="NfcIconBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource BasicIconCircleBorder}">
                <Setter Property="BackgroundColor" Value="{StaticResource MetroGrayDark}" />
            </Style>

            <Style x:Key="NfcRippleRing"
                   TargetType="Ellipse"
                   BasedOn="{StaticResource BasicRippleRing}">
                <Setter Property="Stroke" Value="{StaticResource MetroGreen}" />
            </Style>

            <Style x:Key="NfcIconLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicIconCircleLabel}">
                <Setter Property="TextColor" Value="{StaticResource MetroGreen}" />
            </Style>

            <!-- Converter -->

            <converters:SuicaProcessColorConverter x:Key="ProcessColorConverter">
                <converters:SuicaProcessColorConverter.Values>
                    <x:Array Type="{x:Type converters:ProcessColor}">
                        <converters:ProcessColor Color="{StaticResource MetroTeal}"
                                                 ProcessType="1" />
                        <converters:ProcessColor Color="{StaticResource MetroOrangeDark}"
                                                 ProcessType="2" />
                        <converters:ProcessColor Color="{StaticResource MetroTeal}"
                                                 ProcessType="3" />
                        <converters:ProcessColor Color="{StaticResource MetroTeal}"
                                                 ProcessType="4" />
                        <converters:ProcessColor Color="{StaticResource MetroTeal}"
                                                 ProcessType="5" />
                        <converters:ProcessColor Color="{StaticResource MetroTeal}"
                                                 ProcessType="6" />
                        <converters:ProcessColor Color="{StaticResource MetroBlueDarkBrighter}"
                                                 ProcessType="7" />
                        <converters:ProcessColor Color="{StaticResource MetroBlueDarkBrighter}"
                                                 ProcessType="8" />
                        <converters:ProcessColor Color="{StaticResource MetroBlue}"
                                                 ProcessType="13" />
                        <converters:ProcessColor Color="{StaticResource MetroBlue}"
                                                 ProcessType="15" />
                        <converters:ProcessColor Color="{StaticResource MetroBlueDarkBrighter}"
                                                 ProcessType="17" />
                        <converters:ProcessColor Color="{StaticResource MetroLightGreen}"
                                                 ProcessType="19" />
                        <converters:ProcessColor Color="{StaticResource MetroOrangeDark}"
                                                 ProcessType="20" />
                        <converters:ProcessColor Color="{StaticResource MetroOrangeDark}"
                                                 ProcessType="21" />
                        <converters:ProcessColor Color="{StaticResource MetroOrangeDark}"
                                                 ProcessType="31" />
                        <converters:ProcessColor Color="{StaticResource MetroBlue}"
                                                 ProcessType="35" />
                        <converters:ProcessColor Color="{StaticResource MetroMagenta}"
                                                 ProcessType="70" />
                        <converters:ProcessColor Color="{StaticResource MetroOrangeDarkBrighter}"
                                                 ProcessType="72" />
                        <converters:ProcessColor Color="{StaticResource MetroOrangeDarkBrighter}"
                                                 ProcessType="73" />
                        <converters:ProcessColor Color="{StaticResource MetroYellow}"
                                                 ProcessType="74" />
                        <converters:ProcessColor Color="{StaticResource MetroMagenta}"
                                                 ProcessType="75" />
                    </x:Array>
                </converters:SuicaProcessColorConverter.Values>
            </converters:SuicaProcessColorConverter>

            <converters:SuicaLogDateTimeConverter x:Key="LogTimeConverter" />

            <converters:SuicaTerminalTextConverter x:Key="TerminalTextConverter" />

            <converters:SuicaProcessTextConverter x:Key="ProcessTextConverter" />

            <s:CompareToColorConverter x:Key="DifferenceColorConverter"
                                       Expression="{x:Static s:CompareExpressions.GreaterThan}"
                                       TrueValue="{StaticResource BlueLighten1}"
                                       FalseValue="{StaticResource RedLighten1}" />

            <!-- Style -->

            <Style x:Key="IcCardBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,16,16,8" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Background">
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="{StaticResource GreenDarken4}" />
                        <GradientStop Offset="0.6" Color="{StaticResource GreenDarken1}" />
                        <GradientStop Offset="1" Color="{StaticResource LightGreenLighten1}" />
                    </LinearGradientBrush>
                </Setter>
            </Style>

            <Style x:Key="IcCardGrid"
                   TargetType="Grid">
                <Setter Property="RowSpacing" Value="8" />
            </Style>

            <Style x:Key="CardBrandLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="CardIconLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="CardBalanceStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="Spacing" Value="4" />
            </Style>

            <Style x:Key="CardYenLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="CardBalanceLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="40" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="CardIdmStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="0" />
            </Style>

            <Style x:Key="CardCaptionLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="#B3FFFFFF" />
            </Style>

            <Style x:Key="CardIdmLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="LogCollectionView"
                   TargetType="CollectionView">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayDarken4}" />
            </Style>

            <Style x:Key="LogRowGrid"
                   TargetType="Grid">
                <Setter Property="RowSpacing" Value="0" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="LogBandBoxView"
                   TargetType="BoxView">
                <Setter Property="WidthRequest" Value="4" />
            </Style>

            <Style x:Key="LogDateLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
            </Style>

            <Style x:Key="LogDaySpan"
                   TargetType="Span">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="LogTimeSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="LogBadgeStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Margin" Value="0,3,0,8" />
                <Setter Property="Spacing" Value="6" />
            </Style>

            <Style x:Key="LogBadgeBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayDarken3}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 4" />
            </Style>

            <Style x:Key="LogTerminalBadgeBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource LogBadgeBorder}">
                <Setter Property="WidthRequest" Value="76" />
            </Style>

            <Style x:Key="LogProcessBadgeBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource LogBadgeBorder}">
                <Setter Property="MinimumWidthRequest" Value="88" />
            </Style>

            <Style x:Key="LogBadgeLabel"
                   TargetType="Label">
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="LogBalanceLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="LogDifferenceLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,3,16,8" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="LogDividerBoxView"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource GrayDarken3}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Style="{StaticResource IcCardBorder}"
                IsVisible="{Binding Access, Converter={StaticResource NotEmptyConverter}}">
            <Grid Style="{StaticResource IcCardGrid}"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,Auto">
                <Label Grid.Row="0" Grid.Column="0"
                       Style="{StaticResource CardBrandLabel}"
                       Text="Suica" />
                <Label Grid.Row="0" Grid.Column="1"
                       Style="{StaticResource CardIconLabel}"
                       Text="{x:Static fonts:MaterialIcons.Contactless}" />
                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Style="{StaticResource CardBalanceStack}">
                    <Label Style="{StaticResource CardYenLabel}"
                           Text="￥" />
                    <Label Style="{StaticResource CardBalanceLabel}"
                           behaviors:LabelOption.CountUpDuration="600"
                           behaviors:LabelOption.CountUpFormat="{}{0:#,0}"
                           behaviors:LabelOption.CountUpValue="{Binding Access.Balance, FallbackValue=0}" />
                </HorizontalStackLayout>
                <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                     Style="{StaticResource CardIdmStack}">
                    <Label Style="{StaticResource CardCaptionLabel}"
                           Text="IDm" />
                    <Label Style="{StaticResource CardIdmLabel}"
                           Text="{Binding Idm}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <CollectionView Grid.Row="1"
                        Style="{StaticResource LogCollectionView}"
                        ItemsSource="{Binding Logs}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Style="{StaticResource BasicEmptyStack}">
                    <Grid Style="{StaticResource BasicRippleGrid}">
                        <Ellipse Style="{StaticResource NfcRippleRing}"
                                 behaviors:AnimationOption.Ripple="True" />
                        <Ellipse Style="{StaticResource NfcRippleRing}"
                                 behaviors:AnimationOption.Ripple="True"
                                 behaviors:AnimationOption.RippleDelay="900" />
                        <Border Style="{StaticResource NfcIconBorder}">
                            <Label Style="{StaticResource NfcIconLabel}"
                                   Text="{x:Static fonts:MaterialIcons.Contactless}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type sample:SuicaLogData}">
                    <Grid Style="{StaticResource LogRowGrid}"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="Auto,*,Auto">
                        <BoxView Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                 Style="{StaticResource LogBandBoxView}"
                                 Color="{Binding Process, Converter={StaticResource ProcessColorConverter}}" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource LogDateLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource LogDaySpan}"
                                          Text="{Binding DateTime, StringFormat='{0:MM/dd (ddd)}'}" />
                                    <Span Style="{StaticResource LogTimeSpan}"
                                          Text="{Binding ., Converter={StaticResource LogTimeConverter}, StringFormat=' {0:HH:mm}'}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1"
                                               Style="{StaticResource LogBadgeStack}">
                            <Border Style="{StaticResource LogTerminalBadgeBorder}">
                                <Label Style="{StaticResource LogBadgeLabel}"
                                       Text="{Binding Terminal, Converter={StaticResource TerminalTextConverter}}" />
                            </Border>
                            <Border Style="{StaticResource LogProcessBadgeBorder}"
                                    BackgroundColor="{Binding Process, Converter={StaticResource ProcessColorConverter}}">
                                <Label Style="{StaticResource LogBadgeLabel}"
                                       Text="{Binding Process, Converter={StaticResource ProcessTextConverter}}" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Grid.Row="0" Grid.Column="2"
                               Style="{StaticResource LogBalanceLabel}"
                               Text="{Binding Balance, StringFormat='￥{0:#,0}'}" />
                        <Label Grid.Row="1" Grid.Column="2"
                               Style="{StaticResource LogDifferenceLabel}"
                               Text="{Binding Difference, StringFormat='{0:+￥#,0;−￥#,0;#}'}"
                               TextColor="{Binding Difference, Converter={StaticResource DifferenceColorConverter}, ConverterParameter=0}" />
                        <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                 Style="{StaticResource LogDividerBoxView}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentView>
