<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Device"
             x:Class="Template.MobileApp.Modules.Device.DeviceBluetoothView"
             x:DataType="{x:Type module:DeviceBluetoothViewModel}"
             s:BindingContextResolver.Type="{x:Type module:DeviceBluetoothViewModel}"
             shell:ShellProperty.Title="Bluetooth"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Action -->

            <Style x:Key="PrintButton"
                   TargetType="Button"
                   BasedOn="{StaticResource BasicFilledButton}">
                <Setter Property="Margin" Value="16,0,16,16" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <!-- Status -->

            <Style x:Key="StateChip"
                   TargetType="controls:StatusChip">
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <!-- Converter -->

            <converters:MapToIntConverter x:Key="StepConverter">
                <converters:MapToIntConverter.Entries>
                    <converters:MapToIntEntry Key="{x:Static module:BluetoothPrintState.Connecting}"
                                              Value="1" />
                    <converters:MapToIntEntry Key="{x:Static module:BluetoothPrintState.Printing}"
                                              Value="2" />
                    <converters:MapToIntEntry Key="{x:Static module:BluetoothPrintState.Completed}"
                                              Value="3" />
                </converters:MapToIntConverter.Entries>
            </converters:MapToIntConverter>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <Grid Style="{StaticResource RootGrid}"
          RowDefinitions="*,Auto">

        <!-- Status -->
        <Border Grid.Row="0"
                Style="{StaticResource CardCenterBorder}"
                behaviors:AnimationOption.EnterAnimation="FadeUp">
            <VerticalStackLayout Style="{StaticResource CardStack}">

                <Border Style="{StaticResource BasicIconCircleBorder}"
                        behaviors:AnimationOption.Pulse="{Binding State, Converter={s:CompareToBool}, ConverterParameter={x:Static module:BluetoothPrintState.Connecting}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding State}"
                                     Value="Connecting">
                            <Setter Property="BackgroundColor" Value="{StaticResource AmberLighten4}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding State}"
                                     Value="Completed">
                            <Setter Property="BackgroundColor" Value="{StaticResource GreenLighten4}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding State}"
                                     Value="Failed">
                            <Setter Property="BackgroundColor" Value="{StaticResource RedLighten4}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource BasicIconCircleLabel}"
                           behaviors:AnimationOption.Wave="{Binding State, Converter={s:CompareToBool}, ConverterParameter={x:Static module:BluetoothPrintState.Printing}}"
                           Text="{x:Static fonts:MaterialIcons.Bluetooth}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding State}"
                                         Value="Connecting">
                                <Setter Property="TextColor" Value="{StaticResource AmberDarken3}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding State}"
                                         Value="Printing">
                                <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Print}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding State}"
                                         Value="Completed">
                                <Setter Property="TextColor" Value="{StaticResource GreenDarken2}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding State}"
                                         Value="Failed">
                                <Setter Property="TextColor" Value="{StaticResource RedDarken2}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Label Style="{StaticResource BasicCenterTitleLabel}"
                       Text="Bluetooth Serial Print" />

                <controls:StatusChip Style="{StaticResource StateChip}"
                                     Icon="{x:Static fonts:MaterialIcons.Print}"
                                     Text="{Binding State}">
                    <controls:StatusChip.Triggers>
                        <DataTrigger TargetType="controls:StatusChip"
                                     Binding="{Binding State}"
                                     Value="Connecting">
                            <Setter Property="ChipColor" Value="{StaticResource AmberLighten4}" />
                            <Setter Property="IconColor" Value="{StaticResource AmberDarken3}" />
                            <Setter Property="TextColor" Value="{StaticResource AmberDarken3}" />
                        </DataTrigger>
                        <DataTrigger TargetType="controls:StatusChip"
                                     Binding="{Binding State}"
                                     Value="Printing">
                            <Setter Property="ChipColor" Value="{StaticResource BlueLighten4}" />
                            <Setter Property="IconColor" Value="{StaticResource BlueDarken2}" />
                            <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
                        </DataTrigger>
                        <DataTrigger TargetType="controls:StatusChip"
                                     Binding="{Binding State}"
                                     Value="Completed">
                            <Setter Property="ChipColor" Value="{StaticResource GreenLighten4}" />
                            <Setter Property="IconColor" Value="{StaticResource GreenDarken2}" />
                            <Setter Property="TextColor" Value="{StaticResource GreenDarken2}" />
                        </DataTrigger>
                        <DataTrigger TargetType="controls:StatusChip"
                                     Binding="{Binding State}"
                                     Value="Failed">
                            <Setter Property="ChipColor" Value="{StaticResource RedLighten4}" />
                            <Setter Property="IconColor" Value="{StaticResource RedDarken2}" />
                            <Setter Property="TextColor" Value="{StaticResource RedDarken2}" />
                        </DataTrigger>
                    </controls:StatusChip.Triggers>
                </controls:StatusChip>

                <cmc:StepIndicator CurrentStep="{Binding State, Converter={StaticResource StepConverter}}"
                                   TotalSteps="3"
                                   IsCountVisible="False" />

                <Label Style="{StaticResource BasicCenterHintLabel}"
                       behaviors:AnimationOption.FadeInTrigger="{Binding Detail}"
                       Text="{Binding Detail}" />

            </VerticalStackLayout>
        </Border>

        <!-- Action -->
        <Button Grid.Row="1"
                Style="{StaticResource PrintButton}"
                Command="{Binding PrintCommand}"
                Text="Print" />

    </Grid>

</ContentView>
