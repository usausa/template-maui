<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Navigation.Wizard"
             x:Class="Template.MobileApp.Modules.Navigation.Wizard.WizardInput1View"
             x:DataType="{x:Type module:WizardInput1ViewModel}"
             s:BindingContextResolver.Type="{x:Type module:WizardInput1ViewModel}"
             shell:ShellProperty.Title="Input1"
             shell:ShellProperty.Function1Text="◀️"
             shell:ShellProperty.Function4Text="▶️"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Page -->

            <Style x:Key="WizardRootGrid"
                   TargetType="Grid"
                   BasedOn="{StaticResource RootGrid}">
                <Setter Property="Padding" Value="12" />
                <Setter Property="RowSpacing" Value="12" />
            </Style>

            <!-- Form -->

            <Style x:Key="WizardCard"
                   TargetType="controls:InfoCard">
                <Setter Property="VerticalOptions" Value="Start" />
            </Style>

            <Style x:Key="FocusFieldEntry"
                   TargetType="Entry"
                   BasedOn="{StaticResource BasicFieldEntry}">
                <Setter Property="behaviors:Focus.FocusedThickness" Value="2.5" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <Grid Style="{StaticResource WizardRootGrid}"
          RowDefinitions="Auto,*">

        <!-- Step -->
        <cmc:StepIndicator Grid.Row="0"
                           Style="{StaticResource BasicStepIndicator}"
                           behaviors:AnimationOption.EnterAnimation="FadeUp"
                           CurrentStep="1" TotalSteps="3" />

        <!-- Step 1 - Data1 -->
        <controls:InfoCard Grid.Row="1"
                           Style="{StaticResource WizardCard}"
                           behaviors:AnimationOption.EnterAnimation="FadeUp"
                           behaviors:AnimationOption.EnterDelay="80"
                           Title="Step 1 - Data1"
                           Icon="{x:Static fonts:MaterialIcons.Edit}">
            <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                <Label Style="{StaticResource BasicFieldCaptionLabel}"
                       Text="Data1" />
                <Border Style="{StaticResource CardFieldBorder}">
                    <Entry Style="{StaticResource FocusFieldEntry}"
                           Text="{Binding Context.Data1}"
                           Placeholder="e.g. Apple" />
                </Border>
            </VerticalStackLayout>
        </controls:InfoCard>

    </Grid>

</ContentView>
