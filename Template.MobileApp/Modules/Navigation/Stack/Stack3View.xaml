<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Navigation.Stack"
             x:Class="Template.MobileApp.Modules.Navigation.Stack.Stack3View"
             x:DataType="{x:Type module:Stack3ViewModel}"
             s:BindingContextResolver.Type="{x:Type module:Stack3ViewModel}"
             shell:ShellProperty.Title="Stack3"
             shell:ShellProperty.Function1Text="Pop-1"
             shell:ShellProperty.Function2Text="Pop-2"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="LevelIconBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource BasicIconCircleBorder}">
                <Setter Property="BackgroundColor" Value="{StaticResource DeepPurpleLighten5}" />
            </Style>

            <Style x:Key="LevelIconLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicIconCircleLabel}">
                <Setter Property="TextColor" Value="{StaticResource DeepPurpleDefault}" />
            </Style>

            <Style x:Key="LevelStepIndicator"
                   TargetType="controls:StepIndicator">
                <Setter Property="AccentColor" Value="{StaticResource DeepPurpleDefault}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid Style="{StaticResource RootGrid}">

        <Border Style="{StaticResource CardCenterBorder}"
                behaviors:AnimationOption.EnterAnimation="Pop">
            <VerticalStackLayout Style="{StaticResource CardStack}">

                <Border Style="{StaticResource LevelIconBorder}">
                    <Label Style="{StaticResource LevelIconLabel}"
                           Text="{x:Static fonts:MaterialIcons.Looks_3}" />
                </Border>

                <Label Style="{StaticResource BasicCenterTitleLabel}"
                       Text="Stack Level 3" />

                <controls:StepIndicator Style="{StaticResource LevelStepIndicator}"
                                        CurrentStep="3" TotalSteps="3" />

                <BoxView Style="{StaticResource CardDivider}" />

                <Label Style="{StaticResource BasicCenterHintLabel}"
                       Text="Pop-1 → Level 2&#x0a;Pop-2 → Level 1" />

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentView>
