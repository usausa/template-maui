<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Navigation.Effect"
             x:Class="Template.MobileApp.Modules.Navigation.Effect.EffectDialogView"
             x:DataType="{x:Type module:EffectDialogViewModel}"
             s:BindingContextResolver.Type="{x:Type module:EffectDialogViewModel}"
             shell:ShellProperty.Title="Dialog Demo"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Page -->

            <Style x:Key="DialogCardBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource CardCenterBorder}">
                <Setter Property="Margin" Value="32,16" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="OverlayGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="#B3263238" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <Grid Style="{StaticResource OverlayGrid}">

        <Border Style="{StaticResource DialogCardBorder}">
            <VerticalStackLayout Style="{StaticResource CardStack}">

                <!-- Header -->
                <Border Style="{StaticResource BasicWarningIconBorder}">
                    <Label Style="{StaticResource BasicWarningIconLabel}"
                           Text="{x:Static fonts:MaterialIcons.Extension}" />
                </Border>

                <Label Style="{StaticResource BasicCenterTitleLabel}"
                       Text="Dialog Demo" />

                <!-- Detail -->
                <Grid Style="{StaticResource CardInfoGrid}"
                      ColumnDefinitions="2*,3*">
                    <Label Grid.Column="0"
                           Style="{StaticResource BasicItemNameLabel}"
                           Text="Applied" />
                    <Label Grid.Column="1"
                           Style="{StaticResource BasicItemValueLabel}"
                           Text="{Binding AppliedEffect}" />
                </Grid>

                <BoxView Style="{StaticResource CardDivider}" />

                <!-- Action -->
                <Button Style="{StaticResource BasicFilledButton}"
                        Command="{Binding CloseCommand}"
                        Text="Close" />

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentView>
