<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:entity="clr-namespace:Template.MobileApp.Models.Entity"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Navigation.Edit"
             x:Class="Template.MobileApp.Modules.Navigation.Edit.EditListView"
             x:DataType="{x:Type module:EditListViewModel}"
             s:BindingContextResolver.Type="{x:Type module:EditListViewModel}"
             shell:ShellProperty.Title="List"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function3Text="{Binding IsSelectionMode, Converter={s:BoolToText True='Cancel', False='Select'}}"
             shell:ShellProperty.Function4Text="New"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="WorkRowGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="WorkRowContentGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="16,6,8,6" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="ColumnSpacing" Value="10" />
            </Style>

            <Style x:Key="WorkRowSeparator"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource GrayLighten2}" />
            </Style>

            <Style x:Key="WorkIdBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="MinimumWidthRequest" Value="44" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="WorkIdLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="WorkIconButton"
                   TargetType="Button">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

            <Style x:Key="WorkEditButton"
                   TargetType="Button"
                   BasedOn="{StaticResource WorkIconButton}">
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="WorkDeleteButton"
                   TargetType="Button"
                   BasedOn="{StaticResource WorkIconButton}">
                <Setter Property="TextColor" Value="{StaticResource RedDefault}" />
            </Style>

            <Style x:Key="WorkNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="SelectionBarBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten2}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16,16,0,0" />
            </Style>

            <Style x:Key="SelectionCountLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken2}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="SelectionBarButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

            <Style x:Key="SelectionBarButtonDanger"
                   TargetType="Button"
                   BasedOn="{StaticResource SelectionBarButton}">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource RedDefault}" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>

            <Style x:Key="SelectionBarGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="8" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <!-- Content -->
    <Grid Style="{StaticResource RootGrid}"
          RowDefinitions="*,Auto">

        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Items}"
                        SelectionMode="{Binding SelectionMode}"
                        SelectedItems="{Binding SelectedItems}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Style="{StaticResource BasicEmptyStack}">
                    <Border Style="{StaticResource BasicEmptyIconBorder}">
                        <Label Style="{StaticResource BasicEmptyIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Inbox}" />
                    </Border>
                    <Label Style="{StaticResource BasicCenterTitleLabel}"
                           Text="No items" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type entity:WorkEntity}">
                    <Grid x:Name="RowGrid"
                          Style="{StaticResource WorkRowGrid}"
                          RowDefinitions="*,Auto">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter TargetName="RowGrid" Property="Grid.BackgroundColor" Value="{StaticResource AmberLighten4}" />
                                            <Setter TargetName="IdBorder" Property="Border.BackgroundColor" Value="White" />
                                            <Setter TargetName="IdLabel" Property="Label.TextColor" Value="{StaticResource BrownDarken1}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                        <Grid Grid.Row="0"
                              Style="{StaticResource WorkRowContentGrid}"
                              ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border x:Name="IdBorder"
                                    Grid.Column="0"
                                    Style="{StaticResource WorkIdBorder}">
                                <Label x:Name="IdLabel"
                                       Style="{StaticResource WorkIdLabel}"
                                       Text="{Binding Id, StringFormat='#{0}'}" />
                            </Border>
                            <Label x:Name="NameLabel"
                                   Grid.Column="1"
                                   Style="{StaticResource WorkNameLabel}"
                                   Text="{Binding Name}" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource WorkEditButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type module:EditListViewModel}}, Path=SelectCommand, x:DataType={x:Type module:EditListViewModel}}"
                                    CommandParameter="{Binding}"
                                    Text="{x:Static fonts:MaterialIcons.Edit}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type module:EditListViewModel}}, Path=IsSelectionMode, x:DataType={x:Type module:EditListViewModel}}"
                                                 Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="3"
                                    Style="{StaticResource WorkDeleteButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type module:EditListViewModel}}, Path=DeleteCommand, x:DataType={x:Type module:EditListViewModel}}"
                                    CommandParameter="{Binding}"
                                    Text="{x:Static fonts:MaterialIcons.Delete}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type module:EditListViewModel}}, Path=IsSelectionMode, x:DataType={x:Type module:EditListViewModel}}"
                                                 Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                        <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                        <BoxView Grid.Row="1"
                                 Style="{StaticResource WorkRowSeparator}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="1"
                Style="{StaticResource SelectionBarBorder}"
                IsVisible="{Binding IsSelectionMode}">
            <Grid Style="{StaticResource SelectionBarGrid}"
                  ColumnDefinitions="*,Auto,Auto">
                <Label Grid.Column="0"
                       Style="{StaticResource SelectionCountLabel}"
                       Text="{Binding SelectedItems.Count, StringFormat='{0} selected'}" />
                <Button Grid.Column="1"
                        Style="{StaticResource SelectionBarButton}"
                        Command="{Binding SelectAllCommand}"
                        Text="Select all" />
                <Button Grid.Column="2"
                        Style="{StaticResource SelectionBarButtonDanger}"
                        Command="{Binding BulkDeleteCommand}"
                        Text="Delete" />
            </Grid>
        </Border>

    </Grid>

</ContentView>
