<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Main"
             xmlns:diagnostics="clr-namespace:Template.MobileApp.Diagnostics" xmlns:logging="clr-namespace:Microsoft.Extensions.Logging;assembly=Microsoft.Extensions.Logging.Abstractions"
             x:Class="Template.MobileApp.Modules.Main.DiagnosticsView"
             x:DataType="{x:Type module:DiagnosticsViewModel}"
             s:BindingContextResolver.Type="{x:Type module:DiagnosticsViewModel}"
             shell:ShellProperty.Title="Diagnostics"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="SectionNameLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource NameLabel}">
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>

            <Style x:Key="LastSendStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="0,6" />
                <Setter Property="Spacing" Value="4" />
            </Style>

            <Style x:Key="LastSendRowStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="LastSendTimeLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
            </Style>

            <Style x:Key="EmptyNoteLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicFieldCaptionLabel}">
                <Setter Property="Margin" Value="0,4" />
            </Style>

            <Style x:Key="ActionRowGrid"
                   TargetType="Grid"
                   BasedOn="{StaticResource BasicButtonGrid}">
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>

            <Style x:Key="DeleteButton"
                   TargetType="Button"
                   BasedOn="{StaticResource BasicIconOutlinedButton}">
                <Setter Property="TextColor" Value="{StaticResource RedDefault}" />
            </Style>

            <converters:ByteSizeConverter x:Key="ByteSizeConverter" />
            <converters:DurationConverter x:Key="DurationConverter" />

            <!-- テレメトリの送信中 / 未送信のクラッシュ -->
            <s:BoolToTextConverter x:Key="TelemetryTextConverter"
                                   TrueValue="Sending"
                                   FalseValue="Stopped" />
            <converters:MapToToneConverter x:Key="TelemetryToneConverter">
                <converters:MapToToneConverter.Entries>
                    <converters:MapToToneEntry Key="{s:Bool Value=True}"
                                               Value="Success" />
                </converters:MapToToneConverter.Entries>
            </converters:MapToToneConverter>
            <s:BoolToTextConverter x:Key="CrashPendingTextConverter"
                                   TrueValue="Not sent"
                                   FalseValue="None" />
            <converters:MapToToneConverter x:Key="CrashPendingToneConverter">
                <converters:MapToToneConverter.Entries>
                    <converters:MapToToneEntry Key="{s:Bool Value=True}"
                                               Value="Warning" />
                </converters:MapToToneConverter.Entries>
            </converters:MapToToneConverter>

            <!-- 直近の送信の成否 -->
            <s:BoolToTextConverter x:Key="SendResultTextConverter"
                                   TrueValue="Succeeded"
                                   FalseValue="Failed" />
            <converters:MapToToneConverter x:Key="SendResultToneConverter">
                <converters:MapToToneConverter.Entries>
                    <converters:MapToToneEntry Key="{s:Bool Value=True}"
                                               Value="Success" />
                    <converters:MapToToneEntry Key="{s:Bool Value=False}"
                                               Value="Error" />
                </converters:MapToToneConverter.Entries>
            </converters:MapToToneConverter>

            <!-- ログレベル -->
            <s:MapToColorConverter x:Key="LogLevelColorConverter"
                                   DefaultValue="{StaticResource RedDefault}">
                <s:MapToColorConverter.Entries>
                    <s:MapToColorEntry Key="{x:Static logging:LogLevel.Warning}"
                                       Value="{StaticResource OrangeDefault}" />
                </s:MapToColorConverter.Entries>
            </s:MapToColorConverter>

            <!-- 無効時は文字と枠を薄くする -->
            <Style x:Key="EntryStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="4" />
            </Style>

            <!-- ログファイル / 直近のログの行 -->
            <Style x:Key="EntryGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="8" />
                <Setter Property="Padding" Value="0,2" />
            </Style>

            <Style x:Key="EntryNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="EntryValueLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
            </Style>

            <Style x:Key="LogTimeLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource EntryValueLabel}">
                <Setter Property="HorizontalTextAlignment" Value="Start" />
            </Style>

            <Style x:Key="LogLevelLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Start" />
            </Style>

            <Style x:Key="LogMessageLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="LogCategorySpan"
                   TargetType="Span">
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="ReportLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
                <Setter Property="LineBreakMode" Value="CharacterWrap" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <!-- Device -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Device"
                               Icon="{x:Static fonts:MaterialIcons.Smartphone}">
                <Grid Style="{StaticResource CardNameValueGrid}"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnDefinitions="2*,3*">
                    <Label Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Name" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding DeviceName}" />
                    <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="OS" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding DeviceVersion}" />
                    <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Processors" />
                    <Label Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding ProcessorCount}" />
                    <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="3" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Device ID" />
                    <Label Grid.Row="3" Grid.Column="1"
                           Style="{StaticResource CardMonoValueLabel}"
                           Text="{Binding DeviceId}" />
                </Grid>
            </controls:InfoCard>

            <!-- Application -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="60"
                               Title="Application"
                               Icon="{x:Static fonts:MaterialIcons.Apps}">
                <Grid Style="{StaticResource CardNameValueGrid}"
                      RowDefinitions="Auto"
                      ColumnDefinitions="2*,3*">
                    <Label Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Installation" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource CardMonoValueLabel}"
                           Text="{Binding InstallationId}" />
                </Grid>
            </controls:InfoCard>

            <!-- Startup -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="120"
                               Title="Startup"
                               Icon="{x:Static fonts:MaterialIcons.Rocket_launch}">
                <Grid Style="{StaticResource CardNameValueGrid}"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="2*,3*">
                    <Label Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Started" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource CardMonoValueLabel}"
                           Text="{Binding StartedAt, StringFormat='{0:yyyy/MM/dd HH:mm:ss}'}" />
                    <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Uptime" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding Uptime, Converter={StaticResource DurationConverter}}" />
                    <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Initialize" />
                    <Label Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding InitializationTime, Converter={StaticResource DurationConverter}}" />
                </Grid>
            </controls:InfoCard>

            <!-- Database -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="180"
                               Title="Database"
                               Icon="{x:Static fonts:MaterialIcons.Storage}">
                <Grid Style="{StaticResource CardNameValueGrid}"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="2*,3*">
                    <Label Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Path" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource CardMonoValueLabel}"
                           Text="{Binding Database.Path}" />
                    <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Size" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding Database.Size, Converter={StaticResource ByteSizeConverter}}" />
                    <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Modified" />
                    <Label Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource CardMonoValueLabel}"
                           Text="{Binding Database.Modified, StringFormat='{0:yyyy/MM/dd HH:mm:ss}'}" />
                    <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="3" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Data" />
                    <Label Grid.Row="3" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding Database.DataCount, StringFormat='{0:N0} rows'}" />
                    <BoxView Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="4" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Work" />
                    <Label Grid.Row="4" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding Database.WorkCount, StringFormat='{0:N0} rows'}" />
                    <BoxView Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="5" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="BulkData" />
                    <Label Grid.Row="5" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding Database.BulkDataCount, StringFormat='{0:N0} rows'}" />
                </Grid>
            </controls:InfoCard>

            <!-- Connection -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="Connection"
                               Icon="{x:Static fonts:MaterialIcons.Lan}">
                <Grid Style="{StaticResource CardNameValueGrid}"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnDefinitions="2*,3*">
                    <Label Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Login" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           IsVisible="{Binding IsAuthenticated}"
                           Text="{Binding LoginId}" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           IsVisible="{Binding IsAuthenticated, Converter={StaticResource ReverseConverter}}"
                           Text="Not logged in" />
                    <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Token expires" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource CardMonoValueLabel}"
                           Text="{Binding TokenExpires, StringFormat='{0:yyyy/MM/dd HH:mm:ss}'}" />
                    <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Network" />
                    <Label Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding DeviceState.NetworkAccess}" />
                    <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="3" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Profile" />
                    <Label Grid.Row="3" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding DeviceState.NetworkProfile}" />
                </Grid>
            </controls:InfoCard>

            <!-- Telemetry -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="300"
                               Title="Telemetry"
                               Icon="{x:Static fonts:MaterialIcons.Insights}">
                <Grid Style="{StaticResource CardNameValueGrid}"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnDefinitions="2*,3*">
                    <Label Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Status" />
                    <controls:StatusChip Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource CardValueChip}"
                                         Text="{Binding TelemetryActive, Converter={StaticResource TelemetryTextConverter}}"
                                         Tone="{Binding TelemetryActive, Converter={StaticResource TelemetryToneConverter}}" />
                    <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Last send" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           IsVisible="{Binding LastSend, Converter={StaticResource EmptyConverter}}"
                           Text="-" />
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                                         Style="{StaticResource LastSendStack}"
                                         IsVisible="{Binding LastSend, Converter={StaticResource NotEmptyConverter}}">
                        <HorizontalStackLayout Style="{StaticResource LastSendRowStack}">
                            <controls:StatusChip Text="{Binding LastSend.Succeeded, Converter={StaticResource SendResultTextConverter}, FallbackValue=''}"
                                                 Tone="{Binding LastSend.Succeeded, Converter={StaticResource SendResultToneConverter}, FallbackValue=Neutral}" />
                            <Label Style="{StaticResource LastSendTimeLabel}"
                                   Text="{Binding LastSend.Time, StringFormat='{0:HH:mm:ss}', FallbackValue=''}" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource BasicFieldCaptionLabel}"
                               IsVisible="{Binding LastSend.Reason, Converter={StaticResource NotEmptyConverter}, FallbackValue=False}"
                               Text="{Binding LastSend.Reason, FallbackValue=''}" />
                    </VerticalStackLayout>
                    <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Resend" />
                    <Label Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding ResendWaitingCount, StringFormat='{0} waiting'}" />
                    <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource CardRowDivider}" />

                    <Label Grid.Row="3" Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Crash" />
                    <controls:StatusChip Grid.Row="3" Grid.Column="1"
                                         Style="{StaticResource CardValueChip}"
                                         Text="{Binding CrashPending, Converter={StaticResource CrashPendingTextConverter}}"
                                         Tone="{Binding CrashPending, Converter={StaticResource CrashPendingToneConverter}}" />
                </Grid>
            </controls:InfoCard>

            <!-- Log -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="360"
                               Title="Log"
                               Icon="{x:Static fonts:MaterialIcons.Receipt_long}">
                <VerticalStackLayout Style="{StaticResource EntryStack}">
                    <Label Style="{StaticResource NameLabel}"
                           Text="Files" />
                    <Label Style="{StaticResource EmptyNoteLabel}"
                           IsVisible="{Binding LogFiles.Count, Converter={StaticResource EqualsConverter}, ConverterParameter={s:Int32 Value=0}}"
                           Text="None" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LogFiles}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type module:LogFileInfo}">
                                <Grid Style="{StaticResource EntryGrid}"
                                      ColumnDefinitions="*,Auto,Auto">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource EntryNameLabel}"
                                           Text="{Binding Name}" />
                                    <Label Grid.Column="1"
                                           Style="{StaticResource EntryValueLabel}"
                                           Text="{Binding Size, Converter={StaticResource ByteSizeConverter}}" />
                                    <Label Grid.Column="2"
                                           Style="{StaticResource EntryValueLabel}"
                                           Text="{Binding Modified, StringFormat='{0:MM/dd HH:mm}'}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Style="{StaticResource SectionNameLabel}"
                           Text="Recent" />
                    <Label Style="{StaticResource EmptyNoteLabel}"
                           IsVisible="{Binding RecentLogs.Count, Converter={StaticResource EqualsConverter}, ConverterParameter={s:Int32 Value=0}}"
                           Text="No warnings or errors" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentLogs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type diagnostics:DiagnosticLogEntry}">
                                <Grid Style="{StaticResource EntryGrid}"
                                      RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="Auto,*">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource LogLevelLabel}"
                                           Text="{Binding Level}"
                                           TextColor="{Binding Level, Converter={StaticResource LogLevelColorConverter}}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource LogTimeLabel}"
                                           Text="{Binding Time, StringFormat='{0:MM/dd HH:mm:ss}'}" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Style="{StaticResource LogMessageLabel}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource LogCategorySpan}"
                                                      Text="{Binding Category}" />
                                                <Span Text=": " />
                                                <Span Text="{Binding Message}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid Style="{StaticResource ActionRowGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding ShareLogsCommand}"
                                Text="Share files"
                                ImageSource="{x:Static markup:AppIcons.SmallShare}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource DeleteButton}"
                                Command="{Binding DeleteLogsCommand}"
                                Text="Delete files"
                                ImageSource="{x:Static markup:AppIcons.DiagnosticsDelete}" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <!-- Crash -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="420"
                               Title="Crash report"
                               Icon="{x:Static fonts:MaterialIcons.Bug_report}">
                <VerticalStackLayout Style="{StaticResource EntryStack}">
                    <Label Style="{StaticResource EmptyNoteLabel}"
                           IsVisible="{Binding LastCrashReport, Converter={StaticResource EmptyConverter}}"
                           Text="None" />
                    <Label Style="{StaticResource ReportLabel}"
                           IsVisible="{Binding LastCrashReport, Converter={StaticResource NotEmptyConverter}}"
                           Text="{Binding LastCrashReport}" />
                    <Grid Style="{StaticResource ActionRowGrid}"
                          ColumnDefinitions="*">
                        <Button Style="{StaticResource DeleteButton}"
                                Command="{Binding ClearCrashReportCommand}"
                                Text="Clear"
                                ImageSource="{x:Static markup:AppIcons.DiagnosticsDelete}" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
