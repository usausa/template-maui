<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Main"
             x:Class="Template.MobileApp.Modules.Main.MenuView"
             x:DataType="{x:Type module:MenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:MenuViewModel}"
             shell:ShellProperty.Title="Menu"
             shell:ShellProperty.FunctionVisible="False">

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="*,Auto">
        <!-- 9 段構成。関連する項目は横に並べ、余り行は可視の無効ボタンにする -->
        <Grid Grid.Row="0"
              Style="{StaticResource MenuGrid}"
              RowDefinitions="*,*,*,*,*,*,*,*,*"
              ColumnDefinitions="*,*">
            <Button Grid.Row="0" Grid.ColumnSpan="2"
                    Style="{StaticResource MenuIconButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId BasicMenu}"
                    Text="Basic"
                    ImageSource="{x:Static markup:AppIcons.Widgets}" />
            <Button Grid.Row="1" Grid.ColumnSpan="2"
                    Style="{StaticResource MenuIconButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId NavigationMenu}"
                    Text="Navigation"
                    ImageSource="{x:Static markup:AppIcons.Navigation}" />
            <Button Grid.Row="2" Grid.ColumnSpan="2"
                    Style="{StaticResource MenuIconButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId DeviceMenu}"
                    Text="Device"
                    ImageSource="{x:Static markup:AppIcons.Devices}" />
            <Button Grid.Row="3" Grid.Column="0"
                    Style="{StaticResource MenuIconButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId Data}"
                    Text="Data"
                    ImageSource="{x:Static markup:AppIcons.Storage}" />
            <Button Grid.Row="3" Grid.Column="1"
                    Style="{StaticResource MenuIconButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId NetworkMenu}"
                    Text="Network"
                    ImageSource="{x:Static markup:AppIcons.Cloud}" />
            <Button Grid.Row="4" Grid.ColumnSpan="2"
                    Style="{StaticResource MenuIconButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId ViewMenu}"
                    Text="View"
                    ImageSource="{x:Static markup:AppIcons.Layers}" />
            <Button Grid.Row="5" Grid.Column="0"
                    Style="{StaticResource MenuIconButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId UIMenu1}"
                    Text="UI 1"
                    ImageSource="{x:Static markup:AppIcons.Palette}" />
            <Button Grid.Row="5" Grid.Column="1"
                    Style="{StaticResource MenuIconButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId UIMenu2}"
                    Text="UI 2"
                    ImageSource="{x:Static markup:AppIcons.Insights}" />
            <Button Grid.Row="6" Grid.Column="0"
                    Style="{StaticResource MenuIconButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId SampleMenu}"
                    Text="Sample"
                    ImageSource="{x:Static markup:AppIcons.Science}" />
            <Button Grid.Row="6" Grid.Column="1"
                    Style="{StaticResource MenuIconButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId AppMenu}"
                    Text="App"
                    ImageSource="{x:Static markup:AppIcons.Apps}" />
            <Button Grid.Row="7" Grid.ColumnSpan="2"
                    Style="{StaticResource MenuIconButton}"
                    IsEnabled="False"
                    Text="" />
            <Button Grid.Row="8" Grid.ColumnSpan="2"
                    Style="{StaticResource MenuIconButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId Setting}"
                    Text="Setting"
                    ImageSource="{x:Static markup:AppIcons.Settings}" />
        </Grid>

        <FlexLayout Grid.Row="1"
                    Style="{StaticResource FooterFlexLayout}">
            <Label Style="{StaticResource FooterInfoLabel}"
                   Text="{Binding Flavor, StringFormat='{0} flavor'}" />
            <Label Style="{StaticResource FooterInfoLabel}"
                   Text="{Binding Version, StringFormat='Version {0}'}" />
        </FlexLayout>
    </Grid>

</ContentView>
