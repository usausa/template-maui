<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:services="clr-namespace:Template.MobileApp.Services"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Network"
             x:Class="Template.MobileApp.Modules.Network.NetworkGrpcView"
             x:DataType="{x:Type module:NetworkGrpcViewModel}"
             s:BindingContextResolver.Type="{x:Type module:NetworkGrpcViewModel}"
             shell:ShellProperty.Title="gRPC"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Connect"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <!-- gRPC チャット (双方向ストリーミング、管理画面 /chat と相互) と単項 RPC -->

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="ChatEmptyStack"
                   TargetType="VerticalStackLayout"
                   BasedOn="{StaticResource BasicEmptyStack}">
                <Setter Property="Padding" Value="24,0" />
            </Style>

            <Style x:Key="PageGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="12" />
                <Setter Property="RowSpacing" Value="12" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten5}" />
            </Style>

            <Style x:Key="AddressLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken1}" />
                <Setter Property="LineBreakMode" Value="CharacterWrap" />
            </Style>

            <Style x:Key="StateChip"
                   TargetType="controls:StatusChip">
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>

            <s:MapToTextConverter x:Key="StateTextConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static services:ChatConnectionState.Disconnected}"
                                      Value="Disconnected" />
                    <s:MapToTextEntry Key="{x:Static services:ChatConnectionState.Connecting}"
                                      Value="Connecting" />
                    <s:MapToTextEntry Key="{x:Static services:ChatConnectionState.Connected}"
                                      Value="Connected" />
                    <s:MapToTextEntry Key="{x:Static services:ChatConnectionState.Reconnecting}"
                                      Value="Reconnecting" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToBoolConverter x:Key="StateBusyConverter">
                <s:MapToBoolConverter.Entries>
                    <s:MapToBoolEntry Key="{x:Static services:ChatConnectionState.Connecting}"
                                      Value="True" />
                    <s:MapToBoolEntry Key="{x:Static services:ChatConnectionState.Reconnecting}"
                                      Value="True" />
                </s:MapToBoolConverter.Entries>
            </s:MapToBoolConverter>

            <converters:MapToToneConverter x:Key="StateToneConverter">
                <converters:MapToToneConverter.Entries>
                    <converters:MapToToneEntry Key="{x:Static services:ChatConnectionState.Connecting}"
                                               Value="Warning" />
                    <converters:MapToToneEntry Key="{x:Static services:ChatConnectionState.Connected}"
                                               Value="Success" />
                    <converters:MapToToneEntry Key="{x:Static services:ChatConnectionState.Reconnecting}"
                                               Value="Warning" />
                </converters:MapToToneConverter.Entries>
            </converters:MapToToneConverter>

            <Style x:Key="ChatBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten1}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="ChatCollection"
                   TargetType="CollectionView">
                <Setter Property="ItemsUpdatingScrollMode" Value="KeepLastItemInView" />
                <Setter Property="SelectionMode" Value="None" />
            </Style>

            <Style x:Key="MessageGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="12,8,12,0" />
                <Setter Property="RowSpacing" Value="4" />
            </Style>

            <Style x:Key="UserBadgeBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <Style x:Key="UserBadgeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
            </Style>

            <Style x:Key="MessageTimeLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
            </Style>

            <Style x:Key="MessageDivider"
                   TargetType="BoxView">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource GrayLighten3}" />
            </Style>

            <Style x:Key="SendButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid Style="{StaticResource PageGrid}"
          RowDefinitions="Auto,*,Auto">

        <controls:InfoCard Grid.Row="0"
                           behaviors:AnimationOption.EnterAnimation="FadeUp"
                           Title="Connection"
                           Icon="{x:Static fonts:MaterialIcons.Hub}">
            <VerticalStackLayout Style="{StaticResource CardContentStack}">
                <Label Style="{StaticResource AddressLabel}"
                       Text="{Binding AddressDisplay}" />
                <controls:StatusChip Style="{StaticResource StateChip}"
                                     Icon="{x:Static fonts:MaterialIcons.Sync}"
                                     Text="{Binding State, Converter={StaticResource StateTextConverter}}"
                                     IconSpin="{Binding State, Converter={StaticResource StateBusyConverter}}"
                                     Tone="{Binding State, Converter={StaticResource StateToneConverter}}" />
                <Border Style="{StaticResource CardErrorBorder}"
                        IsVisible="{Binding LastError, Converter={StaticResource NotEmptyConverter}}">
                    <Grid Style="{StaticResource CardErrorGrid}"
                          ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Style="{StaticResource CardErrorIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Error_outline}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource CardErrorLabel}"
                               Text="{Binding LastError}" />
                    </Grid>
                </Border>
                <Grid Style="{StaticResource CardNameValueGrid}"
                      ColumnDefinitions="2*,3*">
                    <Label Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Pending sends" />
                    <Label Grid.Column="1"
                           Style="{StaticResource CardValueLabel}"
                           Text="{Binding PendingCount, StringFormat='{0}'}" />
                </Grid>
                <Button Style="{StaticResource BasicOutlinedButton}"
                        Command="{Binding ServerTimeCommand}"
                        Text="Server time (unary RPC)" />
                <Grid Style="{StaticResource CardNameValueGrid}"
                      ColumnDefinitions="2*,3*">
                    <Label Grid.Column="0"
                           Style="{StaticResource CardNameLabel}"
                           Text="Server time" />
                    <Label Grid.Column="1"
                           Style="{StaticResource CardMonoValueLabel}"
                           Text="{Binding ServerTime}" />
                </Grid>
            </VerticalStackLayout>
        </controls:InfoCard>

        <Border Grid.Row="1"
                Style="{StaticResource ChatBorder}"
                behaviors:AnimationOption.EnterAnimation="FadeUp"
                behaviors:AnimationOption.EnterDelay="80">
            <Grid>
                <VerticalStackLayout Style="{StaticResource ChatEmptyStack}"
                                     IsVisible="{Binding IsEmpty}">
                    <Border Style="{StaticResource BasicEmptyIconBorder}">
                        <Label Style="{StaticResource BasicEmptyIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Forum}" />
                    </Border>
                    <Label Style="{StaticResource BasicCenterHintLabel}"
                           Text="No messages yet" />
                </VerticalStackLayout>
                <CollectionView Style="{StaticResource ChatCollection}"
                                ItemsSource="{Binding Messages}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type services:ChatMessageEntry}">
                            <Grid Style="{StaticResource MessageGrid}"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto">
                                <Border Grid.Row="0" Grid.Column="0"
                                        Style="{StaticResource UserBadgeBorder}">
                                    <Label Style="{StaticResource UserBadgeLabel}"
                                           Text="{Binding User}" />
                                </Border>
                                <Label Grid.Row="0" Grid.Column="1"
                                       Style="{StaticResource MessageTimeLabel}"
                                       Text="{Binding Timestamp, StringFormat='{0:HH:mm:ss}'}" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Style="{StaticResource BasicBodyLabel}"
                                       Text="{Binding Text}" />
                                <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                         Style="{StaticResource MessageDivider}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Style="{StaticResource BasicButtonGrid}"
              ColumnDefinitions="*,Auto">
            <Border Grid.Column="0"
                    Style="{StaticResource CardFieldBorder}">
                <Entry Style="{StaticResource BasicFieldEntry}"
                       Text="{Binding Input}"
                       Placeholder="Message"
                       ReturnType="Send"
                       ReturnCommand="{Binding SendCommand}" />
            </Border>
            <Button Grid.Column="1"
                    Style="{StaticResource SendButton}"
                    Command="{Binding SendCommand}"
                    Text="{x:Static fonts:MaterialIcons.Send}" />
        </Grid>

    </Grid>

</ContentView>
