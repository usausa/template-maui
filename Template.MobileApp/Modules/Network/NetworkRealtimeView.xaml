<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Network"
             x:Class="Template.MobileApp.Modules.Network.NetworkRealtimeView"
             x:DataType="{x:Type module:NetworkRealtimeViewModel}"
             s:BindingContextResolver.Type="{x:Type module:NetworkRealtimeViewModel}"
             shell:ShellProperty.Title="Realtime"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Connect"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="StateChip"
                   TargetType="controls:StatusChip">
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>

            <s:MapToTextConverter x:Key="StateTextConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static module:RealtimeState.Stopped}"
                                      Value="Stopped" />
                    <s:MapToTextEntry Key="{x:Static module:RealtimeState.Connecting}"
                                      Value="Connecting" />
                    <s:MapToTextEntry Key="{x:Static module:RealtimeState.Connected}"
                                      Value="Connected" />
                    <s:MapToTextEntry Key="{x:Static module:RealtimeState.Reconnecting}"
                                      Value="Reconnecting" />
                    <s:MapToTextEntry Key="{x:Static module:RealtimeState.Error}"
                                      Value="Error" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToBoolConverter x:Key="StateBusyConverter">
                <s:MapToBoolConverter.Entries>
                    <s:MapToBoolEntry Key="{x:Static module:RealtimeState.Connecting}"
                                      Value="True" />
                    <s:MapToBoolEntry Key="{x:Static module:RealtimeState.Reconnecting}"
                                      Value="True" />
                </s:MapToBoolConverter.Entries>
            </s:MapToBoolConverter>

            <converters:MapToToneConverter x:Key="StateToneConverter">
                <converters:MapToToneConverter.Entries>
                    <converters:MapToToneEntry Key="{x:Static module:RealtimeState.Connecting}"
                                               Value="Warning" />
                    <converters:MapToToneEntry Key="{x:Static module:RealtimeState.Connected}"
                                               Value="Success" />
                    <converters:MapToToneEntry Key="{x:Static module:RealtimeState.Reconnecting}"
                                               Value="Warning" />
                    <converters:MapToToneEntry Key="{x:Static module:RealtimeState.Error}"
                                               Value="Error" />
                </converters:MapToToneConverter.Entries>
            </converters:MapToToneConverter>

            <Style x:Key="StatGraph"
                   TargetType="controls:StatControl">
                <Setter Property="HeightRequest" Value="120" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Connection"
                               Icon="{x:Static fonts:MaterialIcons.Sync}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <controls:StatusChip Style="{StaticResource StateChip}"
                                         Icon="{x:Static fonts:MaterialIcons.Sync}"
                                         Text="{Binding State, Converter={StaticResource StateTextConverter}}"
                                         IconSpin="{Binding State, Converter={StaticResource StateBusyConverter}}"
                                         Tone="{Binding State, Converter={StaticResource StateToneConverter}}" />
                    <Border Style="{StaticResource CardErrorBorder}"
                            IsVisible="{Binding LastError, Converter={StaticResource NotEmptyConverter}}">
                        <Grid Style="{StaticResource CardErrorGrid}"
                              ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardErrorIconLabel}"
                                   Text="{x:Static fonts:MaterialIcons.Error_outline}" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource CardErrorLabel}"
                                   Text="{Binding LastError}" />
                        </Grid>
                    </Border>
                    <Grid Style="{StaticResource CardNameValueGrid}"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="2*,3*">
                        <Label Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource CardNameLabel}"
                               Text="Connection ID" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource CardMonoValueLabel}"
                               Text="{Binding ConnectionId}" />
                        <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                 Style="{StaticResource CardRowDivider}" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource CardNameLabel}"
                               Text="Server time" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource CardMonoValueLabel}"
                               Text="{Binding ServerTime}" />
                        <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                 Style="{StaticResource CardRowDivider}" />

                        <Label Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource CardNameLabel}"
                               Text="Status reports" />
                        <Label Grid.Row="2" Grid.Column="1"
                               Style="{StaticResource CardValueLabel}"
                               Text="{Binding ReportCount, StringFormat='{0} (every 10 s)'}" />
                    </Grid>
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicOutlinedButton}"
                                Command="{Binding ReconnectCommand}"
                                Text="Reconnect" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicOutlinedButton}"
                                Command="{Binding ReportCommand}"
                                Text="Send status" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:StatControl Style="{StaticResource StatGraph}"
                                  behaviors:AnimationOption.EnterAnimation="FadeUp"
                                  behaviors:AnimationOption.EnterDelay="80"
                                  DataSet="{Binding CpuLoadSet}"
                                  GraphColor="{StaticResource BlueDefault}"
                                  Label="Server CPU" />

            <controls:StatControl Style="{StaticResource StatGraph}"
                                  behaviors:AnimationOption.EnterAnimation="FadeUp"
                                  behaviors:AnimationOption.EnterDelay="160"
                                  DataSet="{Binding MemoryLoadSet}"
                                  GraphColor="{StaticResource GreenDefault}"
                                  Label="Server memory" MaxValue="512" Unit="MB" />

            <controls:StatControl Style="{StaticResource StatGraph}"
                                  behaviors:AnimationOption.EnterAnimation="FadeUp"
                                  behaviors:AnimationOption.EnterDelay="240"
                                  DataSet="{Binding ConnectionSet}"
                                  GraphColor="{StaticResource OrangeDefault}"
                                  Label="Connections" MaxValue="10" Unit="" ValueFormat="F0" />

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="320"
                               Title="Notifications"
                               Icon="{x:Static fonts:MaterialIcons.Notifications}">
                <VerticalStackLayout Style="{StaticResource CardSmallContentStack}"
                                     BindableLayout.ItemsSource="{Binding Notifications}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type x:String}">
                            <Label Style="{StaticResource CardLogLabel}"
                                   Text="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    <BindableLayout.EmptyView>
                        <Label Style="{StaticResource BasicCaptionLabel}"
                               Text="Notifications from Devices in the dashboard" />
                    </BindableLayout.EmptyView>
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
