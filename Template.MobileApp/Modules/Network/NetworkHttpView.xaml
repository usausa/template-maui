<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Network"
             x:Class="Template.MobileApp.Modules.Network.NetworkHttpView"
             x:DataType="{x:Type module:NetworkHttpViewModel}"
             s:BindingContextResolver.Type="{x:Type module:NetworkHttpViewModel}"
             shell:ShellProperty.Title="HTTP (Data)"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Reload"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="ListCollection"
                   TargetType="CollectionView">
                <Setter Property="HeightRequest" Value="240" />
                <Setter Property="SelectionMode" Value="Single" />
            </Style>

            <Style x:Key="ListRowGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="ColumnSpacing" Value="8" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="CountBadgeBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <Style x:Key="CountBadgeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
            </Style>

            <Style x:Key="RowIdBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueGrayLighten5}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 4" />
            </Style>

            <Style x:Key="RowIdLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken1}" />
            </Style>

            <Style x:Key="RedButton"
                   TargetType="Button"
                   BasedOn="{StaticResource BasicIconOutlinedButton}">
                <Setter Property="TextColor" Value="{StaticResource RedDefault}" />
            </Style>

            <Style x:Key="RowNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Data"
                               Icon="{x:Static fonts:MaterialIcons.Table_rows}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <Border Style="{StaticResource CountBadgeBorder}">
                        <Label Style="{StaticResource CountBadgeLabel}"
                               Text="{Binding Total, StringFormat='{0} total'}" />
                    </Border>
                    <Grid>
                        <CollectionView Style="{StaticResource ListCollection}"
                                        ItemsSource="{Binding Items}"
                                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                        RemainingItemsThreshold="5"
                                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Style="{StaticResource BasicEmptyStack}"
                                                     IsVisible="{Binding IsEmpty}">
                                    <Border Style="{StaticResource BasicEmptyIconBorder}">
                                        <Label Style="{StaticResource BasicEmptyIconLabel}"
                                               Text="{x:Static fonts:MaterialIcons.Inbox}" />
                                    </Border>
                                    <Label Style="{StaticResource BasicCenterTitleLabel}"
                                           Text="No data" />
                                    <Label Style="{StaticResource BasicCenterHintLabel}"
                                           Text="Add with Create" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="{x:Type module:DataListItem}">
                                    <Grid x:Name="RowGrid"
                                          Style="{StaticResource ListRowGrid}"
                                          ColumnDefinitions="Auto,*">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroupList>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter TargetName="RowGrid" Property="Grid.BackgroundColor" Value="{StaticResource BlueDefault}" />
                                                            <Setter TargetName="NameLabel" Property="Label.TextColor" Value="White" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateGroupList>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border Grid.Column="0"
                                                Style="{StaticResource RowIdBorder}">
                                            <Label Style="{StaticResource RowIdLabel}"
                                                   Text="{Binding Id, StringFormat='#{0}'}" />
                                        </Border>
                                        <Label x:Name="NameLabel"
                                               Grid.Column="1"
                                               Style="{StaticResource RowNameLabel}"
                                               Text="{Binding Name}" />
                                        <BoxView Grid.Column="0" Grid.ColumnSpan="2"
                                                 Style="{StaticResource CardRowDivider}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <ActivityIndicator Style="{StaticResource BasicLoadingIndicator}"
                                           IsRunning="{Binding Loading}"
                                           IsVisible="{Binding Loading}" />
                    </Grid>
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="2*,*">
                        <Entry Grid.Column="0"
                               Style="{StaticResource BasicEntry}"
                               Text="{Binding Name}"
                               Placeholder="Name" />
                        <Entry Grid.Column="1"
                               Style="{StaticResource BasicEntry}"
                               Text="{Binding Value}"
                               Placeholder="Value"
                               Keyboard="Numeric" />
                    </Grid>
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*,*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicFilledButton}"
                                Command="{Binding CreateCommand}"
                                Text="Create" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding UpdateCommand}"
                                Text="Update"
                                ImageSource="{x:Static markup:AppIcons.SmallEdit}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RedButton}"
                                Command="{Binding DeleteCommand}"
                                Text="Delete"
                                ImageSource="{x:Static markup:AppIcons.NetworkDelete}" />
                        <Button Grid.Column="3"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding ClearCommand}"
                                Text="Clear"
                                ImageSource="{x:Static markup:AppIcons.SmallUndo}" />
                    </Grid>
                    <Button Style="{StaticResource BasicIconOutlinedButton}"
                            Command="{Binding SaveToWorkCommand}"
                            Text="Save all to Work"
                            ImageSource="{x:Static markup:AppIcons.SmallCloudSync}" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="80"
                               Title="Test API"
                               Icon="{x:Static fonts:MaterialIcons.Bug_report}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding TestErrorCommand}"
                                Text="Error (500)"
                                ImageSource="{x:Static markup:AppIcons.SmallDoNotDisturb}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding TestDelayCommand}"
                                Text="Delay (5s)"
                                ImageSource="{x:Static markup:AppIcons.SmallAlarm}" />
                    </Grid>
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding DelayCommand}"
                                Text="Delay (10s)"
                                ImageSource="{x:Static markup:AppIcons.SmallDownloading}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource RedButton}"
                                Command="{Binding CancelCommand}"
                                Text="Cancel"
                                ImageSource="{x:Static markup:AppIcons.NetworkCancel}" />
                    </Grid>
                    <ActivityIndicator IsRunning="{Binding Delaying}"
                                       IsVisible="{Binding Delaying}" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="160"
                               Title="Log"
                               Icon="{x:Static fonts:MaterialIcons.Receipt_long}">
                <VerticalStackLayout Style="{StaticResource CardSmallContentStack}"
                                     BindableLayout.ItemsSource="{Binding Logs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type x:String}">
                            <Label Style="{StaticResource CardLogLabel}"
                                   Text="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    <BindableLayout.EmptyView>
                        <Label Style="{StaticResource BasicCaptionLabel}"
                               Text="No calls yet" />
                    </BindableLayout.EmptyView>
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
