<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Network"
             x:Class="Template.MobileApp.Modules.Network.NetworkAuthView"
             x:DataType="{x:Type module:NetworkAuthViewModel}"
             s:BindingContextResolver.Type="{x:Type module:NetworkAuthViewModel}"
             shell:ShellProperty.Title="HTTP (Auth)"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- 認証 API。ID だけでログイン (JWT)、JWT が必要な API の呼び出し、無効なトークンでの再ログイン再送 -->

    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="LoginStateGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="LoginStateBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource BasicEmptyIconBorder}">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            </Style>

            <Style x:Key="LoginStateIconLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicEmptyIconLabel}">
                <Setter Property="FontSize" Value="24" />
            </Style>

            <Style x:Key="LoginStateChip"
                   TargetType="controls:StatusChip">
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <converters:MapToToneConverter x:Key="LoginToneConverter">
                <converters:MapToToneConverter.Entries>
                    <converters:MapToToneEntry Key="{s:Bool Value=True}"
                                               Value="Success" />
                </converters:MapToToneConverter.Entries>
            </converters:MapToToneConverter>

        </ResourceDictionary>
    </ContentView.Resources>

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Log in"
                               Icon="{x:Static fonts:MaterialIcons.Vpn_key}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <Grid Style="{StaticResource LoginStateGrid}"
                          ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0"
                                Style="{StaticResource LoginStateBorder}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsAuthenticated}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource GreenLighten4}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Style="{StaticResource LoginStateIconLabel}"
                                   Text="{x:Static fonts:MaterialIcons.Lock}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsAuthenticated}"
                                                 Value="True">
                                        <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Lock_open}" />
                                        <Setter Property="TextColor" Value="{StaticResource GreenDarken2}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <controls:StatusChip Grid.Column="1"
                                             Style="{StaticResource LoginStateChip}"
                                             Text="{Binding IsAuthenticated, Converter={s:BoolToText True='Signed in', False='Signed out'}}"
                                             Tone="{Binding IsAuthenticated, Converter={StaticResource LoginToneConverter}}" />
                        <Label Grid.Column="2"
                               Style="{StaticResource CardValueLabel}"
                               Text="{Binding AuthenticatedId}" />
                    </Grid>
                    <Grid Style="{StaticResource CardNameValueGrid}"
                          ColumnDefinitions="2*,3*">
                        <Label Grid.Column="0"
                               Style="{StaticResource CardNameLabel}"
                               Text="Token expiry" />
                        <Label Grid.Column="1"
                               Style="{StaticResource CardMonoValueLabel}"
                               Text="{Binding TokenExpires, StringFormat='{0:yyyy/MM/dd HH:mm:ss}', TargetNullValue='-'}" />
                    </Grid>
                    <BoxView Style="{StaticResource CardDivider}" />
                    <VerticalStackLayout Style="{StaticResource CardFieldGroupStack}">
                        <Label Style="{StaticResource BasicFieldCaptionLabel}"
                               Text="Login ID" />
                        <Border Style="{StaticResource CardFieldBorder}">
                            <Entry Style="{StaticResource BasicFieldEntry}"
                                   Text="{Binding LoginId}"
                                   Placeholder="e.g. user" />
                        </Border>
                    </VerticalStackLayout>
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicFilledButton}"
                                Command="{Binding LoginCommand}"
                                Text="Log in" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicOutlinedCancelButton}"
                                Command="{Binding LogoutCommand}"
                                Text="Log out" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="80"
                               Title="JWT API"
                               Icon="{x:Static fonts:MaterialIcons.Verified_user}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding SecureCommand}"
                                Text="Call Secure"
                                ImageSource="{x:Static markup:AppIcons.SmallLock}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicOutlinedCancelButton}"
                                Command="{Binding InvalidateCommand}"
                                Text="Revoke token" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
