<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Network"
             x:Class="Template.MobileApp.Modules.Network.NetworkMenuView"
             x:DataType="{x:Type module:NetworkMenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:NetworkMenuViewModel}"
             shell:ShellProperty.Title="Network"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="*,*,*,*,*,*,*,*,*"
          ColumnDefinitions="*,*">
        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ServerTimeCommand}"
                Text="Get server time"
                ImageSource="{x:Static markup:AppIcons.Schedule}" />

        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding DataListCommand}"
                Text="Data list"
                ImageSource="{x:Static markup:AppIcons.ListAlt}" />

        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding SecureCommand}"
                Text="Secure"
                ImageSource="{x:Static markup:AppIcons.Lock}" />

        <Button Grid.Row="3" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding LoginCommand}"
                Text="Login"
                ImageSource="{x:Static markup:AppIcons.Login}" />
        <Button Grid.Row="3" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding LogoutCommand}"
                Text="Logout"
                ImageSource="{x:Static markup:AppIcons.Logout}" />

        <Button Grid.Row="4" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding DownloadCommand}"
                Text="Download"
                ImageSource="{x:Static markup:AppIcons.Download}" />
        <Button Grid.Row="4" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding UploadCommand}"
                Text="Upload"
                ImageSource="{x:Static markup:AppIcons.Upload}" />

        <Button Grid.Row="5" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding TestErrorCommand}"
                CommandParameter="{s:Int32 500}"
                Text="Error"
                ImageSource="{x:Static markup:AppIcons.ErrorOutline}" />
        <Button Grid.Row="5" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding TestDelayCommand}"
                CommandParameter="{s:Int32 5000}"
                Text="Delay"
                ImageSource="{x:Static markup:AppIcons.HourglassEmpty}" />

        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId NetworkRealtime}"
                Text="Realtime"
                ImageSource="{x:Static markup:AppIcons.Sync}" />

        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId NetworkScp}"
                Text="SCP"
                ImageSource="{x:Static markup:AppIcons.CloudUpload}" />

        <Button Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource MenuButton}"
                IsEnabled="False"
                Text="" />
    </Grid>

</ContentView>
