<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Network"
             x:Class="Template.MobileApp.Modules.Network.NetworkSftpView"
             x:DataType="{x:Type module:NetworkSftpViewModel}"
             s:BindingContextResolver.Type="{x:Type module:NetworkSftpViewModel}"
             shell:ShellProperty.Title="SFTP"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="FingerprintLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken1}" />
                <Setter Property="LineBreakMode" Value="CharacterWrap" />
            </Style>

            <Style x:Key="TransferProgressBar"
                   TargetType="ProgressBar">
                <Setter Property="ProgressColor" Value="{StaticResource BlueDefault}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="接続先"
                               Icon="{x:Static fonts:MaterialIcons.Dns}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <Label Style="{StaticResource BasicBodyLabel}"
                           Text="{Binding HostDisplay}" />
                    <Label Style="{StaticResource BasicCaptionLabel}"
                           IsVisible="{Binding ServerFingerprint, Converter={StaticResource NotEmptyConverter}}"
                           Text="サーバのホスト鍵指紋 (参考表示)" />
                    <Label Style="{StaticResource FingerprintLabel}"
                           IsVisible="{Binding ServerFingerprint, Converter={StaticResource NotEmptyConverter}}"
                           Text="{Binding ServerFingerprint}" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="80"
                               Title="転送"
                               Icon="{x:Static fonts:MaterialIcons.Sync_alt}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <Entry Style="{StaticResource BasicEntry}"
                           IsEnabled="{Binding Configured}"
                           Text="{Binding RemoteFileName}"
                           Placeholder="リモートファイル名" />
                    <ProgressBar Style="{StaticResource TransferProgressBar}"
                                 Progress="{Binding Progress}" />
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicOutlinedButton}"
                                Command="{Binding UploadCommand}"
                                Text="アップロード" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicOutlinedButton}"
                                Command="{Binding DownloadCommand}"
                                Text="ダウンロード" />
                        <Button Grid.Column="2"
                                Style="{StaticResource BasicOutlinedCancelButton}"
                                Command="{Binding CancelCommand}"
                                Text="キャンセル" />
                    </Grid>
                    <Label Style="{StaticResource BasicCaptionLabel}"
                           Text="アップロードは FilePicker で選んだファイルをリモートのホームへ、ダウンロードは上のファイル名を公開フォルダへ取得する" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="160"
                               Title="ログ"
                               Icon="{x:Static fonts:MaterialIcons.Receipt_long}">
                <VerticalStackLayout Style="{StaticResource CardSmallContentStack}"
                                     BindableLayout.ItemsSource="{Binding Logs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type x:String}">
                            <Label Style="{StaticResource CardLogLabel}"
                                   Text="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    <BindableLayout.EmptyView>
                        <Label Style="{StaticResource BasicCaptionLabel}"
                               Text="まだ転送していません" />
                    </BindableLayout.EmptyView>
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
