<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:drawing="clr-namespace:Template.MobileApp.Graphics.Drawing"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Sample"
             x:Class="Template.MobileApp.Modules.Sample.SampleCvNetView"
             x:DataType="{x:Type module:SampleCvNetViewModel}"
             s:BindingContextResolver.Type="{x:Type module:SampleCvNetViewModel}"
             shell:ShellProperty.Title="CV Net"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="{Binding State, Converter={s:CompareToText True='', False='Out'}, ConverterParameter={x:Static module:CaptureState.Result}}"
             shell:ShellProperty.Function3Text="{Binding State, Converter={s:CompareToText True='', False='In'}, ConverterParameter={x:Static module:CaptureState.Result}}"
             shell:ShellProperty.Function4Text="{Binding State, Converter={s:CompareToText True='Retry', False='Detect'}, ConverterParameter={x:Static module:CaptureState.Result}}"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="{Binding State, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:CaptureState.Preview}}"
             shell:ShellProperty.Function3Enabled="{Binding State, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:CaptureState.Preview}}"
             shell:ShellProperty.Function4Enabled="{Binding State, Converter={StaticResource ActionEnabledConverter}}">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Converter -->

            <s:MapToBoolConverter x:Key="PreviewVisibleConverter">
                <s:MapToBoolConverter.Entries>
                    <s:MapToBoolEntry Key="{x:Static module:CaptureState.Preview}"
                                      Value="True" />
                    <s:MapToBoolEntry Key="{x:Static module:CaptureState.Capturing}"
                                      Value="True" />
                </s:MapToBoolConverter.Entries>
            </s:MapToBoolConverter>

            <s:MapToBoolConverter x:Key="ImageVisibleConverter">
                <s:MapToBoolConverter.Entries>
                    <s:MapToBoolEntry Key="{x:Static module:CaptureState.Analyzing}"
                                      Value="True" />
                    <s:MapToBoolEntry Key="{x:Static module:CaptureState.Result}"
                                      Value="True" />
                </s:MapToBoolConverter.Entries>
            </s:MapToBoolConverter>

            <s:MapToBoolConverter x:Key="ActionEnabledConverter">
                <s:MapToBoolConverter.Entries>
                    <s:MapToBoolEntry Key="{x:Static module:CaptureState.Preview}"
                                      Value="True" />
                    <s:MapToBoolEntry Key="{x:Static module:CaptureState.Result}"
                                      Value="True" />
                </s:MapToBoolConverter.Entries>
            </s:MapToBoolConverter>

            <s:CompareToColorConverter x:Key="FeatureBackgroundConverter"
                                       TrueValue="{StaticResource BlueDefault}"
                                       FalseValue="White" />

            <s:CompareToColorConverter x:Key="FeatureTextColorConverter"
                                       TrueValue="White"
                                       FalseValue="{StaticResource BlueGrayDarken2}" />

            <!-- Result -->

            <Style x:Key="CaptureImage"
                   TargetType="Image">
                <Setter Property="BackgroundColor" Value="Black" />
            </Style>

            <!-- Tag -->

            <Style x:Key="TagPanelBorder"
                   TargetType="Border">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="Margin" Value="12" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="BackgroundColor" Value="#B3000000" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="TagPanelLabel"
                   TargetType="Label">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="1.3" />
            </Style>

            <!-- Flash -->

            <Style x:Key="ShutterFlashBoxView"
                   TargetType="BoxView">
                <Setter Property="Color" Value="White" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="InputTransparent" Value="True" />
            </Style>

            <!-- Feature -->

            <Style x:Key="FeatureGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="8" />
                <Setter Property="ColumnSpacing" Value="8" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="FeatureButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="{StaticResource GrayLighten1}" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <!-- Content -->
    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="*,Auto">

        <!-- Camera -->
        <mct:CameraView Grid.Row="0"
                        behaviors:CameraBind.Controller="{Binding Controller}"
                        IsVisible="{Binding State, Converter={StaticResource PreviewVisibleConverter}}" />

        <!-- Result -->
        <Image Grid.Row="0"
               Style="{StaticResource CaptureImage}"
               Source="{Binding Image}"
               IsVisible="{Binding State, Converter={StaticResource ImageVisibleConverter}}" />
        <drawing:DrawingControl Grid.Row="0"
                                IsVisible="{Binding State, Converter={StaticResource ImageVisibleConverter}}"
                                Drawing="{Binding Drawing}" />

        <!-- Tag -->
        <Border Grid.Row="0"
                Style="{StaticResource TagPanelBorder}"
                IsVisible="{Binding TagsText, Converter={StaticResource NotEmptyConverter}}">
            <Label Style="{StaticResource TagPanelLabel}"
                   Text="{Binding TagsText}" />
        </Border>

        <!-- Overlay -->
        <controls:CameraOverlayView Grid.Row="0"
                                    IsVisible="{Binding State, Converter={StaticResource PreviewVisibleConverter}}" />

        <!-- Flash -->
        <BoxView Grid.Row="0"
                 Style="{StaticResource ShutterFlashBoxView}"
                 behaviors:AnimationOption.FlashTrigger="{Binding CaptureCount}" />

        <!-- Feature -->
        <Grid Grid.Row="1"
              Style="{StaticResource FeatureGrid}"
              ColumnDefinitions="*,*,*,*"
              IsEnabled="{Binding State, Converter={StaticResource ActionEnabledConverter}}">
            <Button Grid.Column="0"
                    Style="{StaticResource FeatureButton}"
                    Command="{Binding SelectFeatureCommand}"
                    CommandParameter="{x:Static module:VisionFeature.Objects}"
                    Text="Object"
                    BackgroundColor="{Binding Feature, Converter={StaticResource FeatureBackgroundConverter}, ConverterParameter={x:Static module:VisionFeature.Objects}}"
                    TextColor="{Binding Feature, Converter={StaticResource FeatureTextColorConverter}, ConverterParameter={x:Static module:VisionFeature.Objects}}" />
            <Button Grid.Column="1"
                    Style="{StaticResource FeatureButton}"
                    Command="{Binding SelectFeatureCommand}"
                    CommandParameter="{x:Static module:VisionFeature.Tags}"
                    Text="Tag"
                    BackgroundColor="{Binding Feature, Converter={StaticResource FeatureBackgroundConverter}, ConverterParameter={x:Static module:VisionFeature.Tags}}"
                    TextColor="{Binding Feature, Converter={StaticResource FeatureTextColorConverter}, ConverterParameter={x:Static module:VisionFeature.Tags}}" />
            <Button Grid.Column="2"
                    Style="{StaticResource FeatureButton}"
                    Command="{Binding SelectFeatureCommand}"
                    CommandParameter="{x:Static module:VisionFeature.People}"
                    Text="People"
                    BackgroundColor="{Binding Feature, Converter={StaticResource FeatureBackgroundConverter}, ConverterParameter={x:Static module:VisionFeature.People}}"
                    TextColor="{Binding Feature, Converter={StaticResource FeatureTextColorConverter}, ConverterParameter={x:Static module:VisionFeature.People}}" />
            <Button Grid.Column="3"
                    Style="{StaticResource FeatureButton}"
                    Command="{Binding SelectFeatureCommand}"
                    CommandParameter="{x:Static module:VisionFeature.Ocr}"
                    Text="OCR"
                    BackgroundColor="{Binding Feature, Converter={StaticResource FeatureBackgroundConverter}, ConverterParameter={x:Static module:VisionFeature.Ocr}}"
                    TextColor="{Binding Feature, Converter={StaticResource FeatureTextColorConverter}, ConverterParameter={x:Static module:VisionFeature.Ocr}}" />
        </Grid>

    </Grid>

</ContentView>
