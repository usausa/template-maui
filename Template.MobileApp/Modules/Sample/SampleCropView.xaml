<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:drawing="clr-namespace:Template.MobileApp.Graphics.Drawing"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Sample"
             x:Class="Template.MobileApp.Modules.Sample.SampleCropView"
             x:DataType="{x:Type module:SampleCropViewModel}"
             s:BindingContextResolver.Type="{x:Type module:SampleCropViewModel}"
             shell:ShellProperty.Title="Crop"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Result -->

            <Style x:Key="PanelBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16,16,0,0" />
            </Style>

            <Style x:Key="PreviewBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="88" />
                <Setter Property="HeightRequest" Value="88" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten2}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="PreviewEmptyIconLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicIconCircleLabel}">
                <Setter Property="FontSize" Value="36" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
            </Style>

            <Style x:Key="CropButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken2}" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

            <Style x:Key="CropButtonPrimary"
                   TargetType="Button"
                   BasedOn="{StaticResource CropButton}">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="ExportResultGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>

            <Style x:Key="ExportResultStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="8" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="CropButtonStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="8" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <!-- Content -->
    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="*,Auto">

        <!-- Crop -->
        <drawing:DrawingControl Grid.Row="0"
                                Drawing="{Binding Crop}" />

        <!-- Result -->
        <Border Grid.Row="1"
                Style="{StaticResource PanelBorder}">
            <Grid Style="{StaticResource ExportResultGrid}"
                  ColumnDefinitions="Auto,*">
                <Border Grid.Column="0"
                        Style="{StaticResource PreviewBorder}">
                    <Grid>
                        <Label Style="{StaticResource PreviewEmptyIconLabel}"
                               IsVisible="{Binding CroppedImage, Converter={StaticResource EmptyConverter}}"
                               Text="{x:Static fonts:MaterialIcons.Crop}" />
                        <Image Source="{Binding CroppedImage}"
                               Aspect="AspectFit" />
                    </Grid>
                </Border>
                <VerticalStackLayout Grid.Column="1"
                                     Style="{StaticResource ExportResultStack}">
                    <Label Style="{StaticResource BasicFieldCaptionLabel}"
                           Text="{Binding ResultText}" />
                    <HorizontalStackLayout Style="{StaticResource CropButtonStack}">
                        <Button Style="{StaticResource CropButtonPrimary}"
                                Command="{Binding ExportCommand}"
                                Text="Export" />
                        <Button Style="{StaticResource CropButton}"
                                Command="{Binding ResetCommand}"
                                Text="Reset" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentView>
