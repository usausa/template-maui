<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Sample"
             x:Class="Template.MobileApp.Modules.Sample.SampleMap1View"
             x:DataType="{x:Type module:SampleMap1ViewModel}"
             s:BindingContextResolver.Type="{x:Type module:SampleMap1ViewModel}"
             shell:ShellProperty.Title="Map"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Layer"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="MapFabStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Margin" Value="0,16,16,0" />
                <Setter Property="Spacing" Value="12" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Start" />
            </Style>

            <Style x:Key="MapFabButton"
                   TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="BackgroundColor" Value="#E6FFFFFF" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Offset="0,2"
                                Brush="Black"
                                Opacity="0.3"
                                Radius="6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LayerSheet"
                   TargetType="cmc:BottomSheetView">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="HalfExpandedRatio" Value="0.5" />
            </Style>

            <Style x:Key="LayerSheetStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="20,8,20,20" />
            </Style>

            <Style x:Key="ToggleRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="4" />
                <Setter Property="HeightRequest" Value="44" />
            </Style>

            <Style x:Key="ToggleNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
            </Style>

            <Style x:Key="ToggleSwitch"
                   TargetType="Switch">
                <Setter Property="Scale" Value="0.8" />
                <Setter Property="HorizontalOptions" Value="End" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid Style="{StaticResource FillGrid}">

        <maps:Map behaviors:MapBind.Controller="{Binding Controller}"
                  ItemsSource="{Binding Spots}"
                  MapType="{Binding CurrentMapType}">
            <maps:Map.ItemTemplate>
                <DataTemplate x:DataType="{x:Type sample:MapSpot}">
                    <maps:Pin Address="{Binding Description}"
                              Label="{Binding Name}"
                              Location="{Binding Location}" />
                </DataTemplate>
            </maps:Map.ItemTemplate>
        </maps:Map>

        <VerticalStackLayout Style="{StaticResource MapFabStack}">
            <ImageButton Style="{StaticResource MapFabButton}"
                         Source="{x:Static markup:AppIcons.MapHome}"
                         Command="{Binding HomeCommand}" />
        </VerticalStackLayout>

        <cmc:BottomSheetView Style="{StaticResource LayerSheet}"
                             IsOpen="{Binding IsLayerOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="module:SampleMap1ViewModel">
                    <VerticalStackLayout Style="{StaticResource LayerSheetStack}">
                        <Grid Style="{StaticResource ToggleRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource ToggleNameLabel}"
                                   Text="🛰️ Hybrid" />
                            <Switch Grid.Column="1"
                                    Style="{StaticResource ToggleSwitch}"
                                    IsToggled="{Binding HybridEnabled}" />
                        </Grid>
                        <Grid Style="{StaticResource ToggleRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource ToggleNameLabel}"
                                   Text="🛣️ Route" />
                            <Switch Grid.Column="1"
                                    Style="{StaticResource ToggleSwitch}"
                                    IsToggled="{Binding RouteVisible}" />
                        </Grid>
                        <Grid Style="{StaticResource ToggleRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource ToggleNameLabel}"
                                   Text="🟩 Area" />
                            <Switch Grid.Column="1"
                                    Style="{StaticResource ToggleSwitch}"
                                    IsToggled="{Binding AreaVisible}" />
                        </Grid>
                        <Grid Style="{StaticResource ToggleRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource ToggleNameLabel}"
                                   Text="🔴 Circle" />
                            <Switch Grid.Column="1"
                                    Style="{StaticResource ToggleSwitch}"
                                    IsToggled="{Binding CircleVisible}" />
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>

    </Grid>

</ContentView>
