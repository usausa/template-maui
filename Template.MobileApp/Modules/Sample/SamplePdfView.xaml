<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Sample"
             xmlns:pdf="clr-namespace:Maui.PDFView;assembly=Maui.PDFView"
             x:Class="Template.MobileApp.Modules.Sample.SamplePdfView"
             x:DataType="{x:Type module:SamplePdfViewModel}"
             s:BindingContextResolver.Type="{x:Type module:SamplePdfViewModel}"
             shell:ShellProperty.Title="PDF"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function3Text="Prev"
             shell:ShellProperty.Function4Text="Next"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function3Enabled="{Binding CanMovePrev}"
             shell:ShellProperty.Function4Enabled="{Binding CanMoveNext}">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="PageEdgeButton"
                   TargetType="Button">
                <Setter Property="WidthRequest" Value="56" />
                <Setter Property="VerticalOptions" Value="Fill" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style x:Key="PrevPageEdgeButton"
                   TargetType="Button"
                   BasedOn="{StaticResource PageEdgeButton}">
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>

            <Style x:Key="NextPageEdgeButton"
                   TargetType="Button"
                   BasedOn="{StaticResource PageEdgeButton}">
                <Setter Property="HorizontalOptions" Value="End" />
            </Style>

            <Style x:Key="PageBarGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="16,4" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="PageSlider"
                   TargetType="Slider">
                <Setter Property="ThumbColor" Value="{StaticResource BlueDarken2}" />
                <Setter Property="MinimumTrackColor" Value="{StaticResource BlueDarken2}" />
                <Setter Property="MaximumTrackColor" Value="{StaticResource GrayLighten1}" />
            </Style>

            <Style x:Key="PageNumberLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicMonoLabel}">
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="*,Auto">

        <pdf:PdfView Grid.Row="0"
                     PageIndex="{Binding PageIndex, Mode=TwoWay}"
                     MaxZoom="4"
                     PageChangedCommand="{Binding PageChangedCommand}"
                     Uri="{Binding PdfSource}" />

        <!-- 画面端タップで前後ページ -->
        <Button Grid.Row="0"
                Style="{StaticResource PrevPageEdgeButton}"
                Command="{Binding PrevPageCommand}"
                IsEnabled="{Binding CanMovePrev}" />
        <Button Grid.Row="0"
                Style="{StaticResource NextPageEdgeButton}"
                Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanMoveNext}" />

        <Grid Grid.Row="1"
              Style="{StaticResource PageBarGrid}"
              ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0"
                    Style="{StaticResource PageSlider}"
                    Value="{Binding PageIndex, Mode=TwoWay}"
                    Minimum="0"
                    Maximum="{Binding MaxPageIndex}" />
            <Label Grid.Column="1"
                   Style="{StaticResource PageNumberLabel}"
                   Text="{Binding PageInformation}" />
        </Grid>

    </Grid>

</ContentView>
