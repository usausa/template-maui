<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.App"
             x:Class="Template.MobileApp.Modules.App.AppMenuView"
             x:DataType="{x:Type module:AppMenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:AppMenuViewModel}"
             shell:ShellProperty.Title="App"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="*,*,*,*,*,*,*,*,*">
        <Button Grid.Row="0"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId AppCalc}"
                Text="Calculator" />
        <Button Grid.Row="1"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId AppGame}"
                Text="Sudoku" />
        <Button Grid.Row="2"
                Style="{StaticResource MenuButton}"
                IsEnabled="False" />
        <Button Grid.Row="3"
                Style="{StaticResource MenuButton}"
                IsEnabled="False" />
        <Button Grid.Row="4"
                Style="{StaticResource MenuButton}"
                IsEnabled="False" />
        <Button Grid.Row="5"
                Style="{StaticResource MenuButton}"
                IsEnabled="False" />
        <Button Grid.Row="6"
                Style="{StaticResource MenuButton}"
                IsEnabled="False" />
        <Button Grid.Row="7"
                Style="{StaticResource MenuButton}"
                IsEnabled="False" />
        <Button Grid.Row="8"
                Style="{StaticResource MenuButton}"
                IsEnabled="False" />
    </Grid>

</ContentView>
