<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.App"
             x:Class="Template.MobileApp.Modules.App.AppMenuView"
             x:DataType="{x:Type module:AppMenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:AppMenuViewModel}"
             shell:ShellProperty.Title="App"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="*,*,*,*,*,*,*,*,*">
        <Button Grid.Row="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId AppCalc}"
                Text="Calculator"
                ImageSource="{x:Static markup:AppIcons.Calculate}" />
        <Button Grid.Row="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId AppTimer}"
                Text="Timer"
                ImageSource="{x:Static markup:AppIcons.Timer}" />
        <Button Grid.Row="2"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId AppTodo}"
                Text="ToDo"
                ImageSource="{x:Static markup:AppIcons.Checklist}" />
        <Button Grid.Row="3"
                Style="{StaticResource MenuButton}"
                IsEnabled="False" />
        <Button Grid.Row="4"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId AppSudoku}"
                Text="Sudoku"
                ImageSource="{x:Static markup:AppIcons.GridOn}" />
        <Button Grid.Row="5"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId AppPuzzle2048}"
                Text="2048"
                ImageSource="{x:Static markup:AppIcons.Grid4X4}" />
        <Button Grid.Row="6"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId AppMinesweeper}"
                Text="Minesweeper"
                ImageSource="{x:Static markup:AppIcons.Flag}" />
        <Button Grid.Row="7"
                Style="{StaticResource MenuButton}"
                IsEnabled="False" />
        <Button Grid.Row="8"
                Style="{StaticResource MenuButton}"
                IsEnabled="False" />
    </Grid>

</ContentView>
