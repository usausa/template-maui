<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:clam="clr-namespace:ClamGrid;assembly=ClamGrid"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIGridColumnView"
             x:DataType="{x:Type module:UIGridColumnViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIGridColumnViewModel}"
             shell:ShellProperty.Title="Grid Column"
             shell:ShellProperty.Function1Text="Cancel"
             shell:ShellProperty.Function4Text="Apply"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Grid -->

            <Style x:Key="SettingsGrid"
                   TargetType="clam:ClamGridView"
                   BasedOn="{StaticResource ClamGridBase}">
                <Setter Property="RowHeadersVisible" Value="True" />
                <Setter Property="RowHeaderWidth" Value="56" />
                <Setter Property="RowHeaderBackground" Value="#F5F7FA" />
                <Setter Property="CornerText" Value="" />
            </Style>

            <!-- Header -->

            <Style x:Key="ColumnCaptionLabel"
                   TargetType="Label">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken2}" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <!-- Message -->

            <Style x:Key="ColumnMessageLabel"
                   TargetType="Label">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten5}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Label Grid.Row="0"
               Style="{StaticResource ColumnCaptionLabel}"
               Text="一覧の表示項目" />

        <!-- Column list -->
        <clam:ClamGridView Grid.Row="1"
                           ItemsSource="{Binding Rows}"
                           AllowColumnConfiguration="False" AllowColumnResizing="False" AllowRowDragging="True"
                           CellValueChangedCommand="{Binding CellValueChangedCommand}"
                           Style="{StaticResource SettingsGrid}"
                           IsReadOnly="False"
                           RowMovedCommand="{Binding RowMovedCommand}"
                           RowMover="{Binding RowMover}"
                           ValueAccessors="{x:Static module:ColumnOptionAccessors.Option}">
            <clam:GridColumn Key="IsVisible"
                             Width="72"
                             Header="表示"
                             Alignment="Center" AllowSorting="False" IsBoolean="True" />
            <clam:GridColumn Key="Header"
                             Width="*" MinWidth="120"
                             Header="項目"
                             AllowSorting="False" />
        </clam:ClamGridView>

        <!-- Message -->
        <Label Grid.Row="2"
               Style="{StaticResource ColumnMessageLabel}"
               Text="{Binding Message}" />
    </Grid>

</ContentView>
