<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIMonitorView"
             x:DataType="{x:Type module:UIMonitorViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIMonitorViewModel}"
             shell:ShellProperty.Title="Monitor"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Range"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Color -->

            <Color x:Key="BoardBackColor">#111217</Color>
            <Color x:Key="PanelBackColor">#181B1F</Color>
            <Color x:Key="PanelLineColor">#1FCCCCDC</Color>
            <Color x:Key="PanelTextColor">#CCCCDC</Color>

            <!-- Panel -->

            <Style x:Key="BoardStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="4" />
                <Setter Property="Spacing" Value="4" />
                <Setter Property="BackgroundColor" Value="{StaticResource BoardBackColor}" />
            </Style>

            <Style x:Key="PanelBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="BackgroundColor" Value="{StaticResource PanelBackColor}" />
                <Setter Property="Stroke" Value="{StaticResource PanelLineColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 6" />
            </Style>

            <Style x:Key="PanelGrid"
                   TargetType="Grid">
                <Setter Property="RowSpacing" Value="2" />
            </Style>

            <Style x:Key="PanelTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource PanelTextColor}" />
            </Style>

            <Style x:Key="TileGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="4" />
            </Style>

            <!-- Chart -->

            <Style x:Key="StatTile"
                   TargetType="clam:ClamStatView">
                <Setter Property="HeightRequest" Value="86" />
                <Setter Property="ColorMode" Value="Background" />
                <Setter Property="ContentPadding" Value="6" />
                <Setter Property="FillMode" Value="Gradient" />
                <Setter Property="GradientStrength" Value="1" />
                <Setter Property="LayoutMode" Value="Horizontal" />
                <Setter Property="TrendPlacement" Value="Background" />
                <Setter Property="UpdateAnimationEnabled" Value="False" />
                <Setter Property="ValueFontSize" Value="26" />
            </Style>

            <Style x:Key="BoardChartBase"
                   TargetType="clam:ChartViewBase"
                   ApplyToDerivedTypes="True">
                <Setter Property="ContentPadding" Value="0" />
                <Setter Property="MutedTextColor" Value="#9CCCCCDC" />
                <Setter Property="PrimaryTextColor" Value="{StaticResource PanelTextColor}" />
                <Setter Property="SecondaryTextColor" Value="#A6CCCCDC" />
                <Setter Property="TooltipBackground" Value="#F022252B" />
                <Setter Property="TooltipBorderColor" Value="{StaticResource PanelLineColor}" />
                <Setter Property="TooltipTextColor" Value="{StaticResource PanelTextColor}" />
                <Setter Property="TrackColor" Value="#22252B" />
                <Setter Property="UpdateAnimationEnabled" Value="False" />
            </Style>

            <Style x:Key="BoardChart"
                   TargetType="clam:ClamChartView"
                   BasedOn="{StaticResource BoardChartBase}">
                <Setter Property="TrackballMode" Value="LongPress" />
                <Setter Property="TrackballSnapEnabled" Value="False" />
                <Setter Property="TrackingGroup" Value="monitor" />
                <Setter Property="TrackingGroupMode" Value="Tooltip" />
                <Setter Property="ValueAccessors" Value="{x:Static sample:MonitorSample.Accessors}" />
                <Setter Property="XKey" Value="time" />
            </Style>

            <Style x:Key="BoardTableChart"
                   TargetType="clam:ClamChartView"
                   BasedOn="{StaticResource BoardChart}">
                <Setter Property="LegendMode" Value="Table" />
                <Setter Property="LegendValues" Value="Last,Max" />
                <Setter Property="LegendToggleEnabled" Value="True" />
            </Style>

            <Style x:Key="BoardLegendChart"
                   TargetType="clam:ClamChartView"
                   BasedOn="{StaticResource BoardChart}">
                <Setter Property="LegendVisible" Value="True" />
            </Style>

            <Style x:Key="BoardGauge"
                   TargetType="clam:ClamBarGaugeView"
                   BasedOn="{StaticResource BoardChartBase}">
                <Setter Property="BarThickness" Value="12" />
                <Setter Property="DisplayMode" Value="Segmented" />
                <Setter Property="ValueMode" Value="Percent" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <ScrollView BackgroundColor="{StaticResource BoardBackColor}">
        <VerticalStackLayout Style="{StaticResource BoardStack}">

            <!-- Stat -->
            <Grid Style="{StaticResource TileGrid}"
                  ColumnDefinitions="*,*">
                <clam:ClamStatView Grid.Column="0"
                                   Style="{StaticResource StatTile}"
                                   Value="{Binding Cpu}"
                                   TrendValues="{Binding CpuTrend}"
                                   Title="CPU"
                                   Fill="#5794F2"
                                   Unit="%"
                                   ValueFormat="N1" />
                <clam:ClamStatView Grid.Column="1"
                                   Style="{StaticResource StatTile}"
                                   Value="{Binding Memory}"
                                   TrendValues="{Binding MemoryTrend}"
                                   Title="Memory"
                                   Fill="#B877D9"
                                   Unit="%"
                                   ValueFormat="N1" />
            </Grid>
            <Grid Style="{StaticResource TileGrid}"
                  ColumnDefinitions="*,*">
                <clam:ClamStatView Grid.Column="0"
                                   Style="{StaticResource StatTile}"
                                   Value="{Binding Temperature}"
                                   TrendValues="{Binding TemperatureTrend}"
                                   Title="Temp"
                                   Fill="#F2495C"
                                   Unit="°C"
                                   ValueFormat="N0" />
                <clam:ClamStatView Grid.Column="1"
                                   Style="{StaticResource StatTile}"
                                   Value="{Binding Network}"
                                   TrendValues="{Binding NetworkTrend}"
                                   Title="Network"
                                   Fill="#73BF69"
                                   Unit="KB/s"
                                   ValueFormat="N0" />
            </Grid>

            <!-- Load -->
            <Border Style="{StaticResource PanelBorder}">
                <Grid Style="{StaticResource PanelGrid}"
                      RowDefinitions="Auto,300">
                    <Label Grid.Row="0"
                           Style="{StaticResource PanelTitleLabel}"
                           Text="CPU Load (%)" />
                    <clam:ClamChartView Grid.Row="1"
                                        Style="{StaticResource BoardTableChart}"
                                        Palette="{StaticResource ChartBlueShades}">
                        <clam:ClamChartView.XAxis>
                            <clam:DateTimeAxis GridLineColor="{StaticResource PanelLineColor}" WindowSize="{Binding Window}" />
                        </clam:ClamChartView.XAxis>
                        <clam:ClamChartView.YAxis>
                            <clam:NumericAxis Minimum="0" Maximum="100" GridLineColor="{StaticResource PanelLineColor}" />
                        </clam:ClamChartView.YAxis>
                        <clam:LineSeries ItemsSource="{Binding Samples}"
                                         YKey="core1"
                                         Title="Core #1"
                                         ValueFormat="{}{0:N1}%"
                                         MarkerMode="None" />
                        <clam:LineSeries ItemsSource="{Binding Samples}"
                                         YKey="core2"
                                         Title="Core #2"
                                         ValueFormat="{}{0:N1}%"
                                         MarkerMode="None" />
                        <clam:LineSeries ItemsSource="{Binding Samples}"
                                         YKey="core3"
                                         Title="Core #3"
                                         ValueFormat="{}{0:N1}%"
                                         MarkerMode="None" />
                        <clam:LineSeries ItemsSource="{Binding Samples}"
                                         YKey="core4"
                                         Title="Core #4"
                                         ValueFormat="{}{0:N1}%"
                                         MarkerMode="None" />
                    </clam:ClamChartView>
                </Grid>
            </Border>

            <!-- Network -->
            <Border Style="{StaticResource PanelBorder}">
                <Grid Style="{StaticResource PanelGrid}"
                      RowDefinitions="Auto,180">
                    <Label Grid.Row="0"
                           Style="{StaticResource PanelTitleLabel}"
                           Text="Network (KB/s)" />
                    <clam:ClamChartView Grid.Row="1"
                                        Style="{StaticResource BoardLegendChart}"
                                        Palette="{StaticResource ChartPurpleShades}">
                        <clam:ClamChartView.XAxis>
                            <clam:DateTimeAxis GridLineColor="{StaticResource PanelLineColor}" WindowSize="{Binding Window}" />
                        </clam:ClamChartView.XAxis>
                        <clam:ClamChartView.YAxis>
                            <clam:NumericAxis Minimum="0" GridLineColor="{StaticResource PanelLineColor}" />
                        </clam:ClamChartView.YAxis>
                        <clam:AreaSeries ItemsSource="{Binding Samples}"
                                         YKey="receive" StackGroup="network"
                                         Title="Receive"
                                         FillOpacity="0.4"
                                         ValueFormat="{}{0:N0} KB/s"
                                         MarkerMode="None"
                                         LiveIndicatorVisible="True" />
                        <clam:AreaSeries ItemsSource="{Binding Samples}"
                                         YKey="send" StackGroup="network"
                                         Title="Send"
                                         FillOpacity="0.4"
                                         ValueFormat="{}{0:N0} KB/s"
                                         MarkerMode="None"
                                         LiveIndicatorVisible="True" />
                    </clam:ClamChartView>
                </Grid>
            </Border>

            <!-- Queue -->
            <Border Style="{StaticResource PanelBorder}">
                <Grid Style="{StaticResource PanelGrid}"
                      RowDefinitions="Auto,140">
                    <Label Grid.Row="0"
                           Style="{StaticResource PanelTitleLabel}"
                           Text="Run Queue" />
                    <clam:ClamChartView Grid.Row="1"
                                        Style="{StaticResource BoardChart}">
                        <clam:ClamChartView.XAxis>
                            <clam:DateTimeAxis GridLineColor="{StaticResource PanelLineColor}" WindowSize="{Binding Window}" />
                        </clam:ClamChartView.XAxis>
                        <clam:BarSeries ItemsSource="{Binding Samples}"
                                        YKey="queue"
                                        Title="Queue"
                                        Color="#FF9830"
                                        ValueFormat="{}{0:N0}" />
                    </clam:ClamChartView>
                </Grid>
            </Border>

            <!-- Disk -->
            <Border Style="{StaticResource PanelBorder}">
                <Grid Style="{StaticResource PanelGrid}"
                      RowDefinitions="Auto,170">
                    <Label Grid.Row="0"
                           Style="{StaticResource PanelTitleLabel}"
                           Text="Disk Usage" />
                    <clam:ClamBarGaugeView Grid.Row="1"
                                           Style="{StaticResource BoardGauge}"
                                           ItemsSource="{Binding Disks}">
                        <clam:ClamBarGaugeView.Thresholds>
                            <clam:ChartThreshold Color="#73BF69" />
                            <clam:ChartThreshold Value="70" Color="#F2CC0C" />
                            <clam:ChartThreshold Value="85" Color="#F2495C" />
                        </clam:ClamBarGaugeView.Thresholds>
                    </clam:ClamBarGaugeView>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
