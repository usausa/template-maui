<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:clam="clr-namespace:ClamCalendar;assembly=ClamCalendar"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UICalendarView"
             x:DataType="{x:Type module:UICalendarViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UICalendarViewModel}"
             shell:ShellProperty.Title="Calendar"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Setting"
             shell:ShellProperty.Function3Text="Today"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="CalendarGrid"
                   TargetType="Grid">
                <Setter Property="RowSpacing" Value="0" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="ModeSheet"
                   TargetType="cmc:BottomSheetView">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="HalfExpandedRatio" Value="0.5" />
            </Style>

            <Style x:Key="ModeSheetGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="20,8,20,24" />
                <Setter Property="ColumnSpacing" Value="8" />
            </Style>

            <Style x:Key="ModeButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <!-- Content -->
    <Grid Style="{StaticResource CalendarGrid}">

        <clam:ClamCalendarView SelectionMode="{Binding SelectionMode}"
                               DayTappedCommand="{Binding DayTappedCommand}"
                               DisplayDate="{Binding DisplayDate, Mode=TwoWay}"
                               DisplayDateChangedCommand="{Binding DisplayDateChangedCommand}"
                               EventTappedCommand="{Binding EventTappedCommand}"
                               Events="{Binding Events}"
                               Holidays="{Binding Holidays}"
                               MonthIndicatorVisible="True"
                               SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                               SelectedDates="{Binding SelectedDates}"
                               SelectedEndDate="{Binding SelectedEndDate, Mode=TwoWay}"
                               SelectedStartDate="{Binding SelectedStartDate, Mode=TwoWay}"
                               Stamps="{Binding Stamps}" />

        <cmc:BottomSheetView Style="{StaticResource ModeSheet}"
                             IsOpen="{Binding IsSettingOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="module:UICalendarViewModel">
                    <Grid Style="{StaticResource ModeSheetGrid}"
                          ColumnDefinitions="*,*,*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource ModeButton}"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static clam:CalendarSelectionMode.None}"
                                Text="None">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectionMode}"
                                             Value="{x:Static clam:CalendarSelectionMode.None}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1"
                                Style="{StaticResource ModeButton}"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static clam:CalendarSelectionMode.SingleDate}"
                                Text="Single">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectionMode}"
                                             Value="{x:Static clam:CalendarSelectionMode.SingleDate}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource ModeButton}"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static clam:CalendarSelectionMode.MultipleDates}"
                                Text="Multi">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectionMode}"
                                             Value="{x:Static clam:CalendarSelectionMode.MultipleDates}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="3"
                                Style="{StaticResource ModeButton}"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static clam:CalendarSelectionMode.DateRange}"
                                Text="Range">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectionMode}"
                                             Value="{x:Static clam:CalendarSelectionMode.DateRange}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>

    </Grid>

</ContentView>
