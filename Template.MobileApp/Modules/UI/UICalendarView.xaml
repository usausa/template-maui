<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             xmlns:clam="clr-namespace:ClamCalendar;assembly=ClamCalendar"
             x:Class="Template.MobileApp.Modules.UI.UICalendarView"
             x:DataType="{x:Type module:UICalendarViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UICalendarViewModel}"
             shell:ShellProperty.Title="Calendar"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="CalendarDivider"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="0.5" />
                <Setter Property="Color" Value="#E0E0E0" />
            </Style>

            <Style x:Key="ModeButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="TodayButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="CalendarGrid"
                   TargetType="Grid">
                <Setter Property="RowSpacing" Value="0" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="ModeBarGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="ColumnSpacing" Value="4" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid Style="{StaticResource CalendarGrid}"
          RowDefinitions="*,Auto,Auto">

        <!-- ClamCalendar: 表示範囲が変わるたびに DisplayDateChangedCommand で範囲のイベント・スタンプ・祝日を渡す -->
        <clam:ClamCalendarView Grid.Row="0"
                               SelectionMode="{Binding SelectionMode}"
                               DayTappedCommand="{Binding DayTappedCommand}"
                               DisplayDate="{Binding DisplayDate, Mode=TwoWay}"
                               DisplayDateChangedCommand="{Binding DisplayDateChangedCommand}"
                               EventTappedCommand="{Binding EventTappedCommand}"
                               Events="{Binding Events}"
                               Holidays="{Binding Holidays}"
                               MonthIndicatorVisible="True"
                               SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                               SelectedDates="{Binding SelectedDates}"
                               SelectedEndDate="{Binding SelectedEndDate, Mode=TwoWay}"
                               SelectedStartDate="{Binding SelectedStartDate, Mode=TwoWay}"
                               Stamps="{Binding Stamps}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource CalendarDivider}" />

        <!-- 選択モード切替+今日へ -->
        <Grid Grid.Row="2"
              Style="{StaticResource ModeBarGrid}"
              ColumnDefinitions="*,*,*,*,8,Auto">
            <Button Grid.Column="0"
                    Style="{StaticResource ModeButton}"
                    Command="{Binding SelectModeCommand}"
                    CommandParameter="{x:Static clam:CalendarSelectionMode.None}"
                    Text="None">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding SelectionMode}"
                                 Value="{x:Static clam:CalendarSelectionMode.None}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Style="{StaticResource ModeButton}"
                    Command="{Binding SelectModeCommand}"
                    CommandParameter="{x:Static clam:CalendarSelectionMode.SingleDate}"
                    Text="Single">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding SelectionMode}"
                                 Value="{x:Static clam:CalendarSelectionMode.SingleDate}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2"
                    Style="{StaticResource ModeButton}"
                    Command="{Binding SelectModeCommand}"
                    CommandParameter="{x:Static clam:CalendarSelectionMode.MultipleDates}"
                    Text="Multi">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding SelectionMode}"
                                 Value="{x:Static clam:CalendarSelectionMode.MultipleDates}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="3"
                    Style="{StaticResource ModeButton}"
                    Command="{Binding SelectModeCommand}"
                    CommandParameter="{x:Static clam:CalendarSelectionMode.DateRange}"
                    Text="Range">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding SelectionMode}"
                                 Value="{x:Static clam:CalendarSelectionMode.DateRange}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="5"
                    Style="{StaticResource TodayButton}"
                    Command="{Binding GoToTodayCommand}"
                    Text="{x:Static fonts:MaterialIcons.Today}" />
        </Grid>

    </Grid>

</ContentView>
