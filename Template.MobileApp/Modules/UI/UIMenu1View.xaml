<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIMenu1View"
             x:DataType="{x:Type module:UIMenu1ViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIMenu1ViewModel}"
             shell:ShellProperty.Title="UI 1"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function4Text="UI 2"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <!-- 余りセルは可視の無効ボタンにする -->
    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="*,*,*,*,*,*,*,*,*"
          ColumnDefinitions="*,*">

        <Button Grid.Row="0" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIProfile}"
                Text="Profile"
                ImageSource="{x:Static markup:AppIcons.AccountCircle}" />
        <Button Grid.Row="0" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UILogin}"
                Text="Login"
                ImageSource="{x:Static markup:AppIcons.Login}" />

        <Button Grid.Row="1" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIMoney}"
                Text="Money"
                ImageSource="{x:Static markup:AppIcons.AccountBalanceWallet}" />
        <Button Grid.Row="1" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UISuper}"
                Text="Super"
                ImageSource="{x:Static markup:AppIcons.Widgets}" />

        <Button Grid.Row="2" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIPos}"
                Text="POS"
                ImageSource="{x:Static markup:AppIcons.PointOfSale}" />
        <Button Grid.Row="2" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIShop}"
                Text="Shop"
                ImageSource="{x:Static markup:AppIcons.Storefront}" />

        <Button Grid.Row="3" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UICalendar}"
                Text="Calendar"
                ImageSource="{x:Static markup:AppIcons.CalendarMonth}" />
        <Button Grid.Row="3" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UISchedule}"
                Text="Schedule"
                ImageSource="{x:Static markup:AppIcons.Schedule}" />

        <Button Grid.Row="4" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIMail}"
                Text="Mail"
                ImageSource="{x:Static markup:AppIcons.Mail}" />
        <Button Grid.Row="4" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIChat}"
                Text="Chat"
                ImageSource="{x:Static markup:AppIcons.Chat}" />

        <Button Grid.Row="5" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UITimeline}"
                Text="Timeline"
                ImageSource="{x:Static markup:AppIcons.ViewTimeline}" />
        <Button Grid.Row="5" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIKitDash}"
                Text="Kit"
                ImageSource="{x:Static markup:AppIcons.GridView}" />

        <Button Grid.Row="6" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIGraph}"
                Text="Graph"
                ImageSource="{x:Static markup:AppIcons.AccountTree}" />
        <Button Grid.Row="6" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIGraph2}"
                Text="Graph2"
                ImageSource="{x:Static markup:AppIcons.Timeline}" />

        <Button Grid.Row="7" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UITreeMap}"
                Text="TreeMap"
                ImageSource="{x:Static markup:AppIcons.Dashboard}" />
        <Button Grid.Row="7" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />

        <Button Grid.Row="8" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />
        <Button Grid.Row="8" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />

    </Grid>

</ContentView>
