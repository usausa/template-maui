<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:drawing="clr-namespace:Template.MobileApp.Graphics.Drawing"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UILoadView"
             x:DataType="{x:Type module:UILoadViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UILoadViewModel}"
             shell:ShellProperty.Title="Load"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function4Text="Clear"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Converter -->

            <converters:DecibelToColorConverter x:Key="DecibelToColorConverter" />

            <!-- Page -->

            <Style x:Key="LoadRootGrid"
                   TargetType="Grid"
                   BasedOn="{StaticResource FillGrid}">
                <Setter Property="BackgroundColor" Value="#2E2F45" />
            </Style>

            <!-- Gauge -->

            <Style x:Key="NoiseGauge"
                   TargetType="controls:NoiseGauge">
                <Setter Property="WarningGaugeColor" Value="{StaticResource RedDefault}" />
                <Setter Property="NeedleColor" Value="{StaticResource DeepOrangeDarken1}" />
                <Setter Property="NeedleCenterColor" Value="{StaticResource DeepOrangeDefault}" />
                <Setter Property="PeakNeedleColor" Value="#B3FFD700" />
            </Style>

            <!-- Recording -->

            <Style x:Key="RecordingDot"
                   TargetType="Ellipse">
                <Setter Property="WidthRequest" Value="12" />
                <Setter Property="HeightRequest" Value="12" />
                <Setter Property="Margin" Value="16" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="Fill" Value="{StaticResource RedDefault}" />
            </Style>

            <!-- Value -->

            <Style x:Key="LoadValueLabel"
                   TargetType="Label">
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="End" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="LoadValueSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="72" />
            </Style>

            <Style x:Key="LoadUnitSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="36" />
            </Style>

            <!-- Summary -->

            <Style x:Key="SummaryNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="SummaryValueLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="SummaryValueSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="24" />
            </Style>

            <Style x:Key="SummaryUnitSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="18" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <Grid Style="{StaticResource LoadRootGrid}"
          RowDefinitions="*,Auto,*">

        <!-- Gauge -->
        <controls:NoiseGauge Grid.Row="0"
                             Style="{StaticResource NoiseGauge}"
                             Value="{Binding Current}"
                             PeakValue="{Binding Peak}" />

        <!-- Recording -->
        <Ellipse Grid.Row="0"
                 Style="{StaticResource RecordingDot}"
                 behaviors:AnimationOption.Blink="True" />

        <!-- Value -->
        <Label Grid.Row="0"
               Style="{StaticResource LoadValueLabel}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Style="{StaticResource LoadValueSpan}"
                          Text="{Binding Current, StringFormat='{0:F1}'}"
                          TextColor="{Binding Current, Converter={StaticResource DecibelToColorConverter}}" />
                    <Span Style="{StaticResource LoadUnitSpan}"
                          Text=" dB" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!-- Summary -->
        <Grid Grid.Row="1"
              Style="{StaticResource FillGrid}"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,*,*">
            <Label Grid.Row="0" Grid.Column="0"
                   Style="{StaticResource SummaryNameLabel}"
                   Text="MIN" />
            <Label Grid.Row="0" Grid.Column="1"
                   Style="{StaticResource SummaryNameLabel}"
                   Text="AVG" />
            <Label Grid.Row="0" Grid.Column="2"
                   Style="{StaticResource SummaryNameLabel}"
                   Text="MAX" />
            <Label Grid.Row="1" Grid.Column="0"
                   Style="{StaticResource SummaryValueLabel}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Style="{StaticResource SummaryValueSpan}"
                              Text="{Binding Min, StringFormat='{0:F1}'}" />
                        <Span Style="{StaticResource SummaryUnitSpan}"
                              Text=" dB" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Grid.Row="1" Grid.Column="1"
                   Style="{StaticResource SummaryValueLabel}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Style="{StaticResource SummaryValueSpan}"
                              Text="{Binding Average, StringFormat='{0:F1}'}" />
                        <Span Style="{StaticResource SummaryUnitSpan}"
                              Text=" dB" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Grid.Row="1" Grid.Column="2"
                   Style="{StaticResource SummaryValueLabel}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Style="{StaticResource SummaryValueSpan}"
                              Text="{Binding Max, StringFormat='{0:F1}'}" />
                        <Span Style="{StaticResource SummaryUnitSpan}"
                              Text=" dB" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Grid>

        <!-- Chart -->
        <drawing:DrawingControl Grid.Row="2"
                                Drawing="{Binding Drawing}" />

    </Grid>

</ContentView>
