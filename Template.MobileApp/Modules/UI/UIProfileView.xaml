<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:mcc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIProfileView"
             x:DataType="{x:Type module:UIProfileViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIProfileViewModel}"
             shell:ShellProperty.Title="Profile"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="ProfileBodyStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
            </Style>

            <!-- Root -->
            <Style x:Key="ProfileScroll"
                   TargetType="ScrollView">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
            </Style>

            <!-- Cover -->
            <Style x:Key="CoverGrid"
                   TargetType="Grid">
                <Setter Property="HeightRequest" Value="140" />
            </Style>

            <Style x:Key="CoverImage"
                   TargetType="Image">
                <Setter Property="HeightRequest" Value="140" />
                <Setter Property="Aspect" Value="AspectFill" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken3}" />
            </Style>

            <!-- Avatar -->
            <Style x:Key="AvatarBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="110" />
                <Setter Property="HeightRequest" Value="110" />
                <Setter Property="StrokeShape" Value="RoundRectangle 55" />
                <Setter Property="Stroke" Value="White" />
                <Setter Property="StrokeThickness" Value="4" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="TranslationY" Value="-55" />
                <Setter Property="Shadow">
                    <Shadow Offset="0,2"
                            Brush="Black"
                            Opacity="0.15"
                            Radius="8" />
                </Setter>
            </Style>

            <Style x:Key="AvatarImage"
                   TargetType="Image">
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>

            <!-- Name / meta -->
            <Style x:Key="ProfileNameLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,-40,0,2" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken4}" />
            </Style>

            <Style x:Key="OccupationLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="LocationRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Spacing" Value="4" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <Style x:Key="LocationIcon"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="LocationLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Stats row -->
            <Style x:Key="StatRow"
                   TargetType="Grid">
                <Setter Property="Margin" Value="16,8" />
            </Style>

            <Style x:Key="StatValue"
                   TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatCaption"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatDivider"
                   TargetType="BoxView">
                <Setter Property="WidthRequest" Value="1" />
                <Setter Property="HeightRequest" Value="28" />
                <Setter Property="Color" Value="{StaticResource GrayLighten2}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- SNS action buttons (all toggle: OFF=白地+色アイコン / ON=色地+白アイコン) -->
            <Style x:Key="ActionRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Spacing" Value="20" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <Style x:Key="ProfileActionButtonBase"
                   TargetType="Button">
                <Setter Property="WidthRequest" Value="52" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Shadow">
                    <Shadow Offset="0,3"
                            Brush="Black"
                            Opacity="0.2"
                            Radius="6" />
                </Setter>
            </Style>

            <Style x:Key="FollowButton"
                   TargetType="Button"
                   BasedOn="{StaticResource ProfileActionButtonBase}">
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="LikeButton"
                   TargetType="Button"
                   BasedOn="{StaticResource ProfileActionButtonBase}">
                <Setter Property="TextColor" Value="{StaticResource PinkAccent2}" />
                <Setter Property="WidthRequest" Value="64" />
                <Setter Property="HeightRequest" Value="64" />
                <Setter Property="CornerRadius" Value="32" />
                <Setter Property="FontSize" Value="26" />
            </Style>

            <Style x:Key="StarButton"
                   TargetType="Button"
                   BasedOn="{StaticResource ProfileActionButtonBase}">
                <Setter Property="TextColor" Value="{StaticResource AmberDefault}" />
            </Style>

            <!-- Card -->
            <Style x:Key="CardBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="12,6" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Shadow">
                    <Shadow Offset="0,2"
                            Brush="Black"
                            Opacity="0.1"
                            Radius="10" />
                </Setter>
            </Style>

            <Style x:Key="SectionTitleRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="6" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="SectionAccent"
                   TargetType="BoxView">
                <Setter Property="WidthRequest" Value="3" />
                <Setter Property="HeightRequest" Value="14" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Color" Value="{StaticResource BlueDefault}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="SectionTitle"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken4}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="BioLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken2}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <!-- Interests -->
            <Style x:Key="InterestsLayout"
                   TargetType="FlexLayout">
                <Setter Property="Wrap" Value="Wrap" />
                <Setter Property="JustifyContent" Value="Start" />
            </Style>

            <Style x:Key="InterestBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="0,4,8,0" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            </Style>

            <Style x:Key="InterestLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <!-- Photos -->
            <Style x:Key="PhotoBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="2" />
                <Setter Property="HeightRequest" Value="90" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="PhotoImage"
                   TargetType="Image">
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>

            <converters:ElapsedTimeConverter x:Key="ElapsedTimeConverter" />

            <s:MapToBoolConverter x:Key="PhotosTabConverter">
                <s:MapToBoolConverter.Entries>
                    <s:MapToBoolEntry Key="{x:Int32 0}"
                                      Value="True" />
                </s:MapToBoolConverter.Entries>
            </s:MapToBoolConverter>

            <s:MapToBoolConverter x:Key="PostsTabConverter">
                <s:MapToBoolConverter.Entries>
                    <s:MapToBoolEntry Key="{x:Int32 1}"
                                      Value="True" />
                </s:MapToBoolConverter.Entries>
            </s:MapToBoolConverter>

            <s:MapToBoolConverter x:Key="LikesTabConverter">
                <s:MapToBoolConverter.Entries>
                    <s:MapToBoolEntry Key="{x:Int32 2}"
                                      Value="True" />
                </s:MapToBoolConverter.Entries>
            </s:MapToBoolConverter>

            <Style x:Key="TabCardBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource CardBorder}">
                <Setter Property="Padding" Value="0,0,0,8" />
            </Style>

            <Style x:Key="ProfileTabStrip"
                   TargetType="mcc:TabStrip">
                <Setter Property="IndicatorColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="IndicatorHeight" Value="3" />
                <Setter Property="IndicatorInset" Value="16" />
            </Style>

            <Style x:Key="TabLabel"
                   TargetType="Label">
                <Setter Property="Padding" Value="20,12" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="TabLine"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource GrayLighten2}" />
            </Style>

            <Style x:Key="TabPhotoLayout"
                   TargetType="FlexLayout">
                <Setter Property="Margin" Value="10,10,10,0" />
                <Setter Property="Wrap" Value="Wrap" />
            </Style>

            <Style x:Key="PostRowGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="RowSpacing" Value="6" />
            </Style>

            <Style x:Key="PostTextLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken4}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="PostMetaRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="16" />
            </Style>

            <Style x:Key="PostMetaLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="RowDivider"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Margin" Value="14,0" />
                <Setter Property="Color" Value="{StaticResource GrayLighten3}" />
            </Style>

            <Style x:Key="LikeRowGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="ColumnSpacing" Value="10" />
            </Style>

            <Style x:Key="LikeAvatarBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            </Style>

            <Style x:Key="LikeTextStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="LikeHeaderRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="LikeAuthorLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken4}" />
            </Style>

            <Style x:Key="PhotoViewerGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="Black" />
            </Style>

            <Style x:Key="PhotoCloseButton"
                   TargetType="Button">
                <Setter Property="Margin" Value="8" />
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="#33FFFFFF" />
            </Style>

            <Style x:Key="PhotoViewerImage"
                   TargetType="Image">
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>

            <Style x:Key="PhotoIndicator"
                   TargetType="IndicatorView">
                <Setter Property="Margin" Value="0,12,0,24" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="IndicatorColor" Value="#66FFFFFF" />
                <Setter Property="SelectedIndicatorColor" Value="White" />
                <Setter Property="IndicatorSize" Value="8" />
            </Style>

            <!-- Root layout -->
            <Style x:Key="ProfileStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="0,0,0,12" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <Grid>

        <!-- カバーはスクロールでパララックス(旧 Profile から移植) -->
        <ScrollView Style="{StaticResource ProfileScroll}"
                    behaviors:Scroll.ParallaxTarget="{x:Reference CoverImage}">
            <VerticalStackLayout Style="{StaticResource ProfileStack}">

                <!-- Cover -->
                <Grid Style="{StaticResource CoverGrid}">
                    <Image x:Name="CoverImage"
                           Style="{StaticResource CoverImage}"
                           Source="profile_cover.jpg" />
                </Grid>

                <!-- カバーより下は不透明ブロック(パララックスしたカバーが透けないように) -->
                <VerticalStackLayout Style="{StaticResource ProfileBodyStack}">

                    <!-- Avatar (overlaps cover) -->
                    <Border Style="{StaticResource AvatarBorder}">
                        <Image Style="{StaticResource AvatarImage}"
                               Source="profile.jpg" />
                    </Border>

                    <!-- Name / meta -->
                    <Label Style="{StaticResource ProfileNameLabel}"
                           Text="{Binding UserName}" />
                    <Label Style="{StaticResource OccupationLabel}"
                           Text="{Binding Occupation}" />
                    <HorizontalStackLayout Style="{StaticResource LocationRow}">
                        <Label Style="{StaticResource LocationIcon}"
                               Text="{x:Static fonts:MaterialIcons.Location_on}" />
                        <Label Style="{StaticResource LocationLabel}"
                               Text="{Binding Location}" />
                    </HorizontalStackLayout>

                    <!-- Stats: Posts / Followers / Following -->
                    <Grid Style="{StaticResource StatRow}"
                          ColumnDefinitions="*,Auto,*,Auto,*">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Style="{StaticResource StatValue}"
                                   Text="{Binding Posts, StringFormat='{0:N0}'}" />
                            <Label Style="{StaticResource StatCaption}"
                                   Text="投稿" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="1"
                                 Style="{StaticResource StatDivider}" />
                        <VerticalStackLayout Grid.Column="2">
                            <Label Style="{StaticResource StatValue}"
                                   Text="{Binding Followers, StringFormat='{0:0,.0k}'}" />
                            <Label Style="{StaticResource StatCaption}"
                                   Text="フォロワー" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="3"
                                 Style="{StaticResource StatDivider}" />
                        <VerticalStackLayout Grid.Column="4">
                            <Label Style="{StaticResource StatValue}"
                                   Text="{Binding Following, StringFormat='{0:N0}'}" />
                            <Label Style="{StaticResource StatCaption}"
                                   Text="フォロー中" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- SNS action buttons: follow, like, favorite -->
                    <HorizontalStackLayout Style="{StaticResource ActionRow}">
                        <Button Style="{StaticResource FollowButton}"
                                behaviors:ButtonOption.PressEffect="True"
                                Command="{Binding FollowCommand}"
                                Text="{x:Static fonts:MaterialIcons.Person_add}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsFollowed}"
                                             Value="True">
                                    <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.How_to_reg}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Style="{StaticResource LikeButton}"
                                behaviors:AnimationOption.HeartbeatTrigger="{Binding IsLiked}"
                                behaviors:AnimationOption.HeartbeatValue="{s:Bool Value=True}"
                                behaviors:ButtonOption.PressEffect="True"
                                Command="{Binding LikeCommand}"
                                Text="{x:Static fonts:MaterialIcons.Favorite_outline}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsLiked}"
                                             Value="True">
                                    <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Favorite}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource PinkAccent2}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Style="{StaticResource StarButton}"
                                behaviors:ButtonOption.PressEffect="True"
                                Command="{Binding StarCommand}"
                                Text="{x:Static fonts:MaterialIcons.Star_outline}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsStarred}"
                                             Value="True">
                                    <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Star}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource AmberDefault}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>

                    <!-- Bio card -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout>
                            <HorizontalStackLayout Style="{StaticResource SectionTitleRow}">
                                <BoxView Style="{StaticResource SectionAccent}" />
                                <Label Style="{StaticResource SectionTitle}"
                                       Text="自己紹介" />
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource BioLabel}"
                                   Text="{Binding Bio}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Interests with colored tags -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout>
                            <HorizontalStackLayout Style="{StaticResource SectionTitleRow}">
                                <BoxView Style="{StaticResource SectionAccent}" />
                                <Label Style="{StaticResource SectionTitle}"
                                       Text="趣味・関心事" />
                            </HorizontalStackLayout>
                            <FlexLayout Style="{StaticResource InterestsLayout}"
                                        BindableLayout.ItemsSource="{Binding Interests}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="module:UIProfileInterest">
                                        <Border Style="{StaticResource InterestBorder}"
                                                BackgroundColor="{Binding BackgroundColor}">
                                            <Label Style="{StaticResource InterestLabel}"
                                                   Text="{Binding Label}"
                                                   TextColor="{Binding TextColor}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource TabCardBorder}">
                        <VerticalStackLayout>
                            <mcc:TabStrip Style="{StaticResource ProfileTabStrip}"
                                          ItemsSource="{Binding Tabs}"
                                          SelectedIndex="{Binding SelectedTab}">
                                <mcc:TabStrip.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Type x:String}">
                                        <Label Style="{StaticResource TabLabel}"
                                               Text="{Binding .}">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroupList>
                                                    <VisualStateGroup x:Name="TabStates">
                                                        <VisualState x:Name="Unselected" />
                                                        <VisualState x:Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateGroupList>
                                            </VisualStateManager.VisualStateGroups>
                                        </Label>
                                    </DataTemplate>
                                </mcc:TabStrip.ItemTemplate>
                            </mcc:TabStrip>
                            <BoxView Style="{StaticResource TabLine}" />

                            <!-- 件数固定の一覧のため、縦ScrollView内で仮想化が無効になるCollectionViewは使わずBindableLayoutで並べる -->
                            <FlexLayout Style="{StaticResource TabPhotoLayout}"
                                        BindableLayout.ItemsSource="{Binding Photos}"
                                        IsVisible="{Binding SelectedTab, Converter={StaticResource PhotosTabConverter}}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="module:UIProfilePhoto">
                                        <Border Style="{StaticResource PhotoBorder}"
                                                FlexLayout.Basis="33.33%">
                                            <Border.GestureRecognizers>
                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:UIProfileViewModel}}, Path=OpenPhotoCommand, x:DataType={x:Type module:UIProfileViewModel}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image Style="{StaticResource PhotoImage}"
                                                   Source="{Binding Image}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <ContentView behaviors:LazyViewOption.Load="{Binding SelectedTab, Converter={StaticResource PostsTabConverter}}"
                                         IsVisible="{Binding SelectedTab, Converter={StaticResource PostsTabConverter}}">
                                <behaviors:LazyViewOption.Template>
                                    <DataTemplate x:DataType="module:UIProfileViewModel">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PostList}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="module:UIProfilePost">
                                                    <VerticalStackLayout>
                                                        <Grid Style="{StaticResource PostRowGrid}"
                                                              RowDefinitions="Auto,Auto">
                                                            <Label Grid.Row="0"
                                                                   Style="{StaticResource PostTextLabel}"
                                                                   Text="{Binding Text}" />
                                                            <HorizontalStackLayout Grid.Row="1"
                                                                                   Style="{StaticResource PostMetaRow}">
                                                                <Label Style="{StaticResource PostMetaLabel}"
                                                                       Text="{Binding Posted, Converter={StaticResource ElapsedTimeConverter}}" />
                                                                <Label Style="{StaticResource PostMetaLabel}"
                                                                       Text="{Binding Likes, StringFormat='❤️ {0}'}" />
                                                                <Label Style="{StaticResource PostMetaLabel}"
                                                                       Text="{Binding Comments, StringFormat='💬 {0}'}" />
                                                            </HorizontalStackLayout>
                                                        </Grid>
                                                        <BoxView Style="{StaticResource RowDivider}" />
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </behaviors:LazyViewOption.Template>
                            </ContentView>

                            <ContentView behaviors:LazyViewOption.Load="{Binding SelectedTab, Converter={StaticResource LikesTabConverter}}"
                                         IsVisible="{Binding SelectedTab, Converter={StaticResource LikesTabConverter}}">
                                <behaviors:LazyViewOption.Template>
                                    <DataTemplate x:DataType="module:UIProfileViewModel">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding LikeList}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="module:UIProfileLike">
                                                    <VerticalStackLayout>
                                                        <Grid Style="{StaticResource LikeRowGrid}"
                                                              ColumnDefinitions="40,*">
                                                            <Border Grid.Column="0"
                                                                    Style="{StaticResource LikeAvatarBorder}">
                                                                <Image Style="{StaticResource PhotoImage}"
                                                                       Source="{Binding Avatar}" />
                                                            </Border>
                                                            <VerticalStackLayout Grid.Column="1"
                                                                                 Style="{StaticResource LikeTextStack}">
                                                                <HorizontalStackLayout Style="{StaticResource LikeHeaderRow}">
                                                                    <Label Style="{StaticResource LikeAuthorLabel}"
                                                                           Text="{Binding Author}" />
                                                                    <Label Style="{StaticResource PostMetaLabel}"
                                                                           VerticalOptions="Center"
                                                                           Text="{Binding Posted, Converter={StaticResource ElapsedTimeConverter}}" />
                                                                </HorizontalStackLayout>
                                                                <Label Style="{StaticResource PostTextLabel}"
                                                                       Text="{Binding Text}" />
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                        <BoxView Style="{StaticResource RowDivider}" />
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </behaviors:LazyViewOption.Template>
                            </ContentView>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <ContentView behaviors:AnimationOption.FadeInTrigger="{Binding IsPhotoViewerVisible}"
                     behaviors:LazyViewOption.Load="{Binding IsPhotoViewerVisible}"
                     IsVisible="{Binding IsPhotoViewerVisible}">
            <behaviors:LazyViewOption.Template>
                <DataTemplate x:DataType="module:UIProfileViewModel">
                    <Grid Style="{StaticResource PhotoViewerGrid}"
                          RowDefinitions="Auto,*,Auto">
                        <Button Grid.Row="0"
                                Style="{StaticResource PhotoCloseButton}"
                                Command="{Binding ClosePhotoCommand}"
                                Text="{x:Static fonts:MaterialIcons.Close}" />
                        <CarouselView Grid.Row="1"
                                      behaviors:CarouselOption.PageSnap="True"
                                      ItemsSource="{Binding Photos}"
                                      IndicatorView="{x:Reference PhotoIndicatorView}"
                                      IsScrollAnimated="False"
                                      Loop="False"
                                      Position="{Binding PhotoPosition}">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="module:UIProfilePhoto">
                                    <Image Style="{StaticResource PhotoViewerImage}"
                                           Source="{Binding Image}" />
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>
                        <IndicatorView x:Name="PhotoIndicatorView"
                                       Grid.Row="2"
                                       Style="{StaticResource PhotoIndicator}" />
                    </Grid>
                </DataTemplate>
            </behaviors:LazyViewOption.Template>
        </ContentView>

    </Grid>

</ContentView>
