<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIStreamView"
             x:DataType="{x:Type module:UIStreamViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIStreamViewModel}"
             shell:ShellProperty.Title="Stream"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Converter -->

            <converters:RuntimeTextConverter x:Key="RuntimeTextConverter" />

            <s:MapToTextConverter x:Key="GenreNameConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Sf}"
                                      Value="SF" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Action}"
                                      Value="アクション" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Romance}"
                                      Value="恋愛" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Comedy}"
                                      Value="コメディ" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Documentary}"
                                      Value="ドキュメンタリー" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Fantasy}"
                                      Value="ファンタジー" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="BadgeTextConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:StreamBadge.New}"
                                      Value="NEW" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamBadge.NewSeason}"
                                      Value="NEW SEASON" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamBadge.Live}"
                                      Value="LIVE" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToBoolConverter x:Key="BadgeVisibleConverter"
                                  DefaultValue="True">
                <s:MapToBoolConverter.Entries>
                    <s:MapToBoolEntry Key="{x:Static sample:StreamBadge.None}"
                                      Value="False" />
                </s:MapToBoolConverter.Entries>
            </s:MapToBoolConverter>

            <s:MapToTextConverter x:Key="ShelfNameConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:StreamShelf.TopRated}"
                                      Value="高評価" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamShelf.Original}"
                                      Value="オリジナル" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamShelf.Trending}"
                                      Value="急上昇" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamShelf.Action}"
                                      Value="アクション &amp; アドベンチャー" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <!-- Top bar -->

            <Style x:Key="TopIconButton"
                   TargetType="Button"
                   BasedOn="{StaticResource HeaderIconButton}">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
            </Style>

            <!-- Page -->

            <Style x:Key="StreamScroll"
                   TargetType="ScrollView">
                <Setter Property="BackgroundColor" Value="Black" />
            </Style>

            <!-- Top bar -->

            <Style x:Key="TopBar"
                   TargetType="Grid">
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style x:Key="LogoLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource RedAccent3}" />
            </Style>

            <!-- Featured -->

            <Style x:Key="FeaturedCarousel"
                   TargetType="CarouselView">
                <Setter Property="HeightRequest" Value="340" />
                <Setter Property="Loop" Value="False" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Never" />
            </Style>

            <Style x:Key="FeaturedImage"
                   TargetType="Image">
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>

            <Style x:Key="FeaturedShade"
                   TargetType="BoxView">
                <Setter Property="Background">
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.35" Color="#00000000" />
                        <GradientStop Offset="1" Color="#E6000000" />
                    </LinearGradientBrush>
                </Setter>
            </Style>

            <Style x:Key="FeaturedRatingBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="BackgroundColor" Value="#66000000" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>

            <Style x:Key="FeaturedRatingLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource AmberDefault}" />
            </Style>

            <Style x:Key="FeaturedInfo"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="16,0,16,16" />
                <Setter Property="VerticalOptions" Value="End" />
            </Style>

            <Style x:Key="HeroBadgeBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="BackgroundColor" Value="{StaticResource RedAccent3}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 4" />
            </Style>

            <Style x:Key="HeroBadgeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="HeroTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="HeroMetaLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten2}" />
                <Setter Property="Margin" Value="0,4,0,12" />
            </Style>

            <Style x:Key="HeroButtonsRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="10" />
            </Style>

            <Style x:Key="HeroPlayButton"
                   TargetType="Button">
                <Setter Property="Text" Value="▶ Play" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="WidthRequest" Value="120" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="HeroListButton"
                   TargetType="Button">
                <Setter Property="Text" Value="+ My List" />
                <Setter Property="BackgroundColor" Value="#33FFFFFF" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="WidthRequest" Value="120" />
            </Style>

            <Style x:Key="FeaturedIndicator"
                   TargetType="IndicatorView">
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="IndicatorColor" Value="{StaticResource GrayDarken2}" />
                <Setter Property="SelectedIndicatorColor" Value="{StaticResource RedAccent3}" />
            </Style>

            <Style x:Key="FeaturedIndicatorBar"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="12" />
                <Setter Property="HeightRequest" Value="4" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource GrayDarken2}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="WidthRequest" Value="28" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource RedAccent3}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Section header -->

            <Style x:Key="SectionHeaderGrid"
                   TargetType="Grid">
                <Setter Property="Margin" Value="16,16,16,8" />
            </Style>

            <Style x:Key="StreamSectionLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="SeeAllLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Shelf -->

            <Style x:Key="RowCollection"
                   TargetType="CollectionView">
                <Setter Property="HeightRequest" Value="170" />
            </Style>

            <!-- Continue watching -->

            <Style x:Key="ContinueCollection"
                   TargetType="CollectionView">
                <Setter Property="HeightRequest" Value="194" />
            </Style>

            <Style x:Key="ContinueStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="Spacing" Value="6" />
            </Style>

            <Style x:Key="ContinueBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="110" />
                <Setter Property="HeightRequest" Value="160" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="ContinuePlayBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="#88000000" />
                <Setter Property="Stroke" Value="White" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            </Style>

            <Style x:Key="ContinuePlayLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="ContinueProgressBar"
                   TargetType="ProgressBar">
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="ProgressColor" Value="{StaticResource RedAccent3}" />
            </Style>

            <Style x:Key="ContinueRemainLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
            </Style>

            <!-- Poster -->

            <Style x:Key="PosterBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="WidthRequest" Value="110" />
                <Setter Property="HeightRequest" Value="160" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="PosterImage"
                   TargetType="Image">
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>

            <Style x:Key="PosterBadgeBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="BackgroundColor" Value="{StaticResource RedAccent3}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 4" />
            </Style>

            <Style x:Key="PosterBadgeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="9" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="PosterDurationBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="BackgroundColor" Value="#CC000000" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 4" />
            </Style>

            <Style x:Key="PosterDurationLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="9" />
                <Setter Property="TextColor" Value="White" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <ScrollView Style="{StaticResource StreamScroll}">
        <VerticalStackLayout>

            <!-- Top bar -->
            <Grid Style="{StaticResource TopBar}"
                  ColumnDefinitions="*,Auto,Auto"
                  behaviors:AnimationOption.EnterAnimation="FadeUp">
                <Label Grid.Column="0"
                       Style="{StaticResource LogoLabel}"
                       Text="STREAM" />
                <Button Grid.Column="1"
                        Style="{StaticResource TopIconButton}"
                        behaviors:ButtonOption.PressEffect="True"
                        Text="{x:Static fonts:MaterialIcons.Search}" />
                <Button Grid.Column="2"
                        Style="{StaticResource TopIconButton}"
                        behaviors:ButtonOption.PressEffect="True"
                        Text="{x:Static fonts:MaterialIcons.Notifications}" />
            </Grid>

            <!-- Featured -->
            <CarouselView Style="{StaticResource FeaturedCarousel}"
                          behaviors:AnimationOption.EnterAnimation="FadeUp"
                          behaviors:AnimationOption.EnterDelay="80"
                          ItemsSource="{Binding Featured}"
                          Position="{Binding FeaturedPosition}"
                          IndicatorView="{x:Reference FeaturedIndicator}"
                          CurrentItemChangedCommand="{Binding CurrentChangedCommand}">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="sample:StreamItem">
                        <Grid>
                            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DetailCommand, Source={RelativeSource AncestorType={x:Type module:UIStreamViewModel}}, x:DataType={x:Type module:UIStreamViewModel}}"
                                                      CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Image Style="{StaticResource FeaturedImage}"
                                   Source="{Binding Work.Image}" />
                            <BoxView Style="{StaticResource FeaturedShade}" />
                            <Border Style="{StaticResource FeaturedRatingBorder}">
                                <Label Style="{StaticResource FeaturedRatingLabel}"
                                       Text="{Binding Work.Rating, StringFormat='★ {0:F1}'}" />
                            </Border>
                            <VerticalStackLayout Style="{StaticResource FeaturedInfo}">
                                <Border Style="{StaticResource HeroBadgeBorder}"
                                        behaviors:AnimationOption.Blink="{Binding Work.Badge, Converter={s:CompareToBool}, ConverterParameter={x:Static sample:StreamBadge.Live}}"
                                        IsVisible="{Binding Work.Badge, Converter={StaticResource BadgeVisibleConverter}}">
                                    <Label Style="{StaticResource HeroBadgeLabel}"
                                           Text="{Binding Work.Badge, Converter={StaticResource BadgeTextConverter}}" />
                                </Border>
                                <Label Style="{StaticResource HeroTitleLabel}"
                                       Text="{Binding Work.Title}" />
                                <Label Style="{StaticResource HeroMetaLabel}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                            <Binding Path="Work.Year" />
                                            <Binding Path="Work.Genre"
                                                     Converter="{StaticResource GenreNameConverter}" />
                                            <Binding Path="Work.Minutes"
                                                     Converter="{StaticResource RuntimeTextConverter}" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <HorizontalStackLayout Style="{StaticResource HeroButtonsRow}">
                                    <Button Style="{StaticResource HeroPlayButton}"
                                            behaviors:ButtonOption.PressEffect="True"
                                            Command="{Binding DetailCommand, Source={RelativeSource AncestorType={x:Type module:UIStreamViewModel}}, x:DataType={x:Type module:UIStreamViewModel}}"
                                            CommandParameter="{Binding .}" />
                                    <Button Style="{StaticResource HeroListButton}"
                                            behaviors:ButtonOption.PressEffect="True"
                                            Command="{Binding MyListCommand, Source={RelativeSource AncestorType={x:Type module:UIStreamViewModel}}, x:DataType={x:Type module:UIStreamViewModel}}"
                                            CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding InMyList}"
                                                         Value="True">
                                                <Setter Property="Text" Value="✓ My List" />
                                                <Setter Property="BackgroundColor" Value="{StaticResource RedDefault}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <IndicatorView x:Name="FeaturedIndicator"
                           Style="{StaticResource FeaturedIndicator}">
                <IndicatorView.IndicatorTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FeaturedIndicatorBar}" />
                    </DataTemplate>
                </IndicatorView.IndicatorTemplate>
            </IndicatorView>

            <!-- Continue watching -->
            <VerticalStackLayout behaviors:AnimationOption.EnterAnimation="FadeUp"
                                 behaviors:AnimationOption.EnterDelay="160">
                <Grid Style="{StaticResource SectionHeaderGrid}">
                    <Label Style="{StaticResource StreamSectionLabel}"
                           Text="続きを見る" />
                </Grid>
                <CollectionView Style="{StaticResource ContinueCollection}"
                                ItemsSource="{Binding Continue}"
                                ItemsLayout="HorizontalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="sample:StreamItem">
                            <VerticalStackLayout Style="{StaticResource ContinueStack}">
                                <Border Style="{StaticResource ContinueBorder}">
                                    <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                    <Grid behaviors:TouchOption.ClickCommand="{Binding DetailCommand, Source={RelativeSource AncestorType={x:Type module:UIStreamViewModel}}, x:DataType={x:Type module:UIStreamViewModel}}"
                                          behaviors:TouchOption.ClickCommandParameter="{Binding .}"
                                          behaviors:TouchOption.Ripple="True">
                                        <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                        <Image Style="{StaticResource PosterImage}"
                                               Source="{Binding Work.Image}" />
                                        <Border Style="{StaticResource ContinuePlayBorder}">
                                            <Label Style="{StaticResource ContinuePlayLabel}"
                                                   Text="▶" />
                                        </Border>
                                        <ProgressBar Style="{StaticResource ContinueProgressBar}"
                                                     Progress="{Binding Progress}" />
                                    </Grid>
                                </Border>
                                <Label Style="{StaticResource ContinueRemainLabel}"
                                       Text="{Binding RemainMinutes, StringFormat='残り {0} 分'}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Shelf -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="module:UIStreamSection">
                        <VerticalStackLayout behaviors:AnimationOption.EnterAnimation="FadeUp"
                                             behaviors:AnimationOption.EnterDelay="{Binding Delay}">
                            <Grid Style="{StaticResource SectionHeaderGrid}"
                                  ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Style="{StaticResource StreamSectionLabel}"
                                       Text="{Binding Shelf, Converter={StaticResource ShelfNameConverter}}" />
                                <Label Grid.Column="1"
                                       Style="{StaticResource SeeAllLabel}"
                                       Text="See all ›" />
                            </Grid>
                            <CollectionView Style="{StaticResource RowCollection}"
                                            ItemsSource="{Binding Items}"
                                            ItemsLayout="HorizontalList">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="sample:StreamItem">
                                        <Border Style="{StaticResource PosterBorder}">
                                            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                            <Grid behaviors:TouchOption.ClickCommand="{Binding DetailCommand, Source={RelativeSource AncestorType={x:Type module:UIStreamViewModel}}, x:DataType={x:Type module:UIStreamViewModel}}"
                                                  behaviors:TouchOption.ClickCommandParameter="{Binding .}"
                                                  behaviors:TouchOption.Ripple="True">
                                                <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                                <Image Style="{StaticResource PosterImage}"
                                                       Source="{Binding Work.Image}" />
                                                <Border Style="{StaticResource PosterBadgeBorder}"
                                                        behaviors:AnimationOption.Blink="{Binding Work.Badge, Converter={s:CompareToBool}, ConverterParameter={x:Static sample:StreamBadge.Live}}"
                                                        IsVisible="{Binding Work.Badge, Converter={StaticResource BadgeVisibleConverter}}">
                                                    <Label Style="{StaticResource PosterBadgeLabel}"
                                                           Text="{Binding Work.Badge, Converter={StaticResource BadgeTextConverter}}" />
                                                </Border>
                                                <Border Style="{StaticResource PosterDurationBorder}">
                                                    <Label Style="{StaticResource PosterDurationLabel}"
                                                           Text="{Binding Work.Minutes, Converter={StaticResource RuntimeTextConverter}}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
