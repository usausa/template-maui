<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:drawing="clr-namespace:Template.MobileApp.Graphics.Drawing"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIKitDashView"
             x:DataType="{x:Type module:UIKitDashViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIKitDashViewModel}"
             shell:ShellProperty.Title="Dashboard"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="KitDashScroll"
                   TargetType="ScrollView">
                <Setter Property="BackgroundColor" Value="{StaticResource BlueGrayLighten5}" />
            </Style>

            <!-- Extra bottom padding keeps the header content clear of the overlapping steps card (-30 margin) -->
            <Style x:Key="KitDashHeaderGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="20,24,20,62" />
                <Setter Property="ColumnSpacing" Value="10" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="GreetLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="Opacity" Value="0.85" />
            </Style>

            <Style x:Key="UserLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <!-- Header hub buttons -->
            <Style x:Key="KitIconButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="#22FFFFFF" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
            </Style>

            <Style x:Key="BellArea"
                   TargetType="Grid">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="BellButton"
                   TargetType="Button"
                   BasedOn="{StaticResource KitIconButton}">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="End" />
            </Style>

            <Style x:Key="UnreadDot"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="12" />
                <Setter Property="HeightRequest" Value="12" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="BackgroundColor" Value="{StaticResource RedDefault}" />
                <Setter Property="Stroke" Value="{StaticResource BlueDefault}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeShape" Value="RoundRectangle 6" />
            </Style>

            <!--
                Tiles: steps card (ColumnSpan=2) + metrics are laid out by VariableSizeWrapPanel via BindableLayout.
                The -30 top margin overlaps the header (moved here from the steps card)
            -->
            <Style x:Key="TileLayout"
                   TargetType="cmc:VariableSizeWrapPanel">
                <Setter Property="Margin" Value="16,-30,16,16" />
                <Setter Property="Columns" Value="2" />
                <Setter Property="Spacing" Value="12" />
            </Style>

            <Style x:Key="StepCardBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="20" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>

            <Style x:Key="CardCaption"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="CardValue"
                   TargetType="Label">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken1}" />
            </Style>

            <Style x:Key="MetricBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="14" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="MetricIcon"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="MetricTitle"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="MetricValue"
                   TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="MetricUnit"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="StepCardGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="20" />
            </Style>

            <Style x:Key="StepRingGrid"
                   TargetType="Grid">
                <Setter Property="WidthRequest" Value="104" />
                <Setter Property="HeightRequest" Value="104" />
            </Style>

            <Style x:Key="StepRing"
                   TargetType="controls:GlowRing">
                <Setter Property="Thickness" Value="10" />
                <Setter Property="StartColor" Value="{StaticResource LightBlueLighten1}" />
                <Setter Property="EndColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="TrackColor" Value="{StaticResource BlueLighten5}" />
            </Style>

            <Style x:Key="StepRateLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken1}" />
            </Style>

            <Style x:Key="StepTextStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="StepGoalLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="StepRemainLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <DataTemplate x:Key="HeroTemplate"
                          x:DataType="module:UIKitDashHero">
                <Border Style="{StaticResource StepCardBorder}"
                        cmc:VariableSizeWrapPanel.ColumnSpan="2"
                        behaviors:AnimationOption.EnterAnimation="FadeUp">
                    <Grid Style="{StaticResource StepCardGrid}"
                          ColumnDefinitions="Auto,*">
                        <Grid Grid.Column="0"
                              Style="{StaticResource StepRingGrid}">
                            <controls:GlowRing Style="{StaticResource StepRing}"
                                               Progress="{Binding Rate}" />
                            <Label Style="{StaticResource StepRateLabel}"
                                   Text="{Binding Rate, StringFormat='{0:P0}'}" />
                        </Grid>
                        <VerticalStackLayout Grid.Column="1"
                                             Style="{StaticResource StepTextStack}">
                            <Label Style="{StaticResource CardCaption}"
                                   Text="今日の歩数" />
                            <Label Style="{StaticResource CardValue}"
                                   behaviors:LabelOption.CountUpFormat="{}{0:N0} 歩"
                                   behaviors:LabelOption.CountUpValue="{Binding Steps}" />
                            <Label Style="{StaticResource StepGoalLabel}"
                                   Text="{Binding Goal, StringFormat='目標 {0:N0} 歩'}" />
                            <Label Style="{StaticResource StepRemainLabel}"
                                   Text="{Binding Remain, StringFormat='あと {0:N0} 歩'}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="MetricTemplate"
                          x:DataType="module:UIKitDashMetric">
                <Border Style="{StaticResource MetricBorder}"
                        behaviors:AnimationOption.EnterAnimation="Pop"
                        behaviors:AnimationOption.EnterDelay="{Binding EnterDelay}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource MetricIcon}"
                               Text="{Binding Icon}" />
                        <Label Style="{StaticResource MetricTitle}"
                               Text="{Binding Title}" />
                        <Label Style="{StaticResource MetricValue}"
                               Text="{Binding Value}" />
                        <Label Style="{StaticResource MetricUnit}"
                               Text="{Binding Unit}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>

            <module:UIKitDashTileTemplateSelector x:Key="TileTemplateSelector"
                                                  HeroTemplate="{StaticResource HeroTemplate}"
                                                  MetricTemplate="{StaticResource MetricTemplate}" />

            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
            <Style x:Key="PeriodSegmentLabel"
                   TargetType="Label">
                <Setter Property="behaviors:TouchOption.Ripple" Value="True" />
                <Setter Property="behaviors:TouchOption.ClickCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type cmc:SegmentedView}}, Path=SelectCommand, x:DataType={x:Type cmc:SegmentedView}}" />
                <Setter Property="behaviors:TouchOption.ClickCommandParameter" Value="{Binding Source={RelativeSource Self}, Path=BindingContext, x:DataType={x:Type Label}}" />
            </Style>
            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->

            <Style x:Key="PeriodSegment"
                   TargetType="cmc:SegmentedView">
                <Setter Property="Margin" Value="16,7,16,15" />
                <Setter Property="SegmentHeight" Value="36" />
                <Setter Property="SelectedBackground" Value="{StaticResource BlueDefault}" />
                <Setter Property="SelectedTextColor" Value="White" />
                <Setter Property="ItemStyle" Value="{StaticResource PeriodSegmentLabel}" />
            </Style>

            <Style x:Key="ChartCardBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,0,16,12" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="ChartTitleLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="ChartSummaryLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken1}" />
            </Style>

            <Style x:Key="StepChartControl"
                   TargetType="drawing:DrawingControl">
                <Setter Property="Margin" Value="-12,4,-12,-8" />
                <Setter Property="HeightRequest" Value="190" />
            </Style>

            <Style x:Key="HeartChartControl"
                   TargetType="drawing:DrawingControl">
                <Setter Property="Margin" Value="-12,4,-12,-8" />
                <Setter Property="HeightRequest" Value="170" />
            </Style>

            <Style x:Key="SleepTimeLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,2,0,8" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="SleepBand"
                   TargetType="controls:KitSleepBand">
                <Setter Property="HeightRequest" Value="120" />
                <Setter Property="AwakeColor" Value="{StaticResource BlueLighten3}" />
                <Setter Property="RemColor" Value="{StaticResource BlueLighten1}" />
                <Setter Property="LightColor" Value="{StaticResource BlueDarken2}" />
                <Setter Property="DeepColor" Value="{StaticResource BlueDarken4}" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="GridColor" Value="{StaticResource GrayLighten3}" />
            </Style>

            <Style x:Key="SleepLegendFlex"
                   TargetType="FlexLayout">
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="JustifyContent" Value="SpaceBetween" />
            </Style>

            <Style x:Key="SleepLegendStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="SleepLegendNameStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="4" />
            </Style>

            <Style x:Key="SleepLegendDot"
                   TargetType="Ellipse">
                <Setter Property="WidthRequest" Value="8" />
                <Setter Property="HeightRequest" Value="8" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="SleepLegendNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="SleepLegendValueLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <s:MapToTextConverter x:Key="SleepStageNameConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:KitSleepStage.Deep}"
                                      Value="深い" />
                    <s:MapToTextEntry Key="{x:Static sample:KitSleepStage.Light}"
                                      Value="浅い" />
                    <s:MapToTextEntry Key="{x:Static sample:KitSleepStage.Rem}"
                                      Value="レム" />
                    <s:MapToTextEntry Key="{x:Static sample:KitSleepStage.Awake}"
                                      Value="覚醒" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToColorConverter x:Key="SleepStageColorConverter">
                <s:MapToColorConverter.Entries>
                    <s:MapToColorEntry Key="{x:Static sample:KitSleepStage.Deep}"
                                       Value="{StaticResource BlueDarken4}" />
                    <s:MapToColorEntry Key="{x:Static sample:KitSleepStage.Light}"
                                       Value="{StaticResource BlueDarken2}" />
                    <s:MapToColorEntry Key="{x:Static sample:KitSleepStage.Rem}"
                                       Value="{StaticResource BlueLighten1}" />
                    <s:MapToColorEntry Key="{x:Static sample:KitSleepStage.Awake}"
                                       Value="{StaticResource BlueLighten3}" />
                </s:MapToColorConverter.Entries>
            </s:MapToColorConverter>

            <!-- Quick link cards to other kit screens -->
            <Style x:Key="LinkCardBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,0,16,12" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="LinkCardGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="LinkIconBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten4}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="LinkIcon"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="LinkTextStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="LinkTitle"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="LinkCaption"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="LinkChevron"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <ScrollView Style="{StaticResource KitDashScroll}">
        <VerticalStackLayout>
            <Grid Style="{StaticResource KitDashHeaderGrid}"
                  ColumnDefinitions="*,Auto,Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Style="{StaticResource GreetLabel}"
                           Text="{Binding Greeting}" />
                    <Label Style="{StaticResource UserLabel}"
                           Text="{Binding UserName}" />
                </VerticalStackLayout>
                <Grid Grid.Column="1"
                      Style="{StaticResource BellArea}">
                    <Button Style="{StaticResource BellButton}"
                            behaviors:ButtonOption.PressEffect="True"
                            Command="{Binding NotifyCommand}"
                            Text="{x:Static fonts:MaterialIcons.Notifications}" />
                    <Border Style="{StaticResource UnreadDot}"
                            behaviors:AnimationOption.Pulse="True" />
                </Grid>
                <Button Grid.Column="2"
                        Style="{StaticResource KitIconButton}"
                        Command="{Binding SettingCommand}"
                        Text="{x:Static fonts:MaterialIcons.Settings}" />
            </Grid>

            <!-- Steps card -->
            <cmc:VariableSizeWrapPanel Style="{StaticResource TileLayout}"
                                       BindableLayout.ItemsSource="{Binding Tiles}"
                                       BindableLayout.ItemTemplateSelector="{StaticResource TileTemplateSelector}" />

            <cmc:SegmentedView Style="{StaticResource PeriodSegment}"
                               ItemsSource="{Binding Periods}"
                               SelectedIndex="{Binding PeriodIndex, Mode=TwoWay}" />

            <Border Style="{StaticResource ChartCardBorder}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource ChartTitleLabel}"
                               Text="歩数" />
                        <Label Grid.Column="1"
                               Style="{StaticResource ChartSummaryLabel}"
                               Text="{Binding StepTotal, StringFormat='合計 {0:N0} 歩'}" />
                    </Grid>
                    <drawing:DrawingControl Style="{StaticResource StepChartControl}"
                                            Drawing="{Binding StepChart}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource ChartCardBorder}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource ChartTitleLabel}"
                               Text="心拍数" />
                        <Label Grid.Column="1"
                               Style="{StaticResource ChartSummaryLabel}"
                               Text="{Binding HeartAverage, StringFormat='平均 {0} bpm'}" />
                    </Grid>
                    <drawing:DrawingControl Style="{StaticResource HeartChartControl}"
                                            Drawing="{Binding HeartChart}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource ChartCardBorder}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource ChartTitleLabel}"
                               Text="昨夜の睡眠" />
                        <Label Grid.Column="1"
                               Style="{StaticResource ChartSummaryLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding SleepLength.Hours}" />
                                    <Span Text="時間" />
                                    <Span Text="{Binding SleepLength.Minutes}" />
                                    <Span Text="分" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                    <Label Style="{StaticResource SleepTimeLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding BedTime, StringFormat='{0:H:mm}'}" />
                                <Span Text=" 〜 " />
                                <Span Text="{Binding WakeTime, StringFormat='{0:H:mm}'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <controls:KitSleepBand Style="{StaticResource SleepBand}"
                                           Spans="{Binding Sleep}" />
                    <FlexLayout Style="{StaticResource SleepLegendFlex}"
                                BindableLayout.ItemsSource="{Binding SleepTotals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="sample:KitSleepTotal">
                                <VerticalStackLayout Style="{StaticResource SleepLegendStack}">
                                    <HorizontalStackLayout Style="{StaticResource SleepLegendNameStack}">
                                        <Ellipse Style="{StaticResource SleepLegendDot}"
                                                 Fill="{Binding Stage, Converter={StaticResource SleepStageColorConverter}}" />
                                        <Label Style="{StaticResource SleepLegendNameLabel}"
                                               Text="{Binding Stage, Converter={StaticResource SleepStageNameConverter}}" />
                                    </HorizontalStackLayout>
                                    <Label Style="{StaticResource SleepLegendValueLabel}"
                                           Text="{Binding Length, StringFormat='{0:h\\:mm}'}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Quick links -->
            <Border Style="{StaticResource LinkCardBorder}"
                    behaviors:AnimationOption.EnterAnimation="FadeUp"
                    behaviors:AnimationOption.EnterDelay="320">
                <Grid Style="{StaticResource LinkCardGrid}"
                      ColumnDefinitions="Auto,*,Auto"
                      behaviors:TouchOption.ClickCommand="{Binding TrackingCommand}"
                      behaviors:TouchOption.Ripple="True">
                    <Border Grid.Column="0"
                            Style="{StaticResource LinkIconBorder}">
                        <Label Style="{StaticResource LinkIcon}"
                               Text="{x:Static fonts:MaterialIcons.Local_shipping}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         Style="{StaticResource LinkTextStack}">
                        <Label Style="{StaticResource LinkTitle}"
                               Text="{Binding OrderNumber, StringFormat='注文 {0}'}" />
                        <Label Style="{StaticResource LinkCaption}"
                               Text="{Binding OrderEta, StringFormat='配達中 · {0:H:mm} 到着予定'}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Style="{StaticResource LinkChevron}"
                           Text="{x:Static fonts:MaterialIcons.Chevron_right}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource LinkCardBorder}"
                    behaviors:AnimationOption.EnterAnimation="FadeUp"
                    behaviors:AnimationOption.EnterDelay="380">
                <Grid Style="{StaticResource LinkCardGrid}"
                      ColumnDefinitions="Auto,*,Auto"
                      behaviors:TouchOption.ClickCommand="{Binding OnboardCommand}"
                      behaviors:TouchOption.Ripple="True">
                    <Border Grid.Column="0"
                            Style="{StaticResource LinkIconBorder}">
                        <Label Style="{StaticResource LinkIcon}"
                               Text="{x:Static fonts:MaterialIcons.Rocket_launch}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         Style="{StaticResource LinkTextStack}">
                        <Label Style="{StaticResource LinkTitle}"
                               Text="はじめに" />
                        <Label Style="{StaticResource LinkCaption}"
                               Text="3 ステップで目標を設定" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Style="{StaticResource LinkChevron}"
                           Text="{x:Static fonts:MaterialIcons.Chevron_right}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentView>
