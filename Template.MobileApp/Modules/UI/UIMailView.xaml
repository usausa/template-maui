<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:models="clr-namespace:Template.MobileApp.Models"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIMailView"
             x:DataType="{x:Type module:UIMailViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIMailViewModel}"
             shell:ShellProperty.Title="Mail"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <converters:MailDateTimeStringConverter x:Key="MailDateTimeStringConverter" />

            <s:CompareToColorConverter x:Key="EqualToSelectColorConverter"
                                       Expression="{x:Static s:CompareExpressions.Equal}"
                                       TrueValue="{StaticResource BlueDarken2}"
                                       FalseValue="{StaticResource GrayDarken1}" />

            <s:MapToTextConverter x:Key="FolderNameConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:MailView.Inbox}"
                                      Value="受信トレイ" />
                    <s:MapToTextEntry Key="{x:Static sample:MailView.Starred}"
                                      Value="スター付き" />
                    <s:MapToTextEntry Key="{x:Static sample:MailView.Sent}"
                                      Value="送信済み" />
                    <s:MapToTextEntry Key="{x:Static sample:MailView.Draft}"
                                      Value="下書き" />
                    <s:MapToTextEntry Key="{x:Static sample:MailView.Trash}"
                                      Value="ゴミ箱" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="FolderIconConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:MailView.Inbox}"
                                      Value="{x:Static fonts:MaterialIcons.Inbox}" />
                    <s:MapToTextEntry Key="{x:Static sample:MailView.Starred}"
                                      Value="{x:Static fonts:MaterialIcons.Star}" />
                    <s:MapToTextEntry Key="{x:Static sample:MailView.Sent}"
                                      Value="{x:Static fonts:MaterialIcons.Send}" />
                    <s:MapToTextEntry Key="{x:Static sample:MailView.Draft}"
                                      Value="{x:Static fonts:MaterialIcons.Drafts}" />
                    <s:MapToTextEntry Key="{x:Static sample:MailView.Trash}"
                                      Value="{x:Static fonts:MaterialIcons.Delete}" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="DayNameConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:MailDay.Today}"
                                      Value="今日" />
                    <s:MapToTextEntry Key="{x:Static sample:MailDay.Yesterday}"
                                      Value="昨日" />
                    <s:MapToTextEntry Key="{x:Static sample:MailDay.ThisWeek}"
                                      Value="今週" />
                    <s:MapToTextEntry Key="{x:Static sample:MailDay.Earlier}"
                                      Value="それ以前" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <Style x:Key="MailHeaderRowLayout"
                   TargetType="FlexLayout">
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                <Setter Property="JustifyContent" Value="SpaceBetween" />
            </Style>

            <Style x:Key="MailHeaderColumnLayout"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="12" />
            </Style>

            <Style x:Key="MailHeaderIconButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="FontSize" Value="36" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
            </Style>

            <Style x:Key="MailHeaderLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="36" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="MailHeaderOptionButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
            </Style>

            <Style x:Key="MailHeaderToggle"
                   TargetType="controls:TextToggle">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="WidthRequest" Value="120" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="SelectedTextColor" Value="{StaticResource BlueDarken4}" />
                <Setter Property="SelectedBackgroundColor" Value="White" />
                <Setter Property="UnselectedTextColor" Value="White" />
                <Setter Property="UnselectedBackgroundColor" Value="{StaticResource BlueDarken4}" />
            </Style>

            <Style x:Key="MailHeaderFilterButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="120" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="ContentLayout" Value="Left, 8" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="MessageCollection"
                   TargetType="CollectionView">
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="GroupHeaderLabel"
                   TargetType="Label">
                <Setter Property="Padding" Value="12,8,12,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueGrayLighten5}" />
            </Style>

            <Style x:Key="DeleteSwipeItem"
                   TargetType="SwipeItem">
                <Setter Property="BackgroundColor" Value="{StaticResource RedDefault}" />
            </Style>

            <Style x:Key="ArchiveSwipeItem"
                   TargetType="SwipeItem">
                <Setter Property="BackgroundColor" Value="{StaticResource GreenDefault}" />
            </Style>

            <Style x:Key="MessageGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="ColumnSpacing" Value="3" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="MessageFromLayout"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="4" />
                <Setter Property="VerticalOptions" Value="Start" />
            </Style>

            <Style x:Key="UnreadDot"
                   TargetType="Ellipse">
                <Setter Property="WidthRequest" Value="8" />
                <Setter Property="HeightRequest" Value="8" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Fill" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="EmptyStateLayout"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="12" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style x:Key="EmptyStateIconLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="96" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
            </Style>

            <Style x:Key="EmptyStateTextLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

            <Style x:Key="MessageImage"
                   TargetType="Image">
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Aspect" Value="AspectFill" />
                <Setter Property="Clip">
                    <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                </Setter>
            </Style>

            <Style x:Key="MessageFromLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style x:Key="MessageTitleLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="MessageBodyLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MaxLines" Value="2" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="MessageDateTimeLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="MessageAttachmentLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Attach_file}" />
            </Style>

            <Style x:Key="MessageStarButton"
                   TargetType="Button">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="WidthRequest" Value="32" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
                <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Star_border}" />
            </Style>

            <Style x:Key="EmptyLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,48" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="LoadingIndicator"
                   TargetType="ActivityIndicator">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Color" Value="{StaticResource BlueDarken2}" />
            </Style>

            <Style x:Key="FloatingButton"
                   TargetType="Button">
                <Setter Property="Margin" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="56" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
                <Setter Property="Shadow">
                    <Shadow Offset="4,4"
                            Brush="Black"
                            Opacity="0.5"
                            Radius="8" />
                </Setter>
            </Style>

            <Style x:Key="MailMenuGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
            </Style>

            <Style x:Key="MailMenuButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="ContentLayout" Value="Top, 0" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

            <Style x:Key="DrawerGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="DrawerHeaderGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="16,20" />
                <Setter Property="ColumnSpacing" Value="12" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
            </Style>

            <Style x:Key="DrawerAvatarImage"
                   TargetType="Image">
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Aspect" Value="AspectFill" />
                <Setter Property="Clip">
                    <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                </Setter>
            </Style>

            <Style x:Key="DrawerProfileStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="DrawerNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="DrawerMailLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource BlueLighten5}" />
            </Style>

            <Style x:Key="FolderStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="0,8" />
            </Style>

            <Style x:Key="FolderRowGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>

            <Style x:Key="FolderIconLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken1}" />
            </Style>

            <Style x:Key="FolderNameLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
            </Style>

            <Style x:Key="FolderCountLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="56,48,*,64">

        <!-- Header1 -->
        <FlexLayout Grid.Row="0"
                    Style="{StaticResource MailHeaderRowLayout}">
            <HorizontalStackLayout Style="{StaticResource MailHeaderColumnLayout}">
                <Button Style="{StaticResource MailHeaderIconButton}"
                        Command="{Binding DrawerCommand}"
                        Text="{Binding Context.View, Converter={StaticResource FolderIconConverter}}" />
                <Label Style="{StaticResource MailHeaderLabel}"
                       Text="{Binding Context.View, Converter={StaticResource FolderNameConverter}}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Style="{StaticResource MailHeaderColumnLayout}">
                <Button Style="{StaticResource MailHeaderOptionButton}"
                        Text="{x:Static fonts:MaterialIcons.Notifications}" />
                <Button Style="{StaticResource MailHeaderOptionButton}"
                        Text="{x:Static fonts:MaterialIcons.Search}" />
            </HorizontalStackLayout>
        </FlexLayout>

        <!-- Header2 -->
        <FlexLayout Grid.Row="1"
                    Style="{StaticResource MailHeaderRowLayout}">
            <HorizontalStackLayout Style="{StaticResource MailHeaderColumnLayout}">
                <controls:TextToggle Style="{StaticResource MailHeaderToggle}"
                                     OnText="優先" OffText="その他" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Style="{StaticResource MailHeaderColumnLayout}">
                <Button Style="{StaticResource MailHeaderFilterButton}"
                        Text="フィルター"
                        ImageSource="{x:Static markup:AppIcons.FilterList}" />
            </HorizontalStackLayout>
        </FlexLayout>

        <!-- Messages -->
        <CollectionView Grid.Row="2"
                        Style="{StaticResource MessageCollection}"
                        behaviors:AnimationOption.FadeInTrigger="{Binding Selected}"
                        behaviors:Scroll.HideOnScrollTarget="{x:Reference MailFab}"
                        ItemsSource="{Binding Context.Groups}"
                        IsVisible="{Binding Selected, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:MailPage.Mail}}"
                        IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="{x:Type sample:MailGroup}">
                    <Label Style="{StaticResource GroupHeaderLabel}"
                           Text="{Binding Day, Converter={StaticResource DayNameConverter}}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type sample:MailMessage}">
                    <SwipeView>
                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                        <SwipeView.LeftItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Style="{StaticResource DeleteSwipeItem}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type module:UIMailViewModel}}, Path=DeleteCommand, x:DataType={x:Type module:UIMailViewModel}}"
                                           CommandParameter="{Binding .}"
                                           Text="削除"
                                           IconImageSource="{x:Static markup:AppIcons.Delete}" />
                            </SwipeItems>
                        </SwipeView.LeftItems>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Style="{StaticResource ArchiveSwipeItem}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type module:UIMailViewModel}}, Path=ArchiveCommand, x:DataType={x:Type module:UIMailViewModel}}"
                                           CommandParameter="{Binding .}"
                                           Text="アーカイブ"
                                           IconImageSource="{x:Static markup:AppIcons.Archive}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Style="{StaticResource MessageGrid}"
                              RowDefinitions="24,20,32"
                              ColumnDefinitions="48,*,40">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:UIMailViewModel}}, Path=OpenCommand, x:DataType={x:Type module:UIMailViewModel}}"
                                                      CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <controls:MailAvatarImage Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                                      Style="{StaticResource MessageImage}"
                                                      Avatar="{Binding Avatar}"
                                                      Sender="{Binding From}" />
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1"
                                                   Style="{StaticResource MessageFromLayout}">
                                <Ellipse Style="{StaticResource UnreadDot}"
                                         IsVisible="{Binding IsUnread}" />
                                <Label Style="{StaticResource MessageFromLabel}"
                                       Text="{Binding From}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsUnread}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="Black" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                            <Label Grid.Row="0" Grid.Column="2"
                                   Style="{StaticResource MessageDateTimeLabel}"
                                   Text="{Binding DateTime, Converter={StaticResource MailDateTimeStringConverter}}" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource MessageTitleLabel}"
                                   Text="{Binding Title}" />
                            <Label Grid.Row="1" Grid.Column="2"
                                   Style="{StaticResource MessageAttachmentLabel}"
                                   IsVisible="{Binding HasAttachment}" />
                            <Label Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource MessageBodyLabel}"
                                   Text="{Binding Preview}" />
                            <Button Grid.Row="2" Grid.Column="2"
                                    Style="{StaticResource MessageStarButton}"
                                    behaviors:AnimationOption.BounceTrigger="{Binding IsStarred}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type module:UIMailViewModel}}, Path=StarCommand, x:DataType={x:Type module:UIMailViewModel}}"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsStarred}"
                                                 Value="True">
                                        <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Star}" />
                                        <Setter Property="TextColor" Value="{StaticResource AmberDarken1}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                        <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Style="{StaticResource EmptyLabel}"
                       IsVisible="{Binding Context.IsLoaded}"
                       Text="メールはありません" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="2"
                             Style="{StaticResource EmptyStateLayout}"
                             behaviors:AnimationOption.FadeInTrigger="{Binding Selected}"
                             IsVisible="{Binding Selected, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:MailPage.Schedule}}">
            <Label Style="{StaticResource EmptyStateIconLabel}"
                   behaviors:AnimationOption.Float="True"
                   Text="{x:Static fonts:MaterialIcons.Event_busy}" />
            <Label Style="{StaticResource EmptyStateTextLabel}"
                   Text="今日の予定はありません" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2"
                             Style="{StaticResource EmptyStateLayout}"
                             behaviors:AnimationOption.FadeInTrigger="{Binding Selected}"
                             IsVisible="{Binding Selected, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:MailPage.Application}}">
            <Label Style="{StaticResource EmptyStateIconLabel}"
                   behaviors:AnimationOption.Float="True"
                   Text="{x:Static fonts:MaterialIcons.Apps}" />
            <Label Style="{StaticResource EmptyStateTextLabel}"
                   Text="アプリはまだありません" />
        </VerticalStackLayout>

        <!-- Indicator -->
        <ActivityIndicator Grid.Row="2"
                           Style="{StaticResource LoadingIndicator}"
                           IsRunning="{Binding IsLoading}" />

        <!-- Floating Button -->
        <Button x:Name="MailFab"
                Grid.Row="2"
                Style="{StaticResource FloatingButton}"
                IsVisible="{Binding Selected, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:MailPage.Mail}}"
                ImageSource="{x:Static markup:AppIcons.LargeAdd}" />

        <!-- Tab -->
        <Grid Grid.Row="3"
              Style="{StaticResource MailMenuGrid}"
              ColumnDefinitions="*,*,*">
            <Button Grid.Column="0"
                    Style="{StaticResource MailMenuButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static module:MailPage.Mail}"
                    Text="メール"
                    TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MailPage.Mail}}">
                <Button.ImageSource>
                    <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Mail}"
                                     Size="36"
                                     FontFamily="MaterialIcons"
                                     Color="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MailPage.Mail}}" />
                </Button.ImageSource>
            </Button>
            <Button Grid.Column="1"
                    Style="{StaticResource MailMenuButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static module:MailPage.Schedule}"
                    Text="予定表"
                    TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MailPage.Schedule}}">
                <Button.ImageSource>
                    <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Calendar_month}"
                                     Size="36"
                                     FontFamily="MaterialIcons"
                                     Color="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MailPage.Schedule}}" />
                </Button.ImageSource>
            </Button>
            <Button Grid.Column="2"
                    Style="{StaticResource MailMenuButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static module:MailPage.Application}"
                    Text="アプリ"
                    TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MailPage.Application}}">
                <Button.ImageSource>
                    <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Apps}"
                                     Size="36"
                                     FontFamily="MaterialIcons"
                                     Color="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MailPage.Application}}" />
                </Button.ImageSource>
            </Button>
        </Grid>

        <cmc:SideDrawer Grid.Row="0" Grid.RowSpan="4"
                        IsOpen="{Binding IsDrawerOpen}"
                        DrawerWidth="280" EdgeSwipeEnabled="False">
            <cmc:SideDrawer.DrawerContent>
                <ContentView behaviors:LazyViewOption.Load="{Binding IsDrawerOpen}">
                    <behaviors:LazyViewOption.Template>
                        <DataTemplate x:DataType="module:UIMailViewModel">
                            <Grid Style="{StaticResource DrawerGrid}"
                                  RowDefinitions="Auto,*">
                                <Grid Grid.Row="0"
                                      Style="{StaticResource DrawerHeaderGrid}"
                                      ColumnDefinitions="Auto,*">
                                    <controls:MailAvatarImage Grid.Column="0"
                                                              Style="{StaticResource DrawerAvatarImage}"
                                                              Sender="{Binding OwnerName}" />
                                    <VerticalStackLayout Grid.Column="1"
                                                         Style="{StaticResource DrawerProfileStack}">
                                        <Label Style="{StaticResource DrawerNameLabel}"
                                               Text="{Binding OwnerName}" />
                                        <Label Style="{StaticResource DrawerMailLabel}"
                                               Text="usausa@example.com" />
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Grid.Row="1"
                                                     Style="{StaticResource FolderStack}"
                                                     BindableLayout.ItemsSource="{Binding Context.Folders}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:Selectable(sample:MailViewCount)">
                                            <Grid Style="{StaticResource FolderRowGrid}"
                                                  ColumnDefinitions="Auto,*,Auto">
                                                <Grid.Triggers>
                                                    <DataTrigger TargetType="Grid"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource AmberLighten4}" />
                                                    </DataTrigger>
                                                </Grid.Triggers>
                                                <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:UIMailViewModel}}, Path=FolderCommand, x:DataType={x:Type module:UIMailViewModel}}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                                <Label Grid.Column="0"
                                                       Style="{StaticResource FolderIconLabel}"
                                                       Text="{Binding Item.View, Converter={StaticResource FolderIconConverter}}" />
                                                <Label Grid.Column="1"
                                                       Style="{StaticResource FolderNameLabel}"
                                                       Text="{Binding Item.View, Converter={StaticResource FolderNameConverter}}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsSelected}"
                                                                     Value="True">
                                                            <Setter Property="FontAttributes" Value="Bold" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Grid.Column="2"
                                                       Style="{StaticResource FolderCountLabel}"
                                                       IsVisible="{Binding Item.Count, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter={s:Int32 0}}"
                                                       Text="{Binding Item.Count}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </behaviors:LazyViewOption.Template>
                </ContentView>
            </cmc:SideDrawer.DrawerContent>
        </cmc:SideDrawer>

    </Grid>

</ContentView>
