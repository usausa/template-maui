<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIScheduleView"
             x:DataType="{x:Type module:UIScheduleViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIScheduleViewModel}"
             shell:ShellProperty.Title="Schedule"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Selector -->

            <Style x:Key="DayChipCollection"
                   TargetType="CollectionView">
                <Setter Property="HeightRequest" Value="84" />
            </Style>

            <Style x:Key="DayChipGrid"
                   TargetType="Grid">
                <Setter Property="WidthRequest" Value="56" />
                <Setter Property="Padding" Value="0,8" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style x:Key="DayChipBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="60" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            </Style>

            <Style x:Key="DayChipStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="DayChipDowLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

            <Style x:Key="DayChipDayLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
            </Style>

            <!-- Summary -->

            <Style x:Key="SummaryBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="12,0,12,8" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten5}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="SummaryItemStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="SummaryCaptionLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

            <Style x:Key="SummaryValueLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken2}" />
            </Style>

            <Style x:Key="SummaryFreeValueLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource SummaryValueLabel}">
                <Setter Property="TextColor" Value="{StaticResource GreenDefault}" />
            </Style>

            <!-- All -->

            <Style x:Key="AllDayScroll"
                   TargetType="ScrollView">
                <Setter Property="Margin" Value="12,0,12,8" />
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Never" />
            </Style>

            <Style x:Key="AllDayStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="6" />
            </Style>

            <Style x:Key="AllDayCaptionLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="AllDayChipBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
            </Style>

            <Style x:Key="AllDayChipLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <!-- Detail -->

            <Style x:Key="DetailSheet"
                   TargetType="cmc:BottomSheetView">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="HalfExpandedRatio" Value="0.5" />
            </Style>

            <Style x:Key="DetailStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="20,8,20,20" />
                <Setter Property="Spacing" Value="14" />
            </Style>

            <Style x:Key="DetailTitleGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="DetailColorBar"
                   TargetType="BoxView">
                <Setter Property="WidthRequest" Value="6" />
                <Setter Property="CornerRadius" Value="3" />
            </Style>

            <Style x:Key="DetailTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="DetailRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="DetailIconLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDefault}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="DetailValueLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="DurationChipBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
            </Style>

            <Style x:Key="DurationChipLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
            </Style>

            <Style x:Key="DetailMembers"
                   TargetType="cmc:AvatarGroup">
                <Setter Property="AvatarSize" Value="32" />
                <Setter Property="MaxDisplayed" Value="4" />
                <Setter Property="Overlap" Value="10" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="DetailMemberCountLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="DetailMemoBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten5}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="DetailMemoLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="1.3" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken2}" />
            </Style>

            <Style x:Key="DetailCloseButton"
                   TargetType="Button">
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken3}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <!-- Content -->
    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="Auto,Auto,Auto,*">

        <!-- Selector -->
        <CollectionView Grid.Row="0"
                        Style="{StaticResource DayChipCollection}"
                        ItemsSource="{Binding Days}"
                        SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                        SelectionMode="Single">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal"
                                   ItemSpacing="0" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type sample:TimetableDay}">
                    <Grid Style="{StaticResource DayChipGrid}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter TargetName="ChipBorder" Property="Border.BackgroundColor" Value="{StaticResource BlueDefault}" />
                                            <Setter TargetName="ChipDow" Property="Label.TextColor" Value="White" />
                                            <Setter TargetName="ChipDay" Property="Label.TextColor" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="ChipBorder"
                                Style="{StaticResource DayChipBorder}">
                            <VerticalStackLayout Style="{StaticResource DayChipStack}">
                                <Label x:Name="ChipDow"
                                       Style="{StaticResource DayChipDowLabel}"
                                       Text="{Binding DowText}" />
                                <Label x:Name="ChipDay"
                                       Style="{StaticResource DayChipDayLabel}"
                                       Text="{Binding Day}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Summary -->
        <Border Grid.Row="1"
                Style="{StaticResource SummaryBorder}">
            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0"
                                     Style="{StaticResource SummaryItemStack}">
                    <Label Style="{StaticResource SummaryCaptionLabel}"
                           Text="予定" />
                    <Label Style="{StaticResource SummaryValueLabel}"
                           Text="{Binding EventCount, StringFormat='{0} 件'}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1"
                                     Style="{StaticResource SummaryItemStack}">
                    <Label Style="{StaticResource SummaryCaptionLabel}"
                           Text="合計" />
                    <Label Style="{StaticResource SummaryValueLabel}"
                           Text="{Binding TotalTimeText}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2"
                                     Style="{StaticResource SummaryItemStack}">
                    <Label Style="{StaticResource SummaryCaptionLabel}"
                           Text="空き" />
                    <Label Style="{StaticResource SummaryFreeValueLabel}"
                           Text="{Binding FreeTimeText}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- All -->
        <ScrollView Grid.Row="2"
                    Style="{StaticResource AllDayScroll}"
                    IsVisible="{Binding AllDayEvents.Count, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter={s:Int32 0}}">
            <HorizontalStackLayout Style="{StaticResource AllDayStack}">
                <Label Style="{StaticResource AllDayCaptionLabel}"
                       Text="終日" />
                <HorizontalStackLayout Style="{StaticResource AllDayStack}"
                                       BindableLayout.ItemsSource="{Binding AllDayEvents}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="module:UIScheduleAllDay">
                            <Border Style="{StaticResource AllDayChipBorder}"
                                    BackgroundColor="{Binding Color}">
                                <Label Style="{StaticResource AllDayChipLabel}"
                                       Text="{Binding Title}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Timetable -->
        <ScrollView Grid.Row="3">
            <controls:DayTimetableView CurrentTime="{Binding CurrentTime}"
                                       EventTappedCommand="{Binding EventTappedCommand}"
                                       Events="{Binding Events}"
                                       ShowCurrentTime="{Binding ShowCurrentTime}" />
        </ScrollView>

        <!-- Detail -->
        <cmc:BottomSheetView Grid.Row="0" Grid.RowSpan="4"
                             Style="{StaticResource DetailSheet}"
                             IsOpen="{Binding IsDetailOpen}">
            <cmc:BottomSheetView.SheetContent>
                <VerticalStackLayout Style="{StaticResource DetailStack}">
                    <Grid Style="{StaticResource DetailTitleGrid}"
                          ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 Style="{StaticResource DetailColorBar}"
                                 Color="{Binding SelectedEvent.Color}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource DetailTitleLabel}"
                               Text="{Binding SelectedEvent.Title}" />
                    </Grid>
                    <Grid Style="{StaticResource DetailRowGrid}"
                          ColumnDefinitions="Auto,Auto,*">
                        <Label Grid.Column="0"
                               Style="{StaticResource DetailIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Schedule}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource DetailValueLabel}"
                               Text="{Binding SelectedTimeText}" />
                        <Border Grid.Column="2"
                                Style="{StaticResource DurationChipBorder}">
                            <Label Style="{StaticResource DurationChipLabel}"
                                   Text="{Binding SelectedDurationText}" />
                        </Border>
                    </Grid>
                    <Grid Style="{StaticResource DetailRowGrid}"
                          ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Style="{StaticResource DetailIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Place}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource DetailValueLabel}"
                               Text="{Binding SelectedEvent.Place}" />
                    </Grid>
                    <Grid Style="{StaticResource DetailRowGrid}"
                          ColumnDefinitions="Auto,Auto,*">
                        <Label Grid.Column="0"
                               Style="{StaticResource DetailIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Group}" />
                        <cmc:AvatarGroup Grid.Column="1"
                                         Style="{StaticResource DetailMembers}"
                                         ItemsSource="{Binding SelectedEvent.Members}" />
                        <Label Grid.Column="2"
                               Style="{StaticResource DetailMemberCountLabel}"
                               Text="{Binding SelectedEvent.Members.Count, StringFormat='{0} 人'}" />
                    </Grid>
                    <Border Style="{StaticResource DetailMemoBorder}">
                        <Label Style="{StaticResource DetailMemoLabel}"
                               Text="{Binding SelectedEvent.Memo}" />
                    </Border>
                    <Button Style="{StaticResource DetailCloseButton}"
                            Command="{Binding CloseDetailCommand}"
                            Text="閉じる" />
                </VerticalStackLayout>
            </cmc:BottomSheetView.SheetContent>
        </cmc:BottomSheetView>

    </Grid>

</ContentView>
