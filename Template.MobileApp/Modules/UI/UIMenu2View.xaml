<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIMenu2View"
             x:DataType="{x:Type module:UIMenu2ViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIMenu2ViewModel}"
             shell:ShellProperty.Title="UI 2"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function4Text="UI 1"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <!-- グループ毎に行を分け、余りセルは可視の無効ボタンにする -->
    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="*,*,*,*,*,*,*,*,*"
          ColumnDefinitions="*,*,*">

        <!-- データ可視化 -->
        <Button Grid.Row="0" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIGraph}"
                Text="Graph"
                ImageSource="{x:Static markup:AppIcons.AccountTree}" />
        <Button Grid.Row="0" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIGraph2}"
                Text="Graph2"
                ImageSource="{x:Static markup:AppIcons.Timeline}" />
        <Button Grid.Row="0" Grid.Column="2"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UITreeMap}"
                Text="TreeMap"
                ImageSource="{x:Static markup:AppIcons.Dashboard}" />
        <Button Grid.Row="1" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIMixer}"
                Text="Mixer"
                ImageSource="{x:Static markup:AppIcons.Tune}" />
        <Button Grid.Row="1" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />
        <Button Grid.Row="1" Grid.Column="2"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />

        <!-- 計器・ゲージ -->
        <Button Grid.Row="2" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIMeter}"
                Text="Meter"
                ImageSource="{x:Static markup:AppIcons.Speed}" />
        <Button Grid.Row="2" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIGauge}"
                Text="Gauge"
                ImageSource="{x:Static markup:AppIcons.AvTimer}" />
        <Button Grid.Row="2" Grid.Column="2"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UILoad}"
                Text="Load"
                ImageSource="{x:Static markup:AppIcons.Hearing}" />
        <Button Grid.Row="3" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIRadar}"
                Text="Radar"
                ImageSource="{x:Static markup:AppIcons.Radar}" />
        <Button Grid.Row="3" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />
        <Button Grid.Row="3" Grid.Column="2"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />

        <!-- HUD (フルスクリーン SkiaSharp) -->
        <Button Grid.Row="4" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIFlight}"
                Text="Flight"
                ImageSource="{x:Static markup:AppIcons.FlightTakeoff}" />
        <Button Grid.Row="4" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UITactical}"
                Text="Tactical"
                ImageSource="{x:Static markup:AppIcons.SmartToy}" />
        <Button Grid.Row="4" Grid.Column="2"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UITelemetry}"
                Text="Telemetry"
                ImageSource="{x:Static markup:AppIcons.Sensors}" />
        <Button Grid.Row="5" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIEnergy}"
                Text="Energy"
                ImageSource="{x:Static markup:AppIcons.Bolt}" />
        <Button Grid.Row="5" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />
        <Button Grid.Row="5" Grid.Column="2"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />

        <!-- 描画デモ -->
        <Button Grid.Row="6" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId UIWheel}"
                Text="Wheel"
                ImageSource="{x:Static markup:AppIcons.Attractions}" />
        <Button Grid.Row="6" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />
        <Button Grid.Row="6" Grid.Column="2"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />

        <!-- 拡張用 -->
        <Button Grid.Row="7" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />
        <Button Grid.Row="7" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />
        <Button Grid.Row="7" Grid.Column="2"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />
        <Button Grid.Row="8" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />
        <Button Grid.Row="8" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />
        <Button Grid.Row="8" Grid.Column="2"
                Style="{StaticResource MenuIconButton}"
                IsEnabled="False"
                Text="" />

    </Grid>

</ContentView>
