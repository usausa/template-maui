<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIKitTrackingView"
             x:DataType="{x:Type module:UIKitTrackingViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIKitTrackingViewModel}"
             shell:ShellProperty.Title="Tracking"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="KitTrackingScroll"
                   TargetType="ScrollView">
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="HeaderBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten4}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>

            <Style x:Key="OrderCaption"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="OrderValue"
                   TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken1}" />
            </Style>

            <Style x:Key="EtaLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
            </Style>

            <Style x:Key="RemainStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="HorizontalOptions" Value="End" />
            </Style>

            <Style x:Key="RemainCaption"
                   TargetType="Label"
                   BasedOn="{StaticResource OrderCaption}">
                <Setter Property="HorizontalOptions" Value="End" />
            </Style>

            <Style x:Key="RemainValueLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken1}" />
            </Style>

            <Style x:Key="RemainNumberSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="RemainUnitSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="DeliveryProgressBar"
                   TargetType="ProgressBar">
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="ProgressColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="CourierBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,0,16,8" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten2}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>

            <Style x:Key="CourierGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="CourierIconBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten4}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="Ellipse" />
            </Style>

            <Style x:Key="CourierIconLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="CourierTextStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="CourierNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="CourierInfoLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="CourierButton"
                   TargetType="Button">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="StepRow"
                   TargetType="Grid">
                <Setter Property="Margin" Value="24,0" />
                <Setter Property="HeightRequest" Value="80" />
            </Style>

            <Style x:Key="DotComplete"
                   TargetType="Ellipse">
                <Setter Property="WidthRequest" Value="18" />
                <Setter Property="HeightRequest" Value="18" />
                <Setter Property="Fill" Value="{StaticResource GreenDefault}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Start" />
            </Style>

            <Style x:Key="DotPending"
                   TargetType="Ellipse">
                <Setter Property="WidthRequest" Value="18" />
                <Setter Property="HeightRequest" Value="18" />
                <Setter Property="Fill" Value="{StaticResource GrayLighten2}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Start" />
            </Style>

            <Style x:Key="DotCurrent"
                   TargetType="Ellipse">
                <Setter Property="WidthRequest" Value="18" />
                <Setter Property="HeightRequest" Value="18" />
                <Setter Property="Fill" Value="{StaticResource BlueDefault}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Start" />
            </Style>

            <Style x:Key="DotCheckLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Check}" />
            </Style>

            <Style x:Key="TimelineLine"
                   TargetType="BoxView">
                <Setter Property="WidthRequest" Value="2" />
                <Setter Property="Color" Value="{StaticResource GrayLighten2}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Margin" Value="0,18,0,0" />
            </Style>

            <Style x:Key="TimelineDoneLine"
                   TargetType="BoxView"
                   BasedOn="{StaticResource TimelineLine}">
                <Setter Property="Color" Value="{StaticResource GreenDefault}" />
            </Style>

            <Style x:Key="StepTextStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="StepTitle"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="StepTime"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <ScrollView Style="{StaticResource KitTrackingScroll}">
        <VerticalStackLayout>
            <Border Style="{StaticResource HeaderBorder}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Style="{StaticResource OrderCaption}"
                                   Text="注文番号" />
                            <Label Style="{StaticResource OrderValue}"
                                   Text="{Binding OrderNumber}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"
                                             Style="{StaticResource RemainStack}">
                            <Label Style="{StaticResource RemainCaption}"
                                   Text="到着まで" />
                            <Label Style="{StaticResource RemainValueLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource RemainNumberSpan}"
                                              Text="{Binding RemainMinutes}" />
                                        <Span Style="{StaticResource RemainUnitSpan}"
                                              Text=" 分" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                    <ProgressBar Style="{StaticResource DeliveryProgressBar}"
                                 Progress="{Binding DeliveryProgress}" />
                    <Label Style="{StaticResource EtaLabel}"
                           Text="{Binding Eta, StringFormat='到着予定: {0:H:mm}'}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CourierBorder}">
                <Grid Style="{StaticResource CourierGrid}"
                      ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Grid.Column="0"
                            Style="{StaticResource CourierIconBorder}">
                        <Label Style="{StaticResource CourierIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Delivery_dining}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         Style="{StaticResource CourierTextStack}">
                        <Label Style="{StaticResource CourierNameLabel}"
                               Text="宇佐見さん" />
                        <Label Style="{StaticResource CourierInfoLabel}"
                               Text="★ 4.9 · 配達 1,284 件" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2"
                            Style="{StaticResource CourierButton}"
                            behaviors:ButtonOption.PressEffect="True"
                            Text="{x:Static fonts:MaterialIcons.Phone}" />
                    <Button Grid.Column="3"
                            Style="{StaticResource CourierButton}"
                            behaviors:ButtonOption.PressEffect="True"
                            Text="{x:Static fonts:MaterialIcons.Chat}" />
                </Grid>
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="module:UIKitTrackingStep">
                        <Grid Style="{StaticResource StepRow}"
                              ColumnDefinitions="40,*"
                              behaviors:AnimationOption.EnterAnimation="FadeUp"
                              behaviors:AnimationOption.EnterDelay="{Binding Delay}">
                            <Grid Grid.Column="0">
                                <BoxView Style="{StaticResource TimelineLine}" />
                                <BoxView Style="{StaticResource TimelineDoneLine}"
                                         behaviors:AnimationOption.EnterAnimation="Grow"
                                         behaviors:AnimationOption.EnterDelay="{Binding LineDelay}"
                                         IsVisible="{Binding IsComplete}" />
                                <Ellipse Style="{StaticResource DotComplete}"
                                         IsVisible="{Binding IsComplete}" />
                                <Label Style="{StaticResource DotCheckLabel}"
                                       IsVisible="{Binding IsComplete}" />
                                <Ellipse Style="{StaticResource DotCurrent}"
                                         behaviors:AnimationOption.Pulse="True"
                                         IsVisible="{Binding IsCurrent}" />
                                <Ellipse Style="{StaticResource DotPending}"
                                         IsVisible="{Binding IsPending}" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="1"
                                                 Style="{StaticResource StepTextStack}">
                                <Label Style="{StaticResource StepTitle}"
                                       Text="{Binding Title}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsCurrent}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Style="{StaticResource StepTime}"
                                       Text="{Binding Time, StringFormat='{0:M/d H:mm}'}" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentView>
