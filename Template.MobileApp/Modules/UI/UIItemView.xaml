<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIItemView"
             x:DataType="{x:Type module:UIItemViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIItemViewModel}"
             shell:ShellProperty.Title="Item"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True"
             behaviors:Focus.SuppressDefaultFocus="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <s:BoolToTextConverter x:Key="FavoriteGlyphConverter"
                                   TrueValue="{x:Static fonts:MaterialIcons.Favorite}"
                                   FalseValue="{x:Static fonts:MaterialIcons.Favorite_outline}" />

            <s:BoolToTextConverter x:Key="AddTextConverter"
                                   TrueValue="✓ カートに追加しました"
                                   FalseValue="カートに入れる" />

            <!-- Root -->
            <Style x:Key="ItemDetailGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
            </Style>

            <Style x:Key="PlateEllipse"
                   TargetType="Ellipse">
                <Setter Property="WidthRequest" Value="260" />
                <Setter Property="HeightRequest" Value="260" />
                <Setter Property="Fill" Value="{StaticResource BlueLighten5}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="ProductImageBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="200" />
                <Setter Property="HeightRequest" Value="200" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 100" />
                <Setter Property="Shadow">
                    <Shadow Offset="0,4"
                            Brush="Black"
                            Opacity="0.15"
                            Radius="12" />
                </Setter>
            </Style>

            <Style x:Key="ProductImage"
                   TargetType="Image">
                <Setter Property="Margin" Value="20" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>

            <!-- Floating buttons (stay over the scroll) -->
            <Style x:Key="TopButtonsGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="16" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="InputTransparent" Value="True" />
                <Setter Property="CascadeInputTransparent" Value="False" />
            </Style>

            <Style x:Key="BackButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Shadow">
                    <Shadow Offset="0,2"
                            Brush="Black"
                            Opacity="0.15"
                            Radius="6" />
                </Setter>
            </Style>

            <Style x:Key="CartButtonArea"
                   TargetType="Grid">
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="HorizontalOptions" Value="End" />
            </Style>

            <Style x:Key="CartButton"
                   TargetType="Button"
                   BasedOn="{StaticResource BackButton}">
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="CartBadgeBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="20" />
                <Setter Property="HeightRequest" Value="20" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="BackgroundColor" Value="{StaticResource RedDefault}" />
                <Setter Property="Stroke" Value="White" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <Style x:Key="CartBadgeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Sheet -->
            <Style x:Key="SheetBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="20,24,20,20" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 40,40,0,0" />
            </Style>

            <Style x:Key="SheetStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="12" />
            </Style>

            <Style x:Key="KindRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="CategoryLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.2" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="FavoriteButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="22" />
            </Style>

            <Style x:Key="ItemTitleRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="ItemTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="PriceLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Rating -->
            <Style x:Key="RatingRowStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="ProductRating"
                   TargetType="mct:RatingView">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="MaximumRating" Value="5" />
                <Setter Property="ShapeDiameter" Value="18" />
                <Setter Property="FillColor" Value="{StaticResource AmberDefault}" />
                <Setter Property="EmptyShapeColor" Value="{StaticResource GrayLighten2}" />
                <Setter Property="ShapeBorderColor" Value="{StaticResource AmberDefault}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="RatingValueLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource AmberDarken3}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="ReviewCountLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Variant chips -->
            <Style x:Key="VariantStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="6" />
            </Style>

            <Style x:Key="VariantCaption"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
            <Style x:Key="VariantChipLabel"
                   TargetType="Label">
                <Setter Property="behaviors:TouchOption.Ripple" Value="True" />
                <Setter Property="behaviors:TouchOption.RippleColor" Value="#201C1B1F" />
                <Setter Property="behaviors:TouchOption.ClickCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type cmc:ChipGroup}}, Path=SelectCommand, x:DataType={x:Type cmc:ChipGroup}}" />
                <Setter Property="behaviors:TouchOption.ClickCommandParameter" Value="{Binding Source={RelativeSource Self}, Path=BindingContext, x:DataType={x:Type Label}}" />
            </Style>
            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->

            <Style x:Key="VariantChipGroup"
                   TargetType="cmc:ChipGroup">
                <Setter Property="ChipTextSize" Value="14" />
                <Setter Property="ChipCornerRadius" Value="18" />
                <Setter Property="ChipPadding" Value="16,0" />
                <Setter Property="ChipBackground" Value="{StaticResource GrayLighten4}" />
                <Setter Property="ChipStroke" Value="{StaticResource GrayLighten4}" />
                <Setter Property="ChipTextColor" Value="{StaticResource GrayDarken2}" />
                <Setter Property="SelectedChipBackground" Value="{StaticResource BlueDefault}" />
                <Setter Property="SelectedChipTextColor" Value="White" />
                <Setter Property="ItemStyle" Value="{StaticResource VariantChipLabel}" />
            </Style>

            <!-- Accordion -->
            <Style x:Key="DetailAccordion"
                   TargetType="cmc:AccordionView">
                <Setter Property="ExpandMode" Value="MultipleOrNone" />
            </Style>

            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
            <Style x:Key="AccordionHeaderRowGrid"
                   TargetType="Grid">
                <Setter Property="behaviors:TouchOption.Ripple" Value="True" />
                <Setter Property="behaviors:TouchOption.ClickCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type cmc:AccordionItem}}, Path=ToggleCommand, x:DataType={x:Type cmc:AccordionItem}}" />
            </Style>
            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->

            <Style TargetType="cmc:AccordionItem">
                <Setter Property="Icon" Value="{x:Static fonts:MaterialIcons.Expand_more}" />
                <Setter Property="IconFontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
                <Setter Property="HeaderRowStyle" Value="{StaticResource AccordionHeaderRowGrid}" />
            </Style>

            <Style x:Key="AccordionHeaderLabel"
                   TargetType="Label">
                <Setter Property="Padding" Value="0,12" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="AccordionBodyLabel"
                   TargetType="Label">
                <Setter Property="Padding" Value="0,0,0,12" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="1.3" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken2}" />
            </Style>

            <Style x:Key="SpecStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="0,0,0,12" />
            </Style>

            <Style x:Key="SpecRowGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="0,8" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="SpecNameLabel"
                   TargetType="Label">
                <Setter Property="WidthRequest" Value="88" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

            <Style x:Key="SpecValueLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="SpecDivider"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource GrayLighten3}" />
            </Style>

            <!-- Footer -->
            <Style x:Key="FooterBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="16,10,16,14" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Shadow">
                    <Shadow Offset="0,-2"
                            Brush="Black"
                            Opacity="0.08"
                            Radius="8" />
                </Setter>
            </Style>

            <Style x:Key="FooterGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>

            <Style x:Key="StepperRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="12" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="StepperButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="36" />
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="QuantityLabel"
                   TargetType="Label">
                <Setter Property="WidthRequest" Value="24" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="AddToCartButton"
                   TargetType="Button">
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Shadow">
                    <Shadow Offset="0,3"
                            Brush="Black"
                            Opacity="0.2"
                            Radius="6" />
                </Setter>
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- 商品は文脈 (UIShopContext) の Selected。カートに入れるとバッジの数が増える -->
    <Grid Style="{StaticResource ItemDetailGrid}"
          RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <!-- Rows 0-1: product backdrop / rows 1-2: sheet. The shared 40px row makes the sheet overlap the backdrop -->
            <Grid RowDefinitions="300,40,Auto">

                <Grid Grid.Row="0" Grid.RowSpan="2">
                    <Ellipse Style="{StaticResource PlateEllipse}"
                             behaviors:AnimationOption.EnterAnimation="Pop" />
                    <Border Style="{StaticResource ProductImageBorder}"
                            behaviors:AnimationOption.EnterAnimation="Pop"
                            behaviors:AnimationOption.EnterDelay="80">
                        <Image Style="{StaticResource ProductImage}"
                               Source="{Binding Context.Selected.Product.Image}" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Grid.RowSpan="2"
                        Style="{StaticResource SheetBorder}">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">

                        <Grid Style="{StaticResource KindRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CategoryLabel}"
                                   Text="{Binding Context.Selected.Product.Kind}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource FavoriteButton}"
                                    behaviors:AnimationOption.HeartbeatTrigger="{Binding Context.Selected.IsFavorite}"
                                    behaviors:AnimationOption.HeartbeatValue="{s:Bool Value=True}"
                                    Command="{Binding FavoriteCommand}"
                                    Text="{Binding Context.Selected.IsFavorite, Converter={StaticResource FavoriteGlyphConverter}}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding Context.Selected.IsFavorite}"
                                                 Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource PinkDefault}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>

                        <Grid Style="{StaticResource ItemTitleRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource ItemTitleLabel}"
                                   Text="{Binding Context.Selected.Product.Name}" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource PriceLabel}"
                                   Text="{Binding Context.Selected.Product.Price, StringFormat='¥{0:N0}'}" />
                        </Grid>

                        <HorizontalStackLayout Style="{StaticResource RatingRowStack}">
                            <mct:RatingView Style="{StaticResource ProductRating}"
                                            Rating="{Binding Context.Selected.Product.Rating}" />
                            <Label Style="{StaticResource RatingValueLabel}"
                                   Text="{Binding Context.Selected.Product.Rating, StringFormat='{0:F1}'}" />
                            <Label Style="{StaticResource ReviewCountLabel}"
                                   Text="{Binding Context.Selected.Product.ReviewCount, StringFormat='({0} 件のレビュー)'}" />
                        </HorizontalStackLayout>

                        <!-- 種類 (無い商品は出さない) -->
                        <VerticalStackLayout Style="{StaticResource VariantStack}"
                                             IsVisible="{Binding Context.Selected.Product.VariantName, Converter={StaticResource NotEmptyConverter}}">
                            <Label Style="{StaticResource VariantCaption}"
                                   Text="{Binding Context.Selected.Product.VariantName}" />
                            <cmc:ChipGroup Style="{StaticResource VariantChipGroup}"
                                           ItemsSource="{Binding Context.Selected.Product.Variants}"
                                           SelectedItem="{Binding SelectedVariant}" />
                        </VerticalStackLayout>

                        <cmc:AccordionView Style="{StaticResource DetailAccordion}">
                            <cmc:AccordionItem IsExpanded="True">
                                <cmc:AccordionItem.Header>
                                    <Label Style="{StaticResource AccordionHeaderLabel}"
                                           Text="商品の説明" />
                                </cmc:AccordionItem.Header>
                                <cmc:AccordionItem.Content>
                                    <Label Style="{StaticResource AccordionBodyLabel}"
                                           Text="{Binding Context.Selected.Product.Description}" />
                                </cmc:AccordionItem.Content>
                            </cmc:AccordionItem>
                            <cmc:AccordionItem>
                                <cmc:AccordionItem.Header>
                                    <Label Style="{StaticResource AccordionHeaderLabel}"
                                           Text="仕様" />
                                </cmc:AccordionItem.Header>
                                <cmc:AccordionItem.Content>
                                    <VerticalStackLayout Style="{StaticResource SpecStack}"
                                                         BindableLayout.ItemsSource="{Binding Context.Selected.Product.Specs}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="sample:ShopSpec">
                                                <VerticalStackLayout>
                                                    <Grid Style="{StaticResource SpecRowGrid}"
                                                          ColumnDefinitions="Auto,*">
                                                        <Label Grid.Column="0"
                                                               Style="{StaticResource SpecNameLabel}"
                                                               Text="{Binding Name}" />
                                                        <Label Grid.Column="1"
                                                               Style="{StaticResource SpecValueLabel}"
                                                               Text="{Binding Value}" />
                                                    </Grid>
                                                    <BoxView Style="{StaticResource SpecDivider}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </cmc:AccordionItem.Content>
                            </cmc:AccordionItem>
                            <cmc:AccordionItem>
                                <cmc:AccordionItem.Header>
                                    <Label Style="{StaticResource AccordionHeaderLabel}"
                                           Text="配送・返品" />
                                </cmc:AccordionItem.Header>
                                <cmc:AccordionItem.Content>
                                    <Label Style="{StaticResource AccordionBodyLabel}"
                                           Text="14 時までのご注文で翌日に発送します。届いてから 30 日以内なら、開封していない商品を返品できます。" />
                                </cmc:AccordionItem.Content>
                            </cmc:AccordionItem>
                        </cmc:AccordionView>

                    </VerticalStackLayout>
                </Border>

            </Grid>
        </ScrollView>

        <Grid Grid.Row="0"
              Style="{StaticResource TopButtonsGrid}"
              ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    Style="{StaticResource BackButton}"
                    Command="{Binding BackCommand}"
                    Text="{x:Static fonts:MaterialIcons.Arrow_back}" />
            <Grid Grid.Column="2"
                  Style="{StaticResource CartButtonArea}">
                <Button Style="{StaticResource CartButton}"
                        Command="{Binding CartCommand}"
                        Text="{x:Static fonts:MaterialIcons.Shopping_cart}" />
                <Border Style="{StaticResource CartBadgeBorder}"
                        behaviors:AnimationOption.BounceTrigger="{Binding Context.Store.CartCount}"
                        IsVisible="{Binding Context.Store.CartCount, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter={s:Int32 0}}">
                    <Label Style="{StaticResource CartBadgeLabel}"
                           Text="{Binding Context.Store.CartCount, Converter={StaticResource BadgeCountConverter}}" />
                </Border>
            </Grid>
        </Grid>

        <!-- Footer: quantity + add to cart -->
        <Border Grid.Row="1"
                Style="{StaticResource FooterBorder}">
            <Grid Style="{StaticResource FooterGrid}"
                  ColumnDefinitions="Auto,*">
                <HorizontalStackLayout Grid.Column="0"
                                       Style="{StaticResource StepperRow}">
                    <Button Style="{StaticResource StepperButton}"
                            behaviors:ButtonOption.PressEffect="True"
                            Command="{Binding DecrementCommand}"
                            Text="−" />
                    <Label Style="{StaticResource QuantityLabel}"
                           Text="{Binding Quantity}" />
                    <Button Style="{StaticResource StepperButton}"
                            behaviors:ButtonOption.PressEffect="True"
                            Command="{Binding IncrementCommand}"
                            Text="+" />
                </HorizontalStackLayout>
                <Button Grid.Column="1"
                        Style="{StaticResource AddToCartButton}"
                        behaviors:ButtonOption.PressEffect="True"
                        Command="{Binding AddCommand}"
                        Text="{Binding IsAdded, Converter={StaticResource AddTextConverter}}" />
            </Grid>
        </Border>

    </Grid>

</ContentView>
