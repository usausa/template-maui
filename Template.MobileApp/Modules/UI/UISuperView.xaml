<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:models="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UISuperView"
             x:DataType="{x:Type module:UISuperViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UISuperViewModel}"
             shell:ShellProperty.Title="Super"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <s:MapToTextConverter x:Key="CrowdTextConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static models:SuperCrowd.Low}"
                                      Value="空いています" />
                    <s:MapToTextEntry Key="{x:Static models:SuperCrowd.Medium}"
                                      Value="やや混雑" />
                    <s:MapToTextEntry Key="{x:Static models:SuperCrowd.High}"
                                      Value="混雑" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToColorConverter x:Key="CrowdColorConverter">
                <s:MapToColorConverter.Entries>
                    <s:MapToColorEntry Key="{x:Static models:SuperCrowd.Low}"
                                       Value="{StaticResource GreenDarken1}" />
                    <s:MapToColorEntry Key="{x:Static models:SuperCrowd.Medium}"
                                       Value="{StaticResource OrangeDarken1}" />
                    <s:MapToColorEntry Key="{x:Static models:SuperCrowd.High}"
                                       Value="{StaticResource RedDarken1}" />
                </s:MapToColorConverter.Entries>
            </s:MapToColorConverter>

            <Style x:Key="SuperPageStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="0,12,0,24" />
            </Style>

            <Style x:Key="SearchBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            </Style>

            <Style x:Key="SearchIconLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

            <Style x:Key="SearchHintLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

            <Style x:Key="PointBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="BackgroundColor" Value="{StaticResource AmberLighten4}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            </Style>

            <Style x:Key="PointLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource OrangeDarken3}" />
            </Style>

            <Style x:Key="BannerCarouselView"
                   TargetType="CarouselView">
                <Setter Property="Margin" Value="0,16,0,0" />
                <Setter Property="HeightRequest" Value="140" />
            </Style>

            <Style x:Key="BannerBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,0" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            </Style>

            <Style x:Key="BannerCaptionStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="BackgroundColor" Value="#99000000" />
            </Style>

            <Style x:Key="BannerTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="BannerSubLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="#CCFFFFFF" />
            </Style>

            <Style x:Key="BannerIndicatorView"
                   TargetType="IndicatorView">
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="IndicatorSize" Value="8" />
                <Setter Property="IndicatorColor" Value="{StaticResource GrayLighten2}" />
                <Setter Property="SelectedIndicatorColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="SuperSectionLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="20,20,20,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="AppFlex"
                   TargetType="FlexLayout">
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="JustifyContent" Value="SpaceEvenly" />
                <Setter Property="Wrap" Value="Wrap" />
            </Style>

            <Style x:Key="AppItemStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Margin" Value="8" />
                <Setter Property="FlexLayout.Basis" Value="22%" />
            </Style>

            <Style x:Key="AppIconButton"
                   TargetType="Button">
                <Setter Property="WidthRequest" Value="52" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="AppNameLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken2}" />
            </Style>

            <Style x:Key="CouponCollection"
                   TargetType="CollectionView">
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="HeightRequest" Value="128" />
            </Style>

            <Style x:Key="CouponBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="240" />
                <Setter Property="HeightRequest" Value="120" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            </Style>

            <Style x:Key="CouponTextStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="4" />
            </Style>

            <Style x:Key="CouponTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="CouponSubLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="#CCFFFFFF" />
            </Style>

            <Style x:Key="CouponIconLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="TextColor" Value="#4DFFFFFF" />
            </Style>

            <Style x:Key="CouponAcquireButton"
                   TargetType="Button">
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
            </Style>

            <Style x:Key="ShopCollection"
                   TargetType="CollectionView">
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="HeightRequest" Value="100" />
            </Style>

            <Style x:Key="ShopBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="180" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten3}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="ShopIconBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            </Style>

            <Style x:Key="ShopIconLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="ShopNameStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="ShopNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="MaxLines" Value="1" />
            </Style>

            <Style x:Key="ShopCategoryLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

            <Style x:Key="ShopBadgeStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Spacing" Value="6" />
            </Style>

            <Style x:Key="DistanceBadgeBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
            </Style>

            <Style x:Key="DistanceBadgeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
            </Style>

            <Style x:Key="CrowdBadgeBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
            </Style>

            <Style x:Key="CrowdBadgeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="SearchRowGrid"
                   TargetType="Grid">
                <Setter Property="Margin" Value="16,0" />
                <Setter Property="ColumnSpacing" Value="10" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource SuperPageStack}">

            <!-- 検索バー+ポイント残高 -->
            <Grid Style="{StaticResource SearchRowGrid}"
                  ColumnDefinitions="*,Auto">
                <Border Grid.Column="0"
                        Style="{StaticResource SearchBorder}">
                    <HorizontalStackLayout>
                        <Label Style="{StaticResource SearchIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Search}" />
                        <Label Style="{StaticResource SearchHintLabel}"
                               Text="サービス・店舗を検索" />
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="1"
                        Style="{StaticResource PointBorder}">
                    <Label Style="{StaticResource PointLabel}"
                           Text="{Binding Point, StringFormat='{0:N0} pt'}" />
                </Border>
            </Grid>

            <!-- バナーカルーセル -->
            <CarouselView x:Name="BannerCarousel"
                          Style="{StaticResource BannerCarouselView}"
                          ItemsSource="{Binding Banners}"
                          IndicatorView="BannerIndicator" Loop="True"
                          Position="{Binding BannerPosition, Mode=TwoWay}">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:SuperBanner}">
                        <Border Style="{StaticResource BannerBorder}">
                            <Grid>
                                <Image Source="{Binding Image}"
                                       Aspect="AspectFill" />
                                <VerticalStackLayout Style="{StaticResource BannerCaptionStack}">
                                    <Label Style="{StaticResource BannerTitleLabel}"
                                           Text="{Binding Title}" />
                                    <Label Style="{StaticResource BannerSubLabel}"
                                           Text="{Binding Sub}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
            <IndicatorView x:Name="BannerIndicator"
                           Style="{StaticResource BannerIndicatorView}" />

            <!-- ミニアプリ -->
            <Label Style="{StaticResource SuperSectionLabel}"
                   Text="サービス" />
            <FlexLayout Style="{StaticResource AppFlex}"
                        BindableLayout.ItemsSource="{Binding Apps}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:SuperApp}">
                        <VerticalStackLayout Style="{StaticResource AppItemStack}">
                            <Button Style="{StaticResource AppIconButton}"
                                    behaviors:ButtonOption.PressEffect="True"
                                    BackgroundColor="{Binding Color}"
                                    Text="{Binding Glyph}" />
                            <Label Style="{StaticResource AppNameLabel}"
                                   Text="{Binding Name}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- クーポン -->
            <Label Style="{StaticResource SuperSectionLabel}"
                   Text="クーポン・キャンペーン" />
            <CollectionView Style="{StaticResource CouponCollection}"
                            ItemsSource="{Binding Coupons}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:SuperCoupon}">
                        <Border Style="{StaticResource CouponBorder}"
                                Background="{Binding Background}">
                            <Grid>
                                <VerticalStackLayout Style="{StaticResource CouponTextStack}">
                                    <Label Style="{StaticResource CouponTitleLabel}"
                                           Text="{Binding Title}" />
                                    <Label Style="{StaticResource CouponSubLabel}"
                                           Text="{Binding Sub}" />
                                </VerticalStackLayout>
                                <Label Style="{StaticResource CouponIconLabel}"
                                       Text="{x:Static fonts:MaterialIcons.Confirmation_number}" />
                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                <Button Style="{StaticResource CouponAcquireButton}"
                                        behaviors:AnimationOption.BounceTrigger="{Binding IsAcquired}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type module:UISuperViewModel}}, Path=AcquireCommand, x:DataType={x:Type module:UISuperViewModel}}"
                                        CommandParameter="{Binding .}"
                                        Text="獲得する">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                                                     Binding="{Binding IsAcquired}"
                                                     Value="True">
                                            <Setter Property="Text" Value="✓ 獲得済み" />
                                            <Setter Property="BackgroundColor" Value="#40FFFFFF" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Style="{StaticResource SuperSectionLabel}"
                   Text="近くのお店" />
            <CollectionView Style="{StaticResource ShopCollection}"
                            ItemsSource="{Binding Shops}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:SuperShop}">
                        <Border Style="{StaticResource ShopBorder}">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0"
                                            Style="{StaticResource ShopIconBorder}"
                                            BackgroundColor="{Binding Color}">
                                        <Label Style="{StaticResource ShopIconLabel}"
                                               Text="{Binding Glyph}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Style="{StaticResource ShopNameStack}">
                                        <Label Style="{StaticResource ShopNameLabel}"
                                               Text="{Binding Name}" />
                                        <Label Style="{StaticResource ShopCategoryLabel}"
                                               Text="{Binding Category}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <HorizontalStackLayout Style="{StaticResource ShopBadgeStack}">
                                    <Border Style="{StaticResource DistanceBadgeBorder}">
                                        <Label Style="{StaticResource DistanceBadgeLabel}"
                                               Text="{Binding Distance, StringFormat='📍 {0:N0} m'}" />
                                    </Border>
                                    <Border Style="{StaticResource CrowdBadgeBorder}"
                                            BackgroundColor="{Binding Crowd, Converter={StaticResource CrowdColorConverter}}">
                                        <Label Style="{StaticResource CrowdBadgeLabel}"
                                               Text="{Binding Crowd, Converter={StaticResource CrowdTextConverter}}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
