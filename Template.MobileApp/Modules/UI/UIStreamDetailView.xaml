<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIStreamDetailView"
             x:DataType="{x:Type module:UIStreamDetailViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIStreamDetailViewModel}"
             shell:ShellProperty.Title="Stream Detail"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Converter -->

            <converters:RuntimeTextConverter x:Key="RuntimeTextConverter" />

            <s:MapToTextConverter x:Key="GenreNameConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Sf}"
                                      Value="SF" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Action}"
                                      Value="アクション" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Romance}"
                                      Value="恋愛" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Comedy}"
                                      Value="コメディ" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Documentary}"
                                      Value="ドキュメンタリー" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamGenre.Fantasy}"
                                      Value="ファンタジー" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="TrailerKindConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:StreamTrailerKind.Trailer}"
                                      Value="予告編" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamTrailerKind.Teaser}"
                                      Value="ティザー" />
                    <s:MapToTextEntry Key="{x:Static sample:StreamTrailerKind.Extra}"
                                      Value="特典" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <!-- Layout -->

            <Style x:Key="StreamDetailScroll"
                   TargetType="ScrollView">
                <Setter Property="BackgroundColor" Value="Black" />
            </Style>

            <!-- Player -->

            <Style x:Key="PlayerGrid"
                   TargetType="Grid">
                <Setter Property="HeightRequest" Value="220" />
            </Style>

            <Style x:Key="PlayerImage"
                   TargetType="Image">
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>

            <Style x:Key="PlayButtonOverlay"
                   TargetType="Button">
                <Setter Property="Text" Value="▶" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="BackgroundColor" Value="#88000000" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="35" />
                <Setter Property="WidthRequest" Value="70" />
                <Setter Property="HeightRequest" Value="70" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="PlayerProgressBar"
                   TargetType="ProgressBar">
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="ProgressColor" Value="{StaticResource RedAccent3}" />
            </Style>

            <!-- Title -->

            <Style x:Key="StreamDetailTitleLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="16,16,16,4" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="MetaRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Margin" Value="16,0" />
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="MatchLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GreenDefault}" />
            </Style>

            <Style x:Key="MetaLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten2}" />
            </Style>

            <!-- Action -->

            <Style x:Key="ActionRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Margin" Value="16,12" />
                <Setter Property="Spacing" Value="10" />
            </Style>

            <Style x:Key="PrimaryPlayButton"
                   TargetType="Button">
                <Setter Property="Text" Value="▶ Resume" />
                <Setter Property="BackgroundColor" Value="{StaticResource RedAccent3}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="WidthRequest" Value="120" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="IconActionButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="#33FFFFFF" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
            </Style>

            <!-- Synopsis -->

            <Style x:Key="SynopsisLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="16,4,16,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
            </Style>

            <Style x:Key="CastLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="16,0,16,12" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <!-- Friend -->

            <Style x:Key="FriendsRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Margin" Value="16,0,16,12" />
                <Setter Property="Spacing" Value="10" />
            </Style>

            <Style x:Key="FriendsAvatars"
                   TargetType="cmc:AvatarGroup">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="MaxDisplayed" Value="3" />
                <Setter Property="Overlap" Value="10" />
                <Setter Property="CountBackgroundColor" Value="#33FFFFFF" />
                <Setter Property="CountTextColor" Value="White" />
            </Style>

            <Style x:Key="FriendsLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Tab -->

            <Style x:Key="TabRow"
                   TargetType="Grid">
                <Setter Property="Margin" Value="16,8" />
            </Style>

            <Style x:Key="TabLabelActive"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="TabLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="TabIndicator"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="2" />
                <Setter Property="Color" Value="{StaticResource RedAccent3}" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <Style x:Key="TabIndicatorInactive"
                   TargetType="BoxView"
                   BasedOn="{StaticResource TabIndicator}">
                <Setter Property="Color" Value="Transparent" />
            </Style>

            <!-- Trailer -->

            <Style x:Key="TrailerStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Margin" Value="16,4,16,16" />
                <Setter Property="Spacing" Value="12" />
            </Style>

            <Style x:Key="TrailerRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="TrailerThumbBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="120" />
                <Setter Property="HeightRequest" Value="68" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="TrailerImage"
                   TargetType="Image">
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>

            <Style x:Key="TrailerPlayBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="28" />
                <Setter Property="HeightRequest" Value="28" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="#88000000" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>

            <Style x:Key="TrailerPlayLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="TrailerTextStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="TrailerTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="TrailerMetaLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <!-- Related -->

            <Style x:Key="RelatedCollection"
                   TargetType="CollectionView">
                <Setter Property="Margin" Value="12,0,12,16" />
                <Setter Property="HeightRequest" Value="260" />
            </Style>

            <Style x:Key="RelatedBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="4" />
                <Setter Property="HeightRequest" Value="120" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="RelatedImage"
                   TargetType="Image">
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>

            <Style x:Key="RelatedOverlay"
                   TargetType="Border">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="BackgroundColor" Value="#AA000000" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="RelatedTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="RelatedDurationLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten2}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <ScrollView Style="{StaticResource StreamDetailScroll}"
                behaviors:ScrollBind.Controller="{Binding Scroller}">
        <VerticalStackLayout>

            <!-- Player -->
            <Grid Style="{StaticResource PlayerGrid}">
                <Image Style="{StaticResource PlayerImage}"
                       Source="{Binding Context.Selected.Work.Image}" />
                <Button Style="{StaticResource PlayButtonOverlay}"
                        behaviors:ButtonOption.PressEffect="True" />
                <ProgressBar Style="{StaticResource PlayerProgressBar}"
                             IsVisible="{Binding Context.Selected.Progress, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter={s:Double 0}}"
                             Progress="{Binding Context.Selected.Progress}" />
            </Grid>

            <!-- Title -->
            <Label Style="{StaticResource StreamDetailTitleLabel}"
                   Text="{Binding Context.Selected.Work.Title}" />
            <HorizontalStackLayout Style="{StaticResource MetaRow}">
                <Label Style="{StaticResource MatchLabel}"
                       Text="{Binding Context.Selected.Work.Match, StringFormat='{0}% マッチ'}" />
                <Label Style="{StaticResource MetaLabel}">
                    <Label.Text>
                        <MultiBinding StringFormat="{}{0} · {1} · {2} · {3}">
                            <Binding Path="Context.Selected.Work.Year" />
                            <Binding Path="Context.Selected.Work.Genre"
                                     Converter="{StaticResource GenreNameConverter}" />
                            <Binding Path="Context.Selected.Work.Minutes"
                                     Converter="{StaticResource RuntimeTextConverter}" />
                            <Binding Path="Context.Selected.Work.Rated" />
                        </MultiBinding>
                    </Label.Text>
                </Label>
            </HorizontalStackLayout>

            <!-- Action -->
            <HorizontalStackLayout Style="{StaticResource ActionRow}">
                <Button Style="{StaticResource PrimaryPlayButton}"
                        behaviors:ButtonOption.PressEffect="True">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Context.Selected.Progress, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter={s:Double 0}}"
                                     Value="False">
                            <Setter Property="Text" Value="▶ Play" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource IconActionButton}"
                        behaviors:ButtonOption.PressEffect="True"
                        Command="{Binding DownloadCommand}"
                        Text="{x:Static fonts:MaterialIcons.Download}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Context.Selected.IsDownloaded}"
                                     Value="True">
                            <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Check}" />
                            <Setter Property="TextColor" Value="{StaticResource GreenDefault}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource IconActionButton}"
                        behaviors:ButtonOption.PressEffect="True"
                        Text="{x:Static fonts:MaterialIcons.Share}" />
                <Button Style="{StaticResource IconActionButton}"
                        behaviors:AnimationOption.HeartbeatTrigger="{Binding Context.Selected.IsFavorite}"
                        behaviors:AnimationOption.HeartbeatValue="{s:Bool Value=True}"
                        behaviors:ButtonOption.PressEffect="True"
                        Command="{Binding FavoriteCommand}"
                        Text="{x:Static fonts:MaterialIcons.Favorite_outline}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Context.Selected.IsFavorite}"
                                     Value="True">
                            <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Favorite}" />
                            <Setter Property="TextColor" Value="{StaticResource RedDefault}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>

            <!-- Synopsis -->
            <Label Style="{StaticResource SynopsisLabel}"
                   Text="{Binding Context.Selected.Work.Synopsis}" />
            <Label Style="{StaticResource CastLabel}">
                <Label.Text>
                    <MultiBinding StringFormat="出演: {0} · 監督: {1}">
                        <Binding Path="Context.Selected.Work.Cast" />
                        <Binding Path="Context.Selected.Work.Director" />
                    </MultiBinding>
                </Label.Text>
            </Label>

            <!-- Friend -->
            <HorizontalStackLayout Style="{StaticResource FriendsRow}">
                <cmc:AvatarGroup Style="{StaticResource FriendsAvatars}"
                                 ItemsSource="{Binding Friends}" />
                <Label Style="{StaticResource FriendsLabel}"
                       Text="Friends are watching" />
            </HorizontalStackLayout>

            <!-- Tab -->
            <Grid Style="{StaticResource TabRow}"
                  ColumnDefinitions="*,*">
                <VerticalStackLayout Grid.Column="0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}"
                                              CommandParameter="Trailers" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Style="{StaticResource TabLabelActive}"
                           IsVisible="{Binding TrailersSelected}"
                           Text="Trailers" />
                    <Label Style="{StaticResource TabLabel}"
                           IsVisible="{Binding RelatedSelected}"
                           Text="Trailers" />
                    <BoxView Style="{StaticResource TabIndicator}"
                             IsVisible="{Binding TrailersSelected}" />
                    <BoxView Style="{StaticResource TabIndicatorInactive}"
                             IsVisible="{Binding RelatedSelected}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}"
                                              CommandParameter="Related" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Style="{StaticResource TabLabelActive}"
                           IsVisible="{Binding RelatedSelected}"
                           Text="More Like This" />
                    <Label Style="{StaticResource TabLabel}"
                           IsVisible="{Binding TrailersSelected}"
                           Text="More Like This" />
                    <BoxView Style="{StaticResource TabIndicator}"
                             IsVisible="{Binding RelatedSelected}" />
                    <BoxView Style="{StaticResource TabIndicatorInactive}"
                             IsVisible="{Binding TrailersSelected}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Trailer -->
            <VerticalStackLayout Style="{StaticResource TrailerStack}"
                                 behaviors:AnimationOption.FadeInTrigger="{Binding TrailersSelected}"
                                 BindableLayout.ItemsSource="{Binding Context.Selected.Work.Trailers}"
                                 IsVisible="{Binding TrailersSelected}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="sample:StreamTrailer">
                        <Grid Style="{StaticResource TrailerRowGrid}"
                              ColumnDefinitions="Auto,*">
                            <Grid Grid.ColumnSpan="2"
                                  ColumnDefinitions="Auto,*"
                                  behaviors:TouchOption.Ripple="True">
                                <Border Grid.Column="0"
                                        Style="{StaticResource TrailerThumbBorder}">
                                    <Grid>
                                        <Image Style="{StaticResource TrailerImage}"
                                               Source="{Binding Image}" />
                                        <Border Style="{StaticResource TrailerPlayBorder}">
                                            <Label Style="{StaticResource TrailerPlayLabel}"
                                                   Text="▶" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Style="{StaticResource TrailerTextStack}">
                                    <Label Style="{StaticResource TrailerTitleLabel}"
                                           Text="{Binding Title}" />
                                    <Label Style="{StaticResource TrailerMetaLabel}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1:m'm 'ss's'}">
                                                <Binding Path="Kind"
                                                         Converter="{StaticResource TrailerKindConverter}" />
                                                <Binding Path="Length" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Related -->
            <CollectionView Style="{StaticResource RelatedCollection}"
                            behaviors:AnimationOption.FadeInTrigger="{Binding RelatedSelected}"
                            ItemsSource="{Binding Context.Related}"
                            IsVisible="{Binding RelatedSelected}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="sample:StreamItem">
                        <Border Style="{StaticResource RelatedBorder}">
                            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                            <Grid behaviors:TouchOption.ClickCommand="{Binding RelatedCommand, Source={RelativeSource AncestorType={x:Type module:UIStreamDetailViewModel}}, x:DataType={x:Type module:UIStreamDetailViewModel}}"
                                  behaviors:TouchOption.ClickCommandParameter="{Binding .}"
                                  behaviors:TouchOption.Ripple="True">
                                <Image Style="{StaticResource RelatedImage}"
                                       Source="{Binding Work.Image}" />
                                <Border Style="{StaticResource RelatedOverlay}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Style="{StaticResource RelatedTitleLabel}"
                                               Text="{Binding Work.Title}" />
                                        <Label Grid.Column="1"
                                               Style="{StaticResource RelatedDurationLabel}"
                                               Text="{Binding Work.Minutes, Converter={StaticResource RuntimeTextConverter}}" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
