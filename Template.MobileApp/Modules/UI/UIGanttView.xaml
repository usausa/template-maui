<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:drawing="clr-namespace:Template.MobileApp.Graphics.Drawing"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIGanttView"
             x:DataType="{x:Type module:UIGanttViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIGanttViewModel}"
             shell:ShellProperty.Title="Gantt"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="再読込"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Converter -->

            <s:MapToColorConverter x:Key="TaskStateColorConverter">
                <s:MapToColorConverter.Entries>
                    <s:MapToColorEntry Key="{x:Static sample:ProjectTaskState.Completed}"
                                       Value="#43A047" />
                    <s:MapToColorEntry Key="{x:Static sample:ProjectTaskState.Running}"
                                       Value="#1E88E5" />
                    <s:MapToColorEntry Key="{x:Static sample:ProjectTaskState.Delayed}"
                                       Value="#FB8C00" />
                    <s:MapToColorEntry Key="{x:Static sample:ProjectTaskState.Milestone}"
                                       Value="#8E24AA" />
                    <s:MapToColorEntry Key="{x:Static sample:ProjectTaskState.Waiting}"
                                       Value="#9E9E9E" />
                </s:MapToColorConverter.Entries>
            </s:MapToColorConverter>

            <!-- Color -->

            <Color x:Key="GanttTextColor">#212121</Color>
            <Color x:Key="GanttSubTextColor">#757575</Color>
            <Color x:Key="GanttLineColor">#E0E0E0</Color>

            <!-- Header -->

            <Style x:Key="TopGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="ColumnSpacing" Value="10" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="ProjectStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="ProjectNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GanttTextColor}" />
            </Style>

            <Style x:Key="ProjectInfoLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="TextColor" Value="{StaticResource GanttSubTextColor}" />
            </Style>

            <Style x:Key="ScaleBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="2" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{StaticResource GanttLineColor}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="ScaleButton"
                   TargetType="Button">
                <Setter Property="WidthRequest" Value="42" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GanttSubTextColor}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style x:Key="TodayButton"
                   TargetType="Button">
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{StaticResource PinkAccent3}" />
                <Setter Property="BackgroundColor" Value="{StaticResource RedLighten5}" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

            <!-- Band -->

            <Style x:Key="BandGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="CornerLabel"
                   TargetType="Label">
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="{StaticResource GanttSubTextColor}" />
            </Style>

            <Style x:Key="SeparatorLine"
                   TargetType="BoxView">
                <Setter Property="WidthRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource GanttLineColor}" />
                <Setter Property="HorizontalOptions" Value="End" />
            </Style>

            <!-- Task -->

            <Style x:Key="TaskGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="ColumnSpacing" Value="8" />
            </Style>

            <Style x:Key="AvatarBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="30" />
                <Setter Property="HeightRequest" Value="30" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="Ellipse" />
            </Style>

            <Style x:Key="AvatarLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="TaskTextStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="1" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="TaskNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="TextColor" Value="{StaticResource GanttTextColor}" />
            </Style>

            <Style x:Key="TaskAssigneeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GanttSubTextColor}" />
            </Style>

            <!-- Footer -->

            <Style x:Key="FooterGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="ColumnSpacing" Value="14" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="FooterStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="1" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="FooterCaptionLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayLighten2}" />
            </Style>

            <Style x:Key="FooterValueLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="FooterDelayLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource FooterValueLabel}">
                <Setter Property="TextColor" Value="{StaticResource AmberDefault}" />
            </Style>

            <Style x:Key="FooterBarStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="6" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="FooterBarGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="8" />
            </Style>

            <Style x:Key="FooterCountLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayLighten2}" />
            </Style>

            <Style x:Key="FooterProgressBar"
                   TargetType="ProgressBar">
                <Setter Property="ProgressColor" Value="{StaticResource GreenAccent3}" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueGrayDarken2}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Project -->
        <Grid Grid.Row="0"
              Style="{StaticResource TopGrid}"
              ColumnDefinitions="*,Auto,Auto">
            <VerticalStackLayout Grid.Column="0"
                                 Style="{StaticResource ProjectStack}">
                <Label Style="{StaticResource ProjectNameLabel}"
                       Text="{Binding Schedule.Name}" />
                <Label Style="{StaticResource ProjectInfoLabel}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Schedule.Start, StringFormat='{0:yyyy/MM/dd}'}" />
                            <Span Text=" – " />
                            <Span Text="{Binding Schedule.End, StringFormat='{0:MM/dd}'}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    Style="{StaticResource ScaleBorder}">
                <HorizontalStackLayout>
                    <Button Style="{StaticResource ScaleButton}"
                            Command="{Binding ScaleCommand}"
                            CommandParameter="{x:Static sample:GanttScale.Day}"
                            Text="日">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding Scale}"
                                         Value="{x:Static sample:GanttScale.Day}">
                                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Style="{StaticResource ScaleButton}"
                            Command="{Binding ScaleCommand}"
                            CommandParameter="{x:Static sample:GanttScale.Week}"
                            Text="週">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding Scale}"
                                         Value="{x:Static sample:GanttScale.Week}">
                                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Style="{StaticResource ScaleButton}"
                            Command="{Binding ScaleCommand}"
                            CommandParameter="{x:Static sample:GanttScale.Month}"
                            Text="月">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding Scale}"
                                         Value="{x:Static sample:GanttScale.Month}">
                                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </Border>
            <Button Grid.Column="2"
                    Style="{StaticResource TodayButton}"
                    Command="{Binding TodayCommand}"
                    Text="今日" />
        </Grid>

        <!-- Date -->
        <Grid Grid.Row="1"
              Style="{StaticResource BandGrid}"
              ColumnDefinitions="140,*"
              HeightRequest="44">
            <Label Grid.Column="0"
                   Style="{StaticResource CornerLabel}"
                   Text="工程 / 担当" />
            <BoxView Grid.Column="0"
                     Style="{StaticResource SeparatorLine}" />
            <ScrollView Grid.Column="1"
                        x:Name="HeaderScroll"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        behaviors:Scroll.SyncTarget="{x:Reference ChartScroll}"
                        behaviors:Scroll.SyncOrientation="Horizontal">
                <drawing:DrawingControl Drawing="{Binding HeaderDrawing}"
                                        HeightRequest="44"
                                        WidthRequest="{Binding ChartWidth}" />
            </ScrollView>
        </Grid>

        <!-- Body -->
        <ScrollView Grid.Row="2"
                    Orientation="Vertical">
            <Grid Style="{StaticResource BandGrid}"
                  ColumnDefinitions="140,*">
                <VerticalStackLayout Grid.Column="0"
                                     BindableLayout.ItemsSource="{Binding Schedule.Tasks}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type sample:ProjectTask}">
                            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                            <Grid Style="{StaticResource TaskGrid}"
                                  ColumnDefinitions="Auto,*"
                                  HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type module:UIGanttViewModel}}, Path=ChartDrawing.RowHeight, x:DataType={x:Type module:UIGanttViewModel}}">
                                <Border Grid.Column="0"
                                        Style="{StaticResource AvatarBorder}"
                                        BackgroundColor="{Binding State, Converter={StaticResource TaskStateColorConverter}}">
                                    <Label Style="{StaticResource AvatarLabel}"
                                           Text="{Binding Assignee, Converter={StaticResource InitialConverter}}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Style="{StaticResource TaskTextStack}">
                                    <Label Style="{StaticResource TaskNameLabel}"
                                           Text="{Binding Name}" />
                                    <Label Style="{StaticResource TaskAssigneeLabel}"
                                           Text="{Binding Assignee}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <BoxView Grid.Column="0"
                         Style="{StaticResource SeparatorLine}" />
                <ScrollView Grid.Column="1"
                            x:Name="ChartScroll"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            behaviors:Scroll.SyncTarget="{x:Reference HeaderScroll}"
                            behaviors:Scroll.SyncOrientation="Horizontal"
                            behaviors:ScrollBind.Controller="{Binding Scroller}"
                            behaviors:ScrollBind.InsetX="120">
                    <drawing:DrawingControl Drawing="{Binding ChartDrawing}"
                                            WidthRequest="{Binding ChartWidth}"
                                            HeightRequest="{Binding ChartHeight}" />
                </ScrollView>
            </Grid>
        </ScrollView>

        <!-- Footer -->
        <Grid Grid.Row="3"
              Style="{StaticResource FooterGrid}"
              ColumnDefinitions="Auto,Auto,*">
            <VerticalStackLayout Grid.Column="0"
                                 Style="{StaticResource FooterStack}">
                <Label Style="{StaticResource FooterCaptionLabel}"
                       Text="進捗" />
                <Label Style="{StaticResource FooterValueLabel}"
                       Text="{Binding Schedule.Progress, StringFormat='{0:P0}'}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1"
                                 Style="{StaticResource FooterStack}">
                <Label Style="{StaticResource FooterCaptionLabel}"
                       Text="遅延" />
                <Label Style="{StaticResource FooterDelayLabel}"
                       Text="{Binding Schedule.DelayedCount, StringFormat='{0} 件'}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2"
                                 Style="{StaticResource FooterBarStack}">
                <Grid Style="{StaticResource FooterBarGrid}"
                      ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0"
                           Style="{StaticResource FooterCaptionLabel}"
                           Text="全体進捗" />
                    <Label Grid.Column="1"
                           Style="{StaticResource FooterCountLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Schedule.CompletedCount}" />
                                <Span Text=" / " />
                                <Span Text="{Binding Schedule.TaskCount}" />
                                <Span Text=" 完了" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>
                <ProgressBar Style="{StaticResource FooterProgressBar}"
                             Progress="{Binding Schedule.Progress}" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentView>
