<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIGraphView"
             x:DataType="{x:Type module:UIGraphViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIGraphViewModel}"
             shell:ShellProperty.Title="Graph"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Converter -->

            <converters:RefKindBrushConverter x:Key="RefBackgroundConverter"
                                              Foreground="False" />
            <converters:RefKindBrushConverter x:Key="RefForegroundConverter"
                                              Foreground="True" />
            <converters:AlternateRowBackgroundConverter x:Key="RowBackgroundConverter"
                                                        EvenColor="Transparent"
                                                        OddColor="{StaticResource GrayLighten4}" />

            <!-- Graph -->

            <Style x:Key="GraphHeaderLabel"
                   TargetType="Label">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="RefBadgeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="SummaryLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
            </Style>

            <Style x:Key="MetaLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="#FF666666" />
            </Style>

            <Style x:Key="ShaLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource MetaLabel}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="TextColor" Value="#FF888888" />
            </Style>

            <Style x:Key="GraphHeaderBarBorder"
                   TargetType="Border">
                <Setter Property="BackgroundColor" Value="#FF2D2D30" />
                <Setter Property="Stroke" Value="#FF2D2D30" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
            </Style>

            <Style x:Key="RefBadgeBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="Stroke" Value="#FF333333" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 4" />
            </Style>

            <Style x:Key="RefListStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Margin" Value="6,0,4,0" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="GraphRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="0" />
                <Setter Property="HeightRequest" Value="26" />
            </Style>

            <!-- Template -->

            <DataTemplate x:Key="RefBadgeTemplate"
                          x:DataType="{x:Type sample:GraphRef}">
                <Border Style="{StaticResource RefBadgeBorder}"
                        BackgroundColor="{Binding Kind, Converter={StaticResource RefBackgroundConverter}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Kind}"
                                     Value="{x:Static sample:GraphRefKind.Head}">
                            <Setter Property="StrokeThickness" Value="2" />
                            <Setter Property="Stroke" Value="{StaticResource BlueDarken4}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource RefBadgeLabel}"
                           Text="{Binding Name}"
                           TextColor="{Binding Kind, Converter={StaticResource RefForegroundConverter}}" />
                </Border>
            </DataTemplate>

            <!-- Commit sheet -->

            <Style x:Key="CommitSheet"
                   TargetType="cmc:BottomSheetView">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="HalfExpandedRatio" Value="0.5" />
            </Style>

            <Style x:Key="SheetStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="20,8,20,24" />
                <Setter Property="Spacing" Value="12" />
            </Style>

            <Style x:Key="SheetSummaryLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="SheetRefLayout"
                   TargetType="FlexLayout">
                <Setter Property="Wrap" Value="Wrap" />
                <Setter Property="Direction" Value="Row" />
                <Setter Property="AlignItems" Value="Start" />
            </Style>

            <Style x:Key="SheetRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="SheetIconLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDefault}" />
            </Style>

            <Style x:Key="SheetValueLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="SheetShaLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource SheetValueLabel}">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <!-- Content -->
    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource GraphHeaderBarBorder}">
            <Label Style="{StaticResource GraphHeaderLabel}"
                   Text="{Binding HeaderText}" />
        </Border>

        <!-- Graph -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Rows}"
                        SelectedItem="{Binding Selected}"
                        SelectionMode="Single"
                        HorizontalScrollBarVisibility="Always" VerticalScrollBarVisibility="Always">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="0" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type sample:GraphRow}">
                    <Grid Style="{StaticResource GraphRowGrid}"
                          ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                          BackgroundColor="{Binding Row, Converter={StaticResource RowBackgroundConverter}}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten4}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>

                        <controls:GraphRowSurface Grid.Column="0"
                                                  RowData="{Binding .}" />

                        <HorizontalStackLayout Grid.Column="1"
                                               Style="{StaticResource RefListStack}"
                                               BindableLayout.ItemsSource="{Binding Refs}"
                                               BindableLayout.ItemTemplate="{StaticResource RefBadgeTemplate}" />

                        <Label Grid.Column="2"
                               Style="{StaticResource SummaryLabel}"
                               Text="{Binding Summary}" />

                        <Label Grid.Column="3"
                               Style="{StaticResource ShaLabel}"
                               Text="{Binding ShortSha}" />

                        <Label Grid.Column="4"
                               Style="{StaticResource MetaLabel}"
                               Text="{Binding When, StringFormat='{0:yyyy-MM-dd}'}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Commit sheet -->
        <cmc:BottomSheetView Grid.Row="0" Grid.RowSpan="2"
                             Style="{StaticResource CommitSheet}"
                             IsOpen="{Binding IsDetailOpen}">
            <cmc:BottomSheetView.SheetContent>
                <VerticalStackLayout Style="{StaticResource SheetStack}">
                    <Label Style="{StaticResource SheetSummaryLabel}"
                           Text="{Binding Detail.Summary}" />
                    <FlexLayout Style="{StaticResource SheetRefLayout}"
                                BindableLayout.ItemsSource="{Binding Detail.Refs}"
                                BindableLayout.ItemTemplate="{StaticResource RefBadgeTemplate}"
                                IsVisible="{Binding Detail.Refs.Count, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter={s:Int32 0}}" />
                    <Grid Style="{StaticResource SheetRowGrid}"
                          ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Style="{StaticResource SheetIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Person}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource SheetValueLabel}"
                               Text="{Binding Detail.Author}" />
                    </Grid>
                    <Grid Style="{StaticResource SheetRowGrid}"
                          ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Style="{StaticResource SheetIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Schedule}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource SheetValueLabel}"
                               Text="{Binding Detail.When, StringFormat='{0:yyyy-MM-dd HH:mm}'}" />
                    </Grid>
                    <Grid Style="{StaticResource SheetRowGrid}"
                          ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Style="{StaticResource SheetIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Commit}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource SheetShaLabel}"
                               Text="{Binding Detail.Sha}" />
                    </Grid>
                </VerticalStackLayout>
            </cmc:BottomSheetView.SheetContent>
        </cmc:BottomSheetView>
    </Grid>

</ContentView>
