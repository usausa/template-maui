<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:models="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UICartView"
             x:DataType="{x:Type module:UICartViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UICartViewModel}"
             shell:ShellProperty.Title="Cart"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True"
             behaviors:Focus.SuppressDefaultFocus="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Root -->
            <Style x:Key="CartGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
            </Style>

            <Style x:Key="CartStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="0,0,0,16" />
                <Setter Property="Spacing" Value="12" />
            </Style>

            <!-- Header banner -->
            <Style x:Key="BannerBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="20,18" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 0,0,24,24" />
            </Style>

            <Style x:Key="BannerTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="BannerCountLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="Opacity" Value="0.9" />
            </Style>

            <!-- Cart items (flat rows) -->
            <Style x:Key="ItemsBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,4,16,0" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten2}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>

            <Style x:Key="DeleteSwipeItem"
                   TargetType="SwipeItemView">
                <Setter Property="WidthRequest" Value="88" />
                <Setter Property="BackgroundColor" Value="{StaticResource RedDefault}" />
            </Style>

            <Style x:Key="DeleteSwipeStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="DeleteSwipeIcon"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="DeleteSwipeLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="ItemRowStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="ItemGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="12" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="ItemImageBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="56" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <Style x:Key="ItemImage"
                   TargetType="Image">
                <Setter Property="Margin" Value="4" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>

            <Style x:Key="ItemTextStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="2" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="ItemTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="VariantBadgeBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
            </Style>

            <Style x:Key="VariantBadgeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
            </Style>

            <Style x:Key="ItemPriceLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="StepperRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="8" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="StepperButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="32" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="QuantityLabel"
                   TargetType="Label">
                <Setter Property="WidthRequest" Value="20" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="RowDivider"
                   TargetType="BoxView">
                <Setter Property="Margin" Value="80,0,0,0" />
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource GrayLighten3}" />
            </Style>

            <!-- Empty -->
            <Style x:Key="EmptyStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="0,48" />
                <Setter Property="Spacing" Value="12" />
            </Style>

            <Style x:Key="EmptyIconLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="56" />
                <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
            </Style>

            <Style x:Key="EmptyTitleLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken3}" />
            </Style>

            <!-- Coupon / points -->
            <Style x:Key="CouponBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,0" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten2}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>

            <Style x:Key="CouponRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="10" />
            </Style>

            <Style x:Key="CouponIcon"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="CouponLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="AppliedBadgeBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="BackgroundColor" Value="{StaticResource GreenLighten5}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="AppliedBadgeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GreenDarken2}" />
            </Style>

            <Style x:Key="CouponDivider"
                   TargetType="BoxView">
                <Setter Property="Margin" Value="0,10" />
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource GrayLighten3}" />
            </Style>

            <Style x:Key="PointsIcon"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="{StaticResource AmberDefault}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="PointsLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Totals -->
            <Style x:Key="TotalsBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,0" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten2}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>

            <Style x:Key="TotalsStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="TotalsCaption"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="TotalsValue"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
            </Style>

            <Style x:Key="DiscountValue"
                   TargetType="Label"
                   BasedOn="{StaticResource TotalsValue}">
                <Setter Property="TextColor" Value="{StaticResource GreenDarken2}" />
            </Style>

            <Style x:Key="TotalCaption"
                   TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="TotalValue"
                   TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
            </Style>

            <!-- Fixed footer -->
            <Style x:Key="FooterBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="16,10,16,14" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Shadow">
                    <Shadow Offset="0,-2"
                            Brush="Black"
                            Opacity="0.08"
                            Radius="8" />
                </Setter>
            </Style>

            <Style x:Key="CheckoutButton"
                   TargetType="Button">
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Shadow">
                    <Shadow Offset="0,3"
                            Brush="Black"
                            Opacity="0.2"
                            Radius="6" />
                </Setter>
                <Style.Triggers>
                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                        <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten1}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Order completed -->
            <Style x:Key="CompletedGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="32" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="CompletedStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="12" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="CompletedIconBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="WidthRequest" Value="96" />
                <Setter Property="HeightRequest" Value="96" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="{StaticResource GreenDefault}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 48" />
                <Setter Property="Shadow">
                    <Shadow Offset="0,4"
                            Brush="{StaticResource GreenDefault}"
                            Opacity="0.4"
                            Radius="16" />
                </Setter>
            </Style>

            <Style x:Key="CompletedIconLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="56" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="CompletedTitleLabel"
                   TargetType="Label">
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
            </Style>

            <Style x:Key="CompletedTextLabel"
                   TargetType="Label">
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="OrderInfoBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="0,12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten5}" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten2}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>

            <Style x:Key="OrderInfoGrid"
                   TargetType="Grid">
                <Setter Property="RowSpacing" Value="10" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="OrderValueLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource TotalsValue}">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- カートの行と合計は文脈 (UIShopContext)。レジに進むと注文を確定して完了を出す -->
    <Grid Style="{StaticResource CartGrid}"
          RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Style="{StaticResource CartStack}">

                <!-- Header banner -->
                <Border Style="{StaticResource BannerBorder}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource BannerTitleLabel}"
                               Text="ショッピングカート" />
                        <Label Style="{StaticResource BannerCountLabel}"
                               Text="{Binding Context.Store.CartCount, StringFormat='カートに {0} 点'}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Empty -->
                <VerticalStackLayout Style="{StaticResource EmptyStack}"
                                     IsVisible="{Binding Context.Store.CartCount, Converter={StaticResource EqualsConverter}, ConverterParameter={s:Int32 0}}">
                    <Label Style="{StaticResource EmptyIconLabel}"
                           behaviors:AnimationOption.Float="True"
                           Text="{x:Static fonts:MaterialIcons.Remove_shopping_cart}" />
                    <Label Style="{StaticResource EmptyTitleLabel}"
                           Text="カートは空です" />
                </VerticalStackLayout>

                <!-- Cart items (swipe left to delete) -->
                <Border Style="{StaticResource ItemsBorder}"
                        IsVisible="{Binding Context.Store.CartCount, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter={s:Int32 0}}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Context.Store.Cart}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ShopCartItem">
                                <VerticalStackLayout>
                                    <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                    <SwipeView>
                                        <SwipeView.RightItems>
                                            <SwipeItems Mode="Execute">
                                                <SwipeItemView Style="{StaticResource DeleteSwipeItem}"
                                                               Command="{Binding Source={RelativeSource AncestorType={x:Type module:UICartViewModel}}, Path=RemoveCommand, x:DataType={x:Type module:UICartViewModel}}"
                                                               CommandParameter="{Binding .}">
                                                    <VerticalStackLayout Style="{StaticResource DeleteSwipeStack}">
                                                        <Label Style="{StaticResource DeleteSwipeIcon}"
                                                               Text="{x:Static fonts:MaterialIcons.Delete}" />
                                                        <Label Style="{StaticResource DeleteSwipeLabel}"
                                                               Text="削除" />
                                                    </VerticalStackLayout>
                                                </SwipeItemView>
                                            </SwipeItems>
                                        </SwipeView.RightItems>
                                        <VerticalStackLayout Style="{StaticResource ItemRowStack}">
                                            <Grid Style="{StaticResource ItemGrid}"
                                                  ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0"
                                                        Style="{StaticResource ItemImageBorder}">
                                                    <Image Style="{StaticResource ItemImage}"
                                                           Source="{Binding Product.Image}" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1"
                                                                     Style="{StaticResource ItemTextStack}">
                                                    <Label Style="{StaticResource ItemTitleLabel}"
                                                           Text="{Binding Product.Name}" />
                                                    <Border Style="{StaticResource VariantBadgeBorder}"
                                                            IsVisible="{Binding Variant, Converter={StaticResource NotEmptyConverter}}">
                                                        <Label Style="{StaticResource VariantBadgeLabel}"
                                                               Text="{Binding Variant}" />
                                                    </Border>
                                                    <Label Style="{StaticResource ItemPriceLabel}"
                                                           Text="{Binding Amount, StringFormat='¥{0:N0}'}" />
                                                </VerticalStackLayout>
                                                <HorizontalStackLayout Grid.Column="2"
                                                                       Style="{StaticResource StepperRow}">
                                                    <Button Style="{StaticResource StepperButton}"
                                                            behaviors:ButtonOption.PressEffect="True"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type module:UICartViewModel}}, Path=DecrementCommand, x:DataType={x:Type module:UICartViewModel}}"
                                                            CommandParameter="{Binding .}"
                                                            Text="−" />
                                                    <Label Style="{StaticResource QuantityLabel}"
                                                           Text="{Binding Quantity}" />
                                                    <Button Style="{StaticResource StepperButton}"
                                                            behaviors:ButtonOption.PressEffect="True"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type module:UICartViewModel}}, Path=IncrementCommand, x:DataType={x:Type module:UICartViewModel}}"
                                                            CommandParameter="{Binding .}"
                                                            Text="+" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <BoxView Style="{StaticResource RowDivider}" />
                                        </VerticalStackLayout>
                                    </SwipeView>
                                    <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Coupon / points -->
                <Border Style="{StaticResource CouponBorder}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource CouponRowGrid}"
                              ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CouponIcon}"
                                   Text="{x:Static fonts:MaterialIcons.Local_offer}" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource CouponLabel}"
                                   Text="{Binding Coupon}" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource AppliedBadgeBorder}">
                                <Label Style="{StaticResource AppliedBadgeLabel}"
                                       Text="適用済み" />
                            </Border>
                        </Grid>
                        <BoxView Style="{StaticResource CouponDivider}" />
                        <Grid Style="{StaticResource CouponRowGrid}"
                              ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0"
                                   Style="{StaticResource PointsIcon}"
                                   Text="{x:Static fonts:MaterialIcons.Star}" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource PointsLabel}"
                                   Text="{Binding Points}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Totals -->
                <Border Style="{StaticResource TotalsBorder}">
                    <VerticalStackLayout Style="{StaticResource TotalsStack}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource TotalsCaption}"
                                   Text="小計" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource TotalsValue}"
                                   Text="{Binding Context.Store.Subtotal, StringFormat='¥{0:N0}'}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource TotalsCaption}"
                                   Text="割引" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource DiscountValue}"
                                   Text="{Binding Context.Store.Discount, StringFormat='− ¥{0:N0}'}" />
                        </Grid>
                        <BoxView Style="{StaticResource CouponDivider}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource TotalCaption}"
                                   Text="合計" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource TotalValue}"
                                   behaviors:LabelOption.CountUpDuration="450"
                                   behaviors:LabelOption.CountUpFormat="¥{0:N0}"
                                   behaviors:LabelOption.CountUpValue="{Binding Context.Store.Total}"
                                   behaviors:AnimationOption.BounceTrigger="{Binding Context.Store.Total}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Fixed checkout footer -->
        <Border Grid.Row="1"
                Style="{StaticResource FooterBorder}">
            <Button Style="{StaticResource CheckoutButton}"
                    behaviors:ButtonOption.PressEffect="True"
                    Command="{Binding CheckoutCommand}"
                    IsEnabled="{Binding Context.Store.CartCount, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter={s:Int32 0}}"
                    Text="レジに進む" />
        </Border>

        <!-- Order completed -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Style="{StaticResource CompletedGrid}"
              IsVisible="{Binding IsCompleted}">
            <VerticalStackLayout Style="{StaticResource CompletedStack}">
                <Border Style="{StaticResource CompletedIconBorder}"
                        behaviors:AnimationOption.BounceTrigger="{Binding IsCompleted}">
                    <Label Style="{StaticResource CompletedIconLabel}"
                           Text="{x:Static fonts:MaterialIcons.Check}" />
                </Border>
                <Label Style="{StaticResource CompletedTitleLabel}"
                       Text="ご注文ありがとうございました" />
                <Label Style="{StaticResource CompletedTextLabel}"
                       Text="確認のメールをお送りしました" />
                <Border Style="{StaticResource OrderInfoBorder}">
                    <Grid Style="{StaticResource OrderInfoGrid}"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto">
                        <Label Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource TotalsCaption}"
                               Text="注文番号" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource OrderValueLabel}"
                               Text="{Binding Order.Number, StringFormat='#{0}'}" />
                        <Label Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource TotalsCaption}"
                               Text="お届け予定" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource TotalsValue}"
                               Text="{Binding Order.DeliveryDate, StringFormat='{0:M/d (ddd)}'}" />
                        <Label Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource TotalsCaption}"
                               Text="点数" />
                        <Label Grid.Row="2" Grid.Column="1"
                               Style="{StaticResource TotalsValue}"
                               Text="{Binding Order.Count, StringFormat='{0} 点'}" />
                        <Label Grid.Row="3" Grid.Column="0"
                               Style="{StaticResource TotalCaption}"
                               Text="お支払い" />
                        <Label Grid.Row="3" Grid.Column="1"
                               Style="{StaticResource TotalValue}"
                               Text="{Binding Order.Total, StringFormat='¥{0:N0}'}" />
                    </Grid>
                </Border>
                <Button Style="{StaticResource CheckoutButton}"
                        behaviors:ButtonOption.PressEffect="True"
                        Command="{Binding ContinueCommand}"
                        Text="お買い物を続ける" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentView>
