                           Style="{StaticResource ShopIconLabel}"
                           Text="{Binding Kind, Converter={StaticResource ShopEmojiConverter}}" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource TransactionShopLabel}"
                           Text="{Binding Shop}" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource TransactionTimeLabel}"
                           Text="{Binding Date, StringFormat='{0:HH:mm}'}" />
