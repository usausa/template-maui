<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:drawing="clr-namespace:Template.MobileApp.Graphics.Drawing"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:models="clr-namespace:Template.MobileApp.Models"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIMoneyView"
             x:DataType="{x:Type module:UIMoneyViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIMoneyViewModel}"
             shell:ShellProperty.Title="Money"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <s:CompareToColorConverter x:Key="EqualToSelectColorConverter"
                                       Expression="{x:Static s:CompareExpressions.Equal}"
                                       TrueValue="{StaticResource PinkAccent3}"
                                       FalseValue="{StaticResource GrayDefault}" />

            <converters:RelativeDayConverter x:Key="RelativeDayConverter" />

            <s:CompareToColorConverter x:Key="AmountColorConverter"
                                       Expression="{x:Static s:CompareExpressions.GreaterThan}"
                                       TrueValue="{StaticResource GreenDarken1}"
                                       FalseValue="{StaticResource RedDarken1}" />

            <s:MapToTextConverter x:Key="ShopEmojiConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Cafe}"
                                      Value="☕" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Restaurant}"
                                      Value="🍱" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Grocery}"
                                      Value="🛒" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Convenience}"
                                      Value="🏪" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Fashion}"
                                      Value="👕" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Train}"
                                      Value="🚃" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Taxi}"
                                      Value="🚕" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Electricity}"
                                      Value="💡" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Water}"
                                      Value="🚰" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Mobile}"
                                      Value="📱" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Cinema}"
                                      Value="🎬" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Book}"
                                      Value="📚" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Pharmacy}"
                                      Value="💊" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyShopKind.Charge}"
                                      Value="💰" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="CategoryNameConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Food}"
                                      Value="食費" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Shopping}"
                                      Value="買い物" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Transport}"
                                      Value="交通" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Utility}"
                                      Value="光熱・通信" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Entertainment}"
                                      Value="趣味" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Health}"
                                      Value="医療" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToTextConverter x:Key="CategoryIconConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Food}"
                                      Value="{x:Static fonts:MaterialIcons.Restaurant}" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Shopping}"
                                      Value="{x:Static fonts:MaterialIcons.Shopping_bag}" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Transport}"
                                      Value="{x:Static fonts:MaterialIcons.Train}" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Utility}"
                                      Value="{x:Static fonts:MaterialIcons.Lightbulb}" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Entertainment}"
                                      Value="{x:Static fonts:MaterialIcons.Movie}" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyCategory.Health}"
                                      Value="{x:Static fonts:MaterialIcons.Local_hospital}" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToColorConverter x:Key="CategoryColorConverter">
                <s:MapToColorConverter.Entries>
                    <s:MapToColorEntry Key="{x:Static sample:MoneyCategory.Food}"
                                       Value="{StaticResource DeepOrangeLighten1}" />
                    <s:MapToColorEntry Key="{x:Static sample:MoneyCategory.Shopping}"
                                       Value="{StaticResource PinkLighten1}" />
                    <s:MapToColorEntry Key="{x:Static sample:MoneyCategory.Transport}"
                                       Value="{StaticResource BlueLighten1}" />
                    <s:MapToColorEntry Key="{x:Static sample:MoneyCategory.Utility}"
                                       Value="{StaticResource AmberDarken1}" />
                    <s:MapToColorEntry Key="{x:Static sample:MoneyCategory.Entertainment}"
                                       Value="{StaticResource PurpleLighten1}" />
                    <s:MapToColorEntry Key="{x:Static sample:MoneyCategory.Health}"
                                       Value="{StaticResource TealLighten1}" />
                </s:MapToColorConverter.Entries>
            </s:MapToColorConverter>

            <s:MapToTextConverter x:Key="NoticeIconConverter">
                <s:MapToTextConverter.Entries>
                    <s:MapToTextEntry Key="{x:Static sample:MoneyNoticeKind.Charge}"
                                      Value="{x:Static fonts:MaterialIcons.Account_balance_wallet}" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyNoticeKind.Point}"
                                      Value="{x:Static fonts:MaterialIcons.Savings}" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyNoticeKind.Campaign}"
                                      Value="{x:Static fonts:MaterialIcons.Campaign}" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyNoticeKind.Statement}"
                                      Value="{x:Static fonts:MaterialIcons.Receipt_long}" />
                    <s:MapToTextEntry Key="{x:Static sample:MoneyNoticeKind.Security}"
                                      Value="{x:Static fonts:MaterialIcons.Verified_user}" />
                </s:MapToTextConverter.Entries>
            </s:MapToTextConverter>

            <s:MapToColorConverter x:Key="NoticeColorConverter">
                <s:MapToColorConverter.Entries>
                    <s:MapToColorEntry Key="{x:Static sample:MoneyNoticeKind.Charge}"
                                       Value="{StaticResource GreenDefault}" />
                    <s:MapToColorEntry Key="{x:Static sample:MoneyNoticeKind.Point}"
                                       Value="{StaticResource AmberDarken1}" />
                    <s:MapToColorEntry Key="{x:Static sample:MoneyNoticeKind.Campaign}"
                                       Value="{StaticResource PinkDefault}" />
                    <s:MapToColorEntry Key="{x:Static sample:MoneyNoticeKind.Statement}"
                                       Value="{StaticResource BlueDefault}" />
                    <s:MapToColorEntry Key="{x:Static sample:MoneyNoticeKind.Security}"
                                       Value="{StaticResource RedDefault}" />
                </s:MapToColorConverter.Entries>
            </s:MapToColorConverter>

            <!-- Background -->
            <Style x:Key="BackgroundGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="{StaticResource RedLighten5}" />
            </Style>

            <!-- Header -->
            <Style x:Key="MoneyHeaderBackgroundBorder"
                   TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.0" Color="{StaticResource RedLighten5}" />
                            <GradientStop Offset="1.0" Color="{StaticResource RedLighten4}" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="0,0,36,36" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MoneyHeaderBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,16,16,40" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="MoneyHeaderGrid"
                   TargetType="Grid">
                <Setter Property="Margin" Value="8" />
            </Style>

            <Style x:Key="MoneyHeaderLogoLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="MoneyHeaderLogoIconSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="36" />
            </Style>

            <Style x:Key="MoneyHeaderLogoNameSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="24" />
            </Style>

            <Style x:Key="MoneyHeaderInformationButton"
                   TargetType="Button">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="108" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource LightBlueDefault}" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="MoneyHeaderAmountStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="MoneyHeaderAmountValueLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="36" />
            </Style>

            <Style x:Key="MoneyHeaderAmountUnitLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="MoneyHeaderPointLayout"
                   TargetType="VerticalStackLayout">
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="MoneyHeaderPointNameLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="10" />
            </Style>

            <Style x:Key="MoneyHeaderPointValueLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="MoneyHeaderPointValueSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="MoneyHeaderPointUnitSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Rank -->
            <Style x:Key="RankBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="320" />
                <!-- Lift with a negative margin instead of TranslationY, which is not applied to Shadow on Android -->
                <Setter Property="Margin" Value="0,-20,0,20" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="Stroke" Value="{StaticResource RedLighten3}" />
                <Setter Property="Shadow">
                    <Shadow Brush="{StaticResource RedLighten1}"
                            Opacity="0.5"
                            Radius="12" />
                </Setter>
            </Style>
            <Style x:Key="RankBadgeBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="2" />
                <Setter Property="StrokeShape" Value="Ellipse" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Background">
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#F2F2F2" />
                        <GradientStop Offset="0.5" Color="#C4C4CC" />
                        <GradientStop Offset="1.0" Color="#9E9EA6" />
                    </LinearGradientBrush>
                </Setter>
            </Style>

            <Style x:Key="RankBadgeLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="RankValueLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="RankLinkLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <!-- Menu -->
            <Style x:Key="MoneyMenuBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,0,16,16" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="MoneyMenuGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="0,16" />
                <Setter Property="RowSpacing" Value="16" />
            </Style>

            <Style x:Key="MoneyMenuImageButton"
                   TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="64" />
                <Setter Property="HeightRequest" Value="64" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.1" Color="{StaticResource PinkAccent2}" />
                            <GradientStop Offset="1.0" Color="{StaticResource PinkAccent1}" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MoneyMenuLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Detail -->
            <Style x:Key="DetailLayout"
                   TargetType="VerticalStackLayout">
                <Setter Property="Margin" Value="16,0,16,16" />
            </Style>

            <Style x:Key="DetailBorder"
                   TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="DetailSeparatorBoxView"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="0.5" />
                <Setter Property="Color" Value="{StaticResource GrayLighten2}" />
            </Style>

            <Style x:Key="DetailGridWithLink"
                   TargetType="Grid">
                <Setter Property="Padding" Value="8,8,0,8" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="DetailGridWithoutLink"
                   TargetType="Grid">
                <Setter Property="Padding" Value="8" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="DetailNameLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="DetailValueLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="DetailNextLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="DetailButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!-- Bottom select -->
            <Style x:Key="BottomSelectSeparatorBoxView"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="0.5" />
                <Setter Property="Color" Value="{StaticResource GrayLighten1}" />
            </Style>

            <Style x:Key="BottomSelectGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="BottomSelectImage"
                   TargetType="Image">
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style x:Key="BottomSelectLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Bottom select badge -->
            <Style x:Key="BottomSelectBadgeBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="20" />
                <Setter Property="HeightRequest" Value="20" />
                <Setter Property="TranslationX" Value="20" />
                <Setter Property="TranslationY" Value="4" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="{StaticResource OrangeDefault}" />
                <Setter Property="StrokeShape" Value="Ellipse" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="BottomSelectBadgeLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <!-- お知らせ件数バッジ(「99+」まで収まるピル型) -->
            <Style x:Key="NotificationBadgeBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource BottomSelectBadgeBorder}">
                <Setter Property="WidthRequest" Value="28" />
                <Setter Property="TranslationX" Value="24" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <!-- Center button -->
            <Style x:Key="CenterButton"
                   TargetType="Button">
                <Setter Property="WidthRequest" Value="72" />
                <Setter Property="HeightRequest" Value="72" />
                <Setter Property="Padding" Value="0,6,0,0" />
                <Setter Property="TranslationY" Value="-12" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="CornerRadius" Value="36" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BackgroundColor" Value="{StaticResource PinkDefault}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="ContentLayout" Value="Top, 0" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

            <Style x:Key="RateBadgeBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="{StaticResource GreenLighten5}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 2" />
            </Style>

            <Style x:Key="RateBadgeLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GreenDarken2}" />
            </Style>

            <Style x:Key="MoneyCardBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,0,16,16" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="SearchResultBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource MoneyCardBorder}">
                <Setter Property="VerticalOptions" Value="Fill" />
                <Setter Property="Padding" Value="16,0" />
            </Style>

            <Style x:Key="CardTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
            </Style>

            <Style x:Key="CardHeaderGrid"
                   TargetType="Grid">
                <Setter Property="MinimumHeightRequest" Value="32" />
            </Style>

            <Style x:Key="CardChevronLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

            <Style x:Key="MonthSelectStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="MonthSelectLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken2}" />
            </Style>

            <Style x:Key="MonthSelectArrowLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken2}" />
            </Style>

            <Style x:Key="ExpenseTotalStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="ExpenseTotalLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
            </Style>

            <Style x:Key="ExpenseCaptionSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

            <Style x:Key="ExpenseValueSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="ExpenseAverageLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

            <Style x:Key="WeeklyChartControl"
                   TargetType="drawing:DrawingControl">
                <Setter Property="Margin" Value="-12,4,-12,-8" />
                <Setter Property="HeightRequest" Value="190" />
            </Style>

            <Style x:Key="CategoryScroll"
                   TargetType="ScrollView">
                <Setter Property="Margin" Value="-16,8,-16,0" />
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Never" />
            </Style>

            <Style x:Key="CategoryStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Padding" Value="8,0" />
            </Style>

            <Style x:Key="CategoryItemStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="WidthRequest" Value="80" />
                <Setter Property="Spacing" Value="2" />
            </Style>

            <Style x:Key="CategoryIconBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="Ellipse" />
            </Style>

            <Style x:Key="CategoryIconLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="CategoryNameLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken2}" />
            </Style>

            <Style x:Key="CategoryAmountLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
            </Style>

            <Style x:Key="CategoryRatioLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

