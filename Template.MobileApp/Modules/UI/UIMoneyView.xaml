                           Style="{StaticResource TransactionAmountLabel}"
                           Text="{Binding Amount, StringFormat='{0:+#,0;−#,0;0} 円'}"
                           TextColor="{Binding Amount, Converter={StaticResource AmountColorConverter}, ConverterParameter={s:Int32 0}}" />
