    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid RowDefinitions="*,Auto,Auto">

        <!-- Content -->
        <ScrollView Grid.Row="0"
                    IsVisible="{Binding Selected, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:MoneyPage.Home}}">

            <Grid Style="{StaticResource BackgroundGrid}"
                  RowDefinitions="196,40,Auto,Auto,Auto,Auto,Auto">

                <!-- Header -->
                <Border Grid.Row="0"
                        Style="{StaticResource MoneyHeaderBackgroundBorder}" />

                <Border Grid.Row="0"
                        Style="{StaticResource MoneyHeaderBorder}"
                        behaviors:AnimationOption.EnterAnimation="FadeUp">
                    <Grid Style="{StaticResource MoneyHeaderGrid}"
                          RowDefinitions="*,*"
                          ColumnDefinitions="3*,2*">
                        <Label Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource MoneyHeaderLogoLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource MoneyHeaderLogoIconSpan}"
                                          Text="🐰" />
                                    <Span Style="{StaticResource MoneyHeaderLogoNameSpan}"
                                          Text="うさペイ残高" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource MoneyHeaderInformationButton}"
                                Command="{Binding DetailCommand}"
                                Text="詳細" />
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource MoneyHeaderAmountStack}">
                            <Label Style="{StaticResource MoneyHeaderAmountValueLabel}"
                                   behaviors:LabelOption.CountUpFormat="{}{0:N0}"
                                   behaviors:LabelOption.CountUpValue="{Binding Balance}" />
                            <Label Style="{StaticResource MoneyHeaderAmountUnitLabel}"
                                   Text=" 円" />
                            <Border Style="{StaticResource RateBadgeBorder}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsBalanceUp}"
                                                 Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource RedLighten5}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Style="{StaticResource RateBadgeLabel}"
                                       Text="{Binding BalanceRate, StringFormat='{0:↑ +0.0%;↓ −0.0%;→ 0.0%}'}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsBalanceUp}"
                                                     Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource RedDarken2}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                                             Style="{StaticResource MoneyHeaderPointLayout}">
                            <Label Style="{StaticResource MoneyHeaderPointNameLabel}"
                                   Text="ポイント残高" />
                            <Label Style="{StaticResource MoneyHeaderPointValueLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource MoneyHeaderPointValueSpan}"
                                              Text="1,234" />
                                        <Span Style="{StaticResource MoneyHeaderPointUnitSpan}"
                                              Text=" pt" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Rank -->
                <Border Grid.Row="1"
                        Style="{StaticResource RankBorder}"
                        behaviors:AnimationOption.EnterAnimation="FadeUp"
                        behaviors:AnimationOption.EnterDelay="100">
                    <Grid ColumnDefinitions="36,*,36"
                          behaviors:TouchOption.Ripple="True">
                        <Border Grid.Column="0"
                                Style="{StaticResource RankBadgeBorder}">
