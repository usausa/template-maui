<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:converters="clr-namespace:Template.MobileApp.Converters"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.UI"
             x:Class="Template.MobileApp.Modules.UI.UIMoneyView"
             x:DataType="{x:Type module:UIMoneyViewModel}"
             s:BindingContextResolver.Type="{x:Type module:UIMoneyViewModel}"
             shell:ShellProperty.Title="Money"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <s:CompareToColorConverter x:Key="EqualToSelectColorConverter"
                                       Expression="{x:Static s:CompareExpressions.Equal}"
                                       TrueValue="{StaticResource PinkAccent3}"
                                       FalseValue="{StaticResource GrayDefault}" />

            <converters:BadgeCountConverter x:Key="BadgeCountConverter" />

            <!-- Background -->
            <Style x:Key="BackgroundGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="{StaticResource RedLighten5}" />
            </Style>

            <!-- Header -->
            <Style x:Key="MoneyHeaderBackgroundBorder"
                   TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.0" Color="{StaticResource RedLighten5}" />
                            <GradientStop Offset="1.0" Color="{StaticResource RedLighten4}" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="0,0,36,36" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MoneyHeaderBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,16,16,40" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="MoneyHeaderGrid"
                   TargetType="Grid">
                <Setter Property="Margin" Value="8" />
            </Style>

            <Style x:Key="MoneyHeaderLogoLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="MoneyHeaderLogoIconSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="36" />
            </Style>

            <Style x:Key="MoneyHeaderLogoNameSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="24" />
            </Style>

            <Style x:Key="MoneyHeaderInformationButton"
                   TargetType="Button">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="108" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource LightBlueDefault}" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="MoneyHeaderAmountLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="MoneyHeaderAmountValueSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="36" />
            </Style>

            <Style x:Key="MoneyHeaderAmountUnitSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="MoneyHeaderPointLayout"
                   TargetType="VerticalStackLayout">
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="MoneyHeaderPointNameLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="10" />
            </Style>

            <Style x:Key="MoneyHeaderPointValueLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="MoneyHeaderPointValueSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="MoneyHeaderPointUnitSpan"
                   TargetType="Span">
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Rank -->
            <Style x:Key="RankBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="320" />
                <!-- Lift with a negative margin instead of TranslationY, which is not applied to Shadow on Android -->
                <Setter Property="Margin" Value="0,-20,0,20" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="Stroke" Value="{StaticResource RedLighten3}" />
                <Setter Property="Shadow">
                    <Shadow Brush="{StaticResource RedLighten1}"
                            Opacity="0.5" Radius="12" />
                </Setter>
            </Style>
            <Style x:Key="RankEffect"
                   TargetType="toolkit:SfEffectsView">
                <Setter Property="TouchDownEffects" Value="Ripple" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="RankBadgeBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="2" />
                <Setter Property="StrokeShape" Value="Ellipse" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Background">
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#F2F2F2" />
                        <GradientStop Offset="0.5" Color="#C4C4CC" />
                        <GradientStop Offset="1.0" Color="#9E9EA6" />
                    </LinearGradientBrush>
                </Setter>
            </Style>

            <Style x:Key="RankBadgeLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="RankValueLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="RankLinkLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <!-- Menu -->
            <Style x:Key="MoneyMenuBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,0,16,16" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="MoneyMenuGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="0,16" />
                <Setter Property="RowSpacing" Value="16" />
            </Style>

            <Style x:Key="MoneyMenuImageButton"
                   TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="64" />
                <Setter Property="HeightRequest" Value="64" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.1" Color="{StaticResource PinkAccent2}" />
                            <GradientStop Offset="1.0" Color="{StaticResource PinkAccent1}" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MoneyMenuLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Detail -->
            <Style x:Key="DetailLayout"
                   TargetType="VerticalStackLayout">
                <Setter Property="Margin" Value="16,0,16,16" />
            </Style>

            <Style x:Key="DetailBorder"
                   TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="DetailSeparatorBoxView"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="0.5" />
                <Setter Property="Color" Value="{StaticResource GrayLighten2}" />
            </Style>

            <Style x:Key="DetailEffectWithLink"
                   TargetType="toolkit:SfEffectsView">
                <Setter Property="TouchDownEffects" Value="Ripple" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="DetailEffectWithoutLink"
                   TargetType="toolkit:SfEffectsView">
                <Setter Property="TouchDownEffects" Value="None" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="DetailGridWithLink"
                   TargetType="Grid">
                <Setter Property="Padding" Value="8,8,0,8" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="DetailGridWithoutLink"
                   TargetType="Grid">
                <Setter Property="Padding" Value="8" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="DetailNameLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="DetailValueLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="DetailNextLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="DetailButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!-- Bottom select -->
            <Style x:Key="BottomSelectSeparatorBoxView"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="0.5" />
                <Setter Property="Color" Value="{StaticResource GrayLighten1}" />
            </Style>

            <Style x:Key="BottomSelectGrid"
                   TargetType="Grid">
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style x:Key="BottomSelectEffect"
                   TargetType="toolkit:SfEffectsView">
                <Setter Property="TouchDownEffects" Value="None" />
            </Style>

            <Style x:Key="BottomSelectImage"
                   TargetType="Image">
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style x:Key="BottomSelectLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Bottom select badge -->
            <Style x:Key="BottomSelectBadgeBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="20" />
                <Setter Property="HeightRequest" Value="20" />
                <Setter Property="TranslationX" Value="20" />
                <Setter Property="TranslationY" Value="4" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="{StaticResource OrangeDefault}" />
                <Setter Property="StrokeShape" Value="Ellipse" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="BottomSelectBadgeLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <!-- お知らせ件数バッジ(「99+」まで収まるピル型) -->
            <Style x:Key="NotificationBadgeBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource BottomSelectBadgeBorder}">
                <Setter Property="WidthRequest" Value="28" />
                <Setter Property="TranslationX" Value="24" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <!-- Center button -->
            <Style x:Key="CenterButtonBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="72" />
                <Setter Property="HeightRequest" Value="72" />
                <Setter Property="TranslationY" Value="-12" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="BackgroundColor" Value="{StaticResource PinkDefault}" />
                <Setter Property="StrokeShape" Value="Ellipse" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

            <Style x:Key="CenterButtonEffect"
                   TargetType="toolkit:SfEffectsView">
                <Setter Property="TouchDownEffects" Value="Ripple" />
            </Style>

            <Style x:Key="CenterButtonLayout"
                   TargetType="VerticalStackLayout">
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="CenterButtonImage"
                   TargetType="Image">
                <Setter Property="WidthRequest" Value="36" />
                <Setter Property="HeightRequest" Value="36" />
            </Style>

            <Style x:Key="CenterButtonLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="White" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid RowDefinitions="*,Auto,Auto">

        <!-- Content -->
        <ScrollView Grid.Row="0">

            <Grid Style="{StaticResource BackgroundGrid}"
                  RowDefinitions="196,40,Auto,*">

                <!-- Header -->
                <Border Grid.Row="0"
                        Style="{StaticResource MoneyHeaderBackgroundBorder}" />

                <Border Grid.Row="0"
                        Style="{StaticResource MoneyHeaderBorder}"
                        behaviors:AnimationOption.EnterAnimation="FadeUp">
                    <Grid Style="{StaticResource MoneyHeaderGrid}"
                          RowDefinitions="*,*"
                          ColumnDefinitions="3*,2*">
                        <Label Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource MoneyHeaderLogoLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource MoneyHeaderLogoIconSpan}"
                                          Text="🐰" />
                                    <Span Style="{StaticResource MoneyHeaderLogoNameSpan}"
                                          Text="うさペイ残高" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource MoneyHeaderInformationButton}"
                                Text="詳細" />
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0"
                                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Label behaviors:LabelOption.CountUpFormat="{}{0:N0}"
                                   behaviors:LabelOption.CountUpValue="{Binding Balance}"
                                   VerticalOptions="Center"
                                   FontSize="36" />
                            <Label VerticalOptions="Center"
                                   Text=" 円"
                                   FontSize="18" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                                             Style="{StaticResource MoneyHeaderPointLayout}">
                            <Label Style="{StaticResource MoneyHeaderPointNameLabel}"
                                   Text="ポイント残高" />
                            <Label Style="{StaticResource MoneyHeaderPointValueLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource MoneyHeaderPointValueSpan}"
                                              Text="1,234" />
                                        <Span Style="{StaticResource MoneyHeaderPointUnitSpan}"
                                              Text=" pt" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Rank -->
                <Border Grid.Row="1"
                        Style="{StaticResource RankBorder}"
                        behaviors:AnimationOption.EnterAnimation="FadeUp" behaviors:AnimationOption.EnterDelay="100">
                    <toolkit:SfEffectsView Style="{StaticResource RankEffect}">
                        <Grid ColumnDefinitions="36,*,36">
                            <Border Grid.Column="0"
                                    Style="{StaticResource RankBadgeBorder}">
                                <Label Style="{StaticResource RankBadgeLabel}"
                                       Text="S" />
                            </Border>
                            <Label Grid.Column="1"
                                   Style="{StaticResource RankValueLabel}"
                                   Text="シルバーランク会員" />
                            <Label Grid.Column="2"
                                   Style="{StaticResource RankLinkLabel}"
                                   Text="➡️" />
                        </Grid>
                    </toolkit:SfEffectsView>
                </Border>

                <!-- Menu -->
                <Border Grid.Row="2"
                        Style="{StaticResource MoneyMenuBorder}"
                        behaviors:AnimationOption.EnterAnimation="FadeUp" behaviors:AnimationOption.EnterDelay="200">
                    <Grid Style="{StaticResource MoneyMenuGrid}"
                          RowDefinitions="*,*"
                          ColumnDefinitions="*,*,*,*">

                        <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                            <ImageButton Style="{StaticResource MoneyMenuImageButton}"
                                         Source="{markup:MoneyIcon {x:Static fonts:MaterialIcons.Stars}}" />
                            <Label Style="{StaticResource MoneyMenuLabel}"
                                   Text="クーポン" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                            <ImageButton Style="{StaticResource MoneyMenuImageButton}"
                                         Source="{markup:MoneyIcon {x:Static fonts:MaterialIcons.View_comfy}}" />
                            <Label Style="{StaticResource MoneyMenuLabel}"
                                   Text="スタンプ" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="2">
                            <ImageButton Style="{StaticResource MoneyMenuImageButton}"
                                         Source="{markup:MoneyIcon {x:Static fonts:MaterialIcons.Paid}}" />
                            <Label Style="{StaticResource MoneyMenuLabel}"
                                   Text="ポイント" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="3">
                            <ImageButton Style="{StaticResource MoneyMenuImageButton}"
                                         Source="{markup:MoneyIcon {x:Static fonts:MaterialIcons.Add_circle}}" />
                            <Label Style="{StaticResource MoneyMenuLabel}"
                                   Text="チャージ" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                            <ImageButton Style="{StaticResource MoneyMenuImageButton}"
                                         Source="{markup:MoneyIcon {x:Static fonts:MaterialIcons.Document_scanner}}" />
                            <Label Style="{StaticResource MoneyMenuLabel}"
                                   Text="スキャン" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <ImageButton Style="{StaticResource MoneyMenuImageButton}"
                                         Source="{markup:MoneyIcon {x:Static fonts:MaterialIcons.Send}}" />
                            <Label Style="{StaticResource MoneyMenuLabel}"
                                   Text="送る" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="2">
                            <ImageButton Style="{StaticResource MoneyMenuImageButton}"
                                         Source="{markup:MoneyIcon {x:Static fonts:MaterialIcons.Receipt_long}}" />
                            <Label Style="{StaticResource MoneyMenuLabel}"
                                   Text="履歴" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="3">
                            <ImageButton Style="{StaticResource MoneyMenuImageButton}"
                                         Source="{markup:MoneyIcon {x:Static fonts:MaterialIcons.Shopping_cart}}" />
                            <Label Style="{StaticResource MoneyMenuLabel}"
                                   Text="カート" />
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!-- Detail -->
                <VerticalStackLayout Grid.Row="3"
                                     Style="{StaticResource DetailLayout}">
                    <Border Style="{StaticResource DetailBorder}">
                        <VerticalStackLayout>
                            <toolkit:SfEffectsView Style="{StaticResource DetailEffectWithLink}">
                                <Grid Style="{StaticResource DetailGridWithLink}"
                                      ColumnDefinitions="*,*,36">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource DetailNameLabel}"
                                           Text="💰 利用可能額" />
                                    <Label Grid.Column="1"
                                           Style="{StaticResource DetailValueLabel}"
                                           Text="21,234 円" />
                                    <Label Grid.Column="2"
                                           Style="{StaticResource DetailNextLabel}"
                                           Text="➡️" />
                                </Grid>
                            </toolkit:SfEffectsView>

                            <BoxView Style="{StaticResource DetailSeparatorBoxView}" />

                            <toolkit:SfEffectsView Style="{StaticResource DetailEffectWithLink}">
                                <Grid Style="{StaticResource DetailGridWithLink}"
                                      ColumnDefinitions="*,*,36">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource DetailNameLabel}"
                                           Text="🪙 うさうさポイント" />
                                    <Label Grid.Column="1"
                                           Style="{StaticResource DetailValueLabel}"
                                           Text="1,234 pt" />
                                    <Label Grid.Column="2"
                                           Style="{StaticResource DetailNextLabel}"
                                           Text="➡️" />
                                </Grid>
                            </toolkit:SfEffectsView>

                            <BoxView Style="{StaticResource DetailSeparatorBoxView}" />

                            <toolkit:SfEffectsView Style="{StaticResource DetailEffectWithoutLink}">
                                <Grid Style="{StaticResource DetailGridWithoutLink}"
                                      ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource DetailNameLabel}"
                                           Text="💳 うさうさカード" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource DetailButton}"
                                            Text="クレジット設定" />
                                </Grid>
                            </toolkit:SfEffectsView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </Grid>

        </ScrollView>

        <!-- Bottom select -->
        <BoxView Grid.Row="1"
                 Style="{StaticResource BottomSelectSeparatorBoxView}" />

        <Grid Grid.Row="2"
              Style="{StaticResource BottomSelectGrid}"
              ColumnDefinitions="*,*,72,*,*">

            <toolkit:SfEffectsView Grid.Column="0"
                                   TouchDownCommand="{Binding PageCommand}"
                                   TouchDownCommandParameter="{x:Static module:MoneyPage.Home}"
                                   TouchDownEffects="None">
                <Grid RowDefinitions="*,Auto">
                    <Image Grid.Row="0"
                           Style="{StaticResource BottomSelectImage}"
                           behaviors:AnimationOption.BounceTrigger="{Binding Selected}"
                           behaviors:AnimationOption.BounceValue="{x:Static module:MoneyPage.Home}">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Home}"
                                             FontFamily="MaterialIcons"
                                             Color="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Home}}"
                                             Size="36" />
                        </Image.Source>
                    </Image>
                    <Label Grid.Row="1"
                           Style="{StaticResource BottomSelectLabel}"
                           Text="ホーム"
                           TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Home}}" />
                </Grid>
            </toolkit:SfEffectsView>

            <toolkit:SfEffectsView Grid.Column="1"
                                   TouchDownCommand="{Binding PageCommand}"
                                   TouchDownCommandParameter="{x:Static module:MoneyPage.Search}"
                                   TouchDownEffects="None">
                <Grid RowDefinitions="*,Auto">
                    <Image Grid.Row="0"
                           Style="{StaticResource BottomSelectImage}"
                           behaviors:AnimationOption.BounceTrigger="{Binding Selected}"
                           behaviors:AnimationOption.BounceValue="{x:Static module:MoneyPage.Search}">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Search}"
                                             FontFamily="MaterialIcons"
                                             Color="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Search}}"
                                             Size="36" />
                        </Image.Source>
                    </Image>
                    <Label Grid.Row="1"
                           Style="{StaticResource BottomSelectLabel}"
                           Text="検索"
                           TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Search}}" />
                </Grid>
            </toolkit:SfEffectsView>

            <toolkit:SfEffectsView Grid.Column="3"
                                   TouchDownCommand="{Binding PageCommand}"
                                   TouchDownCommandParameter="{x:Static module:MoneyPage.Notifications}"
                                   TouchDownEffects="None">
                <Grid RowDefinitions="*,Auto">
                    <Image Grid.Row="0"
                           Style="{StaticResource BottomSelectImage}"
                           behaviors:AnimationOption.BounceTrigger="{Binding Selected}"
                           behaviors:AnimationOption.BounceValue="{x:Static module:MoneyPage.Notifications}">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Notifications_none}"
                                             FontFamily="MaterialIcons"
                                             Color="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Notifications}}"
                                             Size="36" />
                        </Image.Source>
                    </Image>
                    <Label Grid.Row="1"
                           Style="{StaticResource BottomSelectLabel}"
                           Text="お知らせ"
                           TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Notifications}}" />
                    <Border Grid.Row="0" Grid.RowSpan="2"
                            Style="{StaticResource NotificationBadgeBorder}"
                            behaviors:AnimationOption.EnterAnimation="Pop"
                            behaviors:AnimationOption.EnterTrigger="{Binding NotificationCount}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Value="0"
                                         Binding="{Binding NotificationCount}">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Style="{StaticResource BottomSelectBadgeLabel}"
                               Text="{Binding NotificationCount, Converter={StaticResource BadgeCountConverter}}" />
                    </Border>
                </Grid>
            </toolkit:SfEffectsView>

            <toolkit:SfEffectsView Grid.Column="4"
                                   TouchDownCommand="{Binding PageCommand}"
                                   TouchDownCommandParameter="{x:Static module:MoneyPage.Account}"
                                   TouchDownEffects="None">
                <Grid RowDefinitions="*,Auto">
                    <Image Grid.Row="0"
                           Style="{StaticResource BottomSelectImage}"
                           behaviors:AnimationOption.BounceTrigger="{Binding Selected}"
                           behaviors:AnimationOption.BounceValue="{x:Static module:MoneyPage.Account}">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Account_circle}"
                                             FontFamily="MaterialIcons"
                                             Color="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Account}}"
                                             Size="36" />
                        </Image.Source>
                    </Image>
                    <Label Grid.Row="1"
                           Style="{StaticResource BottomSelectLabel}"
                           Text="アカウント"
                           TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Account}}" />
                    <Border Grid.Row="0" Grid.RowSpan="2"
                            Style="{StaticResource BottomSelectBadgeBorder}"
                            IsVisible="{Binding HasAccountAlert}">
                        <Label Style="{StaticResource BottomSelectBadgeLabel}"
                               Text="!" />
                    </Border>
                </Grid>
            </toolkit:SfEffectsView>

        </Grid>

        <!-- Center button -->
        <Border Grid.RowSpan="3"
                Style="{StaticResource CenterButtonBorder}"
                behaviors:AnimationOption.Pulse="True">
            <toolkit:SfEffectsView Style="{StaticResource CenterButtonEffect}">
                <VerticalStackLayout Style="{StaticResource CenterButtonLayout}">
                    <Image Style="{StaticResource CenterButtonImage}"
                           Source="{markup:MoneyIcon {x:Static fonts:MaterialIcons.Qr_code},
                                                     Size=36}" />
                    <Label Style="{StaticResource CenterButtonLabel}"
                           Text="支払い" />
                </VerticalStackLayout>
            </toolkit:SfEffectsView>
        </Border>

    </Grid>

</ContentView>
