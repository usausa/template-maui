                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource ExpenseCaptionSpan}"
                                                  Text="合計 " />
                                            <Span Style="{StaticResource ExpenseValueSpan}"
                                                  Text="{Binding Month.Total, StringFormat='{0:N0} 円'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Style="{StaticResource ExpenseAverageLabel}"
                                       Text="{Binding WeeklyAverage, StringFormat='週の平均 {0:N0} 円'}" />
                            </VerticalStackLayout>
                        </Grid>
                        <drawing:DrawingControl Style="{StaticResource WeeklyChartControl}"
                                                Drawing="{Binding WeeklyChart}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="5"
                        Style="{StaticResource MoneyCardBorder}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource CardHeaderGrid}"
                              ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CategoryListCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardTitleLabel}"
                                   Text="支出の分類" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource CardChevronLabel}"
                                   Text="{x:Static fonts:MaterialIcons.Chevron_right}" />
                        </Grid>
                        <ScrollView Style="{StaticResource CategoryScroll}">
                            <HorizontalStackLayout Style="{StaticResource CategoryStack}"
                                                   BindableLayout.ItemsSource="{Binding Categories}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="sample:MoneyCategoryTotal">
                                        <VerticalStackLayout Style="{StaticResource CategoryItemStack}">
                                            <Border Style="{StaticResource CategoryIconBorder}"
                                                    BackgroundColor="{Binding Category, Converter={StaticResource CategoryColorConverter}}">
                                                <Label Style="{StaticResource CategoryIconLabel}"
                                                       Text="{Binding Category, Converter={StaticResource CategoryIconConverter}}" />
                                            </Border>
                                            <Label Style="{StaticResource CategoryNameLabel}"
                                                   Text="{Binding Category, Converter={StaticResource CategoryNameConverter}}" />
                                            <Label Style="{StaticResource CategoryAmountLabel}"
                                                   Text="{Binding Amount, StringFormat='{0:N0} 円'}" />
                                            <Label Style="{StaticResource CategoryRatioLabel}"
                                                   Text="{Binding Ratio, StringFormat='{0:P0}'}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="6"
                        Style="{StaticResource MoneyCardBorder}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource CardTitleLabel}"
                               Text="最近の取引" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentDays}"
                                             BindableLayout.ItemTemplate="{StaticResource DayTemplate}" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </ScrollView>

        <ContentView Grid.Row="0"
                     behaviors:LazyViewOption.Load="{Binding Selected, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:MoneyPage.Search}}"
                     IsVisible="{Binding Selected, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:MoneyPage.Search}}">
            <behaviors:LazyViewOption.Template>
                <DataTemplate x:DataType="module:UIMoneyViewModel">
                    <Grid Style="{StaticResource BackgroundGrid}"
                          RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                Style="{StaticResource SearchBorder}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0"
                                       Style="{StaticResource SearchIconLabel}"
                                       Text="{x:Static fonts:MaterialIcons.Search}" />
                                <Entry Grid.Column="1"
                                       Style="{StaticResource SearchEntry}"
                                       Text="{Binding SearchText}" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1"
                                Style="{StaticResource SearchResultBorder}">
                            <CollectionView ItemsSource="{Binding SearchResults}"
                                            ItemTemplate="{StaticResource TransactionTemplate}"
                                            IsGrouped="True">
                                <CollectionView.GroupHeaderTemplate>
                                    <DataTemplate x:DataType="sample:MoneyDay">
                                        <Label Style="{StaticResource DayHeaderLabel}"
                                               Text="{Binding Date, Converter={StaticResource RelativeDayConverter}}" />
                                    </DataTemplate>
                                </CollectionView.GroupHeaderTemplate>
                                <CollectionView.EmptyView>
                                    <Label Style="{StaticResource EmptyLabel}"
                                           Text="見つかりませんでした" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Border>
                    </Grid>
                </DataTemplate>
            </behaviors:LazyViewOption.Template>
        </ContentView>

        <ContentView Grid.Row="0"
                     behaviors:LazyViewOption.Load="{Binding Selected, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:MoneyPage.Notifications}}"
                     IsVisible="{Binding Selected, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:MoneyPage.Notifications}}">
            <behaviors:LazyViewOption.Template>
                <DataTemplate x:DataType="module:UIMoneyViewModel">
                    <ScrollView Style="{StaticResource NoticeScroll}">
                        <Border Style="{StaticResource MoneyCardBorder}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Notices}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="sample:MoneyNotice">
                                        <VerticalStackLayout>
                                            <Grid Style="{StaticResource NoticeRowGrid}"
                                                  ColumnDefinitions="Auto,*,Auto">
                                                <Grid.GestureRecognizers>
                                                    <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:UIMoneyViewModel}}, Path=ReadNoticeCommand, x:DataType={x:Type module:UIMoneyViewModel}}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <Border Grid.Column="0"
                                                        Style="{StaticResource NoticeIconBorder}"
                                                        BackgroundColor="{Binding Kind, Converter={StaticResource NoticeColorConverter}}">
                                                    <Label Style="{StaticResource NoticeIconLabel}"
                                                           Text="{Binding Kind, Converter={StaticResource NoticeIconConverter}}" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1"
                                                                     Style="{StaticResource NoticeTextStack}">
                                                    <Label Style="{StaticResource NoticeTitleLabel}"
                                                           Text="{Binding Title}">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding IsUnread}"
                                                                         Value="True">
                                                                <Setter Property="FontAttributes" Value="Bold" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label Style="{StaticResource NoticeBodyLabel}"
                                                           Text="{Binding Body}" />
                                                    <Label Style="{StaticResource NoticeDateLabel}"
                                                           Text="{Binding Date, StringFormat='{0:MM/dd HH:mm}'}" />
                                                </VerticalStackLayout>
                                                <Ellipse Grid.Column="2"
                                                         Style="{StaticResource NoticeUnreadEllipse}"
                                                         IsVisible="{Binding IsUnread}" />
                                            </Grid>
                                            <BoxView Style="{StaticResource RowLine}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </ScrollView>
                </DataTemplate>
            </behaviors:LazyViewOption.Template>
        </ContentView>

        <ScrollView Grid.Row="0"
                    Style="{StaticResource NoticeScroll}"
                    IsVisible="{Binding Selected, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:MoneyPage.Account}}">
            <ContentView behaviors:LazyViewOption.Load="{Binding Selected, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:MoneyPage.Account}}">
                <behaviors:LazyViewOption.Template>
                    <DataTemplate x:DataType="module:UIMoneyViewModel">
                        <VerticalStackLayout>
                            <Border Style="{StaticResource MoneyCardBorder}">
                                <Grid Style="{StaticResource AccountProfileGrid}"
                                      ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0"
                                            Style="{StaticResource AccountAvatarBorder}">
                                        <Image Source="avatar_user.jpg"
                                               Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Style="{StaticResource AccountTextStack}">
                                        <Label Style="{StaticResource AccountNameLabel}"
                                               Text="うさうさ" />
                                        <Label Style="{StaticResource AccountRankLabel}"
                                               Text="シルバーランク会員" />
                                        <Label Style="{StaticResource AccountIdLabel}"
                                               Text="ID 2412-0817-3301" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MoneyCardBorder}">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Style="{StaticResource CardTitleLabel}"
                                               Text="ランク" />
                                        <Label Grid.Column="1"
                                               Style="{StaticResource RankNextLabel}"
                                               Text="次はゴールド" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource RankProgressBar}"
                                                 Progress="0.62" />
                                    <Label Style="{StaticResource RankNoteLabel}"
                                           Text="ゴールドまで、あと 38,000 円のお支払い" />
                                    <Grid Style="{StaticResource AccountStatGrid}"
                                          ColumnDefinitions="*,*">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Style="{StaticResource AccountStatCaptionLabel}"
                                                   Text="今月のお支払い" />
                                            <Label Style="{StaticResource AccountStatValueLabel}"
                                                   Text="{Binding CurrentMonth.Total, StringFormat='{0:N0} 円'}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Style="{StaticResource AccountStatCaptionLabel}"
                                                   Text="ポイント残高" />
                                            <Label Style="{StaticResource AccountStatValueLabel}"
                                                   Text="1,234 pt" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                            <VerticalStackLayout Style="{StaticResource DetailLayout}">
                                <Border Style="{StaticResource DetailBorder}">
                                    <VerticalStackLayout>
                                        <Grid Style="{StaticResource DetailGridWithLink}"
                                              ColumnDefinitions="*,*,36"
                                              behaviors:TouchOption.Ripple="True">
                                            <Label Grid.Column="0"
                                                   Style="{StaticResource DetailNameLabel}"
                                                   Text="🪪 本人確認" />
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource AlertBadgeBorder}"
                                                    IsVisible="{Binding HasAccountAlert}">
                                                <Label Style="{StaticResource AlertBadgeLabel}"
                                                       Text="未完了" />
                                            </Border>
                                            <Label Grid.Column="2"
                                                   Style="{StaticResource DetailNextLabel}"
                                                   Text="➡️" />
                                        </Grid>

                                        <BoxView Style="{StaticResource DetailSeparatorBoxView}" />

                                        <Grid Style="{StaticResource DetailGridWithLink}"
                                              ColumnDefinitions="*,*,36"
                                              behaviors:TouchOption.Ripple="True">
                                            <Label Grid.Column="0"
                                                   Style="{StaticResource DetailNameLabel}"
                                                   Text="💳 支払い方法" />
                                            <Label Grid.Column="1"
                                                   Style="{StaticResource DetailValueLabel}"
                                                   Text="うさうさカード" />
                                            <Label Grid.Column="2"
                                                   Style="{StaticResource DetailNextLabel}"
                                                   Text="➡️" />
                                        </Grid>

                                        <BoxView Style="{StaticResource DetailSeparatorBoxView}" />

                                        <Grid Style="{StaticResource DetailGridWithLink}"
                                              ColumnDefinitions="*,*,36"
                                              behaviors:TouchOption.Ripple="True">
                                            <Label Grid.Column="0"
                                                   Style="{StaticResource DetailNameLabel}"
                                                   Text="🧾 利用明細" />
                                            <Label Grid.Column="2"
                                                   Style="{StaticResource DetailNextLabel}"
                                                   Text="➡️" />
                                        </Grid>

                                        <BoxView Style="{StaticResource DetailSeparatorBoxView}" />

                                        <Grid Style="{StaticResource DetailGridWithLink}"
                                              ColumnDefinitions="*,*,36"
                                              behaviors:TouchOption.Ripple="True">
                                            <Label Grid.Column="0"
                                                   Style="{StaticResource DetailNameLabel}"
                                                   Text="🔔 通知の設定" />
                                            <Label Grid.Column="2"
                                                   Style="{StaticResource DetailNextLabel}"
                                                   Text="➡️" />
                                        </Grid>

                                        <BoxView Style="{StaticResource DetailSeparatorBoxView}" />

                                        <Grid Style="{StaticResource DetailGridWithLink}"
                                              ColumnDefinitions="*,*,36"
                                              behaviors:TouchOption.Ripple="True">
                                            <Label Grid.Column="0"
                                                   Style="{StaticResource DetailNameLabel}"
                                                   Text="❓ ヘルプ" />
                                            <Label Grid.Column="2"
                                                   Style="{StaticResource DetailNextLabel}"
                                                   Text="➡️" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </behaviors:LazyViewOption.Template>
            </ContentView>
        </ScrollView>

        <!-- Bottom select -->
        <BoxView Grid.Row="1"
                 Style="{StaticResource BottomSelectSeparatorBoxView}" />

        <Grid Grid.Row="2"
              Style="{StaticResource BottomSelectGrid}"
              ColumnDefinitions="*,*,72,*,*">

            <Grid Grid.Column="0"
                  RowDefinitions="*,Auto"
                  behaviors:TouchOption.ClickCommand="{Binding PageCommand}"
                  behaviors:TouchOption.ClickCommandParameter="{x:Static module:MoneyPage.Home}">
                <Image Grid.Row="0"
                       Style="{StaticResource BottomSelectImage}"
                       behaviors:AnimationOption.BounceTrigger="{Binding Selected}"
                       behaviors:AnimationOption.BounceValue="{x:Static module:MoneyPage.Home}">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Home}"
                                         Size="36"
                                         FontFamily="MaterialIcons"
                                         Color="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Home}}" />
                    </Image.Source>
                </Image>
                <Label Grid.Row="1"
                       Style="{StaticResource BottomSelectLabel}"
                       Text="ホーム"
                       TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Home}}" />
            </Grid>

            <Grid Grid.Column="1"
                  RowDefinitions="*,Auto"
                  behaviors:TouchOption.ClickCommand="{Binding PageCommand}"
                  behaviors:TouchOption.ClickCommandParameter="{x:Static module:MoneyPage.Search}">
                <Image Grid.Row="0"
                       Style="{StaticResource BottomSelectImage}"
                       behaviors:AnimationOption.BounceTrigger="{Binding Selected}"
                       behaviors:AnimationOption.BounceValue="{x:Static module:MoneyPage.Search}">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Search}"
                                         Size="36"
                                         FontFamily="MaterialIcons"
                                         Color="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Search}}" />
                    </Image.Source>
                </Image>
                <Label Grid.Row="1"
                       Style="{StaticResource BottomSelectLabel}"
                       Text="検索"
                       TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Search}}" />
            </Grid>

            <Grid Grid.Column="3"
                  RowDefinitions="*,Auto"
                  behaviors:TouchOption.ClickCommand="{Binding PageCommand}"
                  behaviors:TouchOption.ClickCommandParameter="{x:Static module:MoneyPage.Notifications}">
                <Image Grid.Row="0"
                       Style="{StaticResource BottomSelectImage}"
                       behaviors:AnimationOption.BounceTrigger="{Binding Selected}"
                       behaviors:AnimationOption.BounceValue="{x:Static module:MoneyPage.Notifications}">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Notifications_none}"
                                         Size="36"
                                         FontFamily="MaterialIcons"
                                         Color="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Notifications}}" />
                    </Image.Source>
                </Image>
                <Label Grid.Row="1"
                       Style="{StaticResource BottomSelectLabel}"
                       Text="お知らせ"
                       TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Notifications}}" />
                <Border Grid.Row="0" Grid.RowSpan="2"
                        Style="{StaticResource NotificationBadgeBorder}"
                        behaviors:AnimationOption.EnterAnimation="Pop"
                        behaviors:AnimationOption.EnterTrigger="{Binding NotificationCount}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding NotificationCount}"
                                     Value="0">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource BottomSelectBadgeLabel}"
                           Text="{Binding NotificationCount, Converter={StaticResource BadgeCountConverter}}" />
                </Border>
            </Grid>

            <Grid Grid.Column="4"
                  RowDefinitions="*,Auto"
                  behaviors:TouchOption.ClickCommand="{Binding PageCommand}"
                  behaviors:TouchOption.ClickCommandParameter="{x:Static module:MoneyPage.Account}">
                <Image Grid.Row="0"
                       Style="{StaticResource BottomSelectImage}"
                       behaviors:AnimationOption.BounceTrigger="{Binding Selected}"
                       behaviors:AnimationOption.BounceValue="{x:Static module:MoneyPage.Account}">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static fonts:MaterialIcons.Account_circle}"
                                         Size="36"
                                         FontFamily="MaterialIcons"
                                         Color="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Account}}" />
                    </Image.Source>
                </Image>
                <Label Grid.Row="1"
                       Style="{StaticResource BottomSelectLabel}"
                       Text="アカウント"
                       TextColor="{Binding Selected, Converter={StaticResource EqualToSelectColorConverter}, ConverterParameter={x:Static module:MoneyPage.Account}}" />
                <Border Grid.Row="0" Grid.RowSpan="2"
                        Style="{StaticResource BottomSelectBadgeBorder}"
                        IsVisible="{Binding HasAccountAlert}">
                    <Label Style="{StaticResource BottomSelectBadgeLabel}"
                           Text="!" />
                </Border>
            </Grid>

        </Grid>

        <!-- Center button -->
        <Button Grid.RowSpan="3"
                Style="{StaticResource CenterButton}"
                Command="{Binding PayCommand}"
                Text="支払い"
                ImageSource="{x:Static markup:AppIcons.LargeQrCode}" />

        <cmc:BottomSheetView Grid.Row="0" Grid.RowSpan="3"
                             Style="{StaticResource PaymentSheet}"
                             IsOpen="{Binding IsPaymentOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="module:UIMoneyViewModel">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitleLabel}"
                               Text="支払い" />
                        <Border Style="{StaticResource PaymentCodeBorder}">
                            <VerticalStackLayout Style="{StaticResource PaymentCodeStack}">
                                <controls:BarcodeView Style="{StaticResource PaymentBarcode}"
                                                      Value="{Binding PaymentCode}" />
                                <Label Style="{StaticResource PaymentCodeLabel}"
                                       Text="{Binding PaymentCode}" />
                                <Image Style="{StaticResource PaymentQrImage}"
                                       Source="{Binding PaymentCode, Converter={StaticResource QrImageSourceConverter}}" />
                            </VerticalStackLayout>
                        </Border>
                        <ProgressBar Style="{StaticResource PaymentProgressBar}"
                                     Progress="{Binding PaymentProgress}" />
                        <Label Style="{StaticResource PaymentRemainLabel}"
                               Text="{Binding PaymentRemain, StringFormat='あと {0} 秒でコードを更新'}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource PaymentBalanceLabel}"
                                   Text="🐰 うさペイ残高" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource PaymentBalanceValueLabel}"
                                   Text="{Binding Balance, StringFormat='{0:N0} 円'}" />
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>

        <cmc:BottomSheetView Grid.Row="0" Grid.RowSpan="3"
                             Style="{StaticResource MoneySheet}"
                             IsOpen="{Binding IsBalanceOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="module:UIMoneyViewModel">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitleLabel}"
                               Text="残高の推移" />
                        <Label Style="{StaticResource SheetCaptionLabel}"
                               Text="最近 30 日" />
                        <drawing:DrawingControl Style="{StaticResource BalanceChartControl}"
                                                Drawing="{Binding BalanceChart}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>

        <cmc:BottomSheetView Grid.Row="0" Grid.RowSpan="3"
                             Style="{StaticResource MoneySheet}"
                             IsOpen="{Binding IsMonthOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="module:UIMoneyViewModel">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitleLabel}"
                               Text="月を選ぶ" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Months}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Selectable(sample:MoneyMonth)">
                                    <VerticalStackLayout>
                                        <Grid Style="{StaticResource MonthRowGrid}"
                                              ColumnDefinitions="Auto,*,Auto">
                                            <Grid.GestureRecognizers>
                                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:UIMoneyViewModel}}, Path=SelectMonthCommand, x:DataType={x:Type module:UIMoneyViewModel}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label Grid.Column="0"
                                                   Style="{StaticResource MonthCheckLabel}"
                                                   IsVisible="{Binding IsSelected}"
                                                   Text="{x:Static fonts:MaterialIcons.Check}" />
                                            <Label Grid.Column="1"
                                                   Style="{StaticResource MonthNameLabel}"
                                                   Text="{Binding Item.Month, StringFormat='{0:yyyy年M月}'}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Grid.Column="2"
                                                   Style="{StaticResource MonthTotalLabel}"
                                                   Text="{Binding Item.Total, StringFormat='{0:N0} 円'}" />
                                        </Grid>
                                        <BoxView Style="{StaticResource RowLine}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>

        <cmc:BottomSheetView Grid.Row="0" Grid.RowSpan="3"
                             Style="{StaticResource MoneySheet}"
                             IsOpen="{Binding IsCategoryOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="module:UIMoneyViewModel">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitleLabel}"
                               Text="{Binding Month.Month, StringFormat='{0:M月}の支出の分類'}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="sample:MoneyCategoryTotal">
                                    <Grid Style="{StaticResource CategoryRowGrid}"
                                          RowDefinitions="Auto,Auto"
                                          ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                Style="{StaticResource CategoryRowIconBorder}"
                                                BackgroundColor="{Binding Category, Converter={StaticResource CategoryColorConverter}}">
                                            <Label Style="{StaticResource CategoryIconLabel}"
                                                   Text="{Binding Category, Converter={StaticResource CategoryIconConverter}}" />
                                        </Border>
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Style="{StaticResource CategoryRowNameLabel}"
                                               Text="{Binding Category, Converter={StaticResource CategoryNameConverter}}" />
                                        <Label Grid.Row="0" Grid.Column="2"
                                               Style="{StaticResource CategoryRowAmountLabel}"
                                               Text="{Binding Amount, StringFormat='{0:N0} 円'}" />
                                        <ProgressBar Grid.Row="1" Grid.Column="1"
                                                     Style="{StaticResource CategoryRowProgressBar}"
                                                     Progress="{Binding Ratio}"
                                                     ProgressColor="{Binding Category, Converter={StaticResource CategoryColorConverter}}" />
                                        <Label Grid.Row="1" Grid.Column="2"
                                               Style="{StaticResource CategoryRowRatioLabel}"
                                               Text="{Binding Ratio, StringFormat='{0:P0}'}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>

    </Grid>

</ContentView>
