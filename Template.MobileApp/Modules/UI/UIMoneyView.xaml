                                <Label Style="{StaticResource CardTitleLabel}"
                                       Text="月の支出" />
                                <HorizontalStackLayout Style="{StaticResource MonthSelectStack}">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding MonthListCommand}" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <Label Style="{StaticResource MonthSelectLabel}"
                                           Text="{Binding Month.Month, StringFormat='{0:yyyy年M月}'}" />
