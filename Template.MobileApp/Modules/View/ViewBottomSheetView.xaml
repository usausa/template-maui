<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:sf="http://schemas.syncfusion.com/maui/toolkit"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewBottomSheetView"
             x:DataType="{x:Type module:ViewBottomSheetViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewBottomSheetViewModel}"
             shell:ShellProperty.Title="Bottom Sheet"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Sf"
             shell:ShellProperty.Function3Text="Custom"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Bottom sheet -->

            <Style x:Key="SfSheet"
                   TargetType="sf:SfBottomSheet">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HalfExpandedRatio" Value="0.45" />
            </Style>

            <Style x:Key="SheetStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="16,4,16,16" />
                <Setter Property="Spacing" Value="4" />
            </Style>

            <Style x:Key="SheetTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="SheetItemGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="4,10" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="SheetItemIcon"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken1}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="SheetItemLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="SheetSeparator"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource GrayLighten3}" />
            </Style>

            <Style x:Key="SheetCloseButton"
                   TargetType="Button"
                   BasedOn="{StaticResource BasicFilledSecondaryButton}">
                <Setter Property="Margin" Value="0,12,0,0" />
            </Style>

            <!-- Result -->

            <Style x:Key="ResultRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="ResultIconBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            </Style>

            <Style x:Key="ResultIconLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="ResultNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Custom action sheet -->

            <Style x:Key="CustomSheet"
                   TargetType="cmc:BottomSheetView">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HalfExpandedRatio" Value="0.45" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <Grid>

        <!-- Sf bottom sheet -->
        <sf:SfBottomSheet Style="{StaticResource SfSheet}"
                          IsOpen="{Binding IsSfSheetOpen}"
                          IsModal="True">

            <!-- Sf action sheet -->
            <sf:SfBottomSheet.BottomSheetContent>
                <ContentView behaviors:LazyViewOption.Load="{Binding IsSfSheetOpen}">
                    <behaviors:LazyViewOption.Template>
                        <DataTemplate x:DataType="module:ViewBottomSheetViewModel">
                            <VerticalStackLayout Style="{StaticResource SheetStack}">
                                <Label Style="{StaticResource SheetTitleLabel}"
                                       Text="SfBottomSheet" />
                                <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Actions}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="module:BottomSheetAction">
                                            <VerticalStackLayout>
                                                <Grid Style="{StaticResource SheetItemGrid}"
                                                      ColumnDefinitions="Auto,*">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:ViewBottomSheetViewModel}}, Path=SelectCommand, x:DataType={x:Type module:ViewBottomSheetViewModel}}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Grid.GestureRecognizers>
                                                    <Label Grid.Column="0"
                                                           Style="{StaticResource SheetItemIcon}"
                                                           Text="{Binding Icon}"
                                                           TextColor="{Binding Color}" />
                                                    <Label Grid.Column="1"
                                                           Style="{StaticResource SheetItemLabel}"
                                                           Text="{Binding Text}" />
                                                </Grid>
                                                <BoxView Style="{StaticResource SheetSeparator}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                <Button Style="{StaticResource SheetCloseButton}"
                                        Command="{Binding CloseCommand}"
                                        Text="Close" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </behaviors:LazyViewOption.Template>
                </ContentView>
            </sf:SfBottomSheet.BottomSheetContent>

            <!-- Content -->
            <ScrollView Style="{StaticResource RootScroll}">
                <VerticalStackLayout Style="{StaticResource PageStack}">

                    <!-- SfBottomSheet -->
                    <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                                       Title="SfBottomSheet"
                                       Icon="{x:Static fonts:MaterialIcons.Vertical_align_top}">
                        <VerticalStackLayout Style="{StaticResource CardContentStack}">
                            <Button Style="{StaticResource BasicFilledButton}"
                                    Command="{Binding OpenSfSheetCommand}"
                                    Text="Open Sf sheet (F2)" />
                        </VerticalStackLayout>
                    </controls:InfoCard>

                    <!-- BottomSheetView -->
                    <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                                       behaviors:AnimationOption.EnterDelay="100"
                                       Title="BottomSheetView"
                                       Icon="{x:Static fonts:MaterialIcons.Vertical_align_bottom}">
                        <VerticalStackLayout Style="{StaticResource CardContentStack}">
                            <Button Style="{StaticResource BasicFilledButton}"
                                    Command="{Binding OpenCustomSheetCommand}"
                                    Text="Open BottomSheetView (F3)" />
                        </VerticalStackLayout>
                    </controls:InfoCard>

                    <!-- Result -->
                    <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                                       behaviors:AnimationOption.EnterDelay="200"
                                       Title="Result"
                                       Icon="{x:Static fonts:MaterialIcons.Check_circle}">
                        <Grid>
                            <Label Style="{StaticResource CardAccentLabel}"
                                   IsVisible="{Binding Selected, Converter={StaticResource EmptyConverter}}"
                                   Text="Not opened yet" />
                            <Grid Style="{StaticResource ResultRowGrid}"
                                  ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding Selected, Converter={StaticResource NotEmptyConverter}}">
                                <Border Grid.Column="0"
                                        Style="{StaticResource ResultIconBorder}"
                                        BackgroundColor="{Binding Selected.BackgroundColor}">
                                    <Label Style="{StaticResource ResultIconLabel}"
                                           Text="{Binding Selected.Icon}"
                                           TextColor="{Binding Selected.Color}" />
                                </Border>
                                <Label Grid.Column="1"
                                       Style="{StaticResource ResultNameLabel}"
                                       Text="{Binding Selected.Text}" />
                            </Grid>
                        </Grid>
                    </controls:InfoCard>

                </VerticalStackLayout>
            </ScrollView>

        </sf:SfBottomSheet>

        <!-- Custom action sheet -->
        <cmc:BottomSheetView Style="{StaticResource CustomSheet}"
                             IsOpen="{Binding IsCustomSheetOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="module:ViewBottomSheetViewModel">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitleLabel}"
                               Text="BottomSheetView" />
                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Actions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="module:BottomSheetAction">
                                    <VerticalStackLayout>
                                        <Grid Style="{StaticResource SheetItemGrid}"
                                              ColumnDefinitions="Auto,*">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:ViewBottomSheetViewModel}}, Path=SelectCommand, x:DataType={x:Type module:ViewBottomSheetViewModel}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label Grid.Column="0"
                                                   Style="{StaticResource SheetItemIcon}"
                                                   Text="{Binding Icon}"
                                                   TextColor="{Binding Color}" />
                                            <Label Grid.Column="1"
                                                   Style="{StaticResource SheetItemLabel}"
                                                   Text="{Binding Text}" />
                                        </Grid>
                                        <BoxView Style="{StaticResource SheetSeparator}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                        <Button Style="{StaticResource SheetCloseButton}"
                                Command="{Binding CloseCommand}"
                                Text="Close" />
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>

    </Grid>

</ContentView>
