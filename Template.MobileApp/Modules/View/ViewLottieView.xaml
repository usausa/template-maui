<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:extended="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewLottieView"
             x:DataType="{x:Type module:ViewLottieViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewLottieViewModel}"
             shell:ShellProperty.Title="Lottie"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function3Text="Reset"
             shell:ShellProperty.Function4Text="{Binding IsAnimationEnabled, Converter={s:BoolToText True='Pause', False='Play'}}"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="FrameBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="12" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="{StaticResource BlueLighten5}" />
                            <GradientStop Offset="1" Color="{StaticResource PurpleLighten5}" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Stroke" Value="{StaticResource GrayLighten1}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            </Style>

            <Style x:Key="PlayerPanelBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16,16,0,0" />
            </Style>

            <Style x:Key="PlayerStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="TimeRowGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="15,0" />
            </Style>

            <Style x:Key="TransportRow"
                   TargetType="HorizontalStackLayout">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Spacing" Value="24" />
            </Style>

            <Style x:Key="TransportButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken2}" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

            <Style x:Key="MainTransportButton"
                   TargetType="Button"
                   BasedOn="{StaticResource TransportButton}">
                <Setter Property="WidthRequest" Value="64" />
                <Setter Property="HeightRequest" Value="64" />
                <Setter Property="CornerRadius" Value="32" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="ScrubStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="6" />
            </Style>

            <Style x:Key="ScrubTrackBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="900" />
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="{StaticResource BlueDefault}" />
                            <GradientStop Offset="1" Color="{StaticResource PinkDefault}" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ScrubTrackLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="16,0" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="HoldButton"
                   TargetType="Button">
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken2}" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid Style="{StaticResource RootGrid}"
          RowDefinitions="*,Auto">

        <Border Grid.Row="0"
                Style="{StaticResource FrameBorder}">
            <extended:SKLottieView Source="Lottie/popping.json"
                                   Progress="{Binding Progress}"
                                   Duration="{Binding Duration}"
                                   IsAnimationEnabled="{Binding IsAnimationEnabled}"
                                   RepeatCount="-1" />
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PlayerPanelBorder}">
            <VerticalStackLayout Style="{StaticResource PlayerStack}">

                <VerticalStackLayout Style="{StaticResource BasicTextGroupStack}">
                    <Slider behaviors:SliderOption.DragCompletedCommand="{Binding SeekCommand}"
                            Value="{Binding ProgressSeconds, Mode=OneWay}"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}" />
                    <Grid Style="{StaticResource TimeRowGrid}"
                          ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource BasicMonoLabel}"
                               Text="{Binding Progress, StringFormat='{0:mm\\:ss\\.f}'}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource BasicMonoLabel}"
                               Text="{Binding Duration, StringFormat='{0:mm\\:ss\\.f}'}" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Style="{StaticResource ScrubStack}">
                    <ScrollView behaviors:Scroll.RatioCommand="{Binding ScrubCommand}"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <Border Style="{StaticResource ScrubTrackBorder}">
                            <Label Style="{StaticResource ScrubTrackLabel}"
                                   Text="→ → → Scroll to play → → →" />
                        </Border>
                    </ScrollView>
                    <Button Style="{StaticResource HoldButton}"
                            behaviors:AnimationOption.HoldCommand="{Binding ScrubCommand}"
                            behaviors:AnimationOption.HoldDuration="2000"
                            Text="Long press (2s)" />
                </VerticalStackLayout>

                <HorizontalStackLayout Style="{StaticResource TransportRow}">
                    <Button Style="{StaticResource TransportButton}"
                            Command="{Binding ResetCommand}"
                            Text="{x:Static fonts:MaterialIcons.Replay}" />
                    <Button Style="{StaticResource MainTransportButton}"
                            behaviors:ButtonOption.HapticFeedback="True"
                            Command="{Binding PlayPauseCommand}"
                            Text="{x:Static fonts:MaterialIcons.Play_arrow}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsAnimationEnabled}"
                                         Value="True">
                                <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Pause}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentView>
