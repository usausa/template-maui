<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:drawing="clr-namespace:Template.MobileApp.Graphics.Drawing"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewChartView"
             x:DataType="{x:Type module:ViewChartViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewChartViewModel}"
             shell:ShellProperty.Title="Chart"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="SegmentButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="BorderColor" Value="{StaticResource BlueLighten3}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="ContentLayout" Value="Left,4" />
            </Style>

            <Style x:Key="SegmentGrid"
                   TargetType="Grid">
                <Setter Property="Margin" Value="16,12" />
                <Setter Property="RowSpacing" Value="8" />
                <Setter Property="ColumnSpacing" Value="8" />
            </Style>

            <Style x:Key="ChartFrameBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="16,0,16,16" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten1}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <Grid Style="{StaticResource RootGrid}"
          RowDefinitions="Auto,*">

        <!-- 切替セグメント -->
        <Grid Grid.Row="0"
              Style="{StaticResource SegmentGrid}"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,*,*,*,*,*,*,*">
            <Button Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource SegmentButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static drawing:ChartKind.Line}"
                    Text="Line"
                    ImageSource="{x:Static markup:AppIcons.ChartLine}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static drawing:ChartKind.Line}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                        <Setter Property="ImageSource" Value="{x:Static markup:AppIcons.ChartLineWhite}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2" Grid.ColumnSpan="2"
                    Style="{StaticResource SegmentButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static drawing:ChartKind.Bar}"
                    Text="Bar"
                    ImageSource="{x:Static markup:AppIcons.ChartBar}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static drawing:ChartKind.Bar}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                        <Setter Property="ImageSource" Value="{x:Static markup:AppIcons.ChartBarWhite}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="4" Grid.ColumnSpan="2"
                    Style="{StaticResource SegmentButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static drawing:ChartKind.Donut}"
                    Text="Donut"
                    ImageSource="{x:Static markup:AppIcons.ChartDonut}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static drawing:ChartKind.Donut}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                        <Setter Property="ImageSource" Value="{x:Static markup:AppIcons.ChartDonutWhite}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="6" Grid.ColumnSpan="2"
                    Style="{StaticResource SegmentButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static drawing:ChartKind.Candle}"
                    Text="Candle"
                    ImageSource="{x:Static markup:AppIcons.ChartCandle}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static drawing:ChartKind.Candle}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                        <Setter Property="ImageSource" Value="{x:Static markup:AppIcons.ChartCandleWhite}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                    Style="{StaticResource SegmentButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static drawing:ChartKind.Stacked}"
                    Text="Stacked"
                    ImageSource="{x:Static markup:AppIcons.ChartStacked}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static drawing:ChartKind.Stacked}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                        <Setter Property="ImageSource" Value="{x:Static markup:AppIcons.ChartStackedWhite}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                    Style="{StaticResource SegmentButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static drawing:ChartKind.Scatter}"
                    Text="Scatter"
                    ImageSource="{x:Static markup:AppIcons.ChartScatter}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static drawing:ChartKind.Scatter}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                        <Setter Property="ImageSource" Value="{x:Static markup:AppIcons.ChartScatterWhite}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2"
                    Style="{StaticResource SegmentButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static drawing:ChartKind.Heat}"
                    Text="Heat"
                    ImageSource="{x:Static markup:AppIcons.ChartHeat}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static drawing:ChartKind.Heat}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                        <Setter Property="ImageSource" Value="{x:Static markup:AppIcons.ChartHeatWhite}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- チャート -->
        <Border Grid.Row="1"
                Style="{StaticResource ChartFrameBorder}">
            <drawing:DrawingControl Drawing="{Binding Drawing}" />
        </Border>

    </Grid>

</ContentView>
