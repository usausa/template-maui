<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewChartView"
             x:DataType="{x:Type module:ViewChartViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewChartViewModel}"
             shell:ShellProperty.Title="Clam Chart"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Tab -->

            <Style x:Key="TabGrid"
                   TargetType="Grid">
                <Setter Property="Margin" Value="12,8" />
                <Setter Property="RowSpacing" Value="6" />
                <Setter Property="ColumnSpacing" Value="6" />
            </Style>

            <Style x:Key="TabButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="BorderColor" Value="{StaticResource BlueLighten3}" />
                <Setter Property="BorderWidth" Value="1" />
            </Style>

            <!-- Panel -->

            <Style x:Key="PanelBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="12,0,12,12" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten1}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="PanelGrid"
                   TargetType="Grid">
                <Setter Property="RowSpacing" Value="4" />
            </Style>

            <Style x:Key="PanelTitleLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken2}" />
            </Style>

            <Style x:Key="PanelNoteLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <!-- Chart -->

            <Style x:Key="SampleChartBase"
                   TargetType="clam:ClamChartView">
                <Setter Property="ContentPadding" Value="0" />
                <Setter Property="Palette" Value="{StaticResource ChartPalette}" />
                <Setter Property="TrackballMode" Value="Touch" />
            </Style>

            <Style x:Key="SampleChart"
                   TargetType="clam:ClamChartView"
                   BasedOn="{StaticResource SampleChartBase}">
                <Setter Property="ValueAccessors" Value="{x:Static sample:MonthlySales.Accessors}" />
                <Setter Property="XKey" Value="month" />
            </Style>

            <Style x:Key="SampleClimateChart"
                   TargetType="clam:ClamChartView"
                   BasedOn="{StaticResource SampleChartBase}">
                <Setter Property="ValueAccessors" Value="{x:Static sample:ClimateRecord.Accessors}" />
                <Setter Property="XKey" Value="time" />
                <Setter Property="LegendMode" Value="Table" />
                <Setter Property="LegendPosition" Value="Bottom" />
                <Setter Property="LegendValues" Value="Last,Min,Max" />
            </Style>

            <Style x:Key="SamplePieChart"
                   TargetType="clam:ClamPieChartView">
                <Setter Property="ContentPadding" Value="0" />
                <Setter Property="Palette" Value="{StaticResource ChartPalette}" />
                <Setter Property="LabelsMode" Value="Outside" />
            </Style>

            <Style x:Key="SampleHeatmap"
                   TargetType="clam:ClamHeatmapView">
                <Setter Property="ContentPadding" Value="0" />
                <Setter Property="SelectionMode" Value="Item" />
                <Setter Property="TrackballMode" Value="Touch" />
            </Style>

            <Style x:Key="StatView"
                   TargetType="clam:ClamStatView">
                <Setter Property="HeightRequest" Value="84" />
                <Setter Property="ColorMode" Value="Value" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <Grid Style="{StaticResource RootGrid}"
          RowDefinitions="Auto,*">

        <!-- Tab -->
        <Grid Grid.Row="0"
              Style="{StaticResource TabGrid}"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,*,*,*">
            <Button Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource TabButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static module:ViewChartKind.Line}"
                    Text="Line">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static module:ViewChartKind.Line}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource TabButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static module:ViewChartKind.Area}"
                    Text="Area">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static module:ViewChartKind.Area}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource TabButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static module:ViewChartKind.Bar}"
                    Text="Bar">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static module:ViewChartKind.Bar}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Row="0" Grid.Column="3"
                    Style="{StaticResource TabButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static module:ViewChartKind.Stacked}"
                    Text="Stack">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static module:ViewChartKind.Stacked}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource TabButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static module:ViewChartKind.Scatter}"
                    Text="Scatter">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static module:ViewChartKind.Scatter}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource TabButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static module:ViewChartKind.Pie}"
                    Text="Pie">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static module:ViewChartKind.Pie}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource TabButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static module:ViewChartKind.Heatmap}"
                    Text="Heat">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static module:ViewChartKind.Heatmap}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Row="1" Grid.Column="3"
                    Style="{StaticResource TabButton}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{x:Static module:ViewChartKind.Climate}"
                    Text="Climate">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Kind}"
                                 Value="{x:Static module:ViewChartKind.Climate}">
                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Chart -->
        <Grid Grid.Row="1">

            <Border Style="{StaticResource PanelBorder}"
                    IsVisible="{Binding Kind, Converter={s:CompareToBool}, ConverterParameter={x:Static module:ViewChartKind.Line}}">
                <clam:ClamChartView Style="{StaticResource SampleChart}">
                    <clam:LineSeries ItemsSource="{Binding Sales}"
                                     YKey="productA"
                                     Title="製品 A" />
                    <clam:LineSeries ItemsSource="{Binding Sales}"
                                     YKey="productB"
                                     Title="製品 B" />
                    <clam:LineSeries ItemsSource="{Binding Sales}"
                                     YKey="productC"
                                     Title="製品 C" />
                </clam:ClamChartView>
            </Border>

            <Border Style="{StaticResource PanelBorder}"
                    IsVisible="{Binding Kind, Converter={s:CompareToBool}, ConverterParameter={x:Static module:ViewChartKind.Area}}">
                <clam:ClamChartView Style="{StaticResource SampleChart}">
                    <clam:AreaSeries ItemsSource="{Binding Sales}"
                                     YKey="productA"
                                     Title="製品 A"
                                     FillOpacity="0.25" />
                    <clam:AreaSeries ItemsSource="{Binding Sales}"
                                     YKey="productB"
                                     Title="製品 B"
                                     FillOpacity="0.25" />
                </clam:ClamChartView>
            </Border>

            <Border Style="{StaticResource PanelBorder}"
                    IsVisible="{Binding Kind, Converter={s:CompareToBool}, ConverterParameter={x:Static module:ViewChartKind.Bar}}">
                <clam:ClamChartView Style="{StaticResource SampleChart}">
                    <clam:BarSeries ItemsSource="{Binding Sales}"
                                    YKey="productA"
                                    Title="製品 A"
                                    CornerRadius="3" />
                    <clam:BarSeries ItemsSource="{Binding Sales}"
                                    YKey="productB"
                                    Title="製品 B"
                                    CornerRadius="3" />
                </clam:ClamChartView>
            </Border>

            <Border Style="{StaticResource PanelBorder}"
                    IsVisible="{Binding Kind, Converter={s:CompareToBool}, ConverterParameter={x:Static module:ViewChartKind.Stacked}}">
                <clam:ClamChartView Style="{StaticResource SampleChart}">
                    <clam:BarSeries ItemsSource="{Binding Sales}"
                                    YKey="productA" StackGroup="sales"
                                    Title="製品 A" />
                    <clam:BarSeries ItemsSource="{Binding Sales}"
                                    YKey="productB" StackGroup="sales"
                                    Title="製品 B" />
                    <clam:BarSeries ItemsSource="{Binding Sales}"
                                    YKey="productC" StackGroup="sales"
                                    Title="製品 C"
                                    CornerRadius="3" />
                </clam:ClamChartView>
            </Border>

            <Border Style="{StaticResource PanelBorder}"
                    IsVisible="{Binding Kind, Converter={s:CompareToBool}, ConverterParameter={x:Static module:ViewChartKind.Scatter}}">
                <clam:ClamChartView Style="{StaticResource SampleChartBase}">
                    <clam:ScatterSeries ItemsSource="{Binding Scatter}"
                                        Title="計測値" />
                </clam:ClamChartView>
            </Border>

            <Border Style="{StaticResource PanelBorder}"
                    IsVisible="{Binding Kind, Converter={s:CompareToBool}, ConverterParameter={x:Static module:ViewChartKind.Pie}}">
                <clam:ClamPieChartView Style="{StaticResource SamplePieChart}"
                                       ItemsSource="{Binding Shares}"
                                       ValueFormat="{}{0:N0}%" />
            </Border>

            <!-- Heatmap -->
            <ScrollView IsVisible="{Binding Kind, Converter={s:CompareToBool}, ConverterParameter={x:Static module:ViewChartKind.Heatmap}}">
                <VerticalStackLayout>
                    <Border Style="{StaticResource PanelBorder}">
                        <Grid Style="{StaticResource PanelGrid}"
                              RowDefinitions="Auto,Auto,170">
                            <Label Grid.Row="0"
                                   Style="{StaticResource PanelTitleLabel}"
                                   Text="日ごとの活動量" />
                            <Label Grid.Row="1"
                                   Style="{StaticResource PanelNoteLabel}"
                                   Text="1 週 1 列、1 年分。GitHub の草と同じ形" />
                            <clam:ClamHeatmapView Grid.Row="2"
                                                  Style="{StaticResource SampleHeatmap}"
                                                  ItemsSource="{Binding Contributions}"
                                                  ValueFormat="{}{0:N0} 件"
                                                  ColorScale="{StaticResource ChartGreenScale}"
                                                  LayoutMode="Calendar" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource PanelBorder}">
                        <Grid Style="{StaticResource PanelGrid}"
                              RowDefinitions="Auto,Auto,260">
                            <Label Grid.Row="0"
                                   Style="{StaticResource PanelTitleLabel}"
                                   Text="曜日と時間帯のアクセス数" />
                            <Label Grid.Row="1"
                                   Style="{StaticResource PanelNoteLabel}"
                                   Text="行と列を指定した行列の形" />
                            <clam:ClamHeatmapView Grid.Row="2"
                                                  Style="{StaticResource SampleHeatmap}"
                                                  ItemsSource="{Binding Accesses}"
                                                  ValueAccessors="{x:Static sample:AccessCount.Accessors}"
                                                  RowKey="day" ColumnKey="hour" ValueKey="count"
                                                  ValueFormat="{}{0:N0}"
                                                  ColorScale="{StaticResource ChartBlueScale}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Climate -->
            <Grid RowDefinitions="Auto,*"
                  IsVisible="{Binding Kind, Converter={s:CompareToBool}, ConverterParameter={x:Static module:ViewChartKind.Climate}}">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,*">
                    <Border Grid.Column="0"
                            Style="{StaticResource PanelBorder}"
                            Margin="12,0,6,12">
                        <clam:ClamStatView Style="{StaticResource StatView}"
                                           Value="{Binding Temperature}"
                                           Title="室温"
                                           Fill="#EF5350"
                                           Unit="°C"
                                           ValueFormat="N1" />
                    </Border>
                    <Border Grid.Column="1"
                            Style="{StaticResource PanelBorder}"
                            Margin="6,0,12,12">
                        <clam:ClamStatView Style="{StaticResource StatView}"
                                           Value="{Binding Humidity}"
                                           Title="湿度"
                                           Fill="#42A5F5"
                                           Unit="%"
                                           ValueFormat="N0" />
                    </Border>
                </Grid>
                <Border Grid.Row="1"
                        Style="{StaticResource PanelBorder}">
                    <Grid Style="{StaticResource PanelGrid}"
                          RowDefinitions="Auto,*">
                        <Label Grid.Row="0"
                               Style="{StaticResource PanelTitleLabel}"
                               Text="48 時間の温度と湿度" />
                        <clam:ClamChartView Grid.Row="1"
                                            Style="{StaticResource SampleClimateChart}">
                            <clam:ClamChartView.XAxis>
                                <clam:DateTimeAxis LabelFormat="HH:mm" />
                            </clam:ClamChartView.XAxis>
                            <clam:ClamChartView.YAxis>
                                <clam:NumericAxis Title="°C" IncludeZero="False" LabelFormat="N0" />
                            </clam:ClamChartView.YAxis>
                            <clam:ClamChartView.SecondaryYAxis>
                                <clam:NumericAxis Minimum="0" Maximum="100" Title="%" LabelFormat="N0" />
                            </clam:ClamChartView.SecondaryYAxis>
                            <clam:AreaSeries ItemsSource="{Binding Records}"
                                             YKey="temperature"
                                             Title="室温"
                                             Color="#EF5350"
                                             FillOpacity="0.18"
                                             ValueFormat="{}{0:N1} °C"
                                             MarkerMode="None" />
                            <clam:LineSeries ItemsSource="{Binding Records}"
                                             YKey="outside"
                                             Title="外気温"
                                             Color="#FFA726"
                                             ValueFormat="{}{0:N1} °C"
                                             MarkerMode="None"
                                             DashPattern="4,3" />
                            <clam:LineSeries ItemsSource="{Binding Records}"
                                             YKey="humidity" YAxis="Secondary"
                                             Title="湿度"
                                             Color="#42A5F5"
                                             ValueFormat="{}{0:N0} %"
                                             MarkerMode="None" />
                        </clam:ClamChartView>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

    </Grid>

</ContentView>
