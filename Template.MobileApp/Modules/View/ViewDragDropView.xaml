<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewDragDropView"
             x:DataType="{x:Type module:ViewDragDropViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewDragDropViewModel}"
             shell:ShellProperty.Title="DragDrop"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- 標準の DragGestureRecognizer / DropGestureRecognizer のデモ (長押しでドラッグ開始) -->
    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="TaskLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource CardRowLabel}">
                <Setter Property="Padding" Value="10,12" />
            </Style>

            <Style x:Key="TaskBorder"
                   TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten1}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,3" />
            </Style>

            <!-- 挿入位置の線 (上へ動かすときは行の上端、下へ動かすときは行の下端) -->
            <Style x:Key="InsertLine"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="3" />
                <Setter Property="Color" Value="{StaticResource BlueDefault}" />
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style x:Key="ColumnBorder"
                   TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MinimumHeightRequest" Value="200" />
            </Style>

            <Style x:Key="TrashBorder"
                   TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten1}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeDashArray" Value="4,4" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="0,10" />
            </Style>

            <Style x:Key="TrashLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <!-- ドラッグ可能 + アイテム上へのドロップを受けるタスク行 (3 リスト共用) -->
            <DataTemplate x:Key="TaskTemplate"
                          x:DataType="{x:Type module:DragTask}">
                <Border Style="{StaticResource TaskBorder}">
                    <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type module:ViewDragDropViewModel}}, Path=IsDragging, x:DataType={x:Type module:ViewDragDropViewModel}}"
                                     Value="True">
                            <Setter Property="Stroke" Value="{StaticResource BlueLighten2}" />
                            <Setter Property="StrokeDashArray" Value="4,3" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding IsOver}"
                                     Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                            <Setter Property="Stroke" Value="{StaticResource BlueDefault}" />
                            <Setter Property="StrokeThickness" Value="2" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding IsSource}"
                                     Value="True">
                            <Setter Property="Opacity" Value="0.35" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <DragGestureRecognizer CanDrag="True"
                                               DragStartingCommand="{Binding Source={RelativeSource AncestorType={x:Type module:ViewDragDropViewModel}}, Path=DragStartingCommand, x:DataType={x:Type module:ViewDragDropViewModel}}"
                                               DragStartingCommandParameter="{Binding .}"
                                               DropCompletedCommand="{Binding Source={RelativeSource AncestorType={x:Type module:ViewDragDropViewModel}}, Path=DropCompletedCommand, x:DataType={x:Type module:ViewDragDropViewModel}}" />
                        <DropGestureRecognizer AllowDrop="True"
                                               DragLeaveCommand="{Binding Source={RelativeSource AncestorType={x:Type module:ViewDragDropViewModel}}, Path=ItemLeaveCommand, x:DataType={x:Type module:ViewDragDropViewModel}}"
                                               DragLeaveCommandParameter="{Binding .}"
                                               DragOverCommand="{Binding Source={RelativeSource AncestorType={x:Type module:ViewDragDropViewModel}}, Path=ItemOverCommand, x:DataType={x:Type module:ViewDragDropViewModel}}"
                                               DragOverCommandParameter="{Binding .}"
                                               DropCommand="{Binding Source={RelativeSource AncestorType={x:Type module:ViewDragDropViewModel}}, Path=DropOnItemCommand, x:DataType={x:Type module:ViewDragDropViewModel}}"
                                               DropCommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                    <Grid RowDefinitions="Auto,*,Auto"
                          ColumnDefinitions="4,*">
                        <BoxView Grid.Row="0" Grid.ColumnSpan="2"
                                 Style="{StaticResource InsertLine}"
                                 IsVisible="{Binding IsOverAbove}" />
                        <BoxView Grid.Row="2" Grid.ColumnSpan="2"
                                 Style="{StaticResource InsertLine}"
                                 IsVisible="{Binding IsOverBelow}" />
                        <BoxView Grid.Row="1" Grid.Column="0"
                                 Color="{Binding Accent}" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource TaskLabel}"
                               Text="{Binding Text}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <Style x:Key="BoardGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="8" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="並べ替え"
                               Icon="{x:Static fonts:MaterialIcons.Swap_vert}">
                <VerticalStackLayout Style="{StaticResource CardSmallContentStack}">
                    <Label Style="{StaticResource BasicCaptionLabel}"
                           Text="行を長押しでドラッグし、別の行に重ねて離すとその位置へ移動する (ドラッグ中は受け入れ先が破線、重ねた行に挿入位置の線)" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReorderList}"
                                         BindableLayout.ItemTemplate="{StaticResource TaskTemplate}" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="80"
                               Title="リスト間移動とゴミ箱"
                               Icon="{x:Static fonts:MaterialIcons.Move_up}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <Label Style="{StaticResource BasicCaptionLabel}"
                           Text="TODO ⇔ DONE へドラッグで移動。ゴミ箱に落とすと削除 (重ねている先が濃く光る)" />
                    <Grid Style="{StaticResource BoardGrid}"
                          ColumnDefinitions="*,*">
                        <Border Grid.Column="0"
                                Style="{StaticResource ColumnBorder}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsDragging}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                                    <Setter Property="Stroke" Value="{StaticResource BlueLighten2}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="StrokeDashArray" Value="4,3" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding TodoOver}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten4}" />
                                    <Setter Property="Stroke" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="StrokeDashArray" Value="1,0" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <DropGestureRecognizer AllowDrop="True"
                                                       DragLeaveCommand="{Binding ListLeaveCommand}"
                                                       DragLeaveCommandParameter="Todo"
                                                       DragOverCommand="{Binding ListOverCommand}"
                                                       DragOverCommandParameter="Todo"
                                                       DropCommand="{Binding DropOnListCommand}"
                                                       DropCommandParameter="Todo" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Style="{StaticResource CardSmallContentStack}">
                                <Label Style="{StaticResource BasicHeaderCaptionLabel}"
                                       Text="TODO" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TodoList}"
                                                     BindableLayout.ItemTemplate="{StaticResource TaskTemplate}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1"
                                Style="{StaticResource ColumnBorder}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsDragging}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                                    <Setter Property="Stroke" Value="{StaticResource BlueLighten2}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="StrokeDashArray" Value="4,3" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding DoneOver}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten4}" />
                                    <Setter Property="Stroke" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="StrokeDashArray" Value="1,0" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <DropGestureRecognizer AllowDrop="True"
                                                       DragLeaveCommand="{Binding ListLeaveCommand}"
                                                       DragLeaveCommandParameter="Done"
                                                       DragOverCommand="{Binding ListOverCommand}"
                                                       DragOverCommandParameter="Done"
                                                       DropCommand="{Binding DropOnListCommand}"
                                                       DropCommandParameter="Done" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Style="{StaticResource CardSmallContentStack}">
                                <Label Style="{StaticResource BasicHeaderCaptionLabel}"
                                       Text="DONE" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DoneList}"
                                                     BindableLayout.ItemTemplate="{StaticResource TaskTemplate}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource TrashBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsDragging}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource RedLighten5}" />
                                <Setter Property="Stroke" Value="{StaticResource RedLighten2}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding TrashActive}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource RedLighten4}" />
                                <Setter Property="Stroke" Value="{StaticResource RedDefault}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <DropGestureRecognizer AllowDrop="True"
                                                   DragLeaveCommand="{Binding TrashLeaveCommand}"
                                                   DragOverCommand="{Binding TrashOverCommand}"
                                                   DropCommand="{Binding DropOnTrashCommand}" />
                        </Border.GestureRecognizers>
                        <Label Style="{StaticResource TrashLabel}"
                               Text="{x:Static fonts:MaterialIcons.Delete}" />
                    </Border>
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
