<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewStateView"
             x:DataType="{x:Type module:ViewStateViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewStateViewModel}"
             shell:ShellProperty.Title="State"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="StateErrorIconBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource BasicIconCircleBorder}">
                <Setter Property="BackgroundColor" Value="{StaticResource RedLighten4}" />
            </Style>

            <Style x:Key="StateErrorIconLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicIconCircleLabel}">
                <Setter Property="TextColor" Value="{StaticResource RedDarken2}" />
            </Style>

            <Style x:Key="StateTextLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="StateContainerGrid"
                   TargetType="Grid">
                <Setter Property="HeightRequest" Value="180" />
            </Style>

            <Style x:Key="StateButtonGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="6" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="StateContainer"
                               Icon="{x:Static fonts:MaterialIcons.Swap_horiz}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <Grid Style="{StaticResource StateButtonGrid}"
                          ColumnDefinitions="*,*,*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicOutlinedButton}"
                                Command="{Binding StateCommand}"
                                CommandParameter="Loading"
                                Text="Loading">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding CurrentState}"
                                             Value="Loading">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="BorderColor" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicOutlinedButton}"
                                Command="{Binding StateCommand}"
                                CommandParameter="Empty"
                                Text="Empty">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding CurrentState}"
                                             Value="Empty">
                                    <Setter Property="BackgroundColor" Value="{StaticResource GrayDefault}" />
                                    <Setter Property="BorderColor" Value="{StaticResource GrayDefault}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource BasicOutlinedButton}"
                                Command="{Binding StateCommand}"
                                CommandParameter="Error"
                                Text="Error">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding CurrentState}"
                                             Value="Error">
                                    <Setter Property="BackgroundColor" Value="{StaticResource RedDefault}" />
                                    <Setter Property="BorderColor" Value="{StaticResource RedDefault}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="3"
                                Style="{StaticResource BasicOutlinedButton}"
                                Command="{Binding StateCommand}"
                                CommandParameter=""
                                Text="Success">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding CurrentState, Converter={StaticResource EmptyConverter}}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource GreenDefault}" />
                                    <Setter Property="BorderColor" Value="{StaticResource GreenDefault}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <Grid Style="{StaticResource StateContainerGrid}"
                          mct:StateContainer.CurrentState="{Binding CurrentState}">
                        <mct:StateContainer.StateViews>
                            <VerticalStackLayout Style="{StaticResource BasicEmptyStack}"
                                                 mct:StateView.StateKey="Loading">
                                <ActivityIndicator Style="{StaticResource BasicLoadingIndicator}"
                                                   IsRunning="True" />
                                <Label Style="{StaticResource StateTextLabel}"
                                       Text="Loading..." />
                            </VerticalStackLayout>
                            <VerticalStackLayout Style="{StaticResource BasicEmptyStack}"
                                                 mct:StateView.StateKey="Empty">
                                <Border Style="{StaticResource BasicEmptyIconBorder}">
                                    <Label Style="{StaticResource BasicEmptyIconLabel}"
                                           Text="{x:Static fonts:MaterialIcons.Inbox}" />
                                </Border>
                                <Label Style="{StaticResource StateTextLabel}"
                                       Text="No data" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Style="{StaticResource BasicEmptyStack}"
                                                 mct:StateView.StateKey="Error">
                                <Border Style="{StaticResource StateErrorIconBorder}">
                                    <Label Style="{StaticResource StateErrorIconLabel}"
                                           Text="{x:Static fonts:MaterialIcons.Error}" />
                                </Border>
                                <Label Style="{StaticResource StateTextLabel}"
                                       Text="Failed to load" />
                            </VerticalStackLayout>
                        </mct:StateContainer.StateViews>

                        <VerticalStackLayout Style="{StaticResource BasicEmptyStack}">
                            <Border Style="{StaticResource BasicSuccessIconBorder}">
                                <Label Style="{StaticResource BasicSuccessIconLabel}"
                                       Text="{x:Static fonts:MaterialIcons.Check_circle}" />
                            </Border>
                            <Label Style="{StaticResource StateTextLabel}"
                                   Text="Loaded" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="80"
                               Title="LazyView"
                               Icon="{x:Static fonts:MaterialIcons.Hourglass_empty}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <Button Style="{StaticResource BasicOutlinedButton}"
                            Command="{Binding LoadPanelCommand}"
                            Text="Load content" />
                    <mct:LazyView x:TypeArguments="module:ViewStatePanelView"
                                  behaviors:LazyViewOption.Load="{Binding PanelRequested}" />
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
