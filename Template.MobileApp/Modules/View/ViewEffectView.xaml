<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             xmlns:extended="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="Template.MobileApp.Modules.View.ViewEffectView"
             x:DataType="{x:Type module:ViewEffectViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewEffectViewModel}"
             shell:ShellProperty.Title="Effect"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="GreenFocusEntry"
                   TargetType="Entry"
                   BasedOn="{StaticResource BasicFieldEntry}">
                <Setter Property="behaviors:Focus.FocusedStroke" Value="{StaticResource GreenDefault}" />
            </Style>

            <Style x:Key="SectionLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,20,0,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="EffectCard"
                   TargetType="Border">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Offset="0,2"
                                Brush="Black"
                                Opacity="0.12"
                                Radius="6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="EnterCard"
                   TargetType="Border"
                   BasedOn="{StaticResource EffectCard}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="EnterIconLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="EnterTextLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="12,0,0,0" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
            </Style>

            <Style x:Key="SmallActionButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="StepButton"
                   TargetType="Button"
                   BasedOn="{StaticResource SmallActionButton}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="BadgeBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="5,1" />
                <Setter Property="MinimumWidthRequest" Value="20" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Start" />
                <Setter Property="BackgroundColor" Value="{StaticResource RedDefault}" />
                <Setter Property="Stroke" Value="White" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="TranslationX" Value="10" />
                <Setter Property="TranslationY" Value="-6" />
            </Style>

            <Style x:Key="BadgeLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="AmountLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
            </Style>

            <Style x:Key="FocusEntryBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Padding" Value="12,2" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten2}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="PressCompareLabel"
                   TargetType="Label">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource GrayDefault}" />
            </Style>

            <Style x:Key="RippleEffect"
                   TargetType="toolkit:SfEffectsView">
                <Setter Property="TouchDownEffects" Value="Ripple" />
            </Style>

            <Style x:Key="EffectRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <Style x:Key="EffectPageScroll"
                   TargetType="ScrollView"
                   BasedOn="{StaticResource RootScroll}">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
            </Style>

            <Style x:Key="EffectPageStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="16,0,16,24" />
            </Style>

            <Style x:Key="SectionActionButton"
                   TargetType="Button"
                   BasedOn="{StaticResource SmallActionButton}">
                <Setter Property="Margin" Value="0,12,0,0" />
            </Style>

            <Style x:Key="BadgeHostGrid"
                   TargetType="Grid">
                <Setter Property="Margin" Value="4,0,12,0" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="BellIconLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="36" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
            </Style>

            <Style x:Key="EffectValueLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken2}" />
            </Style>

            <Style x:Key="PressEffectButton"
                   TargetType="Button"
                   BasedOn="{StaticResource SmallActionButton}">
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

            <Style x:Key="RippleButtonBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="BackgroundColor" Value="{StaticResource GreenDefault}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            </Style>

            <Style x:Key="RippleButtonLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="WaveDotStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="16" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="WaveDot"
                   TargetType="BoxView">
                <Setter Property="WidthRequest" Value="14" />
                <Setter Property="HeightRequest" Value="14" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Color" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="PulseDot"
                   TargetType="BoxView">
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="WidthRequest" Value="16" />
                <Setter Property="HeightRequest" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Color" Value="{StaticResource RedDefault}" />
            </Style>

            <Style x:Key="RowSwitch"
                   TargetType="Switch">
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="EffectCardStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="12" />
            </Style>

            <Style x:Key="HeartIconLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextColor" Value="{StaticResource RedDefault}" />
            </Style>

            <Style x:Key="FeedbackTextLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource EffectValueLabel}">
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style x:Key="FlashPreviewGrid"
                   TargetType="Grid">
                <Setter Property="HeightRequest" Value="60" />
            </Style>

            <Style x:Key="DarkPreviewBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueGrayDarken4}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="PreviewCaptionLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="FlashOverlay"
                   TargetType="BoxView">
                <Setter Property="Color" Value="White" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="InputTransparent" Value="True" />
            </Style>

            <Style x:Key="ConfettiGrid"
                   TargetType="Grid">
                <Setter Property="HeightRequest" Value="150" />
            </Style>

            <Style x:Key="CelebrateButton"
                   TargetType="Button"
                   BasedOn="{StaticResource SmallActionButton}">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="End" />
            </Style>

            <Style x:Key="TouchCardBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                <Setter Property="Stroke" Value="{StaticResource BlueLighten3}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="TouchHintLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken2}" />
            </Style>

            <Style x:Key="TintSampleStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="20" />
            </Style>

            <Style x:Key="TintSampleImage"
                   TargetType="Image">
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>

            <Style x:Key="EffectNoteLabel"
                   TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken2}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource EffectPageScroll}">
        <VerticalStackLayout Style="{StaticResource EffectPageStack}">

            <!-- エントランス(FadeUp 時間差) -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Style="{StaticResource SectionLabel}"
                       Text="エントランス(FadeUp 時間差)" />
                <Button Grid.Column="1"
                        Style="{StaticResource SectionActionButton}"
                        Command="{Binding ReplayCommand}"
                        Text="Replay" />
            </Grid>
            <Border Style="{StaticResource EnterCard}"
                    behaviors:AnimationOption.EnterAnimation="FadeUp"
                    behaviors:AnimationOption.EnterTrigger="{Binding ReplayCount}">
                <HorizontalStackLayout>
                    <Label Style="{StaticResource EnterIconLabel}"
                           Text="{x:Static fonts:MaterialIcons.Looks_one}" />
                    <Label Style="{StaticResource EnterTextLabel}"
                           Text="1 番目のカード(遅延なし)" />
                </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource EnterCard}"
                    behaviors:AnimationOption.EnterAnimation="FadeUp"
                    behaviors:AnimationOption.EnterDelay="120"
                    behaviors:AnimationOption.EnterTrigger="{Binding ReplayCount}">
                <HorizontalStackLayout>
                    <Label Style="{StaticResource EnterIconLabel}"
                           Text="{x:Static fonts:MaterialIcons.Looks_two}" />
                    <Label Style="{StaticResource EnterTextLabel}"
                           Text="2 番目のカード(120ms 遅延)" />
                </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource EnterCard}"
                    behaviors:AnimationOption.EnterAnimation="FadeUp"
                    behaviors:AnimationOption.EnterDelay="240"
                    behaviors:AnimationOption.EnterTrigger="{Binding ReplayCount}">
                <HorizontalStackLayout>
                    <Label Style="{StaticResource EnterIconLabel}"
                           Text="{x:Static fonts:MaterialIcons.Looks_3}" />
                    <Label Style="{StaticResource EnterTextLabel}"
                           Text="3 番目のカード(240ms 遅延)" />
                </HorizontalStackLayout>
            </Border>

            <!-- ポップ+バッジ -->
            <Label Style="{StaticResource SectionLabel}"
                   Text="ポップ+バッジ(BadgeCountConverter)" />
            <Border Style="{StaticResource EffectCard}">
                <Grid Style="{StaticResource EffectRowGrid}"
                      ColumnDefinitions="Auto,*,Auto,Auto">
                    <Grid Grid.Column="0"
                          Style="{StaticResource BadgeHostGrid}">
                        <Label Style="{StaticResource BellIconLabel}"
                               Text="{x:Static fonts:MaterialIcons.Notifications}" />
                        <Border Style="{StaticResource BadgeBorder}"
                                behaviors:AnimationOption.EnterAnimation="Pop"
                                behaviors:AnimationOption.EnterTrigger="{Binding BadgeCount}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding BadgeCount}"
                                             Value="0">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Style="{StaticResource BadgeLabel}"
                                   Text="{Binding BadgeCount, Converter={StaticResource BadgeCountConverter}}" />
                        </Border>
                    </Grid>
                    <Label Grid.Column="1"
                           Style="{StaticResource EffectValueLabel}"
                           Text="{Binding BadgeCount, StringFormat='Count = {0}'}" />
                    <Button Grid.Column="2"
                            Style="{StaticResource StepButton}"
                            Command="{Binding BadgePrevCommand}"
                            Text="-" />
                    <Button Grid.Column="3"
                            Style="{StaticResource StepButton}"
                            Command="{Binding BadgeNextCommand}"
                            Text="+" />
                </Grid>
            </Border>

            <!-- カウントアップ -->
            <Label Style="{StaticResource SectionLabel}"
                   Text="カウントアップ" />
            <Border Style="{StaticResource EffectCard}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Style="{StaticResource AmountLabel}"
                           behaviors:LabelOption.CountUpFormat="{}¥{0:N0}"
                           behaviors:LabelOption.CountUpValue="{Binding Amount}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource SmallActionButton}"
                            Command="{Binding AmountCommand}"
                            Text="再設定" />
                </Grid>
            </Border>

            <!-- フォーカス枠 -->
            <Label Style="{StaticResource SectionLabel}"
                   Text="フォーカス枠(Focus)" />
            <Border Style="{StaticResource FocusEntryBorder}">
                <Entry Style="{StaticResource BasicFieldEntry}"
                       Placeholder="ユーザー名(フォーカスで青枠)" />
            </Border>
            <Border Style="{StaticResource FocusEntryBorder}">
                <Entry Style="{StaticResource GreenFocusEntry}"
                       Placeholder="メールアドレス(フォーカスで緑枠)" />
            </Border>

            <!-- 押下フィードバック比較 -->
            <Label Style="{StaticResource SectionLabel}"
                   Text="押下フィードバック比較" />
            <Grid Style="{StaticResource EffectRowGrid}"
                  ColumnDefinitions="*,*">
                <VerticalStackLayout Grid.Column="0">
                    <Button Style="{StaticResource PressEffectButton}"
                            Text="Press Effect" />
                    <Label Style="{StaticResource PressCompareLabel}"
                           Text="ButtonOption.PressEffect" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Border Style="{StaticResource RippleButtonBorder}">
                        <toolkit:SfEffectsView Style="{StaticResource RippleEffect}">
                            <Label Style="{StaticResource RippleButtonLabel}"
                                   Text="Ripple" />
                        </toolkit:SfEffectsView>
                    </Border>
                    <Label Style="{StaticResource PressCompareLabel}"
                           Text="SfEffectsView(Ripple)" />
                </VerticalStackLayout>
            </Grid>

            <!-- 常時アニメ(Wave / Pulse) -->
            <Label Style="{StaticResource SectionLabel}"
                   Text="常時アニメ(Wave / Pulse)" />
            <Border Style="{StaticResource EffectCard}">
                <Grid Style="{StaticResource EffectRowGrid}"
                      ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Grid.Column="0"
                                           Style="{StaticResource WaveDotStack}">
                        <BoxView Style="{StaticResource WaveDot}"
                                 behaviors:AnimationOption.Wave="{Binding WavePulseEnabled}" />
                        <BoxView Style="{StaticResource WaveDot}"
                                 behaviors:AnimationOption.Wave="{Binding WavePulseEnabled}"
                                 behaviors:AnimationOption.WaveDelay="120" />
                        <BoxView Style="{StaticResource WaveDot}"
                                 behaviors:AnimationOption.Wave="{Binding WavePulseEnabled}"
                                 behaviors:AnimationOption.WaveDelay="240" />
                        <BoxView Style="{StaticResource PulseDot}"
                                 behaviors:AnimationOption.Pulse="{Binding WavePulseEnabled}" />
                    </HorizontalStackLayout>
                    <Switch Grid.Column="1"
                            Style="{StaticResource RowSwitch}"
                            IsToggled="{Binding WavePulseEnabled}" />
                </Grid>
            </Border>

            <!-- 変化フィードバック(Bounce / Flash / Highlight) -->
            <Label Style="{StaticResource SectionLabel}"
                   Text="変化フィードバック(Bounce / Flash / Highlight)" />
            <Border Style="{StaticResource EffectCard}">
                <VerticalStackLayout Style="{StaticResource EffectCardStack}">
                    <Grid Style="{StaticResource EffectRowGrid}"
                          ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource HeartIconLabel}"
                               behaviors:AnimationOption.BounceTrigger="{Binding FeedbackCount}"
                               Text="{x:Static fonts:MaterialIcons.Favorite}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource FeedbackTextLabel}"
                               behaviors:AnimationOption.HighlightColor="{StaticResource AmberLighten4}"
                               behaviors:AnimationOption.HighlightTrigger="{Binding FeedbackCount}"
                               Text="Bounce / Highlight / Flash を同時に発火" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SmallActionButton}"
                                Command="{Binding FeedbackCommand}"
                                Text="Fire" />
                    </Grid>
                    <Grid Style="{StaticResource FlashPreviewGrid}">
                        <Border Style="{StaticResource DarkPreviewBorder}">
                            <Label Style="{StaticResource PreviewCaptionLabel}"
                                   Text="撮影プレビュー(FlashTrigger でシャッター発光)" />
                        </Border>
                        <BoxView Style="{StaticResource FlashOverlay}"
                                 behaviors:AnimationOption.FlashTrigger="{Binding FeedbackCount}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Toolkit 演出(Confetti / TouchBehavior / IconTint) -->
            <Label Style="{StaticResource SectionLabel}"
                   Text="Toolkit 演出(Confetti / Touch / IconTint)" />
            <Border Style="{StaticResource EffectCard}">
                <VerticalStackLayout Style="{StaticResource EffectCardStack}">
                    <Grid Style="{StaticResource ConfettiGrid}">
                        <Border Style="{StaticResource DarkPreviewBorder}" />
                        <extended:SKConfettiView IsAnimationEnabled="{Binding ConfettiEnabled}">
                            <extended:SKConfettiView.Systems>
                                <extended:SKConfettiSystemCollection>
                                    <extended:SKConfettiSystem />
                                </extended:SKConfettiSystemCollection>
                            </extended:SKConfettiView.Systems>
                        </extended:SKConfettiView>
                        <Button Style="{StaticResource CelebrateButton}"
                                Command="{Binding CelebrateCommand}"
                                Text="Celebrate" />
                    </Grid>
                    <Grid Style="{StaticResource EffectRowGrid}"
                          ColumnDefinitions="*,Auto">
                        <Border Grid.Column="0"
                                Style="{StaticResource TouchCardBorder}">
                            <Border.Behaviors>
                                <mct:TouchBehavior LongPressCommand="{Binding LongPressCommand}"
                                                   PressedOpacity="0.6" PressedScale="0.95" />
                            </Border.Behaviors>
                            <Label Style="{StaticResource TouchHintLabel}"
                                   Text="TouchBehavior: 押すと縮む / 長押しでカウント" />
                        </Border>
                        <Label Grid.Column="1"
                               Style="{StaticResource EffectValueLabel}"
                               behaviors:AnimationOption.BounceTrigger="{Binding LongPressCount}"
                               Text="{Binding LongPressCount, StringFormat='長押し {0}'}" />
                    </Grid>
                    <HorizontalStackLayout Style="{StaticResource TintSampleStack}">
                        <Image Style="{StaticResource TintSampleImage}"
                               Source="account.png" />
                        <Image Style="{StaticResource TintSampleImage}"
                               Source="account.png">
                            <Image.Behaviors>
                                <mct:IconTintColorBehavior TintColor="{StaticResource BlueDefault}" />
                            </Image.Behaviors>
                        </Image>
                        <Image Style="{StaticResource TintSampleImage}"
                               Source="account.png">
                            <Image.Behaviors>
                                <mct:IconTintColorBehavior TintColor="{StaticResource RedDefault}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Style="{StaticResource EffectNoteLabel}"
                               Text="IconTintColorBehavior" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
