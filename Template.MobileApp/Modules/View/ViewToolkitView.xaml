<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:sf="http://schemas.syncfusion.com/maui/toolkit"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewToolkitView"
             x:DataType="{x:Type module:ViewToolkitViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewToolkitViewModel}"
             shell:ShellProperty.Title="Toolkit"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">
    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="ExpanderHeaderGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="0,8" />
                <Setter Property="ColumnSpacing" Value="8" />
            </Style>

            <Style x:Key="ExpanderGlyphLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="OtpInput"
                   TargetType="sf:SfOtpInput">
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="SegmentedControl"
                   TargetType="sf:SfSegmentedControl">
                <Setter Property="SelectionIndicatorSettings">
                    <Setter.Value>
                        <sf:SelectionIndicatorSettings TextColor="White"
                                                       Background="{StaticResource BlueDefault}" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ExpanderContentLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicCaptionLabel}">
                <Setter Property="Padding" Value="0,4,0,8" />
            </Style>

            <Style x:Key="AccordionHeaderLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource CardRowLabel}">
                <Setter Property="Padding" Value="4,10" />
            </Style>

            <Style x:Key="AccordionContentLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource BasicCaptionLabel}">
                <Setter Property="Padding" Value="4,4,4,10" />
            </Style>

            <Style x:Key="AvatarRowStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="12" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <!--
        導入済み Toolkit の未使用部品デモ。
        Syncfusion = SfTabView / SfOtpInput / SfSegmentedControl / SfChipGroup / SfAccordion (SfBottomSheet は View > Bottom Sheet)
        CommunityToolkit = AvatarView / Expander / RatingView
    -->
    <sf:SfTabView x:Name="ToolkitTabs"
                  IndicatorBackground="{StaticResource BlueDefault}"
                  TabBarBackground="White">
        <sf:SfTabItem Header="Input">
            <ScrollView Style="{StaticResource RootScroll}">
                <VerticalStackLayout Style="{StaticResource PageStack}">

                    <controls:InfoCard Title="SfOtpInput"
                                       Icon="{x:Static fonts:MaterialIcons.Pin}">
                        <VerticalStackLayout Style="{StaticResource CardContentStack}">
                            <sf:SfOtpInput Style="{StaticResource OtpInput}"
                                           Value="{Binding OtpValue}"
                                           Length="4" Type="Number" />
                            <Label Style="{StaticResource CardAccentLabel}"
                                   Text="{Binding OtpValue, StringFormat='Input: {0}'}" />
                        </VerticalStackLayout>
                    </controls:InfoCard>

                    <controls:InfoCard Title="SfSegmentedControl"
                                       Icon="{x:Static fonts:MaterialIcons.View_week}">
                        <VerticalStackLayout Style="{StaticResource CardContentStack}">
                            <sf:SfSegmentedControl Style="{StaticResource SegmentedControl}"
                                                   ItemsSource="{Binding Segments}"
                                                   SegmentHeight="40"
                                                   SelectedIndex="{Binding SegmentIndex, Mode=TwoWay}" />
                            <Label Style="{StaticResource CardAccentLabel}"
                                   Text="{Binding SegmentIndex, StringFormat='Index: {0}'}" />
                        </VerticalStackLayout>
                    </controls:InfoCard>

                    <controls:InfoCard Title="SfChipGroup"
                                       Icon="{x:Static fonts:MaterialIcons.Sell}">
                        <VerticalStackLayout Style="{StaticResource CardContentStack}">
                            <sf:SfChipGroup ItemsSource="{Binding Chips}"
                                            SelectedItem="{Binding SelectedChip}"
                                            ChipType="Choice"
                                            SelectedChipBackground="{StaticResource BlueDefault}"
                                            SelectedChipTextColor="White" />
                            <Label Style="{StaticResource CardAccentLabel}"
                                   Text="{Binding SelectedChip, StringFormat='Selected: {0}'}" />
                        </VerticalStackLayout>
                    </controls:InfoCard>

                </VerticalStackLayout>
            </ScrollView>
        </sf:SfTabItem>

        <sf:SfTabItem Header="Display">
            <ContentView x:DataType="{x:Type sf:SfTabView}"
                         behaviors:LazyViewOption.Load="{Binding SelectedIndex, Source={x:Reference ToolkitTabs}, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Int32 1}}">
                <behaviors:LazyViewOption.Template>
                    <DataTemplate x:DataType="module:ViewToolkitViewModel">
                        <ScrollView Style="{StaticResource RootScroll}">
                            <VerticalStackLayout Style="{StaticResource PageStack}">

                                <controls:InfoCard Title="AvatarView / RatingView"
                                                   Icon="{x:Static fonts:MaterialIcons.Person}">
                                    <VerticalStackLayout Style="{StaticResource CardLargeContentStack}">
                                        <HorizontalStackLayout Style="{StaticResource AvatarRowStack}">
                                            <mct:AvatarView WidthRequest="48" HeightRequest="48"
                                                            Text="US"
                                                            BackgroundColor="{StaticResource BlueDefault}"
                                                            TextColor="White"
                                                            BorderWidth="0" CornerRadius="24" />
                                            <mct:AvatarView WidthRequest="48" HeightRequest="48"
                                                            Text="MK"
                                                            BackgroundColor="{StaticResource GreenDefault}"
                                                            TextColor="White"
                                                            BorderWidth="0" CornerRadius="24" />
                                            <mct:AvatarView WidthRequest="48" HeightRequest="48"
                                                            Text="+3"
                                                            BackgroundColor="{StaticResource GrayLighten2}"
                                                            TextColor="{StaticResource GrayDarken3}"
                                                            BorderWidth="0" CornerRadius="24" />
                                        </HorizontalStackLayout>
                                        <VerticalStackLayout Style="{StaticResource CardSmallContentStack}">
                                            <mct:RatingView EmptyShapeColor="{StaticResource GrayLighten2}"
                                                            FillColor="{StaticResource AmberDefault}"
                                                            MaximumRating="5"
                                                            Rating="{Binding Rating}"
                                                            ShapeBorderColor="{StaticResource AmberDefault}"
                                                            ShapeDiameter="32" />
                                            <Label Style="{StaticResource CardAccentLabel}"
                                                   Text="{Binding Rating, StringFormat='Rating: {0:F1}'}" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </controls:InfoCard>

                                <controls:InfoCard Title="Expander (CommunityToolkit)"
                                                   Icon="{x:Static fonts:MaterialIcons.Unfold_more}">
                                    <mct:Expander x:Name="SampleExpander">
                                        <mct:Expander.Header>
                                            <Grid Style="{StaticResource ExpanderHeaderGrid}"
                                                  ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Style="{StaticResource CardRowLabel}"
                                                       Text="Tap to expand" />
                                                <Label Grid.Column="1"
                                                       x:DataType="{x:Type mct:Expander}"
                                                       Style="{StaticResource ExpanderGlyphLabel}"
                                                       Text="{Binding IsExpanded, Source={x:Reference SampleExpander}, Converter={StaticResource ExpandGlyphConverter}}" />
                                            </Grid>
                                        </mct:Expander.Header>
                                        <Label Style="{StaticResource ExpanderContentLabel}"
                                               Text="Expanded content" />
                                    </mct:Expander>
                                </controls:InfoCard>

                                <controls:InfoCard Title="SfAccordion"
                                                   Icon="{x:Static fonts:MaterialIcons.List}">
                                    <sf:SfAccordion>
                                        <sf:AccordionItem>
                                            <sf:AccordionItem.Header>
                                                <Label Style="{StaticResource AccordionHeaderLabel}"
                                                       Text="What is an account?" />
                                            </sf:AccordionItem.Header>
                                            <sf:AccordionItem.Content>
                                                <Label Style="{StaticResource AccordionContentLabel}"
                                                       Text="The user ID for the app" />
                                            </sf:AccordionItem.Content>
                                        </sf:AccordionItem>
                                        <sf:AccordionItem>
                                            <sf:AccordionItem.Header>
                                                <Label Style="{StaticResource AccordionHeaderLabel}"
                                                       Text="How sync works" />
                                            </sf:AccordionItem.Header>
                                            <sf:AccordionItem.Content>
                                                <Label Style="{StaticResource AccordionContentLabel}"
                                                       Text="Syncs changes in the background when online" />
                                            </sf:AccordionItem.Content>
                                        </sf:AccordionItem>
                                        <sf:AccordionItem>
                                            <sf:AccordionItem.Header>
                                                <Label Style="{StaticResource AccordionHeaderLabel}"
                                                       Text="Delete data" />
                                            </sf:AccordionItem.Header>
                                            <sf:AccordionItem.Content>
                                                <Label Style="{StaticResource AccordionContentLabel}"
                                                       Text="Delete local data in Settings" />
                                            </sf:AccordionItem.Content>
                                        </sf:AccordionItem>
                                    </sf:SfAccordion>
                                </controls:InfoCard>

                            </VerticalStackLayout>
                        </ScrollView>
                    </DataTemplate>
                </behaviors:LazyViewOption.Template>
            </ContentView>
        </sf:SfTabItem>
    </sf:SfTabView>

</ContentView>
