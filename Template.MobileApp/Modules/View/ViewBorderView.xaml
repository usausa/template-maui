<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewBorderView"
             x:DataType="{x:Type module:ViewBorderViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewBorderViewModel}"
             shell:ShellProperty.Title="Border"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True"
             behaviors:Focus.SuppressDefaultFocus="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Preview -->

            <Style x:Key="PreviewCard"
                   TargetType="controls:InfoCard">
                <Setter Property="Margin" Value="12,12,12,0" />
            </Style>

            <Style x:Key="SharedBorderStyle"
                   TargetType="Border">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Margin" Value="20" />
                <Setter Property="WidthRequest" Value="240" />
                <Setter Property="HeightRequest" Value="80" />
                <Setter Property="BackgroundColor" Value="{Binding BorderColor.Color}" />
                <Setter Property="Stroke" Value="{Binding StrokeColor.Color, Converter={StaticResource ColorToBrushConverter}}" />
                <Setter Property="StrokeThickness" Value="{Binding StrokeThickness}" />
                <Setter Property="StrokeDashArray" Value="{Binding StrokeDashArray}" />
                <Setter Property="StrokeDashOffset" Value="{Binding StrokeDashOffset}" />
                <Setter Property="StrokeLineJoin" Value="{Binding StrokeLineJoin}" />
                <Setter Property="StrokeLineCap" Value="{Binding StrokeLineCap}" />
            </Style>

            <!-- Form -->

            <Style x:Key="BorderPickerBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource CardFieldBorder}">
                <Setter Property="WidthRequest" Value="200" />
            </Style>

            <Style x:Key="ColorDotBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="20" />
                <Setter Property="HeightRequest" Value="20" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten1}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="Ellipse" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="BorderValueLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource CardRowValueLabel}">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <Grid Style="{StaticResource RootGrid}"
          RowDefinitions="Auto,*">

        <!-- Preview -->
        <controls:InfoCard Grid.Row="0"
                           Style="{StaticResource PreviewCard}"
                           behaviors:AnimationOption.EnterAnimation="FadeUp"
                           Title="Preview"
                           Icon="{x:Static fonts:MaterialIcons.Visibility}">
            <Grid>
                <Border Style="{StaticResource SharedBorderStyle}"
                        IsVisible="{Binding BorderShape, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:BorderShape.RoundRectangle}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{Binding CornerRadius}" />
                    </Border.StrokeShape>
                </Border>
                <Border Style="{StaticResource SharedBorderStyle}"
                        IsVisible="{Binding BorderShape, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:BorderShape.Ellipse}}">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                </Border>
                <Border Style="{StaticResource SharedBorderStyle}"
                        IsVisible="{Binding BorderShape, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:BorderShape.Rectangle}}">
                    <Border.StrokeShape>
                        <Rectangle />
                    </Border.StrokeShape>
                </Border>
                <Border Style="{StaticResource SharedBorderStyle}"
                        IsVisible="{Binding BorderShape, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:BorderShape.Polygon}}">
                    <Border.StrokeShape>
                        <Path Data="M 120 0 L 0 80 L 240 80 Z" />
                    </Border.StrokeShape>
                </Border>
            </Grid>
        </controls:InfoCard>

        <ScrollView Grid.Row="1"
                    Style="{StaticResource RootScroll}">
            <VerticalStackLayout Style="{StaticResource PageStack}">

                <!-- Shape and color -->
                <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                                   Title="Shape and color"
                                   Icon="{x:Static fonts:MaterialIcons.Palette}">
                    <VerticalStackLayout Style="{StaticResource CardContentStack}">
                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="Shape" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource BorderPickerBorder}">
                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                <Picker Style="{StaticResource CardFieldPicker}"
                                        ItemsSource="{Binding Shapes}"
                                        SelectedItem="{Binding BorderShape, Mode=TwoWay}" />
                            </Border>
                        </Grid>
                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="Color" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource ColorDotBorder}"
                                    BackgroundColor="{Binding BorderColor.Color}" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource BorderPickerBorder}">
                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                <Picker Style="{StaticResource CardFieldPicker}"
                                        ItemsSource="{Binding BorderColors}"
                                        ItemDisplayBinding="{Binding Path=Key, x:DataType={x:Type sample:ColorItem}}"
                                        SelectedItem="{Binding BorderColor, Mode=TwoWay}" />
                            </Border>
                        </Grid>
                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="StrokeColor" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource ColorDotBorder}"
                                    BackgroundColor="{Binding StrokeColor.Color}" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource BorderPickerBorder}">
                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                <Picker Style="{StaticResource CardFieldPicker}"
                                        ItemsSource="{Binding StrokeColors}"
                                        ItemDisplayBinding="{Binding Path=Key, x:DataType={x:Type sample:ColorItem}}"
                                        SelectedItem="{Binding StrokeColor, Mode=TwoWay}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </controls:InfoCard>

                <!-- Stroke -->
                <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                                   Title="Stroke"
                                   Icon="{x:Static fonts:MaterialIcons.Line_weight}">
                    <VerticalStackLayout Style="{StaticResource CardContentStack}">
                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="StrokeThickness" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource BorderValueLabel}"
                                   Text="{Binding StrokeThickness, StringFormat='{0:F2}'}" />
                        </Grid>
                        <Slider Value="{Binding StrokeThickness}"
                                Minimum="0" Maximum="20" />

                        <BoxView Style="{StaticResource CardDivider}" />

                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="StrokeDashArray" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource BorderValueLabel}">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:F2}, {1:F2}">
                                        <Binding Path="StrokeDashLength1" />
                                        <Binding Path="StrokeDashLength2" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </Grid>
                        <Slider Value="{Binding StrokeDashLength1}"
                                Minimum="0" Maximum="10" />
                        <Slider Value="{Binding StrokeDashLength2}"
                                Minimum="0" Maximum="10" />

                        <BoxView Style="{StaticResource CardDivider}" />

                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="StrokeDashOffset" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource BorderValueLabel}"
                                   Text="{Binding StrokeDashOffset, StringFormat='{0:F2}'}" />
                        </Grid>
                        <Slider Value="{Binding StrokeDashOffset}"
                                Minimum="0" Maximum="20" />

                        <BoxView Style="{StaticResource CardDivider}" />

                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="StrokeLineJoin" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource BorderPickerBorder}">
                                <Picker Style="{StaticResource CardFieldPicker}"
                                        ItemsSource="{Binding LineJoins}"
                                        SelectedItem="{Binding StrokeLineJoin, Mode=TwoWay}" />
                            </Border>
                        </Grid>
                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="StrokeLineCap" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource BorderPickerBorder}">
                                <Picker Style="{StaticResource CardFieldPicker}"
                                        ItemsSource="{Binding LineCaps}"
                                        SelectedItem="{Binding StrokeLineCap, Mode=TwoWay}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </controls:InfoCard>

                <!-- Corner radius -->
                <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                                   IsVisible="{Binding BorderShape, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static module:BorderShape.RoundRectangle}}"
                                   Title="Corner radius"
                                   Icon="{x:Static fonts:MaterialIcons.Rounded_corner}">
                    <VerticalStackLayout Style="{StaticResource CardContentStack}">
                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="CornerRadius" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource BorderValueLabel}">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:F2}, {1:F2}, {2:F2}, {3:F2}">
                                        <Binding Path="CornerRadiusTopLeft" />
                                        <Binding Path="CornerRadiusTopRight" />
                                        <Binding Path="CornerRadiusBottomLeft" />
                                        <Binding Path="CornerRadiusBottomRight" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </Grid>
                        <Slider Value="{Binding CornerRadiusTopLeft}"
                                Minimum="0" Maximum="40" />
                        <Slider Value="{Binding CornerRadiusTopRight}"
                                Minimum="0" Maximum="40" />
                        <Slider Value="{Binding CornerRadiusBottomLeft}"
                                Minimum="0" Maximum="40" />
                        <Slider Value="{Binding CornerRadiusBottomRight}"
                                Minimum="0" Maximum="40" />
                    </VerticalStackLayout>
                </controls:InfoCard>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentView>
