<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:drawing="clr-namespace:Template.MobileApp.Graphics.Drawing"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewGraphicsView"
             x:DataType="{x:Type module:ViewGraphicsViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewGraphicsViewModel}"
             shell:ShellProperty.Title="Graphics"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="CountdownGrid"
                   TargetType="Grid">
                <Setter Property="HeightRequest" Value="130" />
            </Style>

            <Style x:Key="CountdownDrawing"
                   TargetType="drawing:DrawingControl">
                <Setter Property="WidthRequest" Value="112" />
                <Setter Property="HeightRequest" Value="112" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="CountdownButton"
                   TargetType="Button">
                <Setter Property="WidthRequest" Value="84" />
                <Setter Property="HeightRequest" Value="84" />
                <Setter Property="CornerRadius" Value="42" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

            <Style x:Key="CountdownDoneLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GreenDefault}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="CanvasBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="280" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten2}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="LargeCanvasBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource CanvasBorder}">
                <Setter Property="HeightRequest" Value="240" />
            </Style>

            <Style x:Key="SmallCanvasBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource CanvasBorder}">
                <Setter Property="HeightRequest" Value="160" />
            </Style>

            <Style x:Key="CountChip"
                   TargetType="controls:StatusChip">
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <!-- Content -->
    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <!-- Shape drawing -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="Shape drawing"
                               Icon="{x:Static fonts:MaterialIcons.Format_paint}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">

                    <Border Style="{StaticResource CanvasBorder}">
                        <drawing:DrawingControl Drawing="{Binding Drawing}" />
                    </Border>

                    <controls:StatusChip Style="{StaticResource CountChip}"
                                         Icon="{x:Static fonts:MaterialIcons.Palette}"
                                         Text="{Binding ShapeCount, StringFormat='{0} shapes'}" />

                    <Grid Style="{StaticResource BasicButtonGrid}"
                          RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,*">
                        <Button Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding AddLineCommand}"
                                Text="Add line"
                                ImageSource="{x:Static markup:AppIcons.SmallHorizontalRule}" />
                        <Button Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding AddCircleCommand}"
                                Text="Add circle"
                                ImageSource="{x:Static markup:AppIcons.SmallRadioButtonUnchecked}" />
                        <Button Grid.Row="1" Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding AddRectCommand}"
                                Text="Add rect"
                                ImageSource="{x:Static markup:AppIcons.SmallCropSquare}" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding ClearCommand}"
                                Text="Clear"
                                ImageSource="{x:Static markup:AppIcons.SmallDoNotDisturb}" />
                    </Grid>

                </VerticalStackLayout>
            </controls:InfoCard>

            <!-- Sketch + PNG export -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="80"
                               Title="Sketch + PNG export"
                               Icon="{x:Static fonts:MaterialIcons.Draw}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">

                    <Border Style="{StaticResource LargeCanvasBorder}">
                        <drawing:DrawingControl Drawing="{Binding Sketch}" />
                    </Border>

                    <controls:StatusChip Style="{StaticResource CountChip}"
                                         Icon="{x:Static fonts:MaterialIcons.Gesture}"
                                         Text="{Binding SketchCount, StringFormat='{0} strokes'}" />

                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding UndoSketchCommand}"
                                Text="Undo"
                                ImageSource="{x:Static markup:AppIcons.SmallUndo}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding ClearSketchCommand}"
                                Text="Clear"
                                ImageSource="{x:Static markup:AppIcons.SmallDoNotDisturb}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource BasicIconOutlinedButton}"
                                Command="{Binding ExportSketchCommand}"
                                Text="Export PNG"
                                ImageSource="{x:Static markup:AppIcons.SmallImage}" />
                    </Grid>

                    <Border Style="{StaticResource SmallCanvasBorder}"
                            IsVisible="{Binding HasExport}">
                        <Image behaviors:AnimationOption.FadeInTrigger="{Binding ExportedImage}"
                               Source="{Binding ExportedImage}"
                               Aspect="AspectFit" />
                    </Border>

                </VerticalStackLayout>
            </controls:InfoCard>

            <!-- Pulse ring -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="160"
                               Title="Pulse ring"
                               Icon="{x:Static fonts:MaterialIcons.Sensors}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">

                    <Border Style="{StaticResource SmallCanvasBorder}">
                        <drawing:DrawingControl Drawing="{Binding Pulse}" />
                    </Border>

                </VerticalStackLayout>
            </controls:InfoCard>

            <!-- Countdown button -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="Countdown button"
                               Icon="{x:Static fonts:MaterialIcons.Timer}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">

                    <Grid Style="{StaticResource CountdownGrid}">
                        <drawing:DrawingControl Style="{StaticResource CountdownDrawing}"
                                                Drawing="{Binding Countdown}" />
                        <Button Style="{StaticResource CountdownButton}"
                                Command="{Binding StartCountdownCommand}"
                                Text="GO">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding CountdownRunning}"
                                             Value="True">
                                    <Setter Property="Text" Value="…" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueGrayDefault}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <Label Style="{StaticResource CountdownDoneLabel}"
                           behaviors:AnimationOption.BounceTrigger="{Binding CountdownDone}"
                           IsVisible="{Binding CountdownDone}"
                           Text="DONE!" />

                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
