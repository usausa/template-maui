<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             xmlns:animations="clr-namespace:Template.MobileApp.Animations"
             x:Class="Template.MobileApp.Modules.View.ViewEasingView"
             x:DataType="{x:Type module:ViewEasingViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewEasingViewModel}"
             shell:ShellProperty.Title="Easing"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function4Text="Run"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function4Enabled="{Binding IsRunning, Converter={StaticResource ReverseConverter}}">

    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="RunStateStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="4" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="PlayIconLabel"
                   TargetType="Label">
                <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken1}" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="EasingCardBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="6" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten1}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <Style x:Key="EasingCardGrid"
                   TargetType="Grid">
                <Setter Property="RowSpacing" Value="4" />
            </Style>

            <Style x:Key="EasingCurve"
                   TargetType="controls:EasingCurveView">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten4}" />
            </Style>

            <Style x:Key="LinearCurve"
                   TargetType="controls:EasingCurveView"
                   BasedOn="{StaticResource EasingCurve}">
                <Setter Property="LineColor" Value="{StaticResource BlueGrayDefault}" />
            </Style>

            <Style x:Key="SinCurve"
                   TargetType="controls:EasingCurveView"
                   BasedOn="{StaticResource EasingCurve}">
                <Setter Property="LineColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="CubicCurve"
                   TargetType="controls:EasingCurveView"
                   BasedOn="{StaticResource EasingCurve}">
                <Setter Property="LineColor" Value="{StaticResource GreenDefault}" />
            </Style>

            <Style x:Key="BounceCurve"
                   TargetType="controls:EasingCurveView"
                   BasedOn="{StaticResource EasingCurve}">
                <Setter Property="LineColor" Value="{StaticResource OrangeDefault}" />
            </Style>

            <Style x:Key="SpringCurve"
                   TargetType="controls:EasingCurveView"
                   BasedOn="{StaticResource EasingCurve}">
                <Setter Property="LineColor" Value="{StaticResource PurpleDefault}" />
            </Style>

            <Style x:Key="EasingNameLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken2}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="EasingBoardGrid"
                   TargetType="Grid">
                <Setter Property="Padding" Value="12" />
                <Setter Property="RowSpacing" Value="8" />
                <Setter Property="ColumnSpacing" Value="8" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten5}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <Grid Style="{StaticResource EasingBoardGrid}"
          RowDefinitions="*,*,*,*"
          ColumnDefinitions="*,*,*">

        <Border Grid.Row="0" Grid.Column="0"
                Style="{StaticResource EasingCardBorder}">
            <Grid Style="{StaticResource EasingCardGrid}"
                  RowDefinitions="*,Auto">
                <controls:EasingCurveView Grid.Row="0"
                                          Style="{StaticResource LinearCurve}"
                                          Easing="{x:Static Easing.Linear}">
                    <controls:EasingCurveView.Behaviors>
                        <s:EventRequestBehavior Request="{Binding AnimationRequest}">
                            <s:BeginAnimationAction>
                                <animations:EasingDemoAnimation Duration="2000" />
                            </s:BeginAnimationAction>
                        </s:EventRequestBehavior>
                    </controls:EasingCurveView.Behaviors>
                </controls:EasingCurveView>
                <Label Grid.Row="1"
                       Style="{StaticResource EasingNameLabel}"
                       Text="Linear" />
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1"
                Style="{StaticResource EasingCardBorder}">
            <Grid Style="{StaticResource EasingCardGrid}"
                  RowDefinitions="*,Auto">
                <controls:EasingCurveView Grid.Row="0"
                                          Style="{StaticResource SinCurve}"
                                          Easing="{x:Static Easing.SinOut}">
                    <controls:EasingCurveView.Behaviors>
                        <s:EventRequestBehavior Request="{Binding AnimationRequest}">
                            <s:BeginAnimationAction>
                                <animations:EasingDemoAnimation Duration="2000" />
                            </s:BeginAnimationAction>
                        </s:EventRequestBehavior>
                    </controls:EasingCurveView.Behaviors>
                </controls:EasingCurveView>
                <Label Grid.Row="1"
                       Style="{StaticResource EasingNameLabel}"
                       Text="SinOut" />
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="2"
                Style="{StaticResource EasingCardBorder}">
            <Grid Style="{StaticResource EasingCardGrid}"
                  RowDefinitions="*,Auto">
                <controls:EasingCurveView Grid.Row="0"
                                          Style="{StaticResource SinCurve}"
                                          Easing="{x:Static Easing.SinIn}">
                    <controls:EasingCurveView.Behaviors>
                        <s:EventRequestBehavior Request="{Binding AnimationRequest}">
                            <s:BeginAnimationAction>
                                <animations:EasingDemoAnimation Duration="2000" />
                            </s:BeginAnimationAction>
                        </s:EventRequestBehavior>
                    </controls:EasingCurveView.Behaviors>
                </controls:EasingCurveView>
                <Label Grid.Row="1"
                       Style="{StaticResource EasingNameLabel}"
                       Text="SinIn" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Style="{StaticResource EasingCardBorder}">
            <Grid Style="{StaticResource EasingCardGrid}"
                  RowDefinitions="*,Auto">
                <controls:EasingCurveView Grid.Row="0"
                                          Style="{StaticResource SinCurve}"
                                          Easing="{x:Static Easing.SinInOut}">
                    <controls:EasingCurveView.Behaviors>
                        <s:EventRequestBehavior Request="{Binding AnimationRequest}">
                            <s:BeginAnimationAction>
                                <animations:EasingDemoAnimation Duration="2000" />
                            </s:BeginAnimationAction>
                        </s:EventRequestBehavior>
                    </controls:EasingCurveView.Behaviors>
                </controls:EasingCurveView>
                <Label Grid.Row="1"
                       Style="{StaticResource EasingNameLabel}"
                       Text="SinInOut" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1"
                Style="{StaticResource EasingCardBorder}">
            <Grid Style="{StaticResource EasingCardGrid}"
                  RowDefinitions="*,Auto">
                <controls:EasingCurveView Grid.Row="0"
                                          Style="{StaticResource CubicCurve}"
                                          Easing="{x:Static Easing.CubicIn}">
                    <controls:EasingCurveView.Behaviors>
                        <s:EventRequestBehavior Request="{Binding AnimationRequest}">
                            <s:BeginAnimationAction>
                                <animations:EasingDemoAnimation Duration="2000" />
                            </s:BeginAnimationAction>
                        </s:EventRequestBehavior>
                    </controls:EasingCurveView.Behaviors>
                </controls:EasingCurveView>
                <Label Grid.Row="1"
                       Style="{StaticResource EasingNameLabel}"
                       Text="CubicIn" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2"
                Style="{StaticResource EasingCardBorder}">
            <Grid Style="{StaticResource EasingCardGrid}"
                  RowDefinitions="*,Auto">
                <controls:EasingCurveView Grid.Row="0"
                                          Style="{StaticResource CubicCurve}"
                                          Easing="{x:Static Easing.CubicOut}">
                    <controls:EasingCurveView.Behaviors>
                        <s:EventRequestBehavior Request="{Binding AnimationRequest}">
                            <s:BeginAnimationAction>
                                <animations:EasingDemoAnimation Duration="2000" />
                            </s:BeginAnimationAction>
                        </s:EventRequestBehavior>
                    </controls:EasingCurveView.Behaviors>
                </controls:EasingCurveView>
                <Label Grid.Row="1"
                       Style="{StaticResource EasingNameLabel}"
                       Text="CubicOut" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0"
                Style="{StaticResource EasingCardBorder}">
            <Grid Style="{StaticResource EasingCardGrid}"
                  RowDefinitions="*,Auto">
                <controls:EasingCurveView Grid.Row="0"
                                          Style="{StaticResource CubicCurve}"
                                          Easing="{x:Static Easing.CubicInOut}">
                    <controls:EasingCurveView.Behaviors>
                        <s:EventRequestBehavior Request="{Binding AnimationRequest}">
                            <s:BeginAnimationAction>
                                <animations:EasingDemoAnimation Duration="2000" />
                            </s:BeginAnimationAction>
                        </s:EventRequestBehavior>
                    </controls:EasingCurveView.Behaviors>
                </controls:EasingCurveView>
                <Label Grid.Row="1"
                       Style="{StaticResource EasingNameLabel}"
                       Text="CubicInOut" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1"
                Style="{StaticResource EasingCardBorder}">
            <Grid Style="{StaticResource EasingCardGrid}"
                  RowDefinitions="*,Auto">
                <controls:EasingCurveView Grid.Row="0"
                                          Style="{StaticResource BounceCurve}"
                                          Easing="{x:Static Easing.BounceOut}">
                    <controls:EasingCurveView.Behaviors>
                        <s:EventRequestBehavior Request="{Binding AnimationRequest}">
                            <s:BeginAnimationAction>
                                <animations:EasingDemoAnimation Duration="2000" />
                            </s:BeginAnimationAction>
                        </s:EventRequestBehavior>
                    </controls:EasingCurveView.Behaviors>
                </controls:EasingCurveView>
                <Label Grid.Row="1"
                       Style="{StaticResource EasingNameLabel}"
                       Text="BounceOut" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="2"
                Style="{StaticResource EasingCardBorder}">
            <Grid Style="{StaticResource EasingCardGrid}"
                  RowDefinitions="*,Auto">
                <controls:EasingCurveView Grid.Row="0"
                                          Style="{StaticResource BounceCurve}"
                                          Easing="{x:Static Easing.BounceIn}">
                    <controls:EasingCurveView.Behaviors>
                        <s:EventRequestBehavior Request="{Binding AnimationRequest}">
                            <s:BeginAnimationAction>
                                <animations:EasingDemoAnimation Duration="2000" />
                            </s:BeginAnimationAction>
                        </s:EventRequestBehavior>
                    </controls:EasingCurveView.Behaviors>
                </controls:EasingCurveView>
                <Label Grid.Row="1"
                       Style="{StaticResource EasingNameLabel}"
                       Text="BounceIn" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Grid.Column="0"
                Style="{StaticResource EasingCardBorder}">
            <Grid Style="{StaticResource EasingCardGrid}"
                  RowDefinitions="*,Auto">
                <controls:EasingCurveView Grid.Row="0"
                                          Style="{StaticResource SpringCurve}"
                                          Easing="{x:Static Easing.SpringIn}">
                    <controls:EasingCurveView.Behaviors>
                        <s:EventRequestBehavior Request="{Binding AnimationRequest}">
                            <s:BeginAnimationAction>
                                <animations:EasingDemoAnimation Duration="2000" />
                            </s:BeginAnimationAction>
                        </s:EventRequestBehavior>
                    </controls:EasingCurveView.Behaviors>
                </controls:EasingCurveView>
                <Label Grid.Row="1"
                       Style="{StaticResource EasingNameLabel}"
                       Text="SpringIn" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Grid.Column="1"
                Style="{StaticResource EasingCardBorder}">
            <Grid Style="{StaticResource EasingCardGrid}"
                  RowDefinitions="*,Auto">
                <controls:EasingCurveView Grid.Row="0"
                                          Style="{StaticResource SpringCurve}"
                                          Easing="{x:Static Easing.SpringOut}">
                    <controls:EasingCurveView.Behaviors>
                        <s:EventRequestBehavior Request="{Binding AnimationRequest}">
                            <s:BeginAnimationAction>
                                <animations:EasingDemoAnimation Duration="2000" />
                            </s:BeginAnimationAction>
                        </s:EventRequestBehavior>
                    </controls:EasingCurveView.Behaviors>
                </controls:EasingCurveView>
                <Label Grid.Row="1"
                       Style="{StaticResource EasingNameLabel}"
                       Text="SpringOut" />
            </Grid>
        </Border>

        <!-- 実行状態 -->
        <Border Grid.Row="3" Grid.Column="2"
                Style="{StaticResource EasingCardBorder}">
            <VerticalStackLayout Style="{StaticResource RunStateStack}">
                <Label Style="{StaticResource PlayIconLabel}"
                       Text="{x:Static fonts:MaterialIcons.Play_arrow}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsRunning}"
                                     Value="True">
                            <Setter Property="Text" Value="{x:Static fonts:MaterialIcons.Schedule}" />
                            <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                            <Setter Property="behaviors:AnimationOption.Pulse" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Style="{StaticResource EasingNameLabel}"
                       Text="Run key">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsRunning}"
                                     Value="True">
                            <Setter Property="Text" Value="Running..." />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentView>
