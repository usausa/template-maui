<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewMenuView"
             x:DataType="{x:Type module:ViewMenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewMenuViewModel}"
             shell:ShellProperty.Title="View"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="*,*,*,*,*,*,*,*,*"
          ColumnDefinitions="*,*">

        <Button Grid.Row="0" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewCollection}"
                Text="Collection"
                ImageSource="{x:Static markup:AppIcons.ViewList}" />
        <Button Grid.Row="0" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewLayout}"
                Text="Layout"
                ImageSource="{x:Static markup:AppIcons.ViewQuilt}" />

        <Button Grid.Row="1" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewCarousel}"
                Text="Carousel"
                ImageSource="{x:Static markup:AppIcons.ViewCarousel}" />
        <Button Grid.Row="1" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewRefresh}"
                Text="Refresh"
                ImageSource="{x:Static markup:AppIcons.Refresh}" />

        <Button Grid.Row="2" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewBorder}"
                Text="Border"
                ImageSource="{x:Static markup:AppIcons.BorderStyle}" />
        <Button Grid.Row="2" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewShadow}"
                Text="Shadow"
                ImageSource="{x:Static markup:AppIcons.BlurOn}" />

        <Button Grid.Row="3" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewAnimation}"
                Text="Animation"
                ImageSource="{x:Static markup:AppIcons.Animation}" />
        <Button Grid.Row="3" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewEasing}"
                Text="Easing"
                ImageSource="{x:Static markup:AppIcons.ShowChart}" />

        <Button Grid.Row="4" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewLottie}"
                Text="Lottie"
                ImageSource="{x:Static markup:AppIcons.MovieFilter}" />
        <Button Grid.Row="4" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewSvg}"
                Text="Svg"
                ImageSource="{x:Static markup:AppIcons.Image}" />

        <Button Grid.Row="5" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewGraphics}"
                Text="Graphics"
                ImageSource="{x:Static markup:AppIcons.Brush}" />
        <Button Grid.Row="5" Grid.Column="1"
                Style="{StaticResource MenuButton}"
                IsEnabled="False"
                Text="" />

        <Button Grid.Row="6" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewDrawing}"
                Text="Drawing"
                ImageSource="{x:Static markup:AppIcons.Draw}" />
        <Button Grid.Row="6" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewDragDrop}"
                Text="DragDrop"
                ImageSource="{x:Static markup:AppIcons.DragIndicator}" />

        <Button Grid.Row="7" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewEffect}"
                Text="Effect"
                ImageSource="{x:Static markup:AppIcons.AutoAwesome}" />
        <Button Grid.Row="7" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewState}"
                Text="State"
                ImageSource="{x:Static markup:AppIcons.ToggleOn}" />

        <Button Grid.Row="8" Grid.Column="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewToolkit}"
                Text="Toolkit"
                ImageSource="{x:Static markup:AppIcons.Handyman}" />
        <Button Grid.Row="8" Grid.Column="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId ViewCustom}"
                Text="Custom"
                ImageSource="{x:Static markup:AppIcons.Extension}" />
    </Grid>


</ContentView>
