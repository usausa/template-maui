<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewCustomView"
             x:DataType="{x:Type module:ViewCustomViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewCustomViewModel}"
             shell:ShellProperty.Title="Custom"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- MarqueeLabel -->

            <Style x:Key="MarqueeBorder"
                   TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource BlueGrayDarken4}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="Padding" Value="8,6" />
            </Style>

            <Style x:Key="MarqueeTextLabel"
                   TargetType="cmc:MarqueeLabel">
                <Setter Property="HeightRequest" Value="24" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#7DF36B" />
            </Style>

            <!-- TreeView -->

            <Style x:Key="FileTreeView"
                   TargetType="cmc:TreeView">
                <Setter Property="ExpandedIcon" Value="{x:Static fonts:MaterialIcons.Expand_more}" />
                <Setter Property="CollapsedIcon" Value="{x:Static fonts:MaterialIcons.Chevron_right}" />
                <Setter Property="IconFontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
            </Style>

            <!-- ColorPicker -->

            <Style x:Key="ColorSwatchBoxView"
                   TargetType="BoxView">
                <Setter Property="WidthRequest" Value="24" />
                <Setter Property="HeightRequest" Value="24" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <!-- AvatarGroup -->

            <Style x:Key="MemberAvatarGroup"
                   TargetType="cmc:AvatarGroup">
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="AvatarSize" Value="40" />
                <Setter Property="Overlap" Value="12" />
            </Style>

            <Style x:Key="SmallButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken2}" />
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
                <Setter Property="behaviors:ButtonOption.PressEffect" Value="True" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <!-- MarqueeLabel -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Title="MarqueeLabel"
                               Icon="{x:Static fonts:MaterialIcons.Campaign}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <Border Style="{StaticResource MarqueeBorder}">
                        <cmc:MarqueeLabel Style="{StaticResource MarqueeTextLabel}"
                                          Text="Maintenance tonight at 21:00 / New item on sale / Double points campaign"
                                          Speed="60" />
                    </Border>
                </VerticalStackLayout>
            </controls:InfoCard>

            <!-- TreeView -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="80"
                               Title="TreeView"
                               Icon="{x:Static fonts:MaterialIcons.Account_tree}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <cmc:TreeView Style="{StaticResource FileTreeView}"
                                  ItemsSource="{Binding Nodes}"
                                  SelectedNode="{Binding SelectedNode}" />
                    <Label Style="{StaticResource CardAccentLabel}"
                           IsVisible="{Binding SelectedNode, Converter={StaticResource NotEmptyConverter}}"
                           Text="{Binding SelectedNode.Text, StringFormat='Selected: {0}', FallbackValue='-'}" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <!-- ColorPicker -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="160"
                               Title="ColorPicker"
                               Icon="{x:Static fonts:MaterialIcons.Palette}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <controls:ColorPicker SelectedColor="{Binding PickedColor}" />
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 Style="{StaticResource ColorSwatchBoxView}"
                                 Color="{Binding PickedColor}" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <!-- DurationPicker -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="240"
                               Title="DurationPicker"
                               Icon="{x:Static fonts:MaterialIcons.Timer}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <controls:DurationPicker Duration="{Binding Duration}" />
                    <Label Style="{StaticResource CardAccentLabel}"
                           Text="{Binding Duration, StringFormat='TimeSpan: {0}'}" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <!-- AvatarGroup -->
            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               behaviors:AnimationOption.EnterDelay="320"
                               Title="AvatarGroup"
                               Icon="{x:Static fonts:MaterialIcons.Group}">
                <VerticalStackLayout Style="{StaticResource CardContentStack}">
                    <Grid Style="{StaticResource BasicButtonGrid}"
                          ColumnDefinitions="*,Auto,Auto">
                        <cmc:AvatarGroup Grid.Column="0"
                                         Style="{StaticResource MemberAvatarGroup}"
                                         ItemsSource="{Binding Avatars}"
                                         MaxDisplayed="4" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding RemoveAvatarCommand}"
                                Text="Remove" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding AddAvatarCommand}"
                                Text="Add" />
                    </Grid>
                    <Label Style="{StaticResource CardAccentLabel}"
                           Text="{Binding Avatars.Count, StringFormat='{0} 人'}" />
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
