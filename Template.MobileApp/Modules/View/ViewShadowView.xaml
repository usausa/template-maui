<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:sample="clr-namespace:Template.MobileApp.Models.Sample"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.View"
             x:Class="Template.MobileApp.Modules.View.ViewShadowView"
             x:DataType="{x:Type module:ViewShadowViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ViewShadowViewModel}"
             shell:ShellProperty.Title="Shadow"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True"
             behaviors:Focus.SuppressDefaultFocus="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="ShadowTargetBorder"
                   TargetType="Border">
                <Setter Property="Margin" Value="20" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="WidthRequest" Value="240" />
                <Setter Property="HeightRequest" Value="80" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            </Style>

            <Style x:Key="PreviewCard"
                   TargetType="controls:InfoCard">
                <Setter Property="Margin" Value="12,12,12,0" />
            </Style>

            <Style x:Key="ShadowValueLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource CardRowValueLabel}">
                <Setter Property="FontFamily" Value="JetBrainsMono" />
            </Style>

            <Style x:Key="ShadowPickerBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource CardFieldBorder}">
                <Setter Property="WidthRequest" Value="200" />
            </Style>

            <Style x:Key="ColorDotBorder"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="20" />
                <Setter Property="HeightRequest" Value="20" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten1}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="Ellipse" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- ニューモーフィズム: 同色タイルに明暗 2 方向の影を重ねて凹凸を表現する -->
            <Style x:Key="NeumorphPanel"
                   TargetType="Border">
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Padding" Value="16,4" />
                <Setter Property="BackgroundColor" Value="#E0E5EC" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            </Style>

            <Style x:Key="NeumorphRowStack"
                   TargetType="HorizontalStackLayout">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Spacing" Value="48" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="NeumorphItemStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="16" />
            </Style>

            <Style x:Key="NeumorphTile"
                   TargetType="Border">
                <Setter Property="WidthRequest" Value="96" />
                <Setter Property="HeightRequest" Value="96" />
                <Setter Property="BackgroundColor" Value="#E0E5EC" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            </Style>

            <Style x:Key="NeumorphRaisedDark"
                   TargetType="Border"
                   BasedOn="{StaticResource NeumorphTile}">
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Offset="8,8"
                                Brush="#A3B1C6"
                                Opacity="0.9"
                                Radius="12" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NeumorphRaisedLight"
                   TargetType="Border"
                   BasedOn="{StaticResource NeumorphTile}">
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Offset="-8,-8"
                                Brush="White"
                                Opacity="1"
                                Radius="12" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NeumorphPressedLight"
                   TargetType="Border"
                   BasedOn="{StaticResource NeumorphTile}">
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Offset="8,8"
                                Brush="White"
                                Opacity="1"
                                Radius="12" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NeumorphPressedDark"
                   TargetType="Border"
                   BasedOn="{StaticResource NeumorphTile}">
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Offset="-8,-8"
                                Brush="#A3B1C6"
                                Opacity="0.9"
                                Radius="12" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NeumorphGlyphLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken1}" />
            </Style>

            <Style x:Key="NeumorphCaptionLabel"
                   TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <Grid Style="{StaticResource RootGrid}"
          RowDefinitions="Auto,*">

        <controls:InfoCard Grid.Row="0"
                           Style="{StaticResource PreviewCard}"
                           behaviors:AnimationOption.EnterAnimation="FadeUp"
                           Title="Preview"
                           Icon="{x:Static fonts:MaterialIcons.Visibility}">
            <Border Style="{StaticResource ShadowTargetBorder}"
                    BackgroundColor="{Binding BorderColor.Color}">
                <Border.Shadow>
                    <Shadow Offset="{Binding ShadowOffset}"
                            Brush="{Binding ShadowColor.Color, Converter={StaticResource ColorToBrushConverter}}"
                            Opacity="{Binding ShadowOpacity}"
                            Radius="{Binding ShadowRadius}" />
                </Border.Shadow>
            </Border>
        </controls:InfoCard>

        <ScrollView Grid.Row="1"
                    Style="{StaticResource RootScroll}">
            <VerticalStackLayout Style="{StaticResource PageStack}">

                <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                                   Title="Shadow"
                                   Icon="{x:Static fonts:MaterialIcons.Tune}">
                    <VerticalStackLayout Style="{StaticResource CardContentStack}">
                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="Border" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource ColorDotBorder}"
                                    BackgroundColor="{Binding BorderColor.Color}" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource ShadowPickerBorder}">
                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                <Picker Style="{StaticResource CardFieldPicker}"
                                        ItemsSource="{Binding BorderColors}"
                                        SelectedItem="{Binding BorderColor, Mode=TwoWay}"
                                        ItemDisplayBinding="{Binding Path=Key, x:DataType={x:Type sample:ColorItem}}" />
                            </Border>
                        </Grid>
                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="Color" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource ColorDotBorder}"
                                    BackgroundColor="{Binding ShadowColor.Color}" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource ShadowPickerBorder}">
                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                <Picker Style="{StaticResource CardFieldPicker}"
                                        ItemsSource="{Binding ShadowColors}"
                                        SelectedItem="{Binding ShadowColor, Mode=TwoWay}"
                                        ItemDisplayBinding="{Binding Path=Key, x:DataType={x:Type sample:ColorItem}}" />
                            </Border>
                        </Grid>

                        <BoxView Style="{StaticResource CardDivider}" />

                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="Offset" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource ShadowValueLabel}">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:F2}, {1:F2}">
                                        <Binding Path="ShadowOffsetX" />
                                        <Binding Path="ShadowOffsetY" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </Grid>
                        <Slider Value="{Binding ShadowOffsetX, Mode=TwoWay}"
                                Minimum="-20" Maximum="20" />
                        <Slider Value="{Binding ShadowOffsetY, Mode=TwoWay}"
                                Minimum="-20" Maximum="20" />

                        <BoxView Style="{StaticResource CardDivider}" />

                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="Radius" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource ShadowValueLabel}"
                                   Text="{Binding ShadowRadius, StringFormat='{0:F2}'}" />
                        </Grid>
                        <Slider Value="{Binding ShadowRadius, Mode=TwoWay}"
                                Minimum="0" Maximum="40" />

                        <BoxView Style="{StaticResource CardDivider}" />

                        <Grid Style="{StaticResource CardRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource CardRowLabel}"
                                   Text="Opacity" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource ShadowValueLabel}"
                                   Text="{Binding ShadowOpacity, StringFormat='{0:F2}'}" />
                        </Grid>
                        <Slider Value="{Binding ShadowOpacity, Mode=TwoWay}"
                                Minimum="0" Maximum="1.0" />
                    </VerticalStackLayout>
                </controls:InfoCard>

                <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                                   Title="Neumorphism"
                                   Icon="{x:Static fonts:MaterialIcons.Contrast}">
                    <VerticalStackLayout Style="{StaticResource CardContentStack}">
                        <Label Style="{StaticResource BasicCaptionLabel}"
                               Text="Two shadows" />
                        <Border Style="{StaticResource NeumorphPanel}">
                            <HorizontalStackLayout Style="{StaticResource NeumorphRowStack}">
                                <VerticalStackLayout Style="{StaticResource NeumorphItemStack}">
                                    <Grid>
                                        <Border Style="{StaticResource NeumorphRaisedDark}" />
                                        <Border Style="{StaticResource NeumorphRaisedLight}">
                                            <Label Style="{StaticResource NeumorphGlyphLabel}"
                                                   Text="Raised" />
                                        </Border>
                                    </Grid>
                                    <Label Style="{StaticResource NeumorphCaptionLabel}"
                                           Text="Raised" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Style="{StaticResource NeumorphItemStack}">
                                    <Grid>
                                        <Border Style="{StaticResource NeumorphPressedLight}" />
                                        <Border Style="{StaticResource NeumorphPressedDark}">
                                            <Label Style="{StaticResource NeumorphGlyphLabel}"
                                                   Text="Pressed" />
                                        </Border>
                                    </Grid>
                                    <Label Style="{StaticResource NeumorphCaptionLabel}"
                                           Text="Pressed" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </controls:InfoCard>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentView>
