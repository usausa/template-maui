{
  "AttributesTolerance": 1,
  "KeepFirstAttributeOnSameLine": true,
  "MaxAttributeCharactersPerLine": 0,
  "MaxAttributesPerLine": 4,
  "NewlineExemptionElements": "
    RadialGradientBrush, GradientStop, LinearGradientBrush,
    ScaleTransform, SkewTransform, RotateTransform, TranslateTransform,
    Trigger, Condition, Setter, On,
    clam:CategoryAxis, clam:DateTimeAxis, clam:NumericAxis, clam:ChartThreshold",
  "SeparateByGroups": true,
  "AttributeIndentation": 0,
  "AttributeIndentationStyle": 1,
  "RemoveDesignTimeReferences": false,
  "EnableAttributeReordering": true,
  "AttributeOrderingRuleGroups": [
    "xmlns",
    "xmlns:x",
    "xmlns:sys",
    "xmlns:d",
    "xmlns:mc",

    "xmlns:android",
    "xmlns:ios",

    "xmlns:logging",
    "xmlns:devices",
    "xmlns:networking",

    "xmlns:s",
    "xmlns:navigation",

    "xmlns:clam",
    "xmlns:cm",
    "xmlns:cmc",

    "xmlns:mct",
    "xmlns:camera",

    "xmlns:sf",
    "xmlns:charts",
    "xmlns:drawer",
    "xmlns:spark",
    "xmlns:sunburst",

    "xmlns:maps",
    "xmlns:mapsui",
    "xmlns:markdown",
    "xmlns:pdf",
    "xmlns:scanner",

    "xmlns:skia",
    "xmlns:extended",

    "xmlns:fonts",
    "xmlns:strings",

    "xmlns:application",
    "xmlns:shell",
    "xmlns:diagnostics",

    "xmlns:animations",
    "xmlns:behaviors",
    "xmlns:controls",
    "xmlns:converters",
    "xmlns:drawing",
    "xmlns:effects",
    "xmlns:markup",

    "xmlns:scene",

    "xmlns:domain",
    "xmlns:enums",
    "xmlns:logic",
    "xmlns:helpers",

    "xmlns:components",
    "xmlns:services",

    "xmlns:state",

    "xmlns:models",
    "xmlns:entity",
    "xmlns:app",
    "xmlns:sample",

    "xmlns:modules",
    "xmlns:module",

    "xmlns:*",

    "mc:Ignorable, d:IsDataSource, d:LayoutOverrides, d:IsStaticText",

    "x:TypeArguments",
    "x:Class",
    "x:Type",
    "x:Key, Key",
    "x:Name, Name",
    "x:Uid, Uid",

    "s:Behavior.Key",
    "s:ValidationProperty.*",

    "TargetType, BasedOn",

    "Class",
    "ClassId",

    "TargetName",
    "Property",

    "Grid.Row, Grid.RowSpan, Grid.Column, Grid.ColumnSpan",
    "Canvas.Left, Canvas.Top, Canvas.Right, Canvas.Bottom",
    "AbsoluteLayout.LayoutBounds, AbsoluteLayout.LayoutFlags",

    "x:DataType",
    "s:BindingContextResolver.*",
    "BindingContext",

    "Style",
    "StyleClass",

    "shell:ShellProperty.Title",
    "shell:ShellProperty.HeaderVisible",
    "shell:ShellProperty.FunctionVisible",
    "shell:ShellProperty.Function1Text",
    "shell:ShellProperty.Function2Text",
    "shell:ShellProperty.Function3Text",
    "shell:ShellProperty.Function4Text",
    "shell:ShellProperty.Function1Enabled",
    "shell:ShellProperty.Function2Enabled",
    "shell:ShellProperty.Function3Enabled",
    "shell:ShellProperty.Function4Enabled",
    "shell:ShellProperty.StatusBarColor",
    "shell:ShellProperty.StatusBarStyle",

    "shell:ShellProperty.BusyOverlay",

    "RowDefinitions",
    "ColumnDefinitions",
    "Width, Height, MinWidth, MinHeight, MaxWidth, MaxHeight, WidthRequest, HeightRequest",

    "android:*",
    "ios:*",
    "cm:*",
    "cmc:*",
    "mct:*",
    "controls:*",
    "behaviors:AnimationOption.EnterAnimation",
    "behaviors:AnimationOption.EnterDelay",
    "behaviors:AnimationOption.Wave",
    "behaviors:AnimationOption.WaveDelay",
    "behaviors:AnimationOption.Ripple",
    "behaviors:AnimationOption.RippleDelay",
    "behaviors:LabelOption.CountUpDuration",
    "behaviors:LabelOption.CountUpFormat",
    "behaviors:LabelOption.CountUpValue",
    "behaviors:GestureOption.PinchEnabled",
    "behaviors:GestureOption.PanEnabled",
    "behaviors:GestureOption.MinScale",
    "behaviors:GestureOption.MaxScale",
    "behaviors:GestureOption.ZoomScale",
    "behaviors:GestureOption.ZoomOffset",
    "behaviors:*",
    "s:*",
    "effects:*",

    "Platform",

    "Orientation",
    "Margin, Padding, ContentPadding",
    "Spacing, RowSpacing, ColumnSpacing",
    "Span, ItemSpacing, HorizontalItemSpacing, VerticalItemSpacing",
    "HorizontalOptions, VerticalOptions",
    "HorizontalTextAlignment, VerticalTextAlignment, HorizontalContentAlignment, VerticalContentAlignment, Panel.ZIndex",
    "Alignment, VerticalAlignment",

    "ItemsSource",
    "ValueAccessors",
    "XKey, YKey, YAxis, StackGroup",
    "XBindingPath, YBindingPath",
    "RowKey, ColumnKey, ValueKey",
    "ItemDisplayBinding",
    "BindableLayout.ItemsSource",
    "BindableLayout.ItemTemplate",
    "BindableLayout.ItemTemplateSelector",
    "ItemTemplate",
    "ItemsLayout",
    "SelectedItem",
    "SelectedIndex",
    "SelectionMode",
    "Position, IndicatorView, Loop, IsScrollAnimated",
    "ItemsUpdatingScrollMode",
    "SnapPointsType, SnapPointsAlignment",
    "HorizontalScrollBarVisibility, VerticalScrollBarVisibility",
    "Source",
    "Aspect",
    "PageSource, PageIndex, Offset",

    "EventName",
    "Direction, Threshold",
    "Command, CommandParameter",
    "AllowDrop, CanDrag",
    "DragStartingCommand, DragStartingCommandParameter",
    "DropCompletedCommand",
    "DragOverCommand, DragOverCommandParameter",
    "DragLeaveCommand, DragLeaveCommandParameter",
    "DropCommand, DropCommandParameter",

    "IsEnabled",
    "IsToggled",
    "IsChecked",
    "IsOpen",
    "IsRunning",
    "IsRefreshing",
    "IsPassword",
    "IsVisible",
    "InputTransparent",

    "Binding",
    "Path, Converter, StringFormat, TargetNullValue",
    "Value",
    "TrendValues",
    "Date",
    "Time",
    "Minimum, Maximum",
    "StartPoint, EndPoint",
    "Progress",

    "Title",
    "Header",
    "Label",
    "Icon, IconColor",
    "Text",
    "CenterLabel, CenterText",
    "Content",
    "Glyph",
    "Size",
    "Placeholder",
    "ImageSource",

    "FontFamily, FontSize, FontAttributes",
    "Color, BackgroundColor, Background, TextColor",
    "ProgressColor",
    "OnColor, OffColor, ThumbColor",
    "MinimumTrackColor, MaximumTrackColor",
    "Brush",
    "Data, Points",
    "Fill, FillMode, FillOpacity",
    "Opacity",
    "Rotation, Scale",
    "IsClippedToBounds",
    "Stroke, StrokeThickness, StrokeShape",
    "BorderColor, BorderWidth, CornerRadius",
    "Radius",
    "Center, RadiusX, RadiusY",

    "Storyboard.*, From, To, Duration",
    "Easing",

    "KeyCode",

    "Keyboard",
    "MaxLength",
    "ReturnType, ReturnCommand",

    "IsAnimationEnabled",

    "GaugeColor",
    "ValueColor",
    "MaxSpeed",
    "Speed",
    "OnText, OffText",

    "CurrentStep, TotalSteps",
    "MinimumValue, MaximumValue",
    "OffsetX, OffsetY",
    "TranslateX, TranslateY",
    "Unit, UnitPosition",
    "ValueFormat, ValueVisible",
    "StartValue, StartColor",
    "EndValue, EndColor",
    "MarkerMode, MarkerSize",
    "AllowSorting, AllowResizing",
    "IsBoolean, IsReadOnly",
    "Text1, Text2, Text3",

    "ToolTipProperties.Text",

    "*",
    "*:*",

    "Expression",
    "TrueValue",
    "FalseValue",
    "HandleEmptyString",
    "NullValue",
    "NonNullValue",
    "DefaultValue"
  ],
  "FirstLineAttributes": "",
  "OrderAttributesByName": true,
  "PutEndingBracketOnNewLine": false,
  "RemoveEndingTagOfEmptyElement": true,
  "SpaceBeforeClosingSlash": true,
  "RootElementLineBreakRule": 0,
  "ReorderVSM": 1,
  "ReorderGridChildren": false,
  "ReorderCanvasChildren": false,
  "ReorderSetters": 0,
  "FormatMarkupExtension": true,
  "NoNewLineMarkupExtensions": "
    Binding, TemplateBinding, AppThemeBinding,
    OnPlatform, OnIdiom,
    s:BoolToBrush, s:BoolToColor, s:BoolToText, s:BoolToVisibility,
    s:ColorBlend,
    s:CompareToBool, s:CompareToBrush, s:CompareToColor, s:CompareToText, s:CompareToVisibility,
    s:ContainsToBool, s:ContainsToBrush, s:ContainsToColor, s:ContainsToText, s:ContainsToVisibility,
    s:FontImage, s:ImageResource,
    s:IntToBool,
    s:NullToBool, s:NullToBrush, s:NullToColor, s:NullToText, s:NullToVisibility,
    s:TextReplace, s:TextToBool",
  "ThicknessSeparator": 2,
  "ThicknessAttributes": "
    Margin, Padding",
  "FormatOnSave": true,
  "CommentPadding": 1,
  "IndentSize": 4
}
