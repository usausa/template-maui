{
  "AttributesTolerance": 1,
  "KeepFirstAttributeOnSameLine": true,
  "MaxAttributeCharactersPerLine": 0,
  "MaxAttributesPerLine": 4,
  "NewlineExemptionElements": "RadialGradientBrush, GradientStop, LinearGradientBrush, ScaleTransform, SkewTransform, RotateTransform, TranslateTransform, Trigger, Condition, Setter, On",
  "SeparateByGroups": true,
  "AttributeIndentation": 0,
  "AttributeIndentationStyle": 1,
  "RemoveDesignTimeReferences": false,
  "EnableAttributeReordering": true,
  "AttributeOrderingRuleGroups": [
    "xmlns",
    "xmlns:x",
    "xmlns:sys",
    "xmlns:d",
    "xmlns:mc",

    "xmlns:android",
    "xmlns:ios",

    "xmlns:logging",
    "xmlns:devices",
    "xmlns:networking",

    "xmlns:s",
    "xmlns:navigation",

    "xmlns:clam",
    "xmlns:cm",
    "xmlns:cmc",

    "xmlns:mct",
    "xmlns:camera",

    "xmlns:sf",
    "xmlns:charts",
    "xmlns:drawer",
    "xmlns:spark",
    "xmlns:sunburst",

    "xmlns:maps",
    "xmlns:mapsui",
    "xmlns:markdown",
    "xmlns:pdf",
    "xmlns:scanner",

    "xmlns:skia",
    "xmlns:extended",

    "xmlns:fonts",
    "xmlns:strings",

    "xmlns:application",
    "xmlns:shell",
    "xmlns:diagnostics",

    "xmlns:animations",
    "xmlns:behaviors",
    "xmlns:controls",
    "xmlns:converters",
    "xmlns:effects",
    "xmlns:markup",

    "xmlns:drawing",
    "xmlns:scene",

    "xmlns:components",
    "xmlns:services",

    "xmlns:state",

    "xmlns:models",
    "xmlns:entity",
    "xmlns:app",
    "xmlns:sample",

    "xmlns:modules",
    "xmlns:module",

    "xmlns:*",

    "mc:Ignorable, d:IsDataSource, d:LayoutOverrides, d:IsStaticText",

    "x:TypeArguments",
    "x:Class",
    "x:Type",
    "x:Key, Key",
    "x:Name, Name",
    "x:Uid, Uid",

    "s:Behavior.Key",
    "s:ValidationProperty.*",

    "TargetType, BasedOn",

    "Class",
    "ClassId",

    "TargetName",
    "Property",

    "Grid.Row, Grid.RowSpan, Grid.Column, Grid.ColumnSpan",
    "Canvas.Left, Canvas.Top, Canvas.Right, Canvas.Bottom",
    "AbsoluteLayout.LayoutBounds, AbsoluteLayout.LayoutFlags",

    "x:DataType",
    "s:BindingContextResolver.*",
    "BindingContext",

    "Style",
    "StyleClass",

    "shell:ShellProperty.Title",
    "shell:ShellProperty.HeaderVisible",
    "shell:ShellProperty.FunctionVisible",
    "shell:ShellProperty.Function1Text",
    "shell:ShellProperty.Function2Text",
    "shell:ShellProperty.Function3Text",
    "shell:ShellProperty.Function4Text",
    "shell:ShellProperty.Function1Enabled",
    "shell:ShellProperty.Function2Enabled",
    "shell:ShellProperty.Function3Enabled",
    "shell:ShellProperty.Function4Enabled",

    "shell:ShellProperty.BusyOverlay",

    "RowDefinitions",
    "ColumnDefinitions",
    "Width, Height, MinWidth, MinHeight, MaxWidth, MaxHeight, WidthRequest, HeightRequest",

    "android:*",
    "ios:*",
    "cm:*",
    "cmc:*",
    "mct:*",
    "controls:*",
    "behaviors:AnimationOption.EnterAnimation",
    "behaviors:AnimationOption.EnterDelay",
    "behaviors:AnimationOption.Wave",
    "behaviors:AnimationOption.WaveDelay",
    "behaviors:AnimationOption.Ripple",
    "behaviors:AnimationOption.RippleDelay",
    "behaviors:LabelOption.CountUpDuration",
    "behaviors:LabelOption.CountUpFormat",
    "behaviors:LabelOption.CountUpValue",
    "behaviors:*",
    "s:*",
    "effects:*",

    "Platform",

    "Orientation",
    "Margin, Padding",
    "Spacing, RowSpacing, ColumnSpacing",
    "HorizontalOptions, VerticalOptions",
    "HorizontalTextAlignment, VerticalTextAlignment, HorizontalContentAlignment, VerticalContentAlignment, Panel.ZIndex",

    "ItemsSource",
    "BindableLayout.ItemsSource",
    "BindableLayout.ItemTemplate",
    "SelectedItem",
    "SelectionMode",
    "ItemsUpdatingScrollMode",
    "HorizontalScrollBarVisibility, VerticalScrollBarVisibility",
    "Source",
    "PageSource, PageIndex, Offset",

    "Command, CommandParameter",

    "IsEnabled",
    "IsToggled",
    "IsChecked",
    "IsOpen",
    "IsRunning",
    "IsPassword",
    "IsVisible",
    "InputTransparent",

    "Binding",
    "Value",
    "Minimum, Maximum",
    "StartPoint, EndPoint",
    "Progress",

    "Title",
    "Icon, IconColor",
    "Text",
    "Glyph",
    "Placeholder",
    "ImageSource",

    "FontFamily, FontSize, FontAttributes",
    "Color, BackgroundColor, TextColor",
    "Brush",
    "Fill",
    "Opacity",
    "Stroke, StrokeThickness, StrokeShape",
    "BorderColor, BorderWidth, CornerRadius",
    "Radius",

    "Storyboard.*, From, To, Duration",

    "KeyCode",

    "Keyboard",

    "IsAnimationEnabled",

    "GaugeColor",
    "ValueColor",
    "MaxSpeed",
    "Speed",
    "OnText, OffText",

    "CurrentStep, TotalSteps",
    "MinimumValue, MaximumValue",
    "OffsetX, OffsetY",
    "TranslateX, TranslateY",
    "XBindingPath, YBindingPath",
    "Text1, Text2, Text3",

    "ToolTipProperties.Text",

    "*",
    "*:*",

    "TrueValue",
    "FalseValue",
    "HandleEmptyString",
    "NullValue",
    "NonNullValue"
  ],
  "FirstLineAttributes": "",
  "OrderAttributesByName": true,
  "PutEndingBracketOnNewLine": false,
  "RemoveEndingTagOfEmptyElement": true,
  "SpaceBeforeClosingSlash": true,
  "RootElementLineBreakRule": 0,
  "ReorderVSM": 1,
  "ReorderGridChildren": false,
  "ReorderCanvasChildren": false,
  "ReorderSetters": 0,
  "FormatMarkupExtension": true,
  "NoNewLineMarkupExtensions": "x:Bind, x:Binding, Binding, TemplateBinding",
  "ThicknessSeparator": 2,
  "ThicknessAttributes": "Margin, Padding, BorderThickness, ThumbnailClipMargin",
  "FormatOnSave": true,
  "CommentPadding": 1,
  "IndentSize": 4
}
